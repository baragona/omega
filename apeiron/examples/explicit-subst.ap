;; Apeiron Example: Explicit Substitution
;; "Dangerous Mode F" — Exposed + Lens Nodes
;;
;; Uses the Lens node for explicit de Bruijn index shifting.
;; NOTE: Lens interaction rules (Lens×App, Lens×Sym) are not yet
;; implemented in the physics engine. This example shows the
;; graph structure without reduction.

[System ExplicitSubst
  [@syntax [sort Term]]
  [@binding exposed]
  [@check beta-reduction]
]

[Theory LensTest :in ExplicitSubst

  ;; A Lens(+1) wrapping an application.
  ;; When Lens interactions are implemented, this would push the
  ;; shift through: [app f [var 0]] → [app f [var 1]]
  [eval lens-test [lens 1 [app f [var 0]]]]

  ;; For now, the Lens node appears in the output as a suspended graph node.
  ;; FUTURE: Lens×App splits into two Lens nodes for each sub-term.
  ;;         Lens×Sym(var) modifies the de Bruijn index.
]
