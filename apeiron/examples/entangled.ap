;; Apeiron Example: Entangled Binding
;; Binding Mode: entangled
;;
;; Wire pairs share quantum-like state: measuring one
;; determines the other. This is a placeholder — the entangled
;; mode is recognized by the parser. Full entanglement semantics
;; (correlated Dup/Erase pairs) are a future extension.
;; For now, the basic pipeline works identically to implicit mode.

[System EntangledSystem
  [@syntax [sort Term]]
  [@binding entangled]
  [@check beta-reduction]
]

[Theory EntangledDemo :in EntangledSystem

  ;; Basic operations still work
  [assert-eq entangled-id [app [lam x x] y] y]

  ;; Non-linear variable duplication (allowed in entangled mode)
  [eval entangled-dup [app [lam x [app x x]] y]]

  ;; Church encoding
  [eval entangled-church
    [app [app [lam f [lam x [app f x]]] [lam y [s y]]] z]
  ]
]
