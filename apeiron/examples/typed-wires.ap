;; Apeiron Example: Type-Checked Wires
;; Check Mode: type-check
;;
;; Wire type annotations enable sort-level validation.
;; This is a placeholder — the type-check mode is recognized
;; by the parser but full wire-type validation is a future extension.
;; For now, we verify that the mode parses and the basic pipeline works.

[System TypedSystem
  [@syntax [sort Term] [sort Type]]
  [@binding implicit]
  [@check beta-reduction type-check]
]

[Theory TypedDemo :in TypedSystem

  ;; Basic lambda calculus still works under type-check mode
  [assert-eq typed-id [app [lam x x] y] y]

  ;; Nested application
  [assert-eq typed-nested [app [lam x x] [app [lam y y] z]] z]

  ;; Eval
  [eval typed-const [app [lam x z] y]]
]
