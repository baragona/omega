;; Apeiron Example: Morphism Zoo
;; "Every Pass in the Book" — systematic test of all morphism combinations.
;;
;; Tests:
;;   Binding passes:  Identity, DeBruijnize, Namify, InjectScope, EraseScopes,
;;                    ValidateLinear, ValidateAffine, AlphaNormalize,
;;                    MaterializeErasure
;;   Checking passes: Identity, NormalizeFirst, ExtractGround, InjectAxiom
;;   Utility:         Operator renaming, @strict validation

;; ============================================================
;; SYSTEMS
;; ============================================================

;; --- Binding mode representatives ---

[System Implicit
  [@syntax [sort Term] [op z] [op s] [op plus] [op f] [op g] [op pair]]
  [@binding implicit]
  [@check rewriting beta-reduction]
]

[System Exposed
  [@syntax [sort Term] [op z] [op s] [op plus] [op f] [op g] [op pair]]
  [@binding exposed]
  [@check rewriting beta-reduction]
]

[System Contextual
  [@syntax [sort Term] [op z] [op s] [op plus] [op f] [op g] [op pair]]
  [@binding contextual]
  [@check rewriting beta-reduction]
]

[System Linear
  [@syntax [sort Term] [op z] [op s] [op plus] [op f] [op g] [op pair]]
  [@binding linear-explicit]
  [@check rewriting beta-reduction]
]

[System Nominal
  [@syntax [sort Term] [op z] [op s] [op plus] [op f] [op g] [op pair]]
  [@binding nominal]
  [@check oracle]
]

;; --- Checking mode representatives ---

[System OracleOnly
  [@syntax [sort Term] [op z] [op s] [op plus] [op f] [op g] [op pair]]
  [@binding implicit]
  [@check oracle]
]

[System PatternSys
  [@syntax [sort Term] [op z] [op s] [op plus] [op f] [op g] [op pair]]
  [@binding implicit]
  [@check pattern-unification]
]

;; --- For operator renaming ---

[System Renamed
  [@syntax [sort Term] [op zero] [op succ] [op add] [op apply] [op compose] [op tuple]]
  [@binding implicit]
  [@check rewriting beta-reduction]
]

;; ============================================================
;; SECTION 1: Identity (same binding mode)
;; ============================================================

[AutoMorphism IdPass Implicit Implicit]

[Theory IdentitySrc :in Implicit
  [def id-term [f [s z]]]
]

[Theory IdentityTest :in Implicit
  [Import id-result [IdPass id-term]]
]

[Proofs IdentityCheck :in IdentityTest
  [assert-eq identity-pass id-result [f [s z]]]
]

;; ============================================================
;; SECTION 2: DeBruijnize (Implicit -> Exposed)
;; ============================================================

[AutoMorphism Debruijn Implicit Exposed]

[Theory DebruijnSrc :in Implicit
  [def db-ground [pair [s z] z]]
  [def db-lam [lam x [f x]]]
  [def db-nested [lam x [lam y [pair x y]]]]
]

[Theory DebruijnTest :in Exposed
  [Import db-g [Debruijn db-ground]]
  [Import db-l [Debruijn db-lam]]
  [Import db-n [Debruijn db-nested]]
]

[Proofs DebruijnCheck :in DebruijnTest
  [assert-eq debruijn-ground db-g [pair [s z] z]]
  [assert-eq debruijn-lam db-l [lam _ [f $0]]]
  [assert-eq debruijn-nested db-n [lam _ [lam _ [pair $1 $0]]]]
]

;; ============================================================
;; SECTION 3: Namify (Exposed -> Implicit)
;; ============================================================

[AutoMorphism NameIt Exposed Implicit]

[Theory NamifySrc :in Exposed
  [def nm-lam [lam _ [f $0]]]
  [def nm-nested [lam _ [lam _ [pair $1 $0]]]]
]

[Theory NamifyTest :in Implicit
  [Import nm-l [NameIt nm-lam]]
  [Import nm-n [NameIt nm-nested]]
]

[Proofs NamifyCheck :in NamifyTest
  [assert-eq namify-lam nm-l [lam x [f x]]]
  [assert-eq namify-nested nm-n [lam x [lam y [pair x y]]]]
]

;; ============================================================
;; SECTION 4: InjectScope (Implicit -> Contextual)
;; ============================================================

[AutoMorphism Scope Implicit Contextual]

[Theory ScopeSrc :in Implicit
  [def scope-term [f z]]
]

[Theory ScopeTest :in Contextual
  [Scope Boundary]
  [Import sc-val [Scope scope-term :scope Boundary]]
]

[Proofs ScopeCheck :in ScopeTest
  [assert-eq inject-scope sc-val [box Boundary [f z]]]
]

;; ============================================================
;; SECTION 5: EraseScopes (Contextual -> Implicit)
;; ============================================================

[AutoMorphism Unscope Contextual Implicit]

[Theory UnscopeSrc :in Contextual
  [Scope Inner]
  [def unscope-term [f z]]
]

[Theory UnscopeTest :in Implicit
  [Import us-val [Unscope unscope-term]]
]

[Proofs UnscopeCheck :in UnscopeTest
  [assert-eq erase-scopes us-val [f z]]
]

;; ============================================================
;; SECTION 6: ValidateLinear (Implicit -> Linear)
;; ============================================================

[AutoMorphism GoLinear Implicit Linear]

[Theory LinearSrc :in Implicit
  [def lin-ok [lam x x]]
]

[Theory LinearTest :in Linear
  [Import lin-val [GoLinear lin-ok]]
]

[Proofs LinearValidation :in LinearTest
  [assert-eq validate-linear lin-val [lam x x]]
]

;; ============================================================
;; SECTION 7: NormalizeFirst (Compute -> Oracle)
;; ============================================================

[AutoMorphism Freeze Implicit OracleOnly]

[Theory FreezeSrc :in Implicit
  [@rule plus-z [plus z ?n] ==> ?n]
  [@rule plus-s [plus [s ?n] ?m] ==> [s [plus ?n ?m]]]
  [def freeze-computation [plus [s [s z]] [s z]]]
]

[Theory FreezeTest :in OracleOnly
  [Import frozen [Freeze freeze-computation]]
]

[Proofs FreezeCheck :in FreezeTest
  [assert-eq normalize-first frozen [s [s [s z]]]]
]

;; ============================================================
;; SECTION 8: ExtractGround (Pattern -> Implicit)
;; ============================================================

[AutoMorphism Extract PatternSys Implicit]

[Theory ExtractSrc :in PatternSys
  [def ext-term [pair [s z] z]]
]

[Theory ExtractTest :in Implicit
  [Import ext-val [Extract ext-term]]
]

[Proofs ExtractCheck :in ExtractTest
  [assert-eq extract-ground ext-val [pair [s z] z]]
]

;; ============================================================
;; SECTION 9: InjectAxiom (Oracle -> Compute)
;; ============================================================

[AutoMorphism Trust OracleOnly Implicit]

[Theory TrustSrc :in OracleOnly
  [def axiom-val [s [s z]]]
]

[Theory TrustTest :in Implicit
  [Import trusted [Trust axiom-val]]
]

[Proofs TrustCheck :in TrustTest
  [assert-eq inject-axiom trusted [s [s z]]]
]

;; ============================================================
;; SECTION 10: Operator Renaming
;; ============================================================

[AutoMorphism Rename Implicit Renamed
  [Map z zero]
  [Map s succ]
  [Map plus add]
  [Map f apply]
  [Map g compose]
  [Map pair tuple]
]

[Theory RenameSrc :in Implicit
  [def ren-term [pair [f z] [g [s z]]]]
]

[Theory RenameTest :in Renamed
  [Import ren-val [Rename ren-term]]
]

[Proofs RenameCheck :in RenameTest
  [assert-eq op-rename ren-val [tuple [apply zero] [compose [succ zero]]]]
]

;; ============================================================
;; SECTION 11: Combined — DeBruijnize + Rename
;; ============================================================

[AutoMorphism CompileAll Implicit Renamed
  [Map z zero]
  [Map s succ]
  [Map plus add]
  [Map f apply]
  [Map g compose]
  [Map pair tuple]
]

[Theory CompileAllSrc :in Implicit
  [def ca-term [lam x [pair x [f z]]]]
]

[Theory CompileAllTest :in Renamed
  [Import ca-val [CompileAll ca-term]]
]

[Proofs CompileAllCheck :in CompileAllTest
  [assert-eq compile-all ca-val [lam x [tuple x [apply zero]]]]
]

;; ============================================================
;; SECTION 12: @strict validation
;; ============================================================

[System StrictSrc
  [@syntax [sort Term] [op high-level] [op low-level]]
  [@binding implicit]
  [@check rewriting]
]

[System StrictTgt
  [@syntax [sort Term] [op LOW]]
  [@binding implicit]
  [@check oracle]
]

[AutoMorphism StrictMorph StrictSrc StrictTgt
  [Map low-level LOW]
  [@strict true]
]

[Theory StrictSrcT :in StrictSrc
  [@rule elim-hl [high-level ?x] ==> ?x]
  [def strict-ok [high-level [low-level [high-level z]]]]
]

[Theory StrictTest :in StrictTgt
  [Import strict-val [StrictMorph strict-ok]]
]

[Proofs StrictCheck :in StrictTest
  [assert-eq strict-pass strict-val [LOW z]]
]

;; ============================================================
;; SECTION 13: Roundtrip — DeBruijnize then Namify
;; ============================================================

[AutoMorphism ToDBI Implicit Exposed]
[AutoMorphism FromDBI Exposed Implicit]

[Theory RoundtripSrc :in Implicit
  [def rt-term [lam a [lam b [pair a b]]]]
]

[Theory RoundtripMid :in Exposed
  [Import rt-dbi [ToDBI rt-term]]
]

[Proofs RoundtripMidCheck :in RoundtripMid
  [assert-eq roundtrip-to-dbi rt-dbi [lam _ [lam _ [pair $1 $0]]]]
]

[Theory RoundtripDst :in Implicit
  [Import rt-named [FromDBI rt-dbi]]
]

[Proofs RoundtripDstCheck :in RoundtripDst
  [assert-eq roundtrip-from-dbi rt-named [lam x [lam y [pair x y]]]]
]

;; ============================================================
;; SECTION 14: Contextual roundtrip
;; ============================================================

[AutoMorphism WrapScope Implicit Contextual]
[AutoMorphism StripScope Contextual Implicit]

[Theory CtxRoundtripSrc :in Implicit
  [def ctx-term [f [s z]]]
]

[Theory CtxRoundtripMid :in Contextual
  [Scope Shell]
  [Import ctx-wrapped [WrapScope ctx-term :scope Shell]]
]

[Proofs CtxRoundtripMidCheck :in CtxRoundtripMid
  [assert-eq ctx-inject ctx-wrapped [box Shell [f [s z]]]]
]

[Theory CtxRoundtripDst :in Implicit
  [Import ctx-unwrapped [StripScope ctx-wrapped]]
]

[Proofs CtxRoundtripDstCheck :in CtxRoundtripDst
  [assert-eq ctx-erase ctx-unwrapped [f [s z]]]
]

;; ============================================================
;; SECTION 15: NormalizeFirst with binders
;; ============================================================

[AutoMorphism FreezeComputed Implicit OracleOnly]

[Theory FreezeLamSrc :in Implicit
  [def beta-term [app [lam x x] [s z]]]
]

[Theory FreezeLamTest :in OracleOnly
  [Import beta-frozen [FreezeComputed beta-term]]
]

[Proofs FreezeLamCheck :in FreezeLamTest
  [assert-eq normalize-beta beta-frozen [s z]]
]
