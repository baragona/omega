;; Apeiron Port: Self-Representation (from Omega's self.omega)
;; "A Proof System Checking Itself" — ported from Omega to Apeiron.
;;
;; Demonstrates Apeiron's three-layer architecture across TWO logical systems:
;;
;;   System 1: Propositional Logic
;;     [System]  — Formulas, derivation trees, checker/solver operators
;;     [Theory]  — The checker + solver as rewrite rules (trusted base)
;;     [Proofs]  — 19 verified theorems (valid, invalid, automated, reflected)
;;
;;   System 2: Arithmetic + Ackermann
;;     [System]  — Peano arithmetic + equality checker operators
;;     [Theory]  — Arithmetic + Ackermann + manual equality checker
;;     [Proofs]  — 11 verified theorems including ack(3,3) = 61
;;
;; Key insight: the Theory defines WHAT the checker/solver does (the rules).
;; The Proofs block is SEALED — it can only verify consequences, never
;; modify the trusted base. This makes the boundary explicit.
;;
;; Architecture note: Omega's tree normalizer uses innermost evaluation
;; (children normalize before parents). Apeiron's graph rewriter scans
;; nodes in allocation order. To prevent catch-all rules from firing on
;; unreduced arguments, we use specific failure patterns that only match
;; when arguments are fully reduced (ok or fail).

;; ════════════════════════════════════════════════════════════
;; SYSTEM 1: Propositional Logic with Checker
;; ════════════════════════════════════════════════════════════

[System SelfCheck
  [@syntax
    [sort Form]
    [sort Deriv]
    [sort Res]
    [sort Context]
    ;; Formulas
    [op P] [op Q] [op R] [op D] [op E]
    [op f-top] [op f-bot]
    [op f-and] [op f-imp]
    ;; Derivation trees
    [op d-assume] [op d-top]
    [op d-and-i] [op d-and-el] [op d-and-er]
    [op d-imp-i] [op d-mp]
    ;; Result type
    [op ok] [op fail]
    ;; Checker internals
    [op concl]
    [op chk-and] [op chk-and-l] [op chk-and-r]
    [op chk-imp] [op chk-mp]
    ;; Context (list)
    [op empty] [op ctx-cons]
    [op flatten] [op lookup]
    ;; Solver
    [op auto] [op tauto]
  ]
  [@binding implicit]
  [@check rewriting]
]

;; ════════════════════════════════════════════════════════════
;; THEORY: Propositional Logic Checker + Solver (Axioms)
;; ════════════════════════════════════════════════════════════
;; The trusted base. No catch-all rules: each combinator has
;; specific success and failure patterns. Unreduced arguments
;; don't match, forcing the engine to reduce children first.

[Theory PropLogic :in SelfCheck

  ;; ── concl dispatch ──
  [@rule concl-assume [concl [d-assume ?F]]       ==> [ok ?F]]
  [@rule concl-top    [concl d-top]                ==> [ok f-top]]
  [@rule concl-and-i  [concl [d-and-i ?D1 ?D2]]   ==> [chk-and [concl ?D1] [concl ?D2]]]
  [@rule concl-and-el [concl [d-and-el ?D]]        ==> [chk-and-l [concl ?D]]]
  [@rule concl-and-er [concl [d-and-er ?D]]        ==> [chk-and-r [concl ?D]]]
  [@rule concl-imp-i  [concl [d-imp-i ?A ?D]]      ==> [chk-imp ?A [concl ?D]]]
  [@rule concl-mp     [concl [d-mp ?D1 ?D2]]       ==> [chk-mp [concl ?D1] [concl ?D2]]]

  ;; ── and-intro: both must be ok ──
  [@rule chk-and-ok [chk-and [ok ?A] [ok ?B]] ==> [ok [f-and ?A ?B]]]
  [@rule chk-and-fl [chk-and fail ?Y]          ==> fail]
  [@rule chk-and-fr [chk-and [ok ?X] fail]     ==> fail]

  ;; ── and-elim-l: must be conjunction ──
  [@rule chk-and-l-ok     [chk-and-l [ok [f-and ?A ?B]]] ==> [ok ?A]]
  [@rule chk-and-l-fail   [chk-and-l fail]                ==> fail]
  [@rule chk-and-l-notand [chk-and-l [ok ?X]]             ==> fail]

  ;; ── and-elim-r: must be conjunction ──
  [@rule chk-and-r-ok     [chk-and-r [ok [f-and ?A ?B]]] ==> [ok ?B]]
  [@rule chk-and-r-fail   [chk-and-r fail]                ==> fail]
  [@rule chk-and-r-notand [chk-and-r [ok ?X]]             ==> fail]

  ;; ── imp-intro: sub-derivation must be ok ──
  [@rule chk-imp-ok   [chk-imp ?A [ok ?B]] ==> [ok [f-imp ?A ?B]]]
  [@rule chk-imp-fail [chk-imp ?A fail]     ==> fail]

  ;; ── Modus ponens ──
  ;; Non-linear ?A verifies antecedent match (requires engine fix).
  [@rule chk-mp-ok     [chk-mp [ok [f-imp ?A ?B]] [ok ?A]] ==> [ok ?B]]
  [@rule chk-mp-notimp [chk-mp [ok ?X] [ok ?Y]]             ==> fail]
  [@rule chk-mp-fl     [chk-mp fail ?Y]                      ==> fail]
  [@rule chk-mp-fr     [chk-mp [ok ?X] fail]                 ==> fail]

  ;; ── Flatten: decompose conjunctions into list ──
  [@rule flatten-and  [flatten [f-and ?A ?B] ?Ctx] ==> [flatten ?A [flatten ?B ?Ctx]]]
  [@rule flatten-atom [flatten ?A ?Ctx]             ==> [ctx-cons ?A ?Ctx]]

  ;; ── Lookup: recursive membership check ──
  ;; Non-linear pattern: head matches goal -> d-assume
  [@rule lookup-hit  [lookup [ctx-cons ?A ?Rest] ?A] ==> [d-assume ?A]]
  [@rule lookup-miss [lookup [ctx-cons ?B ?Rest] ?A] ==> [lookup ?Rest ?A]]

  ;; ── The solver ──
  [@rule tauto-def   [tauto ?F]              ==> [auto empty ?F]]
  [@rule auto-top    [auto ?G f-top]         ==> d-top]
  [@rule auto-and    [auto ?G [f-and ?A ?B]] ==> [d-and-i [auto ?G ?A] [auto ?G ?B]]]
  [@rule auto-imp    [auto ?G [f-imp ?A ?B]] ==> [d-imp-i ?A [auto [flatten ?A ?G] ?B]]]
  [@rule auto-lookup [auto ?Ctx ?A]          ==> [lookup ?Ctx ?A]]
]

;; ════════════════════════════════════════════════════════════
;; PROOFS: Propositional Logic (19 assertions)
;; ════════════════════════════════════════════════════════════
;; Sealed: inherits PropLogic's rules, cannot add new ones.
;; Five acts: Checker, Solver, Reflection, plus invalid cases.

[Proofs PropCheck :in PropLogic

  ;; ── ACT I — THE CHECKER (11 tests) ──

  ;; 1. top-intro -> ok(top)
  [assert-eq check-top-intro
    [concl d-top]
    [ok f-top]]

  ;; 2. Assumption P -> ok(P)
  [assert-eq check-assume
    [concl [d-assume P]]
    [ok P]]

  ;; 3. and-intro -> ok(P and Q)
  [assert-eq check-and-intro
    [concl [d-and-i [d-assume P] [d-assume Q]]]
    [ok [f-and P Q]]]

  ;; 4. and-elim-l -> ok(P)
  [assert-eq check-and-elim-l
    [concl [d-and-el [d-assume [f-and P Q]]]]
    [ok P]]

  ;; 5. Modus Ponens -> ok(Q)
  [assert-eq check-modus-ponens
    [concl [d-mp [d-assume [f-imp P Q]] [d-assume P]]]
    [ok Q]]

  ;; 6. and-commutativity — manual derivation tree
  [assert-eq check-and-comm
    [concl [d-imp-i [f-and P Q]
      [d-and-i
        [d-and-er [d-assume [f-and P Q]]]
        [d-and-el [d-assume [f-and P Q]]]]]]
    [ok [f-imp [f-and P Q] [f-and Q P]]]]

  ;; 7. and-associativity — manual 9-node derivation tree
  [assert-eq check-and-assoc
    [concl [d-imp-i [f-and P [f-and Q R]]
      [d-and-i
        [d-and-i
          [d-and-el [d-assume [f-and P [f-and Q R]]]]
          [d-and-el [d-and-er [d-assume [f-and P [f-and Q R]]]]]]
        [d-and-er [d-and-er [d-assume [f-and P [f-and Q R]]]]]]]]
    [ok [f-imp [f-and P [f-and Q R]] [f-and [f-and P Q] R]]]]

  ;; 8. INVALID — and-elim-l on top -> fail
  [assert-eq reject-and-elim-on-top
    [concl [d-and-el d-top]]
    fail]

  ;; 9. INVALID — failure propagation
  [assert-eq reject-propagation
    [concl [d-and-i [d-and-el d-top] [d-assume Q]]]
    fail]

  ;; 10. INVALID — MP on non-implication -> fail
  [assert-eq reject-mp-non-imp
    [concl [d-mp [d-assume P] [d-assume Q]]]
    fail]

  ;; 11. INVALID — MP antecedent mismatch -> fail
  [assert-eq reject-mp-mismatch
    [concl [d-mp [d-assume [f-imp P Q]] [d-assume R]]]
    fail]

  ;; ── ACT II — THE SOLVER (6 tests) ──

  ;; 12. tauto(P -> P) — identity
  [assert-eq auto-identity
    [concl [tauto [f-imp P P]]]
    [ok [f-imp P P]]]

  ;; 13. tauto(P and Q -> Q and P) — commutativity
  [assert-eq auto-and-comm
    [concl [tauto [f-imp [f-and P Q] [f-and Q P]]]]
    [ok [f-imp [f-and P Q] [f-and Q P]]]]

  ;; 14. tauto(P and (Q and R) -> (P and Q) and R) — associativity
  [assert-eq auto-and-assoc
    [concl [tauto [f-imp [f-and P [f-and Q R]] [f-and [f-and P Q] R]]]]
    [ok [f-imp [f-and P [f-and Q R]] [f-and [f-and P Q] R]]]]

  ;; 15. DEPTH-5 LOOKUP — P and (Q and (R and (D and E))) -> E
  [assert-eq auto-deep-conj
    [concl [tauto [f-imp [f-and P [f-and Q [f-and R [f-and D E]]]] E]]]
    [ok [f-imp [f-and P [f-and Q [f-and R [f-and D E]]]] E]]]

  ;; 16. 5-DEEP IMPLICATION CHAIN — P->Q->R->D->E->P
  [assert-eq auto-deep-imp
    [concl [tauto [f-imp P [f-imp Q [f-imp R [f-imp D [f-imp E P]]]]]]]
    [ok [f-imp P [f-imp Q [f-imp R [f-imp D [f-imp E P]]]]]]]

  ;; 17. WEAKENING — P -> Q -> P
  [assert-eq auto-weakening
    [concl [tauto [f-imp P [f-imp Q P]]]]
    [ok [f-imp P [f-imp Q P]]]]

  ;; ── ACT III — REFLECTION (2 tests) ──
  ;; In Omega, reflection lifts "concl(tauto(phi)) = ok(phi)" to "true(phi)".
  ;; In Apeiron, the computation IS the proof — assert-eq directly verifies.

  ;; 18. P and Q -> Q and P is TRUE
  [assert-eq true-and-comm
    [concl [tauto [f-imp [f-and P Q] [f-and Q P]]]]
    [ok [f-imp [f-and P Q] [f-and Q P]]]]

  ;; 19. P and (Q and (R and (D and E))) -> E is TRUE
  [assert-eq true-deep-conj
    [concl [tauto [f-imp [f-and P [f-and Q [f-and R [f-and D E]]]] E]]]
    [ok [f-imp [f-and P [f-and Q [f-and R [f-and D E]]]] E]]]

  ;; Eval: interaction counts
  [eval solver-and-comm [concl [tauto [f-imp [f-and P Q] [f-and Q P]]]]]
  [eval solver-deep-5   [concl [tauto [f-imp [f-and P [f-and Q [f-and R [f-and D E]]]] E]]]]
]

;; ════════════════════════════════════════════════════════════
;; SYSTEM 2: Arithmetic + Ackermann
;; ════════════════════════════════════════════════════════════

[System ArithCheck
  [@syntax
    [sort Nat]
    [sort Form]
    [sort Deriv]
    [sort Res]
    ;; Natural numbers
    [op Z] [op S]
    [op plus] [op mul]
    ;; Ackermann
    [op ack]
    ;; Equations (for manual checker)
    [op f-eq]
    ;; Manual checker
    [op ok] [op fail]
    [op concl] [op d-refl] [op d-succ] [op d-bad]
    [op chk-succ]
  ]
  [@binding implicit]
  [@check rewriting]
]

;; ════════════════════════════════════════════════════════════
;; THEORY: Arithmetic + Ackermann + Manual Checker (Axioms)
;; ════════════════════════════════════════════════════════════

[Theory ArithSelf :in ArithCheck

  ;; ── Peano Arithmetic ──
  [@rule plus-z [plus Z ?n]      ==> ?n]
  [@rule plus-s [plus [S ?n] ?m] ==> [S [plus ?n ?m]]]
  [@rule mul-z  [mul Z ?n]       ==> Z]
  [@rule mul-s  [mul [S ?n] ?m]  ==> [plus ?m [mul ?n ?m]]]

  ;; ── Ackermann Function ──
  ;; ack(0,n) = n+1
  ;; ack(m+1,0) = ack(m,1)
  ;; ack(m+1,n+1) = ack(m, ack(m+1,n))
  [@rule ack-0   [ack Z ?n]          ==> [S ?n]]
  [@rule ack-m-0 [ack [S ?m] Z]      ==> [ack ?m [S Z]]]
  [@rule ack-m-n [ack [S ?m] [S ?n]] ==> [ack ?m [ack [S ?m] ?n]]]

  ;; ── Manual Equality Checker ──
  [@rule concl-refl [concl [d-refl ?n]]  ==> [ok [f-eq ?n ?n]]]
  [@rule concl-succ [concl [d-succ ?D]]  ==> [chk-succ [concl ?D]]]
  [@rule concl-bad  [concl d-bad]        ==> fail]

  [@rule chk-succ-ok   [chk-succ [ok [f-eq ?A ?B]]] ==> [ok [f-eq [S ?A] [S ?B]]]]
  [@rule chk-succ-fail [chk-succ fail]               ==> fail]
  [@rule chk-succ-bad  [chk-succ [ok ?X]]            ==> fail]
]

;; ════════════════════════════════════════════════════════════
;; PROOFS: Arithmetic + Ackermann (11 assertions)
;; ════════════════════════════════════════════════════════════

[Proofs ArithCheck :in ArithSelf

  ;; ── Manual checker (hand-built derivation trees) ──

  ;; 20. d-refl(Z) -> ok(0 = 0)
  [assert-eq arith-refl-zero
    [concl [d-refl Z]]
    [ok [f-eq Z Z]]]

  ;; 21. d-succ(d-refl(Z)) -> ok(S(0) = S(0))
  [assert-eq arith-succ-cong
    [concl [d-succ [d-refl Z]]]
    [ok [f-eq [S Z] [S Z]]]]

  ;; ── Native definitional equality (Apeiron's engine) ──
  ;; Omega uses an encoded solver. Apeiron normalizes both sides
  ;; via rewrite rules, then compares via topological hashing.

  ;; 22. 1+1 = 2
  [assert-eq native-one-plus-one
    [plus [S Z] [S Z]]
    [S [S Z]]]

  ;; 23. 2+2 = 4
  [assert-eq native-two-plus-two
    [plus [S [S Z]] [S [S Z]]]
    [S [S [S [S Z]]]]]

  ;; 24. 2*3 = 6
  [assert-eq native-two-times-three
    [mul [S [S Z]] [S [S [S Z]]]]
    [S [S [S [S [S [S Z]]]]]]]

  ;; 25. 3*3 = 9
  [assert-eq native-three-times-three
    [mul [S [S [S Z]]] [S [S [S Z]]]]
    [S [S [S [S [S [S [S [S [S Z]]]]]]]]]]

  ;; 26. 1 != 2 — certified rejection
  [assert-neq native-one-neq-two
    [S Z]
    [S [S Z]]]

  ;; 27. (1+1)*(1+1) = 4 — nested computation
  [assert-eq native-nested-computation
    [mul [plus [S Z] [S Z]] [plus [S Z] [S Z]]]
    [S [S [S [S Z]]]]]

  ;; ── THE ACKERMANN TEST ──
  ;; Grows faster than any primitive recursive function.

  ;; 28. ack(1,1) = 3
  [assert-eq ack-1-1
    [ack [S Z] [S Z]]
    [S [S [S Z]]]]

  ;; 29. ack(2,2) = 7
  [assert-eq ack-2-2
    [ack [S [S Z]] [S [S Z]]]
    [S [S [S [S [S [S [S Z]]]]]]]]

  ;; 30. ack(3,3) = 61 — THE showstopper
  ;; RHS: 61 = 2*(5*6) + 1  (to avoid writing 61 nested S's)
  [assert-eq ack-3-3
    [ack [S [S [S Z]]] [S [S [S Z]]]]
    [plus
      [mul [S [S Z]]
           [mul [S [S [S [S [S Z]]]]]
                [S [S [S [S [S [S Z]]]]]]]]
      [S Z]]]

  ;; Eval: show interaction counts
  [eval ack-1-1-eval [ack [S Z] [S Z]]]
  [eval ack-2-2-eval [ack [S [S Z]] [S [S Z]]]]
  [eval ack-3-3-eval [ack [S [S [S Z]]] [S [S [S Z]]]]]
]
