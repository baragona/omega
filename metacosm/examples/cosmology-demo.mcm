;;; Full cosmology mode: the flagship demo.
;;;
;;; "Theorem cosmology pipeline"
;;;
;;; Three worlds with typed epistemic profiles:
;;;   Explorer  — complete discovery, weak canonicality (e-graph saturation)
;;;   Certifier — heuristic discovery, decidable verification (directed rewriting)
;;;   Executor  — no discovery, confluent canonicality (operational compiler)
;;;
;;; A pipeline discovers in Explorer, tunnels to Certifier, coarse-grains to Executor.

;; --- Layer 2: Hyperion categories + substrates ---

[Category CartesianClosed
    [Object Type]
    [Object Term]
    [Morphism app :domain [Term Term] :codomain Term]
    [Exponential lam :object Type]
    [Evaluator app]
]

[Substrate EGraphSubstrate
    @engine interaction-graph
    @resource-mode optimal-sharing
    @barrier transparent
    @equality equality-saturation
]

[Substrate RewriteSubstrate
    @engine term-tree
    @resource-mode optimal-sharing
    @barrier transparent
    @equality rewrite-equivalence
]

[Substrate CompileSubstrate
    @engine abstract-machine
    @resource-mode deep-copy
    @barrier transparent
    @equality rewrite-equivalence
]

;; --- Layer 3: Metacosm worlds with typed epistemic profiles ---
;;
;; Each axis is now a grade in an explicit lattice:
;;   discover:     none < heuristic < semi-decidable < complete-fragment < complete
;;   verify:       none < heuristic < sound < sound-complete < decidable
;;   canonicalize: none < weak-nf < normalizing < confluent < unique-nf
;;   compress:     none | lossless | lossy | quotient | abstraction | codegen

[World Explorer
    :category CartesianClosed
    :substrate EGraphSubstrate
    :epistemic [
        :discover complete
        :verify sound
        :canonicalize weak-nf
        :compress none
    ]
    :admits [Split Tunnel]
]

[World Certifier
    :category CartesianClosed
    :substrate RewriteSubstrate
    :epistemic [
        :discover heuristic
        :verify decidable
        :canonicalize unique-nf
        :compress lossless
    ]
    :admits [CoarseGrain]
]

[World Executor
    :category CartesianClosed
    :substrate CompileSubstrate
    :epistemic [
        :discover none
        :verify sound
        :canonicalize confluent
        :compress codegen
    ]
]

;; --- Transitions with relational transport semantics ---

[Transition DiscoverTunnel
    :kind Tunnel
    :from Explorer
    :to Certifier
    :transport [:mode witness :loss [PathStructure]]
    :preserves [Soundness]
    :breaks [PathStructure]
]

[Transition CertifyToExecute
    :kind CoarseGrain
    :from Certifier
    :to Executor
    :transport [:mode lossy :loss [ResourceSensitivity]]
    :preserves [Soundness Normalization]
    :breaks [ResourceSensitivity]
]

;; --- Universe family ---

[Family TheoremPipeline
    :worlds [Explorer Certifier Executor]
    :invariants [Soundness]
]

;; --- Epistemic observables ---

[Observable DiscoveryPower :kind discovery-strength]
[Observable VerificationClarity :kind verification-strength]
[Observable CanonicalStrength :kind canonicality-strength]
[Observable CompressCapability :kind compression-mode]
[Observable EpistemicDistance :kind epistemic-distance]

;; --- Measurements: typed grades, not adjectives ---

[Measure :observable DiscoveryPower :world Explorer]
[Measure :observable DiscoveryPower :world Certifier]
[Measure :observable DiscoveryPower :world Executor]

[Measure :observable VerificationClarity :world Certifier]
[Measure :observable VerificationClarity :world Executor]

[Measure :observable CanonicalStrength :world Explorer]
[Measure :observable CanonicalStrength :world Certifier]
[Measure :observable CanonicalStrength :world Executor]

[Measure :observable CompressCapability :world Explorer]
[Measure :observable CompressCapability :world Executor]

[Measure :observable EpistemicDistance :world Explorer :target Certifier]
[Measure :observable EpistemicDistance :world Certifier :target Executor]
[Measure :observable EpistemicDistance :world Explorer :target Executor]

;; --- The pipeline ---

[Pipeline TheoremCosmology
    [Step discover-equivalences :action Discover :world Explorer]
    [Step tunnel-to-certifier :action Tunnel :world Explorer :target Certifier]
    [Step verify-result :action Verify :world Certifier]
    [Step compress-for-execution :action CoarseGrain :world Certifier :target Executor]
    [Step measure-outcome :action Measure :world Executor]
]
