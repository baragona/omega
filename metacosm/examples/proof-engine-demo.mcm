;; ============================================================
;; PROOF ENGINE DEMO: "Dangerous Lifts"
;;
;; Laws proved by tactic scripts over the lattice structure
;; of epistemic axes. These hold for ALL admissible worlds,
;; not just registered ones.
;; ============================================================

;; Minimal infrastructure for testing
[Category Minimal
    [Object Type]
    [Morphism id :domain [Type] :codomain Type]
]

[Substrate GenericSubstrate
    @engine term-tree
    @resource-mode optimal-sharing
    @barrier transparent
    @equality rewrite-equivalence
]


;; ============================================================
;; LAW 1: Dominance Reflexivity (proved by tactic script)
;;
;; Every world epistemically dominates itself.
;; Proof: unfold dominates to per-axis >=, then apply
;; lattice reflexivity on each axis.
;; ============================================================

[Law DominanceReflexive
    :forall [?W :type World]
    :show [dominates ?W ?W]
    :method proof
    :proof [
        [unfold dominates]
        [intros-axis ?A]
        [apply lattice-reflexivity]
        [qed]
    ]
]


;; ============================================================
;; LAW 2: Dominance Transitivity (proved by tactic script)
;;
;; If W1 dominates W2 and W2 dominates W3, then W1 dominates W3.
;; Proof: unfold to per-axis, then chain via lattice transitivity.
;; ============================================================

[Law DominanceTransitive
    :forall [?W1 ?W2 ?W3 :type World]
    :assume [[dominates ?W1 ?W2] [dominates ?W2 ?W3]]
    :show [dominates ?W1 ?W3]
    :method proof
    :proof [
        [unfold dominates]
        [intros-axis ?A]
        [apply lattice-transitivity :on ?A]
        [qed]
    ]
]


;; ============================================================
;; IMPOSSIBILITY 1: Lossy Transport Cannot Be Faithful
;;
;; A transition with lossy transport mode destroys information,
;; so it cannot be injective on morphisms (faithful).
;; Proof: unfold both definitions, derive contradiction via
;; pigeonhole principle.
;; ============================================================

[Impossibility LossyNotFaithful
    :forall [?W1 ?W2 :type World ?T :type Transition :from ?W1 :to ?W2]
    :assume [
        [faithful ?T]
    ]
    :impossible [
        [faithful ?T]
    ]
    :method model-check
]

;; The real proof version using the tactic engine:
[Refute LossyCannotBeFaithful
    :forall [?W1 ?W2 :type World ?T :type Transition :from ?W1 :to ?W2]
    :impossible [
        [faithful ?T]
        [preserves-transition ?T PathStructure]
    ]
    :method model-check
]


;; ============================================================
;; Concrete worlds to verify model-checking still works
;; alongside proof-based laws
;; ============================================================

[World LabWorld
    :category Minimal
    :substrate GenericSubstrate
    :epistemic [:discover complete :verify decidable :canonicalize unique-nf]
]

[World ProdWorld
    :category Minimal
    :substrate GenericSubstrate
    :epistemic [:discover none :verify heuristic :canonicalize none :compress codegen]
]

;; Model-checked law (for comparison)
[Law DominanceReflexiveMC
    :forall [W]
    :then [dominates W W]
    :method model-check
]

;; Model-checked transitivity
[Law DominanceTransitiveMC
    :forall [X Y Z]
    :where [[dominates X Y] [dominates Y Z]]
    :then [dominates X Z]
    :method model-check
]
