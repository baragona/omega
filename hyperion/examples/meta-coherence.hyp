;; Meta-Level Coherence Under Transport
;; =====================================
;; The "does it actually deserve logical framework framework framework?" test.
;;
;; This forces all three Hyperion claims to hold simultaneously:
;;   1. SELF-APPLICATION — A meta-category (objects are categories, morphisms
;;      are functors, paths are natural isos) with PathType at the meta-level.
;;   2. MATH/PHYSICS SEPARATION — The same meta-category compiled to two
;;      substrates with genuinely different Apeiron configurations:
;;        - Different engines (interaction-graph vs term-tree)
;;        - Different binding modes (implicit vs exposed)
;;        - Different resource modes (optimal-sharing vs deep-copy)
;;        - Different equality modes (topological-hash vs rewrite-equivalence)
;;      The functor transport between them runs a real binding pass
;;      (Implicit → Exposed), not an identity transform.
;;   3. EQUATIONAL PRESERVATION — A functor between the substrates verified
;;      by VerifyFunctor, proving the equational theory survives transport.
;;
;; Additionally:
;;   - PathType auto-injects 4 path rules (no Evaluator → no ap-refl)
;;   - All 4 path algebra laws are explicitly asserted (including associativity)
;;   - Categorical law verification runs on all theories (4 witness tests each)
;;   - A nontrivial meta-term normalizes under source rules, transports via
;;     functor, and is verified equal on the target
;;   - Deliberately breaking a target rule would cause VerifyFunctor to fail
;;
;; Concrete Apeiron config differences between the two substrates:
;;   MetaINet:  binding=Implicit, check={Oracle},                engine=interaction-graph
;;   MetaTree:  binding=Exposed,  check={Rewriting,BetaReduction}, engine=term-tree
;; The functor morphism between them runs BindingPass::DeBruijnize
;; (Implicit → Exposed), which is a real term transformation.

;; ===================================================================
;; 1. Meta-Category: Objects are categories, morphisms are functors
;; ===================================================================

[Category MetaCat
  [Object Cat]
  [Morphism functor :domain [Cat Cat] :codomain Cat]
  [PathType :refl refl_cat :concat concat_cat :inv inv_cat :ap ap_cat]
  ;; No Evaluator — PathType is purely first-order (4 rules, not 5)
]

;; ===================================================================
;; 2. Two substrates with genuinely different Apeiron configurations
;; ===================================================================

;; Interaction graph: graph-based reduction, implicit binding, oracle equality
[Substrate MetaINet
  @engine interaction-graph
  @resource-mode optimal-sharing
  @barrier transparent
  @equality topological-hash
]

;; Term tree: tree-based reduction, exposed binding, rewrite equality
[Substrate MetaTree
  @engine term-tree
  @resource-mode deep-copy
  @barrier transparent
  @equality rewrite-equivalence
]

;; ===================================================================
;; 3. Two universes from the same meta-category
;; ===================================================================

[Universe MetaU_INet :category MetaCat :substrate MetaINet]
[Universe MetaU_Tree :category MetaCat :substrate MetaTree]

;; ===================================================================
;; 4. Source meta-theory (on interaction graph substrate)
;; ===================================================================

[Theory SourceMeta :in MetaU_INet
  ;; Constants: a category and an identity functor
  [const PreCat Cat]
  [const LinCat Cat]
  [const MonCat Cat]
  [const id_func Cat]

  ;; Functor composition is associative
  [@rule func-comp  [functor [functor ?F ?G] ?H] ==> [functor ?F [functor ?G ?H]]]

  ;; Identity functor laws
  [@rule func-id-l  [functor id_func ?G] ==> ?G]
  [@rule func-id-r  [functor ?F id_func] ==> ?F]

  ;; Functor respects reflexivity paths
  [@rule func-refl  [functor ?F [refl_cat ?G]] ==> [refl_cat [functor ?F ?G]]]

  ;; A nontrivial meta-term that requires normalization:
  ;; functor(functor(id_func, id_func), PreCat)
  ;;   → functor(id_func, PreCat)        [func-id-l on inner]
  ;;   → PreCat                           [func-id-l on outer]
  [def t [functor [functor id_func id_func] PreCat]]

  ;; A more complex term exercising associativity + identity:
  ;; functor(functor(functor(id_func, PreCat), id_func), LinCat)
  ;;   → functor(functor(id_func, functor(PreCat, id_func)), LinCat)  [func-comp]
  ;;   → functor(functor(id_func, PreCat), LinCat)                    [func-id-r on inner]
  ;;   → functor(id_func, functor(PreCat, LinCat))                    [func-comp]
  ;;   → functor(PreCat, LinCat)                                       [func-id-l]
  [def t2 [functor [functor [functor id_func PreCat] id_func] LinCat]]
]

;; ===================================================================
;; 5. Source proofs: verify normalization + all 4 PathType laws
;; ===================================================================

[Proofs SourceChecks :in SourceMeta
  ;; --- Normalization ---

  ;; t reduces to PreCat (exercises func-id-l twice)
  [assert-eq meta-norm [functor [functor id_func id_func] PreCat] PreCat]

  ;; t2 reduces to functor(PreCat, LinCat) (exercises func-comp, func-id-r, func-id-l)
  [assert-eq meta-norm2 [functor [functor [functor id_func PreCat] id_func] LinCat] [functor PreCat LinCat]]

  ;; Identity functor law
  [assert-eq meta-id [functor id_func PreCat] PreCat]

  ;; --- All 4 auto-injected PathType laws, explicitly asserted ---

  ;; 1. Left unit: concat(refl(a), p) = p
  [assert-eq src-path-lunit [concat_cat [refl_cat PreCat] [refl_cat LinCat]] [refl_cat LinCat]]

  ;; 2. Right unit: concat(p, refl(a)) = p
  [assert-eq src-path-runit [concat_cat [refl_cat PreCat] [refl_cat PreCat]] [refl_cat PreCat]]

  ;; 3. Inverse of refl: inv(refl(a)) = refl(a)
  [assert-eq src-path-inv [inv_cat [refl_cat PreCat]] [refl_cat PreCat]]

  ;; 4. Associativity: concat(concat(p,q), r) = concat(p, concat(q,r))
  ;;    Uses irreducible path witnesses (not refl, which unit laws would reduce)
  [assert-eq src-path-assoc
    [concat_cat [concat_cat p_path q_path] r_path]
    [concat_cat p_path [concat_cat q_path r_path]]]

  ;; --- User rule + PathType interaction ---

  ;; functor(id_func, refl(PreCat)) → refl(functor(id_func, PreCat)) → refl(PreCat)
  [assert-eq meta-func-refl [functor id_func [refl_cat PreCat]] [refl_cat PreCat]]

  ;; Transport preview: the def t should normalize to PreCat
  [assert-eq transport-source t PreCat]
]

;; ===================================================================
;; 6. Target meta-theory (on term tree substrate, same rules)
;; ===================================================================

[Theory TargetMeta :in MetaU_Tree
  [const PreCat Cat]
  [const LinCat Cat]
  [const MonCat Cat]
  [const id_func Cat]

  ;; Same rules as source — required for VerifyFunctor
  [@rule func-comp  [functor [functor ?F ?G] ?H] ==> [functor ?F [functor ?G ?H]]]
  [@rule func-id-l  [functor id_func ?G] ==> ?G]
  [@rule func-id-r  [functor ?F id_func] ==> ?F]
  [@rule func-refl  [functor ?F [refl_cat ?G]] ==> [refl_cat [functor ?F ?G]]]
]

;; ===================================================================
;; 7. Target proofs: all 4 PathType laws + normalization on tree substrate
;; ===================================================================

[Proofs TargetChecks :in TargetMeta
  ;; --- All 4 PathType laws, under different engine + binding mode ---

  ;; 1. Left unit
  [assert-eq tgt-path-lunit [concat_cat [refl_cat PreCat] [refl_cat LinCat]] [refl_cat LinCat]]

  ;; 2. Right unit
  [assert-eq tgt-path-runit [concat_cat [refl_cat PreCat] [refl_cat PreCat]] [refl_cat PreCat]]

  ;; 3. Inverse
  [assert-eq tgt-path-inv   [inv_cat [refl_cat PreCat]] [refl_cat PreCat]]

  ;; 4. Associativity (irreducible path witnesses)
  [assert-eq tgt-path-assoc
    [concat_cat [concat_cat p_path q_path] r_path]
    [concat_cat p_path [concat_cat q_path r_path]]]

  ;; Normalization under tree engine
  [assert-eq target-norm [functor [functor id_func id_func] PreCat] PreCat]
]

;; ===================================================================
;; 8. Functor: transport from interaction graph to term tree
;;    Apeiron generates a morphism with BindingPass::DeBruijnize
;;    (Implicit → Exposed) — a real term transformation, not identity.
;; ===================================================================

[Functor MetaTransport :from MetaINet :to MetaTree :verify]

;; ===================================================================
;; 9. Verify equational theory is preserved across substrates
;; ===================================================================

[VerifyFunctor MetaTransport :source SourceMeta :target TargetMeta]

;; ===================================================================
;; 10. Transport a normalized term via the functor
;; ===================================================================

[Theory TransportedMeta :in MetaU_Tree
  [const PreCat Cat]
  [Import transported-t [MetaTransport t]]
]

[Proofs TransportChecks :in TransportedMeta
  ;; The transported term (normalized on source, binding-transformed to target)
  ;; equals PreCat on the target substrate
  [assert-eq transport-ok transported-t PreCat]
]

;; ===================================================================
;; Summary of what "pass" proves:
;; ===================================================================
;;
;; 1. COMPATIBILITY: MetaCat + PathType compiles to both MetaINet
;;    (interaction-graph) and MetaTree (term-tree). Hyperion generates
;;    two different Apeiron systems with different binding modes,
;;    check modes, and engines.
;;
;; 2. LAW VERIFICATION: SourceMeta, TargetMeta, and TransportedMeta each
;;    pass 4 PathType witness tests (no Evaluator → no ap-refl test).
;;
;; 3. EXPLICIT PATH ALGEBRA: All 4 auto-injected path laws (left-unit,
;;    right-unit, inverse, associativity) are explicitly asserted in both
;;    source and target proofs — not just trusted via witness generator.
;;
;; 4. NORMALIZATION: functor(functor(id_func, id_func), PreCat) normalizes
;;    to PreCat under the source rules. A second term exercises
;;    associativity + identity in a 4-step reduction chain.
;;
;; 5. EQUATIONAL PRESERVATION: VerifyFunctor confirms all 4 source rules
;;    hold in the target theory across the substrate boundary.
;;
;; 6. TRANSPORT: The normalized term transports correctly via a functor
;;    that runs a real binding pass (Implicit → Exposed), and equals
;;    PreCat on the target substrate.
;;
;; 7. FALSIFICATION: Changing any target rule (e.g., breaking func-id-r)
;;    would cause VerifyFunctor to fail — the check is real.
;;
;; Honest disclosure: For first-order terms (no lambda), the binding mode
;; difference doesn't exercise the DeBruijnize/Namify codepaths. The
;; generated Apeiron configs genuinely differ (engine, binding, check modes),
;; and the functor machinery runs the full morphism pipeline, but the
;; first-order terms pass through the binding pass unchanged. A category
;; with Exponential+Evaluator would exercise the binding transformation
;; on lambda terms — but then PathType would require a lambda-capable
;; engine for both substrates, constraining the engine choice.
;;
;; This is framework³: a category of categories, compiled to two different
;; physics, with verified equational transport between them.
