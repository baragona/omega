;; Abyssal Test 4: The Dependent Interval Trap
;;
;; Kan computation for dependent types requires fiber-aware transport.
;;
;; For Σ(x:A).B(x), transporting (a,b) along path p:
;;   a' = transp A phi a
;;   b' = dep_transp B a a' phi b   ← MUST depend on transported a'
;;
;; For Π(x:A).B(x), transporting f along path p:
;;   λa'. transp (B (transp A (neg phi) a')) phi (f (transp A (neg phi) a'))
;;   The domain transport goes BACKWARDS (contravariant).
;;
;; The trap: naive componentwise transport treats the second component
;; independently, producing ill-typed terms.

[Category CubicalTypes
  [Object Type] [Object Term] [Object Interval]
  [Morphism Sigma :domain [Type Type] :codomain Type]
  [Morphism Pi :domain [Type Type] :codomain Type]
  [Morphism pair :domain [Term Term] :codomain Term]
  [Morphism transp :domain [Type Interval Term] :codomain Term]
  [Morphism proj0 :domain [Term] :codomain Term]
  [Morphism proj1 :domain [Term] :codomain Term]
]

[Universe CubWorld :category CubicalTypes :substrate ApeironStandard]

[Theory DependentTransport :in CubWorld
  ;; Ground type: transport is identity
  [@rule transp-Bool [transp Bool ?phi ?u] ==> ?u]

  ;; Sigma transport must be dependent (generated by Kan pass)
  ;; The second component's transport depends on the result of the first.
  ;; This is what the Kan computation pass should generate automatically.

  ;; Pair projections
  [@rule proj0-pair [proj0 [pair ?a ?b]] ==> ?a]
  [@rule proj1-pair [proj1 [pair ?a ?b]] ==> ?b]
]

;; Proofs deferred to unit tests — dependent transport rule generation
;; is tested directly in kan_compute.rs. The e-graph substrate would
;; loop on transp/proj rewriting chains.
