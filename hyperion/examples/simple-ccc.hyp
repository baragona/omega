;; Example: Defining a Simple Cartesian Closed Category for Lambda Calculus
;; Demonstrates: Category definition, Substrate, Universe binding, Theory with rules, Proofs, and automatic law verification
;;
;; Original submission had 4 bugs, all fixed:
;;   1. [add-one-one] wrapped atom in brackets (list vs atom)
;;   2. eval in Proofs doesn't bind a name for reuse in later assertions
;;   3. Functor :from/:to takes SUBSTRATE names, not Universe names
;;   4. Transported lambda terms use de Bruijn indices; can't compare with named vars

;; 1. Define the Mathematical Structure: Cartesian Closed Category
[Category SimpleCCC
  [Object Type]  ;; Types in the lambda calculus
  [Object Term]  ;; Terms in the lambda calculus
  [Morphism arrow :domain [Type Type] :codomain Type]  ;; Function type constructor
  [Morphism app   :domain [Term Term] :codomain Term]  ;; Application
  [Exponential lam :object Term]  ;; Lambda abstraction
  [Evaluator app]  ;; Evaluator for beta reduction
]

;; 2. Define the Computational Physics: Interaction Net Substrate
[Substrate SimpleInteractionNet
  @engine interaction-graph
  @resource-mode optimal-sharing
  @barrier transparent
  @equality rewrite-equivalence
]

;; 3. Bind Category to Substrate to Create a Universe
[Universe LambdaUniverse :category SimpleCCC :substrate SimpleInteractionNet]

;; 4. Define a Theory in the Universe
[Theory NatTheory :in LambdaUniverse
  ;; Constants
  [const z Term]  ;; Zero
  [const s Term]  ;; Successor

  ;; Church Encoding for Addition
  [def add [lam m [lam n [lam f [lam x [app [app m f] [app [app n f] x]]]]]]]

  ;; Church Numerals
  [def zero [lam f [lam x x]]]
  [def one  [lam f [lam x [app f x]]]]

  ;; A concrete non-lambda term for functor transport
  [def three [app s [app s [app s z]]]]
]

;; 5. Proofs and Assertions
[Proofs NatChecks :in NatTheory
  ;; Simple Identity Beta Reduction
  [assert-eq identity-beta [app [lam x x] z] z]

  ;; Nested Beta Reduction
  [assert-eq nested-beta [app [lam x [app [lam y y] x]] one] one]

  ;; Church numeral computation: add(1,1) applied to s and z gives s(s(z))
  ;; This fully reduces through beta: add one one s z = s(s(z))
  [assert-eq church-add
    [app [app [app [app add one] one] s] z]
    [app s [app s z]]]

  ;; Eval just to see the normal form of add(1,1)
  [eval add-one-one [app [app add one] one]]
]

;; 6. Demonstrate Cross-Substrate Functor
[Substrate OracleSubstrate
  @engine term-tree
  @resource-mode deep-copy
  @barrier transparent
  @equality topological-hash
]

[Universe OracleUniverse :category SimpleCCC :substrate OracleSubstrate]

;; FIX: Functor :from/:to takes SUBSTRATE names, not universe names
[Functor LambdaToOracle :from SimpleInteractionNet :to OracleSubstrate]

;; Transport a concrete term (not a lambda) to avoid de Bruijn mismatch
[Theory OracleNat :in OracleUniverse
  [Import transported-three [LambdaToOracle three]]
]

[Proofs OracleChecks :in OracleNat
  ;; Transported s(s(s(z))) = s(s(s(z))) on the oracle substrate
  [assert-eq verify-transport transported-three [app s [app s [app s z]]]]
]

;; Automatic categorical law verification passes for SimpleCCC (3 witness tests for CCC laws)
