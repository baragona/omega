;; Hyperion Example: Cross-Substrate Functor with Real Transport
;; Same Category compiled to two different Substrates, with a Functor
;; that generates real Apeiron morphisms for cross-substrate transport.

;; =================================================================
;; Step 1: A single Category used across substrates
;; =================================================================

[Category SimpleMath
  [Object Nat]
  [Morphism z :domain [] :codomain Nat]
  [Morphism s :domain [Nat] :codomain Nat]
  [Morphism plus :domain [Nat Nat] :codomain Nat]
]

;; =================================================================
;; Step 2: Two substrates with different physics
;; =================================================================

;; Compute substrate: normalizes via rewriting
[Substrate ComputeNet
  @engine interaction-graph
  @resource-mode optimal-sharing
  @barrier transparent
  @equality rewrite-equivalence
]

;; Oracle substrate: no rewriting, just asserts equality
[Substrate OracleTree
  @engine term-tree
  @resource-mode deep-copy
  @barrier transparent
  @equality topological-hash
]

;; =================================================================
;; Step 3: Two universes — same math, different physics
;; =================================================================

[Universe PeanoCompute :category SimpleMath :substrate ComputeNet]
[Universe PeanoOracle :category SimpleMath :substrate OracleTree]

;; =================================================================
;; Step 4: Functor declaration (cross-substrate translation)
;; Generates AutoMorphism: __fun_NetToTree_SimpleMath
;; with NormalizeFirst checking pass (compute -> oracle)
;; =================================================================

[Functor NetToTree
  :from ComputeNet
  :to OracleTree
  :verify
]

;; =================================================================
;; Step 5: Source theory with rewrite rules (on compute substrate)
;; =================================================================

[Theory PeanoArith :in PeanoCompute
  [@rule [plus z ?n] ==> ?n]
  [@rule [plus [s ?n] ?m] ==> [s [plus ?n ?m]]]

  ;; 2 + 1 = 3 (will be normalized by source substrate's rewriting)
  [def two-plus-one [plus [s [s z]] [s z]]]
]

[Proofs PeanoCheck :in PeanoArith
  ;; Verify the computation works on the source substrate
  [assert-eq two-plus-two
    [plus [s [s z]] [s [s z]]]
    [s [s [s [s z]]]]
  ]
]

;; =================================================================
;; Step 6: Target theory — transport via Functor
;; The Functor transport normalizes `two-plus-one` in the source
;; substrate (reducing plus to s(s(s(z)))), then transports the
;; normal form to the oracle substrate.
;; =================================================================

[Theory PeanoOracleTheory :in PeanoOracle
  ;; Same rewrite rules — needed for equational verification
  [@rule [plus z ?n] ==> ?n]
  [@rule [plus [s ?n] ?m] ==> [s [plus ?n ?m]]]

  [Import transported-sum [NetToTree two-plus-one]]
]

[Proofs OracleCheck :in PeanoOracleTheory
  ;; The transported term should be fully normalized: s(s(s(z))) = 3
  [assert-eq transport-correct transported-sum [s [s [s z]]]]
]

;; =================================================================
;; Step 7: Verify functor preserves equational theory
;; Checks that every @rule from PeanoArith, when transformed by the
;; functor's op_map, holds in PeanoOracleTheory.
;; =================================================================

[VerifyFunctor NetToTree :source PeanoArith :target PeanoOracleTheory]
