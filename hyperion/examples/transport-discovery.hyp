;; transport-discovery.hyp
;; ======================
;; The Final Boss: Meta-Categorical Transport across Physics Boundaries.
;;
;; Architecture demonstrated in a single file:
;;   Category → 2 Substrates → 2 Universes → Functor → VerifyFunctor →
;;   Source Theory (e-graph) → eval-simplify → Import Transport →
;;   Target Theory (directed) → assert-eq + assert-neq
;;
;; Story:
;;   1. An e-graph universe discovers the Eckmann-Hilton coincidence and commutativity
;;   2. eval-simplify extracts simplified witnesses from the e-graph
;;   3. A functor maps the e-graph substrate to the directed substrate
;;   4. VerifyFunctor confirms all 5 primitive laws are structurally preserved
;;   5. Import transports computed normal forms across the physics boundary
;;   6. The directed world mechanically verifies the transported results
;;   7. But the directed world CANNOT independently discover the coincidence
;;
;; This proves: knowledge generated by advanced physics (equality saturation)
;; can be reliably serialized and verified by weaker, strictly sequential physics
;; (rewrite equivalence) — completing the logical lifecycle of the framework.
;;
;; Run:
;;   hyperion check examples/transport-discovery.hyp

;; ============================================================
;; Shared category: 2-categorical structure with hcomp
;; ============================================================

[Category MetaCat
    [Object Cat]
    [Morphism functor :domain [Cat Cat] :codomain Cat]
    [Morphism app_cat :domain [Cat Cat] :codomain Cat]
    [Morphism hcomp :domain [Cat Cat] :codomain Cat]
    [Exponential lam_cat :object Cat]
    [Evaluator app_cat]
    [PathType :refl refl_cat :concat concat_cat :inv inv_cat :ap ap_cat]
]

;; ============================================================
;; Two substrates: advanced (e-graph) and sequential (directed)
;; ============================================================

[Substrate EGraphPhysics
    @engine interaction-graph
    @resource-mode optimal-sharing
    @barrier transparent
    @equality equality-saturation
]

[Substrate DirectedPhysics
    @engine interaction-graph
    @resource-mode optimal-sharing
    @barrier transparent
    @equality rewrite-equivalence
]

;; ============================================================
;; Two universes: same category, different computational physics
;; ============================================================

[Universe EGraphWorld :category MetaCat :substrate EGraphPhysics]
[Universe DirectedWorld :category MetaCat :substrate DirectedPhysics]

;; ============================================================
;; Functor: maps e-graph physics to directed physics
;; ============================================================
;;
;; No operator renaming needed — both substrates share the same category.
;; The functor's role is to establish structural correspondence so that
;; VerifyFunctor can confirm law preservation and Import can transport terms.

[Functor InsightTransport :from EGraphPhysics :to DirectedPhysics]

;; ============================================================
;; Source Theory: E-Graph Discovery
;; ============================================================
;;
;; The e-graph universe has equality-saturation, which makes @law declarations
;; bidirectional. This enables the full Eckmann-Hilton argument.

[Theory Discovery :in EGraphWorld :no-laws
    ;; Base object — refl_cat(base_obj) is the shared unit for both operations
    [const base_obj Cat]

    ;; Abstract 2-cells in Ω²(base_obj)
    [const alpha Cat]
    [const beta Cat]

    ;; === The 5 primitive Eckmann-Hilton laws ===

    ;; Law 1: Interchange — vertical-then-horizontal = horizontal-then-vertical
    [@law interchange
        [hcomp [concat_cat ?a ?b] [concat_cat ?c ?d]]
        ===
        [concat_cat [hcomp ?a ?c] [hcomp ?b ?d]]
    ]

    ;; Laws 2-3: hcomp unit laws (refl is horizontal identity)
    [@law hcomp-left-id  [hcomp [refl_cat base_obj] ?p] === ?p]
    [@law hcomp-right-id [hcomp ?p [refl_cat base_obj]] === ?p]

    ;; Laws 4-5: concat unit laws (refl is vertical identity)
    [@law concat-left-id  [concat_cat [refl_cat base_obj] ?p] === ?p]
    [@law concat-right-id [concat_cat ?p [refl_cat base_obj]] === ?p]

    ;; === Computed forms for transport ===
    ;; These expressions normalize via forward rules (shared with directed world).
    ;; The key: forward-normalization produces the same result in BOTH substrates,
    ;; making the transported forms independently verifiable.

    ;; concat(refl, alpha) → alpha  [left-unit, forward]
    [def unit-absorb [concat_cat [refl_cat base_obj] alpha]]

    ;; hcomp(concat(alpha, refl), concat(refl, beta))
    ;;   → hcomp(alpha, beta)  [concat unit laws, forward]
    [def compound [hcomp [concat_cat alpha [refl_cat base_obj]]
                         [concat_cat [refl_cat base_obj] beta]]]
]

;; ============================================================
;; Source Proofs: E-Graph Automated Discovery
;; ============================================================

[Proofs DiscoveryProofs :in Discovery
    ;; Forward normalization (works in any substrate)
    [assert-eq unit-check unit-absorb alpha]

    ;; The compound term normalizes to hcomp(alpha, beta) via forward rules
    [assert-eq compound-check compound [hcomp alpha beta]]

    ;; === THE DISCOVERIES ===
    ;; The e-graph autonomously finds these from the 5 primitive laws:

    ;; Discovery 1: concat and hcomp COINCIDE
    [assert-eq discovery-coincide [concat_cat alpha beta] [hcomp alpha beta]]

    ;; Discovery 2: vertical composition is COMMUTATIVE
    [assert-eq discovery-commutes [concat_cat alpha beta] [concat_cat beta alpha]]

    ;; E-graph extraction: pull out the simplest representative
    [eval-simplify simplify-concat [concat_cat alpha beta]]
    [eval-simplify simplify-compound compound]
]

;; ============================================================
;; Target Theory: Directed Verification + Transported Results
;; ============================================================
;;
;; The directed substrate uses rewrite-equivalence: @law declarations are
;; compiled as forward-only rules. Bidirectional reasoning is unavailable.
;; The theory declares the same 5 laws (needed for VerifyFunctor) and
;; imports computed forms from the e-graph world via the functor.

[Theory Received :in DirectedWorld :no-laws
    [const base_obj Cat]
    [const alpha Cat]
    [const beta Cat]

    ;; Same 5 equalities, but declared as @rule (forward-only).
    ;; In rewrite-equivalence substrates, @law is only meaningful for e-graphs.
    ;; @rule compiles to inet forward rules, enabling VerifyFunctor's assert-eq
    ;; to confirm structural preservation via normalization.
    [@rule interchange [hcomp [concat_cat ?a ?b] [concat_cat ?c ?d]]
                   ==> [concat_cat [hcomp ?a ?c] [hcomp ?b ?d]]]
    [@rule hcomp-left-id  [hcomp [refl_cat base_obj] ?p] ==> ?p]
    [@rule hcomp-right-id [hcomp ?p [refl_cat base_obj]] ==> ?p]
    [@rule concat-left-id  [concat_cat [refl_cat base_obj] ?p] ==> ?p]
    [@rule concat-right-id [concat_cat ?p [refl_cat base_obj]] ==> ?p]

    ;; === Transported results from the e-graph world ===
    ;; Import normalizes the source expression using the source substrate's
    ;; inet physics, then ships the normal form across the functor.
    ;; Result: the same normal forms the directed world would compute.

    ;; unit-absorb: concat(refl, alpha) → alpha (via left-unit)
    [Import unit-absorb-t [InsightTransport unit-absorb]]

    ;; compound: hcomp(concat(alpha,refl), concat(refl,beta)) → hcomp(alpha,beta)
    [Import compound-t [InsightTransport compound]]
]

;; ============================================================
;; VerifyFunctor: Laws Are Preserved Across Physics
;; ============================================================
;;
;; Confirms that all 5 primitive laws from Discovery hold in Received.
;; VerifyFunctor concretizes metas (?a → __vf_a) and generates assert-eq
;; proofs in the target theory. Since both theories have the same rules,
;; forward normalization suffices to verify each law.

[VerifyFunctor InsightTransport :source Discovery :target Received]

;; ============================================================
;; Target Proofs: Mechanical Verification + Physics Gap
;; ============================================================

[Proofs TransportVerification :in Received
    ;; === Transported results are valid ===
    ;; The directed world independently confirms the transported normal forms
    ;; by structural comparison — no bidirectional reasoning needed.

    ;; Transport preserved: concat(refl, alpha) normalized to alpha
    [assert-eq transport-unit unit-absorb-t alpha]

    ;; Transport preserved: the compound expression normalized to hcomp(alpha, beta)
    [assert-eq transport-compound compound-t [hcomp alpha beta]]

    ;; === The Physics Gap ===
    ;; The directed world has the SAME laws but CANNOT discover the Eckmann-Hilton
    ;; consequences. These theorems require bidirectional reasoning that only the
    ;; e-graph provides. assert-neq confirms the gap is real.

    ;; Gap 1: concat and hcomp do NOT coincide in directed physics
    [assert-neq gap-coincide [concat_cat alpha beta] [hcomp alpha beta]]

    ;; Gap 2: commutativity is NOT discoverable in directed physics
    [assert-neq gap-commutes [concat_cat alpha beta] [concat_cat beta alpha]]
]

;; ============================================================
;; Summary
;; ============================================================
;;
;; This file exercises the complete Hyperion/Apeiron pipeline in a single
;; coherent narrative:
;;
;;   Category (MetaCat)           — shared mathematical structure
;;   Substrate (2×)               — different computational physics
;;   Universe (2×)                — same math, different physics
;;   Functor (InsightTransport)   — structural bridge between substrates
;;   Theory (Discovery)           — 5 primitive laws + computed defs
;;   Proofs (DiscoveryProofs)     — e-graph discovers coincidence + commutativity
;;   eval-simplify (2×)           — e-graph extraction of witnesses
;;   Theory (Received)            — same laws + imported normal forms
;;   VerifyFunctor                — confirms law preservation (5 rules verified)
;;   Import (2×)                  — transports normal forms across physics
;;   Proofs (TransportVerification) — mechanical verification + physics gap
;;
;; Architectural claims proven:
;;   (1) Advanced physics (e-graph) discovers non-trivial theorems
;;   (2) Structural transport preserves computational results across substrates
;;   (3) Law preservation is mechanically verifiable (VerifyFunctor, 5 rules)
;;   (4) The physics gap is real: same equalities as @law (bidirectional) vs
;;       @rule (forward) produce different provability from identical content
;;   (5) Knowledge flows one way: discovery → serialization → verification
