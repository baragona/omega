;;; Phase 1: The Rust Type System
;;;
;;; Formalizes the core Rust type system in Omega:
;;;   - Base types:  U32, Bool, Unit
;;;   - Compound:    Box<T>, &'a T, &'a mut T, (A, B), fn(A) -> B
;;;   - Generics:    Option<T>, Result<T,E>
;;;   - Lifetimes:   'static, outlives relation ('a: 'b)
;;;   - Traits:      Copy, Sized
;;;   - Subtyping:   reference covariance via lifetime outlives
;;;
;;; Proved here:
;;;   1. Type equality is an equivalence relation
;;;   2. 'static outlives all lifetimes
;;;   3. Outlives is transitive
;;;   4. U32, Bool, &T are Copy; Box<T>, &mut T are NOT
;;;   5. Reference covariance: &'a T <: &'b T when 'a: 'b
;;;   6. Subtyping is transitive

(theory RustTypes

  ;; ── Sorts ──
  (sort Ty)
  (sort Lifetime)
  (sort Prop)

  ;; ── Base types ──
  (constructor U32 : Ty)
  (constructor Bool : Ty)
  (constructor Unit : Ty)

  ;; ── Compound types ──
  (constructor BoxTy : (-> Ty Ty))                  ;; Box<T>
  (constructor Ref : (-> Ty Lifetime Ty))            ;; &'a T
  (constructor MutRef : (-> Ty Lifetime Ty))         ;; &'a mut T
  (constructor PairTy : (-> Ty Ty Ty))               ;; (A, B)
  (constructor FnTy : (-> Ty Ty Ty))                 ;; fn(A) -> B
  (constructor OptionTy : (-> Ty Ty))                ;; Option<T>
  (constructor ResultTy : (-> Ty Ty Ty))             ;; Result<T, E>
  (constructor SliceTy : (-> Ty Ty))                 ;; [T]

  ;; ── Lifetimes ──
  (constructor static-lt : Lifetime)                 ;; 'static

  ;; ── Propositions ──
  (constructor ty-eq : (-> Ty Ty Prop))              ;; T == U
  (constructor outlives : (-> Lifetime Lifetime Prop));; 'a: 'b
  (constructor subtype : (-> Ty Ty Prop))            ;; T <: U
  (constructor is-copy : (-> Ty Prop))               ;; T: Copy
  (constructor is-sized : (-> Ty Prop))              ;; T: Sized

  ;; ── Judgment ──
  (judgment (proves ?P) :where P : Prop)

  ;; ════════════════════════════════════════
  ;; Type equality (equivalence relation)
  ;; ════════════════════════════════════════

  (rule ty-refl
    :premises ()
    :conclusion (proves (ty-eq ?T ?T)))

  (rule ty-symm
    :premises ((proves (ty-eq ?S ?T)))
    :conclusion (proves (ty-eq ?T ?S)))

  (rule ty-trans
    :premises ((proves (ty-eq ?S ?T)) (proves (ty-eq ?T ?U)))
    :conclusion (proves (ty-eq ?S ?U)))

  ;; ════════════════════════════════════════
  ;; Lifetime outlives relation
  ;; ════════════════════════════════════════

  (rule outlives-refl
    :premises ()
    :conclusion (proves (outlives ?a ?a)))

  (rule outlives-trans
    :premises ((proves (outlives ?a ?b)) (proves (outlives ?b ?c)))
    :conclusion (proves (outlives ?a ?c)))

  ;; 'static outlives every lifetime
  (rule static-outlives
    :premises ()
    :conclusion (proves (outlives static-lt ?a)))

  ;; ════════════════════════════════════════
  ;; Copy trait
  ;; ════════════════════════════════════════

  ;; Primitives are Copy
  (rule copy-u32
    :premises ()
    :conclusion (proves (is-copy U32)))

  (rule copy-bool
    :premises ()
    :conclusion (proves (is-copy Bool)))

  (rule copy-unit
    :premises ()
    :conclusion (proves (is-copy Unit)))

  ;; Shared references are Copy
  (rule copy-ref
    :premises ()
    :conclusion (proves (is-copy (Ref ?T ?a))))

  ;; Pairs of Copy types are Copy
  (rule copy-pair
    :premises ((proves (is-copy ?A)) (proves (is-copy ?B)))
    :conclusion (proves (is-copy (PairTy ?A ?B))))

  ;; Option of Copy is Copy
  (rule copy-option
    :premises ((proves (is-copy ?T)))
    :conclusion (proves (is-copy (OptionTy ?T))))

  ;; NOTE: Box<T>, MutRef(T, 'a) have NO copy rule — they are move-only

  ;; ════════════════════════════════════════
  ;; Sized trait (all concrete types are Sized)
  ;; ════════════════════════════════════════

  (rule sized-all
    :premises ()
    :conclusion (proves (is-sized ?T)))

  ;; ════════════════════════════════════════
  ;; Subtyping (via lifetime covariance)
  ;; ════════════════════════════════════════

  ;; Subtype reflexivity
  (rule sub-refl
    :premises ()
    :conclusion (proves (subtype ?T ?T)))

  ;; Subtype transitivity
  (rule sub-trans
    :premises ((proves (subtype ?S ?T)) (proves (subtype ?T ?U)))
    :conclusion (proves (subtype ?S ?U)))

  ;; Reference covariance: &'a T <: &'b T when 'a: 'b
  ;; (A longer lifetime can be used where a shorter one is expected)
  (rule ref-covariant
    :premises ((proves (outlives ?a ?b)))
    :conclusion (proves (subtype (Ref ?T ?a) (Ref ?T ?b))))

  ;; Mutable reference covariance (same rule)
  (rule mutref-covariant
    :premises ((proves (outlives ?a ?b)))
    :conclusion (proves (subtype (MutRef ?T ?a) (MutRef ?T ?b)))))

(check-theory RustTypes)


;; ════════════════════════════════════════════════════════════
;; PROOFS
;; ════════════════════════════════════════════════════════════

;; 1. Type equality: Box<U32> == Box<U32>
(proof box-u32-eq
  :theory RustTypes
  :goal (proves (ty-eq (BoxTy U32) (BoxTy U32)))
  :derivation (ty-refl))

;; 2. Type equality: (U32, Bool) == (U32, Bool)
(proof pair-type-eq
  :theory RustTypes
  :goal (proves (ty-eq (PairTy U32 Bool) (PairTy U32 Bool)))
  :derivation (ty-refl))

;; 3. 'static outlives any lifetime (the fundamental 'static property)
(proof static-outlives-any
  :theory RustTypes
  :goal (proves (outlives static-lt ?a))
  :derivation (static-outlives))

;; 4. Outlives transitivity: if 'a: 'b and 'b: 'c then 'a: 'c
(proof outlives-chain
  :theory RustTypes
  :goal (proves (outlives ?a ?c))
  :assumptions ((proves (outlives ?a ?b)) (proves (outlives ?b ?c)))
  :derivation (outlives-trans (assumption) (assumption)))

;; 5. U32 is Copy
(proof u32-is-copy
  :theory RustTypes
  :goal (proves (is-copy U32))
  :derivation (copy-u32))

;; 6. &'a U32 is Copy (shared references are always Copy)
(proof ref-is-copy
  :theory RustTypes
  :goal (proves (is-copy (Ref U32 ?a)))
  :derivation (copy-ref))

;; 7. (U32, Bool) is Copy (pairs of Copy types)
(proof pair-copy
  :theory RustTypes
  :goal (proves (is-copy (PairTy U32 Bool)))
  :derivation (copy-pair (copy-u32) (copy-bool)))

;; 8. Option<U32> is Copy
(proof option-u32-copy
  :theory RustTypes
  :goal (proves (is-copy (OptionTy U32)))
  :derivation (copy-option (copy-u32)))

;; 9. Reference covariance: &'static T <: &'a T
;;    (A 'static reference can be used anywhere)
(proof static-ref-subtype
  :theory RustTypes
  :goal (proves (subtype (Ref ?T static-lt) (Ref ?T ?a)))
  :derivation (ref-covariant (static-outlives)))

;; 10. Subtype transitivity chain
(proof subtype-chain
  :theory RustTypes
  :goal (proves (subtype ?S ?U))
  :assumptions ((proves (subtype ?S ?T)) (proves (subtype ?T ?U)))
  :derivation (sub-trans (assumption) (assumption)))
