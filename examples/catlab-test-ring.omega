;;; CatLab Test 3.3: Ring Theory
;;; Sort R, constructors add/mul/zero/one/neg, rewrite rules

(theory Ring
  (sort R)
  (constructor add : (-> R R R))
  (constructor mul : (-> R R R))
  (constructor zero : R)
  (constructor one : R)
  (constructor neg : (-> R R))

  (judgment (eq ?a ?b) :where a : R b : R)
  (rule eq-refl :premises () :conclusion (eq ?a ?a))

  ;; Additive monoid
  (rewrite add-assoc (add (add ?x ?y) ?z) (add ?x (add ?y ?z)))
  (rewrite add-left-unit (add zero ?x) ?x)
  (rewrite add-right-unit (add ?x zero) ?x)

  ;; Additive inverse
  (rewrite add-left-inv (add (neg ?x) ?x) zero)

  ;; Multiplicative monoid
  (rewrite mul-assoc (mul (mul ?x ?y) ?z) (mul ?x (mul ?y ?z)))
  (rewrite mul-left-unit (mul one ?x) ?x)
  (rewrite mul-right-unit (mul ?x one) ?x)

  ;; Distributivity
  (rewrite dist-left (mul ?x (add ?y ?z)) (add (mul ?x ?y) (mul ?x ?z)))
  (rewrite dist-right (mul (add ?x ?y) ?z) (add (mul ?x ?z) (mul ?y ?z)))

  ;; Annihilation
  (rewrite mul-left-zero (mul zero ?x) zero)
  (rewrite mul-right-zero (mul ?x zero) zero))

;; Test: 0 + 0 = 0
(proof test-add-unit
  :theory Ring
  :goal (eq (add zero zero) zero)
  :derivation (eq-refl))

;; Test: 1 * 1 = 1
(proof test-mul-unit
  :theory Ring
  :goal (eq (mul one one) one)
  :derivation (eq-refl))

;; Test: 0 * x = 0 (schematic)
(proof test-annihilate
  :theory Ring
  :goal (eq (mul zero ?x) zero)
  :derivation (eq-refl))

;; Test: distributivity normalizes
;; a * (0 + b) should normalize to: a * b  (via add-left-unit inside dist-left? no, add-left-unit fires first)
(proof test-dist
  :theory Ring
  :goal (eq (mul ?a (add zero ?b)) (mul ?a ?b))
  :derivation (eq-refl))

;; Test: add and mul are distinct operations (both R×R→R)
;; add(one, one) should NOT equal mul(one, one) — they normalize differently
;; add(one, one) has no rewrite, mul(one, one) → one
;; So this proof should FAIL:
;; (proof test-add-neq-mul
;;   :theory Ring
;;   :goal (eq (add one one) (mul one one))
;;   :derivation (eq-refl))
;; We leave it commented out — uncomment to verify it fails.

;; Instead verify they normalize differently by proving each separately
(proof test-mul-one-one
  :theory Ring
  :goal (eq (mul one one) one)
  :derivation (eq-refl))
