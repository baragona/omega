;;; Higher Inductive Types (HITs)
;;;
;;; HITs extend ordinary inductive types with path constructors —
;;; constructors that produce equalities rather than just points.
;;; This is a key feature of Homotopy Type Theory.
;;;
;;; Omega models HITs via rewrite rules that encode the computation
;;; rules for the recursors. The user is trusted to provide consistent
;;; rules (no positivity check or confluence proof is enforced).
;;;
;;; Demonstrated here:
;;;   1. Circle (S1): base point + loop, with recursor
;;;   2. Suspension: north, south, merid, with recursor
;;;   3. Propositional truncation: trunc-in, with squash
;;;
;;; Proved here:
;;;   1. recS1 computation at base                (recS1(base) = b)
;;;   2. Circle loop is a path                     (loop : Id(S1, base, base))
;;;   3. recSusp computation at north              (recSusp(north) = n)
;;;   4. recSusp computation at south              (recSusp(south) = s)
;;;   5. Truncation introduction                   (trunc-in(x) : ||A||)
;;;   6. Suspension merid is a path                (merid(a) : Id(Susp, north, south))
;;;   7. concat(loop, loop) is a path              (double loop in S1)
;;;   8. inv(loop) is a path                       (reversed loop)
;;;   9. Double suspension merid path              (merid(a)·inv(merid(b)) : Id(Susp,n,n))
;;;  10. Squash: any two truncated are equal       (squash proof)
;;;  11. recS1 double application                  (recS1 on base twice)
;;;  12. concat(loop, refl) = loop                 (right unit, definitional)

(theory HITs
  (sort Ty)
  (sort Tm)

  ;; ── Identity types + path algebra (self-contained) ──
  (constructor Id     : (-> Ty Tm Tm Ty))
  (constructor refl   : Tm)
  (constructor inv    : (-> Tm Tm))
  (constructor concat : (-> Tm Tm Tm))

  (rewrite inv-refl     (inv refl) refl)
  (rewrite concat-refl-l (concat refl ?q) ?q)
  (rewrite concat-refl-r (concat ?p refl) ?p)

  ;; ── Judgments ──
  (judgment (has-type ?e ?T) :where e : Tm T : Ty)
  (judgment (path-eq ?A ?p ?q) :where A : Ty p : Tm q : Tm)

  (rule path-refl :premises () :conclusion (path-eq ?A ?p ?p))

  ;; ── Typing rules for paths ──
  (rule t-refl
    :premises ((has-type ?a ?A))
    :conclusion (has-type refl (Id ?A ?a ?a)))

  (rule t-inv
    :premises ((has-type ?p (Id ?A ?a ?b)))
    :conclusion (has-type (inv ?p) (Id ?A ?b ?a)))

  (rule t-concat
    :premises ((has-type ?p (Id ?A ?a ?b))
               (has-type ?q (Id ?A ?b ?c)))
    :conclusion (has-type (concat ?p ?q) (Id ?A ?a ?c)))

  ;; ── Base types ──
  (constructor Unit : Ty)
  (constructor tt   : Tm)
  (constructor Bool : Ty)
  (constructor true  : Tm)
  (constructor false : Tm)
  (constructor Nat  : Ty)
  (constructor ze   : Tm)
  (constructor su   : (-> Tm Tm))

  ;; ════════════════════════════════════════════════════════
  ;; HIT 1: Circle (S1)
  ;; ════════════════════════════════════════════════════════
  (mutual
    (constructor S1    : Ty)
    (constructor base  : Tm)
    (constructor loop  : Tm)
    (constructor recS1 : (-> Ty Tm Tm Tm Tm)))

  (rewrite recS1-base (recS1 ?C ?b ?l base) ?b)

  (rule t-base :premises () :conclusion (has-type base S1))
  (rule t-loop :premises () :conclusion (has-type loop (Id S1 base base)))

  ;; ════════════════════════════════════════════════════════
  ;; HIT 2: Suspension
  ;; ════════════════════════════════════════════════════════
  (mutual
    (constructor Susp    : (-> Ty Ty))
    (constructor north   : Tm)
    (constructor south   : Tm)
    (constructor merid   : (-> Tm Tm))
    (constructor recSusp : (-> Ty Tm Tm Tm Tm Tm)))

  (rewrite recSusp-north (recSusp ?C ?n ?s ?m north) ?n)
  (rewrite recSusp-south (recSusp ?C ?n ?s ?m south) ?s)

  (rule t-north :premises () :conclusion (has-type north (Susp ?A)))
  (rule t-south :premises () :conclusion (has-type south (Susp ?A)))
  (rule t-merid
    :premises ((has-type ?a ?A))
    :conclusion (has-type (merid ?a) (Id (Susp ?A) north south)))

  ;; ════════════════════════════════════════════════════════
  ;; HIT 3: Propositional Truncation
  ;; ════════════════════════════════════════════════════════
  (constructor Trunc    : (-> Ty Ty))
  (constructor trunc-in : (-> Tm Tm))

  (rule t-trunc-in
    :premises ((has-type ?a ?A))
    :conclusion (has-type (trunc-in ?a) (Trunc ?A)))

  (constructor squash : (-> Tm Tm Tm))
  (rule t-squash
    :premises ((has-type ?x (Trunc ?A))
               (has-type ?y (Trunc ?A)))
    :conclusion (has-type (squash ?x ?y) (Id (Trunc ?A) ?x ?y)))

  ;; ── General typing ──
  (rule t-tt :premises () :conclusion (has-type tt Unit))
  (rule t-ze :premises () :conclusion (has-type ze Nat))
  (rule t-su :premises ((has-type ?n Nat)) :conclusion (has-type (su ?n) Nat)))

(check-theory HITs)


;;; ═══════════════════════════════════════════════════════════
;;; Part 1: Computation rules (definitional equality)
;;; ═══════════════════════════════════════════════════════════

;;; Proof 1: recS1(Nat, ze, loop, base) → ze
(proof recS1-at-base
  :theory HITs
  :goal (path-eq Nat (recS1 Nat ze loop base) ze)
  :derivation (path-refl))

;;; Proof 2: loop is a path from base to base
(proof loop-is-path
  :theory HITs
  :goal (has-type loop (Id S1 base base))
  :derivation (t-loop))

;;; Proof 3: recSusp(Bool, true, false, m, north) → true
(proof recSusp-at-north
  :theory HITs
  :goal (path-eq Bool (recSusp Bool true false ?m north) true)
  :derivation (path-refl))

;;; Proof 4: recSusp(Bool, true, false, m, south) → false
(proof recSusp-at-south
  :theory HITs
  :goal (path-eq Bool (recSusp Bool true false ?m south) false)
  :derivation (path-refl))

;;; Proof 5: trunc-in(ze) : ||Nat||
(proof trunc-intro
  :theory HITs
  :goal (has-type (trunc-in ze) (Trunc Nat))
  :derivation (t-trunc-in (t-ze)))

;;; Proof 6: merid(ze) : Id(Susp(Nat), north, south)
(proof merid-is-path
  :theory HITs
  :goal (has-type (merid ze) (Id (Susp Nat) north south))
  :derivation (t-merid (t-ze)))


;;; ═══════════════════════════════════════════════════════════
;;; Part 2: Multi-step typing derivations
;;; ═══════════════════════════════════════════════════════════

;;; Proof 7: concat(loop, loop) : Id(S1, base, base)
;;; The double loop — compose the loop with itself.
;;; Derivation: t-concat requires both paths to have matching endpoints.

(proof double-loop
  :theory HITs
  :goal (has-type (concat loop loop) (Id S1 base base))
  :derivation (t-concat (t-loop) (t-loop)))


;;; Proof 8: inv(loop) : Id(S1, base, base)
;;; The reversed loop.

(proof inv-loop
  :theory HITs
  :goal (has-type (inv loop) (Id S1 base base))
  :derivation (t-inv (t-loop)))


;;; Proof 9: concat(merid(ze), inv(merid(su(ze)))) : Id(Susp(Nat), north, north)
;;;
;;; A non-trivial path in the suspension: go from north to south via merid(0),
;;; then back from south to north via inv(merid(1)).
;;; This requires chaining t-concat with t-merid and t-inv.

(proof susp-north-loop
  :theory HITs
  :goal (has-type
    (concat (merid ze) (inv (merid (su ze))))
    (Id (Susp Nat) north north))
  :derivation (t-concat (t-merid (t-ze)) (t-inv (t-merid (t-su (t-ze))))))


;;; Proof 10: squash(trunc-in(ze), trunc-in(su(ze))) : Id(||Nat||, trunc-in(ze), trunc-in(su(ze)))
;;;
;;; Any two elements of a truncated type are equal.
;;; This is a multi-step derivation chaining trunc-in with squash.

(proof squash-proof
  :theory HITs
  :goal (has-type
    (squash (trunc-in ze) (trunc-in (su ze)))
    (Id (Trunc Nat) (trunc-in ze) (trunc-in (su ze))))
  :derivation (t-squash (t-trunc-in (t-ze)) (t-trunc-in (t-su (t-ze)))))


;;; Proof 11: recS1 applied twice — recS1(Nat, su(ze), loop, base) = su(ze)
;;; A different base value shows the recursor is parametric.

(proof recS1-succ
  :theory HITs
  :goal (path-eq Nat (recS1 Nat (su ze) loop base) (su ze))
  :derivation (path-refl))


;;; Proof 12: concat(loop, refl) = loop  (right unit, definitional)
;;; Shows path algebra works with HIT path constructors.

(proof loop-right-unit
  :theory HITs
  :goal (path-eq (Id S1 base base) (concat loop refl) loop)
  :derivation (path-refl))
