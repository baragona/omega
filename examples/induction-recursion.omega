;;; Induction-Recursion: Mutually Defined Types and Decoding Functions
;;;
;;; Demonstrates induction-recursion (IR) in Omega via mutual blocks.
;;; In IR, a type U (codes) and a function El (decoding) are defined
;;; simultaneously — the type of later constructors depends on the
;;; decoding of earlier codes.
;;;
;;; The `(mutual ...)` block is a semantic grouping mechanism that
;;; documents the mutual dependency. Within an Omega theory,
;;; declarations are already unordered, so mutual works by flattening
;;; its contents into the enclosing theory.
;;;
;;; Proved here:
;;;   1. El(nat-code) = Nat                    (decode natural numbers)
;;;   2. El(bool-code) = Bool                  (decode booleans)
;;;   3. Pi-code decodes to function space     (decode Pi)
;;;   4. Sigma-code decodes to pair space      (decode Sigma)
;;;   5. Nested decode: Pi(nat, λx.Bool)       (higher-order decode)
;;;   6. Id type over decoded types             (identity at decoded type)

(theory IR
  (sort Ty)
  (sort Tm)

  ;; ── Base types ──
  (constructor Nat : Ty)
  (constructor Bool : Ty)
  (constructor ze : Tm)
  (constructor su : (-> Tm Tm))
  (constructor true  : Tm)
  (constructor false : Tm)

  ;; ── Type formers ──
  (constructor Pi    : (-> Ty Ty Ty))           ;; Pi(A, B)
  (constructor Sigma : (-> Ty Ty Ty))           ;; Sigma(A, B)
  (constructor Id    : (-> Ty Tm Tm Ty))        ;; Id(A, a, b)
  (constructor refl  : Tm)

  ;; ── Judgments ──
  (judgment (has-type ?e ?T) :where e : Tm T : Ty)
  (judgment (ty-eq ?A ?B) :where A : Ty B : Ty)

  (rule teq-refl :premises () :conclusion (ty-eq ?A ?A))

  ;; ── The mutual block: Universe of codes + decoding function ──
  ;; U is the type of codes, El decodes a code into a type.
  ;; This is the classic Dybjer-Setzer induction-recursion pattern.
  (mutual
    ;; Universe of codes
    (constructor U : Ty)
    (constructor El : (-> Tm Ty))              ;; decoding function

    ;; Codes for base types
    (constructor nat-code  : Tm)
    (constructor bool-code : Tm)

    ;; Code for dependent function space: pi-code(a, b)
    ;; where a : U and b : El(a) -> U
    (constructor pi-code    : (-> Tm Tm Tm))
    (constructor sigma-code : (-> Tm Tm Tm))

    ;; Decoding rewrites: El(code) → Type
    (rewrite el-nat  (El nat-code)  Nat)
    (rewrite el-bool (El bool-code) Bool)
    (rewrite el-pi   (El (pi-code ?a ?b))    (Pi (El ?a) (El (?b ?a))))
    (rewrite el-sigma (El (sigma-code ?a ?b)) (Sigma (El ?a) (El (?b ?a)))))

  ;; ── Typing rules ──
  (rule t-ze :premises () :conclusion (has-type ze Nat))
  (rule t-su :premises ((has-type ?n Nat)) :conclusion (has-type (su ?n) Nat))
  (rule t-true  :premises () :conclusion (has-type true Bool))
  (rule t-false :premises () :conclusion (has-type false Bool))
  (rule t-refl :premises ((has-type ?a ?A))
    :conclusion (has-type refl (Id ?A ?a ?a))))

(check-theory IR)

;;; ═══════════════════════════════════════════════════════════
;;; Proof 1: El(nat-code) = Nat
;;; ═══════════════════════════════════════════════════════════
;;; The el-nat rewrite fires: El(nat-code) → Nat.

(proof decode-nat
  :theory IR
  :goal (ty-eq (El nat-code) Nat)
  :derivation (teq-refl))


;;; ═══════════════════════════════════════════════════════════
;;; Proof 2: El(bool-code) = Bool
;;; ═══════════════════════════════════════════════════════════

(proof decode-bool
  :theory IR
  :goal (ty-eq (El bool-code) Bool)
  :derivation (teq-refl))


;;; ═══════════════════════════════════════════════════════════
;;; Proof 3: Pi-code decodes correctly
;;; ═══════════════════════════════════════════════════════════
;;; El(pi-code(nat-code, f)) = Pi(Nat, El(f nat-code))
;;; where f is an arbitrary code family.

(proof decode-pi
  :theory IR
  :goal (ty-eq (El (pi-code nat-code ?f)) (Pi Nat (El (?f nat-code))))
  :derivation (teq-refl))


;;; ═══════════════════════════════════════════════════════════
;;; Proof 4: Sigma-code decodes correctly
;;; ═══════════════════════════════════════════════════════════

(proof decode-sigma
  :theory IR
  :goal (ty-eq (El (sigma-code bool-code ?g)) (Sigma Bool (El (?g bool-code))))
  :derivation (teq-refl))


;;; ═══════════════════════════════════════════════════════════
;;; Proof 5: Typing at decoded type
;;; ═══════════════════════════════════════════════════════════
;;; ze has type El(nat-code), which normalizes to Nat.

(proof type-at-decoded
  :theory IR
  :goal (has-type ze (El nat-code))
  :derivation (t-ze))


;;; ═══════════════════════════════════════════════════════════
;;; Proof 6: refl at decoded identity type
;;; ═══════════════════════════════════════════════════════════
;;; refl : Id(El(nat-code), ze, ze) which normalizes to Id(Nat, ze, ze)

(proof refl-decoded-id
  :theory IR
  :goal (has-type refl (Id (El nat-code) ze ze))
  :derivation (t-refl (t-ze)))
