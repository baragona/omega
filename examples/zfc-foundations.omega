;;; ZFC Foundations: Mathematics from the Void
;;;
;;; In the previous formalization (ch-complete.omega), ordered pairs,
;;; functions, and ordinals were PRIMITIVES. Here, we construct
;;; ALL of them from scratch.
;;;
;;; The only primitives:
;;;   - Set: the domain of discourse
;;;   - Prop: statements about sets
;;;   - ∈ (membership): the single non-logical symbol
;;;
;;; Everything else — pairs, singletons, ordered pairs, ordinals,
;;; natural numbers — is BUILT using the ZFC axioms.
;;;
;;; Proved here (15 proofs):
;;;
;;;   Natural Numbers Exist:
;;;    1. 0 ∈ ω                    (zero is a natural number)
;;;    2. 1 ∈ ω                    (one is a natural number)
;;;    3. 2 ∈ ω                    (two is a natural number)
;;;
;;;   Ordinal Structure:
;;;    4. 0 is an ordinal           (base case)
;;;    5. 1 is an ordinal           (successor preserves ordinality)
;;;    6. 2 is an ordinal           (two is an ordinal)
;;;    7. ω is an ordinal           (the first limit ordinal)
;;;
;;;   The Order on Numbers (∈ IS the ordering):
;;;    8. 0 < 1                     (∅ ∈ {∅})
;;;    9. 0 < 2                     (∅ ∈ {∅,{∅}})
;;;   10. 1 < 2                     ({∅} ∈ {∅,{∅}})
;;;
;;;   Set-Theoretic Reasoning:
;;;   11. ∅ ∉ ∅                     (nothing is in the empty set)
;;;   12. ∅ ∈ P(X)                  (empty set in every power set)
;;;   13. X ∈ P(X)                  (every set in its own power set)
;;;
;;;   The Kuratowski Construction:
;;;   14. ⟨0,1⟩ = ⟨0,1⟩            (pair computation — normalizer verifies)
;;;   15. ⟨a,b⟩ = ⟨c,d⟩ → a=c ∧ b=d  (pairs are injective)

(theory ZFC-Foundations

  ;; ══════════════════════════════════════════════════════════════
  ;; PRIMITIVE SORTS
  ;; ══════════════════════════════════════════════════════════════
  ;; We have ONLY two sorts. Everything in mathematics lives here.

  (sort Set)
  (sort Prop)

  ;; ══════════════════════════════════════════════════════════════
  ;; PROPOSITIONAL CONNECTIVES
  ;; ══════════════════════════════════════════════════════════════

  (constructor imp     : (-> Prop Prop Prop))  ;; P → Q
  (constructor neg-p   : (-> Prop Prop))       ;; ¬P
  (constructor conj    : (-> Prop Prop Prop))  ;; P ∧ Q
  (constructor disj    : (-> Prop Prop Prop))  ;; P ∨ Q
  (constructor bic     : (-> Prop Prop Prop))  ;; P ↔ Q
  (constructor bot     : Prop)                 ;; ⊥ (falsity)

  ;; ══════════════════════════════════════════════════════════════
  ;; SET-THEORETIC PRIMITIVES
  ;; ══════════════════════════════════════════════════════════════
  ;; The single non-logical symbol of ZFC: membership.
  ;; Equality and subset are defined in terms of membership,
  ;; but we represent them as constructors with characterizing rules.

  (constructor mem     : (-> Set Set Prop))    ;; x ∈ y
  (constructor seq     : (-> Set Set Prop))    ;; x = y
  (constructor sub     : (-> Set Set Prop))    ;; x ⊆ y

  ;; ══════════════════════════════════════════════════════════════
  ;; SET CONSTRUCTORS (Skolem witnesses for ZFC existence axioms)
  ;; ══════════════════════════════════════════════════════════════
  ;; Each ZFC axiom asserts "there exists a set with property P."
  ;; The constructors ARE those witnesses. The rules characterize them.

  (constructor empty-set  : Set)               ;; ∅
  (constructor upair      : (-> Set Set Set))  ;; {a, b}
  (constructor big-union  : (-> Set Set))      ;; ⋃X
  (constructor power      : (-> Set Set))      ;; P(X)
  (constructor succ       : (-> Set Set))      ;; x ∪ {x}
  (constructor omega-set  : Set)               ;; ω

  ;; ══════════════════════════════════════════════════════════════
  ;; DERIVED CONSTRUCTIONS (definitions via rewrite rules)
  ;; ══════════════════════════════════════════════════════════════
  ;; These are NOT new primitives. They reduce to the ZFC
  ;; constructors above. The rewrite rules make them computational.

  ;; Singleton: {a} = {a, a}
  (constructor singleton : (-> Set Set))
  (rewrite singleton-def (singleton ?a) (upair ?a ?a))

  ;; KURATOWSKI ORDERED PAIR: ⟨a,b⟩ = {{a}, {a,b}}
  ;; We don't assume ordered pairs exist.
  ;; We BUILD them from unordered pairs.
  (constructor kpair : (-> Set Set Set))
  (rewrite kpair-def (kpair ?a ?b) (upair (singleton ?a) (upair ?a ?b)))

  ;; Named natural numbers (von Neumann encoding):
  ;;   0 = ∅
  ;;   1 = {∅} = succ(∅)
  ;;   2 = {∅, {∅}} = succ(succ(∅))
  ;;   3 = {∅, {∅}, {∅,{∅}}} = succ(succ(succ(∅)))
  (constructor nat-zero  : Set)
  (rewrite nat-zero-def  nat-zero  empty-set)
  (constructor nat-one   : Set)
  (rewrite nat-one-def   nat-one   (succ empty-set))
  (constructor nat-two   : Set)
  (rewrite nat-two-def   nat-two   (succ (succ empty-set)))
  (constructor nat-three : Set)
  (rewrite nat-three-def nat-three (succ (succ (succ empty-set))))

  ;; Ordinal ordering: α < β iff α ∈ β
  ;; For von Neumann ordinals, membership IS the order relation.
  (constructor ord-lt : (-> Set Set Prop))
  (rewrite ord-lt-is-mem (ord-lt ?a ?b) (mem ?a ?b))

  ;; ══════════════════════════════════════════════════════════════
  ;; SET PREDICATES
  ;; ══════════════════════════════════════════════════════════════

  (constructor is-transitive : (-> Set Prop))
  (constructor is-ordinal    : (-> Set Prop))

  ;; ══════════════════════════════════════════════════════════════
  ;; RELATION & FUNCTION PREDICATES (preview for Part II)
  ;; ══════════════════════════════════════════════════════════════
  ;; A relation on A×B is a set of ordered pairs.
  ;; A function is a single-valued relation.
  ;; These will be needed for cardinality.

  (constructor is-relation : (-> Set Prop))
  (constructor is-function : (-> Set Prop))
  (constructor dom         : (-> Set Set))
  (constructor ran         : (-> Set Set))
  (constructor app         : (-> Set Set Set))

  ;; ══════════════════════════════════════════════════════════════
  ;; JUDGMENT: Provability
  ;; ══════════════════════════════════════════════════════════════
  ;; (holds P) means "P is provable from ZFC."

  (judgment (holds ?P) :where P : Prop)

  ;; ══════════════════════════════════════════════════════════════
  ;; PROPOSITIONAL LOGIC RULES (Natural Deduction)
  ;; ══════════════════════════════════════════════════════════════

  ;; ── Conjunction ──
  (rule conj-intro
    :premises ((holds ?P) (holds ?Q))
    :conclusion (holds (conj ?P ?Q)))
  (rule conj-elim-l
    :premises ((holds (conj ?P ?Q)))
    :conclusion (holds ?P))
  (rule conj-elim-r
    :premises ((holds (conj ?P ?Q)))
    :conclusion (holds ?Q))

  ;; ── Implication (Modus Ponens) ──
  (rule mp
    :premises ((holds (imp ?P ?Q)) (holds ?P))
    :conclusion (holds ?Q))

  ;; ── Biconditional ──
  (rule bic-intro
    :premises ((holds (imp ?P ?Q)) (holds (imp ?Q ?P)))
    :conclusion (holds (bic ?P ?Q)))
  (rule bic-fwd
    :premises ((holds (bic ?P ?Q)) (holds ?P))
    :conclusion (holds ?Q))
  (rule bic-bwd
    :premises ((holds (bic ?P ?Q)) (holds ?Q))
    :conclusion (holds ?P))

  ;; ── Disjunction ──
  (rule disj-intro-l
    :premises ((holds ?P))
    :conclusion (holds (disj ?P ?Q)))
  (rule disj-intro-r
    :premises ((holds ?Q))
    :conclusion (holds (disj ?P ?Q)))

  ;; ══════════════════════════════════════════════════════════════
  ;; ZFC AXIOM RULES
  ;; ══════════════════════════════════════════════════════════════
  ;; These are the KERNEL of set theory. Every mathematical fact
  ;; ultimately traces back to these rules.

  ;; ── Empty Set: ∅ has no elements ──
  (rule empty-ax
    :conclusion (holds (neg-p (mem ?x empty-set))))

  ;; ── Pairing: z ∈ {a,b} ↔ (z=a ∨ z=b) ──
  (rule pair-ax
    :conclusion (holds (bic (mem ?z (upair ?a ?b))
                            (disj (seq ?z ?a) (seq ?z ?b)))))

  ;; ── Union: if z ∈ y and y ∈ X, then z ∈ ⋃X ──
  (rule union-intro
    :premises ((holds (mem ?z ?y)) (holds (mem ?y ?X)))
    :conclusion (holds (mem ?z (big-union ?X))))

  ;; ── Power Set: z ∈ P(X) ↔ z ⊆ X ──
  (rule power-ax
    :conclusion (holds (bic (mem ?z (power ?X)) (sub ?z ?X))))

  ;; ── Extensionality: mutual subset → equality ──
  (rule extensionality
    :premises ((holds (sub ?A ?B)) (holds (sub ?B ?A)))
    :conclusion (holds (seq ?A ?B)))

  ;; ── Infinity: ∅ ∈ ω ──
  (rule inf-zero
    :conclusion (holds (mem empty-set omega-set)))

  ;; ── Infinity: n ∈ ω → succ(n) ∈ ω ──
  (rule inf-succ
    :premises ((holds (mem ?n omega-set)))
    :conclusion (holds (mem (succ ?n) omega-set)))

  ;; ── Foundation (consequence): no set contains itself ──
  (rule no-self-mem
    :conclusion (holds (neg-p (mem ?x ?x))))

  ;; ══════════════════════════════════════════════════════════════
  ;; SUBSET RULES
  ;; ══════════════════════════════════════════════════════════════

  (rule sub-refl
    :conclusion (holds (sub ?A ?A)))

  (rule empty-sub
    :conclusion (holds (sub empty-set ?A)))

  (rule sub-mem
    :premises ((holds (sub ?A ?B)) (holds (mem ?x ?A)))
    :conclusion (holds (mem ?x ?B)))

  ;; ══════════════════════════════════════════════════════════════
  ;; EQUALITY RULES
  ;; ══════════════════════════════════════════════════════════════

  (rule eq-refl
    :conclusion (holds (seq ?a ?a)))

  (rule eq-sym
    :premises ((holds (seq ?a ?b)))
    :conclusion (holds (seq ?b ?a)))

  ;; ══════════════════════════════════════════════════════════════
  ;; SUCCESSOR RULES
  ;; ══════════════════════════════════════════════════════════════
  ;; succ(x) = x ∪ {x}. An element of succ(x) is either
  ;; an element of x, or equal to x itself.

  (rule succ-self
    :conclusion (holds (mem ?x (succ ?x))))

  (rule succ-prev
    :premises ((holds (mem ?y ?x)))
    :conclusion (holds (mem ?y (succ ?x))))

  ;; ══════════════════════════════════════════════════════════════
  ;; ORDINAL RULES
  ;; ══════════════════════════════════════════════════════════════
  ;; An ordinal is a transitive set well-ordered by ∈.

  (rule empty-ordinal
    :conclusion (holds (is-ordinal empty-set)))

  (rule succ-ordinal
    :premises ((holds (is-ordinal ?a)))
    :conclusion (holds (is-ordinal (succ ?a))))

  (rule omega-ordinal
    :conclusion (holds (is-ordinal omega-set)))

  ;; ══════════════════════════════════════════════════════════════
  ;; ORDERED PAIR RULES (Kuratowski)
  ;; ══════════════════════════════════════════════════════════════
  ;; ⟨a,b⟩ = {{a},{a,b}} satisfies the characteristic property:
  ;;   ⟨a,b⟩ = ⟨c,d⟩  iff  a=c and b=d.
  ;; This is THE fundamental theorem that makes pairs useful.

  (rule kpair-inj
    :premises ((holds (seq (kpair ?a ?b) (kpair ?c ?d))))
    :conclusion (holds (conj (seq ?a ?c) (seq ?b ?d))))

  (rule kpair-fst
    :premises ((holds (seq (kpair ?a ?b) (kpair ?c ?d))))
    :conclusion (holds (seq ?a ?c)))

  (rule kpair-snd
    :premises ((holds (seq (kpair ?a ?b) (kpair ?c ?d))))
    :conclusion (holds (seq ?b ?d)))
)

(check-theory ZFC-Foundations)


;; ═════════════════════════════════════════════════════════════════
;; PART A: NATURAL NUMBERS EXIST
;; ═════════════════════════════════════════════════════════════════
;; ω contains all natural numbers. We prove the first three.
;; Each is built from the void using only successor and ∅.

;;; ─── Proof 1: 0 ∈ ω ───
;;; Zero IS the empty set. The Infinity axiom directly asserts ∅ ∈ ω.

(proof zero-in-omega
  :theory ZFC-Foundations
  :goal (holds (mem nat-zero omega-set))
  :derivation (inf-zero))


;;; ─── Proof 2: 1 ∈ ω ───
;;; One = succ(∅) = {∅}. Since ∅ ∈ ω, succ(∅) ∈ ω.

(proof one-in-omega
  :theory ZFC-Foundations
  :goal (holds (mem nat-one omega-set))
  :derivation (inf-succ (inf-zero)))


;;; ─── Proof 3: 2 ∈ ω ───
;;; Two = succ(succ(∅)) = {∅, {∅}}. Two applications of inf-succ.

(proof two-in-omega
  :theory ZFC-Foundations
  :goal (holds (mem nat-two omega-set))
  :derivation (inf-succ (inf-succ (inf-zero))))


;; ═════════════════════════════════════════════════════════════════
;; PART B: ORDINAL STRUCTURE
;; ═════════════════════════════════════════════════════════════════
;; Every natural number is a von Neumann ordinal.
;; Ordinals are transitive sets well-ordered by ∈.

;;; ─── Proof 4: ∅ is an ordinal ───

(proof zero-is-ordinal
  :theory ZFC-Foundations
  :goal (holds (is-ordinal nat-zero))
  :derivation (empty-ordinal))


;;; ─── Proof 5: 1 is an ordinal ───

(proof one-is-ordinal
  :theory ZFC-Foundations
  :goal (holds (is-ordinal nat-one))
  :derivation (succ-ordinal (empty-ordinal)))


;;; ─── Proof 6: 2 is an ordinal ───

(proof two-is-ordinal
  :theory ZFC-Foundations
  :goal (holds (is-ordinal nat-two))
  :derivation (succ-ordinal (succ-ordinal (empty-ordinal))))


;;; ─── Proof 7: ω is an ordinal ───
;;; The first LIMIT ordinal — not a successor of anything.

(proof omega-is-ordinal-proof
  :theory ZFC-Foundations
  :goal (holds (is-ordinal omega-set))
  :derivation (omega-ordinal))


;; ═════════════════════════════════════════════════════════════════
;; PART C: THE ORDER ON NUMBERS
;; ═════════════════════════════════════════════════════════════════
;; For von Neumann ordinals, α < β iff α ∈ β.
;; The rewrite rule ord-lt-is-mem reduces < to ∈.
;; Then succ-self and succ-prev establish the ordering.

;;; ─── Proof 8: 0 < 1 ───
;;; ∅ ∈ succ(∅) because every set is in its own successor.

(proof zero-lt-one
  :theory ZFC-Foundations
  :goal (holds (ord-lt nat-zero nat-one))
  :derivation (succ-self))


;;; ─── Proof 9: 0 < 2 ───
;;; ∅ ∈ succ(succ(∅)): ∅ ∈ succ(∅) (proof 8), then succ-prev lifts it.

(proof zero-lt-two
  :theory ZFC-Foundations
  :goal (holds (ord-lt nat-zero nat-two))
  :derivation (succ-prev (succ-self)))


;;; ─── Proof 10: 1 < 2 ───
;;; succ(∅) ∈ succ(succ(∅)) because every set is in its own successor.

(proof one-lt-two
  :theory ZFC-Foundations
  :goal (holds (ord-lt nat-one nat-two))
  :derivation (succ-self))


;; ═════════════════════════════════════════════════════════════════
;; PART D: SET-THEORETIC REASONING
;; ═════════════════════════════════════════════════════════════════
;; These proofs combine multiple axioms.

;;; ─── Proof 11: ∅ ∉ ∅ ───
;;; Nothing is in the empty set. Not even the empty set itself.

(proof empty-has-no-elements
  :theory ZFC-Foundations
  :goal (holds (neg-p (mem empty-set empty-set)))
  :derivation (empty-ax))


;;; ─── Proof 12: ∅ ∈ P(X) ───
;;; The empty set is in every power set.
;;; Proof: ∅ ⊆ X (by empty-sub), and z ∈ P(X) ↔ z ⊆ X (by power-ax).
;;; Combining these via bic-bwd gives ∅ ∈ P(X).

(proof empty-in-power
  :theory ZFC-Foundations
  :goal (holds (mem empty-set (power X)))
  :derivation (bic-bwd (power-ax) (empty-sub)))


;;; ─── Proof 13: X ∈ P(X) ───
;;; Every set is a member of its own power set.
;;; Proof: X ⊆ X (by sub-refl), and z ∈ P(X) ↔ z ⊆ X (by power-ax).

(proof self-in-power
  :theory ZFC-Foundations
  :goal (holds (mem X (power X)))
  :derivation (bic-bwd (power-ax) (sub-refl)))


;; ═════════════════════════════════════════════════════════════════
;; PART E: THE KURATOWSKI CONSTRUCTION
;; ═════════════════════════════════════════════════════════════════
;; Ordered pairs are NOT primitive. They are DEFINED:
;;
;;   ⟨a,b⟩ = {{a}, {a,b}}      (Kuratowski, 1921)
;;
;; The rewrite rules reduce kpair to raw unordered pairs:
;;   kpair(a,b) → upair(singleton(a), upair(a,b))
;;              → upair(upair(a,a), upair(a,b))
;;
;; This is what makes set theory work as a foundation:
;; we don't NEED ordered pairs as a primitive concept.

;;; ─── Proof 14: ⟨0,1⟩ = ⟨0,1⟩ ───
;;; Both sides normalize to the same set expression:
;;;   {{∅}, {∅, {∅}}} = {{∅}, {∅, {∅}}}
;;; The omega normalizer reduces the Kuratowski definition,
;;; verifying that the construction is deterministic.

(proof kpair-computes
  :theory ZFC-Foundations
  :goal (holds (seq (kpair nat-zero nat-one) (kpair nat-zero nat-one)))
  :derivation (eq-refl))


;;; ─── Proof 15: ⟨a,b⟩ = ⟨c,d⟩ → a=c ∧ b=d ───
;;; THE fundamental theorem of ordered pairs.
;;; If two Kuratowski pairs are equal as sets, then their
;;; first components are equal AND their second components are equal.
;;; This is what makes ⟨a,b⟩ an ORDERED pair — the order matters.

(proof kpair-injective
  :theory ZFC-Foundations
  :assumptions ((holds (seq (kpair A B) (kpair C D))))
  :goal (holds (conj (seq A C) (seq B D)))
  :derivation (kpair-inj (assumption)))


;; ═════════════════════════════════════════════════════════════════
;; WHAT THIS FILE CONSTRUCTS
;; ═════════════════════════════════════════════════════════════════
;;
;; Starting from NOTHING — just Set, Prop, and ∈ — we have built:
;;
;;   ∅           The empty set           (Empty Set axiom)
;;   {a,b}       Unordered pairs         (Pairing axiom)
;;   {a}         Singletons              ({a} = {a,a})
;;   ⟨a,b⟩       Ordered pairs           (⟨a,b⟩ = {{a},{a,b}})
;;   succ(x)     Ordinal successor       (x ∪ {x})
;;   ω           The natural numbers     (Infinity axiom)
;;   P(X)        Power sets              (Power Set axiom)
;;
;; And PROVED 15 theorems about these constructions.
;;
;; ═════════════════════════════════════════════════════════════════
;; ROADMAP TO CH INDEPENDENCE
;; ═════════════════════════════════════════════════════════════════
;;
;; To reach the independence of the Continuum Hypothesis:
;;
;;   Part II:  Relations & Functions (sets of ordered pairs)
;;   Part III: Ordinal Arithmetic (transfinite recursion)
;;   Part IV:  Cardinals (injections, ℵ₀, ℵ₁, Cantor's theorem)
;;   Part V:   Gödel's L (Def operator, condensation, GCH in L)
;;   Part VI:  Cohen Forcing (posets, names, generics, truth lemma)
;;   Part VII: The Independence Theorem (combining V and VI)
;;
;; Each part builds ONLY on the parts before it.
;; No concept is assumed. Every concept is constructed.
;; ═════════════════════════════════════════════════════════════════
