;;; ─── CCC preservation ───
(lemma ccc-gives-countable-supports
  :theory CH-Honest
  :premises ((holds (has-ccc ?P))
             (holds (is-generic ?M ?P ?G))
             (holds (models-zfc ?M)))
  :conclusion (holds (has-countable-supports ?M ?P ?G))
  :derivation (mp (mp (mp (ccc-gives-countable-supports-def) (assumption 0)) (assumption 1)) (assumption 2)))

;;; ─── Cardinality + Independence ───
(lemma card-ge-and-strict-gives-exceeds
  :theory CH-Honest
  :premises ((holds (card-ge-in ?N (power omega-set) (aleph (succ (succ empty-set)))))
             (holds (card-lt (aleph (succ empty-set)) (aleph (succ (succ empty-set))))))
  :conclusion (holds (continuum-exceeds-aleph1 ?N))
  :tactics (auto 4))

(lemma indep-def
  :theory CH-Honest
  :premises ((holds (consistent (and-form ?T ?phi)))
             (holds (consistent (and-form ?T (neg-form ?phi)))))
  :conclusion (holds (independent-of ?phi ?T))
  :tactics (auto 4))


;;; ════════════════════════════════════════════════════════════════════
;;; TARSKI-VAUGHT CRITERION — PROVED BY INDUCTION (Phase 19 Wave 3)
;;; ════════════════════════════════════════════════════════════════════
;;; The first genuine model-theoretic theorem proved by formula induction.
;;; If the TV criterion is satisfied (every existential has a witness),
;;; then ALL formulas are reflected — proved by ind-formula.
;;;
;;; Base: atomic membership is absolute (Δ₀ for transitive models)
;;; Neg:  sat(M,¬φ) ↔ ¬sat(M,φ) — boolean
;;; And:  sat(M,φ∧ψ) ↔ sat(M,φ) ∧ sat(M,ψ) — boolean
;;; Exists: TV criterion provides witnesses — THE key step

(lemma tarski-vaught-criterion-gives-reflection
  :theory CH-Honest
  :premises ((holds (satisfies-tarski-vaught-criterion ?M)))
  :conclusion (holds (has-reflection ?M))
  :derivation (all-reflected-means-has-reflection
    (ind-formula
      ;; Base: mem-form is reflected (absolute for transitive models)
      (formula-reflected-mem)
      ;; Neg: IH(φ) → reflected(¬φ)
      (formula-reflected-neg-step (assumption 1))
      ;; And: IH(φ) ∧ IH(ψ) → reflected(φ∧ψ)
      (formula-reflected-and-step (assumption 1) (assumption 2))
      ;; Exists: IH(φ) + TV criterion → reflected(∃x.φ)
      (formula-reflected-exists-step (assumption 1) (assumption 0)))))

