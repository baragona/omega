(lemma subset-enumeration-gives-power
  :theory CH-Honest
  :premises ((holds (has-subset-enumeration ?M ?P ?G))
             (holds (transitive-m (extension ?M ?P ?G)))
             (holds (definably-closed (extension ?M ?P ?G))))
  :conclusion (holds (sat (extension ?M ?P ?G) ax-power))
  :derivation (mp (mp (mp (subset-enumeration-gives-power-def) (assumption 0)) (assumption 1)) (assumption 2)))

(lemma ground-model-has-name-ranges
  :theory CH-Honest
  :premises ((holds (models-zfc ?M))
             (holds (is-generic ?M ?P ?G)))
  :conclusion (holds (has-name-based-ranges ?M ?P ?G))
