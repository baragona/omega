;;; WAVE 6 CURRIED IMP-DEFINITION LEMMAS (Phase 19)
;;; ════════════════════════════════════════════════════════════════════
;;; 31 multi-premise rules converted to zero-premise curried imp-defs.
;;; 2-premise: (imp A (imp B C)) → (auto 4) finds mp(mp(X-def, a), b)
;;; 3-premise: (imp A (imp B (imp C D))) → (auto 6) finds mp³ chain
;;; 4-premise: similarly → (auto 8)
;;; ════════════════════════════════════════════════════════════════════

;;; ─── Cardinal ordering ───
(lemma card-lt-trans
  :theory CH-Honest
  :premises ((holds (card-lt ?A ?B)) (holds (card-lt ?B ?C)))
  :conclusion (holds (card-lt ?A ?C))
  :tactics (auto 4))

;;; ─── Aleph monotonicity ───
(lemma aleph-strict
  :theory CH-Honest
  :premises ((holds (mem ?a ?b)) (holds (is-ordinal ?b)))
  :conclusion (holds (card-lt (aleph ?a) (aleph ?b)))
  :tactics (auto 4))

;;; ─── L-model membership ───
(lemma def-elem-in-L-model
  :theory CH-Honest
  :premises ((holds (models-zfc ?M))
             (holds (mem ?x (def-op ?Y))))
  :conclusion (holds (mem ?x (model-univ (L-model ?M))))
  :tactics (auto 4))

;;; ─── L-hierarchy ───
(lemma def-stages-give-def-closed
  :theory CH-Honest
  :premises ((holds (has-def-stages ?M))
             (holds (has-transitive-stages ?M)))
  :conclusion (holds (definably-closed ?M))
  :tactics (auto 4))

;;; ─── Tarski-Vaught infrastructure ───
(lemma cofinal-def-closed-meets-criterion
  :theory CH-Honest
  :premises ((holds (has-cofinal-stages ?M))
             (holds (definably-closed ?M)))
  :conclusion (holds (satisfies-tarski-vaught-criterion ?M))
  :tactics (auto 4))

(lemma formula-reflected-and-step
  :theory CH-Honest
  :premises ((holds (formula-reflected ?phi ?M))
             (holds (formula-reflected ?psi ?M)))
  :conclusion (holds (formula-reflected (and-form ?phi ?psi) ?M))
  :tactics (auto 4))

(lemma formula-reflected-exists-step
  :theory CH-Honest
  :premises ((holds (formula-reflected ?phi ?M))
             (holds (satisfies-tarski-vaught-criterion ?M)))
  :conclusion (holds (formula-reflected (exists-form ?phi) ?M))
  :tactics (auto 4))

;;; ─── Satisfaction logic ───
(lemma sat-and-intro
  :theory CH-Honest
  :premises ((holds (sat ?M ?phi)) (holds (sat ?M ?psi)))
  :conclusion (holds (sat ?M (and-form ?phi ?psi)))
  :tactics (auto 4))

;;; ─── Absoluteness ───
(lemma transitive-sat-delta0
  :theory CH-Honest
  :premises ((holds (transitive-m ?M))
             (holds (is-delta0-axiom ?phi)))
  :conclusion (holds (sat ?M ?phi))
  :tactics (auto 4))

(lemma transitive-sat-delta0-param
  :theory CH-Honest
  :premises ((holds (transitive-m ?M))
             (holds (is-delta0-axiom-with-param ?phi ?p))
             (holds (mem ?p (model-univ ?M))))
  :conclusion (holds (sat ?M ?phi))
  :derivation (mp (mp (mp (transitive-sat-delta0-param-def) (assumption 0)) (assumption 1)) (assumption 2)))

;;; ─── Definable closure ───
(lemma def-closure-gives-sat
  :theory CH-Honest
  :premises ((holds (transitive-m ?M))
             (holds (definably-closed ?M))
