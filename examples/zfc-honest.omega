;;; Total: 236 lemmas + 25 proofs (all VALID).
;;; ════════════════════════════════════════════════════════════════════


(theory CH-Honest

  ;; ══════════════════════════════════════════
  ;; SORTS (just two — everything is a set)
  ;; ══════════════════════════════════════════

  (sort Set)
  (sort Prop)


  ;; ══════════════════════════════════════════════════════════════════
  ;; ██  LOGIC + EQUALITY: CLASSICAL FIRST-ORDER LOGIC  ██
  ;; ══════════════════════════════════════════════════════════════════
  ;; 15 LOGIC rules + 6 EQUALITY rules = the inference rules of classical FOL.
  ;; They are the LOGIC, not the MATHEMATICS.
  ;; ══════════════════════════════════════════════════════════════════

  ;; ── Propositional Constructors ──
  (constructor imp   : (-> Prop Prop Prop))
  (constructor neg-p : (-> Prop Prop))
  (constructor conj  : (-> Prop Prop Prop))
  (constructor disj  : (-> Prop Prop Prop))
  (constructor bic   : (-> Prop Prop Prop))
  (constructor bot   : Prop)

  ;; ── The Judgment ──
  (judgment (holds ?P) :where P : Prop)

  ;;; [LOGIC] Conjunction introduction
  (rule conj-intro
    :premises ((holds ?P) (holds ?Q))
    :conclusion (holds (conj ?P ?Q)))

  ;;; [LOGIC] Conjunction elimination (left)
  (rule conj-elim-l
    :premises ((holds (conj ?P ?Q)))
    :conclusion (holds ?P))

  ;;; [LOGIC] Conjunction elimination (right)
  (rule conj-elim-r
    :premises ((holds (conj ?P ?Q)))
    :conclusion (holds ?Q))

  ;;; [LOGIC] Modus ponens
  (rule mp
    :premises ((holds (imp ?P ?Q)) (holds ?P))
    :conclusion (holds ?Q))

  ;;; [LOGIC] Biconditional forward
  (rule bic-fwd
    :premises ((holds (bic ?P ?Q)) (holds ?P))
    :conclusion (holds ?Q))

  ;;; [LOGIC] Biconditional backward
  (rule bic-bwd
    :premises ((holds (bic ?P ?Q)) (holds ?Q))
    :conclusion (holds ?P))

  ;;; [LOGIC] Biconditional introduction
  (rule bic-intro
    :premises ((holds (imp ?P ?Q)) (holds (imp ?Q ?P)))
    :conclusion (holds (bic ?P ?Q)))

  ;;; [LOGIC] Disjunction introduction (left)
  (rule disj-intro-l
    :premises ((holds ?P))
    :conclusion (holds (disj ?P ?Q)))

  ;;; [LOGIC] Disjunction introduction (right)
  (rule disj-intro-r
    :premises ((holds ?Q))
    :conclusion (holds (disj ?P ?Q)))

  ;;; [LOGIC] Ex falso quodlibet (explosion)
  (rule ex-falso
    :premises ((holds bot))
    :conclusion (holds ?Q))

  ;;; [LOGIC] Contradiction: P and ¬P yield ⊥
  (rule contradiction
    :premises ((holds ?P) (holds (neg-p ?P)))
    :conclusion (holds bot))

  ;;; [LOGIC] The liar: (P ↔ ¬P) → ⊥
  ;;; DERIVED from bic-fwd + bic-bwd + neg-intro + contradiction.
  ;;; See "bic-absurd" lemma below (Sub-phase 9.1).
  ;;; Formerly a primitive rule; now a theorem of classical FOL.

  ;;; [LOGIC] Conditional proof (natural deduction imp-intro)
  ;;; Assume A, derive B, conclude A → B.
  (rule imp-intro
    :premises ((holds ?B))
    :context ((0 (holds ?A)))
    :conclusion (holds (imp ?A ?B)))

  ;;; [LOGIC] Negation introduction (proof by contradiction)
  ;;; Assume P, derive ⊥, conclude ¬P.
  (rule neg-intro
    :premises ((holds bot))
    :context ((0 (holds ?P)))
    :conclusion (holds (neg-p ?P)))

  ;;; [LOGIC] Disjunction elimination (case analysis)
  ;;; From A ∨ B, if C follows from A and C follows from B, then C.
  (rule disj-elim
    :premises ((holds (disj ?A ?B)) (holds ?C) (holds ?C))
    :context ((1 (holds ?A)) (2 (holds ?B)))
    :conclusion (holds ?C))

  ;; ── Equality (part of FOL with equality) ──

  (constructor seq : (-> Set Set Prop))

  ;;; [EQUALITY] Reflexivity of equality
  (rule eq-refl
    :conclusion (holds (seq ?a ?a)))

  ;;; [EQUALITY] Symmetry of equality
  (rule eq-sym
    :premises ((holds (seq ?a ?b)))
    :conclusion (holds (seq ?b ?a)))

  ;;; [EQUALITY] Leibniz: equal sets have equal members
  ;;; If X = Y and a ∈ X then a ∈ Y.
  (constructor mem : (-> Set Set Prop))

  (rule mem-eq
    :premises ((holds (seq ?X ?Y)) (holds (mem ?a ?X)))
    :conclusion (holds (mem ?a ?Y)))

  ;;; [EQUALITY] Congruence for membership: equal elements
  ;;; If a = b and a ∈ X then b ∈ X.
  (rule mem-cong
    :premises ((holds (seq ?a ?b)) (holds (mem ?a ?X)))
    :conclusion (holds (mem ?b ?X)))

  ;;; [EQUALITY] neg-mem-eq and bic-mem-eq are now DERIVED (Phase 19).
  ;;; See lemmas below (SUBSET + EQUALITY LEMMAS section).


  ;; ══════════════════════════════════════════════════════════════════
  ;; ██  AXIOM-ZFC: THE ZFC AXIOM SCHEMAS  ██
  ;; ══════════════════════════════════════════════════════════════════
  ;; These 12 rules ARE set theory. Nothing else in the file
  ;; has the right to be called an axiom.
  ;; ══════════════════════════════════════════════════════════════════

  ;; ── Set Constructors (Skolem witnesses for ZFC existence axioms) ──
  (constructor empty-set : Set)
  (constructor upair     : (-> Set Set Set))
  (constructor big-union : (-> Set Set))
  (constructor power     : (-> Set Set))
  (constructor succ      : (-> Set Set))
  (constructor omega-set : Set)
  (constructor sub       : (-> Set Set Prop))
  (constructor app       : (-> Set Set Set))

  ;;; [AXIOM-ZFC 1] Empty Set: nothing is in ∅
  (rule empty-ax
    :conclusion (holds (neg-p (mem ?x empty-set))))

  ;;; [AXIOM-ZFC 2] Pairing: z ∈ {a,b} ↔ z=a ∨ z=b
  (rule pair-ax
    :conclusion (holds (bic (mem ?z (upair ?a ?b))
                            (disj (seq ?z ?a) (seq ?z ?b)))))

  ;;; [AXIOM-ZFC 3] Union: z ∈ y ∧ y ∈ X → z ∈ ⋃X
  (rule union-intro
    :premises ((holds (mem ?z ?y)) (holds (mem ?y ?X)))
    :conclusion (holds (mem ?z (big-union ?X))))

  ;;; [AXIOM-ZFC 4] Power Set: z ∈ P(X) ↔ z ⊆ X
  (rule power-ax
    :conclusion (holds (bic (mem ?z (power ?X)) (sub ?z ?X))))

  ;;; [AXIOM-ZFC 5] Extensionality: A ⊆ B ∧ B ⊆ A → A = B
  (rule extensionality
    :premises ((holds (sub ?A ?B)) (holds (sub ?B ?A)))
    :conclusion (holds (seq ?A ?B)))

  ;;; [AXIOM-ZFC 6] Infinity (base): ∅ ∈ ω
  (rule inf-zero
    :conclusion (holds (mem empty-set omega-set)))

  ;;; [AXIOM-ZFC 7] Infinity (step): n ∈ ω → succ(n) ∈ ω
  (rule inf-succ
    :premises ((holds (mem ?n omega-set)))
    :conclusion (holds (mem (succ ?n) omega-set)))

  ;;; [AXIOM-ZFC 8] Foundation (consequence): ¬(x ∈ x)
  (rule no-self-mem
    :conclusion (holds (neg-p (mem ?x ?x))))

  ;;; [DEFINITION] Subset: A ⊆ B iff every member of A is in B
  ;;; sub-refl, empty-sub, sub-mem are NOW LEMMAS derived from this definition.
  (rule sub-def
    :conclusion (holds (bic (sub ?A ?B) (imp (mem ?x ?A) (mem ?x ?B)))))

  ;;; [AXIOM-ZFC 12a] Successor (self): x ∈ succ(x)
  (rule succ-self
    :conclusion (holds (mem ?x (succ ?x))))

  ;;; [AXIOM-ZFC 12b] Successor (previous): y ∈ x → y ∈ succ(x)
  (rule succ-prev
    :premises ((holds (mem ?y ?x)))
    :conclusion (holds (mem ?y (succ ?x))))

  ;;; [AXIOM-ZFC 12c] Successor (cases): y ∈ succ(x) → y ∈ x ∨ y = x
  ;;; Elimination rule for successor membership.
  (rule succ-cases
    :premises ((holds (mem ?y (succ ?x))))
    :conclusion (holds (disj (mem ?y ?x) (seq ?y ?x))))


  ;; ══════════════════════════════════════════════════════════════════
  ;; ██  DEFINITIONS: Pure abbreviations, zero inference power  ██
  ;; ══════════════════════════════════════════════════════════════════

  ;;; [DEFINITION] Singleton: {a} = {a,a}
  (constructor singleton : (-> Set Set))
  (rewrite singleton-def (singleton ?a) (upair ?a ?a))

  ;;; [DEFINITION] Kuratowski pair: ⟨a,b⟩ = {{a},{a,b}}
  (constructor kpair : (-> Set Set Set))
  (rewrite kpair-def (kpair ?a ?b) (upair (singleton ?a) (upair ?a ?b)))

  ;;; [DEFINITION] Named naturals (von Neumann)
  (constructor nat-zero : Set)
  (rewrite nat-zero-def nat-zero empty-set)
  (constructor nat-one  : Set)
  (rewrite nat-one-def  nat-one  (succ empty-set))
  (constructor nat-two  : Set)
  (rewrite nat-two-def  nat-two  (succ (succ empty-set)))

  ;;; [DEFINITION] Ordinal ordering: α < β iff α ∈ β
  (constructor ord-lt : (-> Set Set Prop))
  (rewrite ord-lt-is-mem (ord-lt ?a ?b) (mem ?a ?b))

  ;;; [DEFINITION] Function application equalities
  ;;; These are equality rules, NOT rewrites — rewrites would normalize away
  ;;; the app/surj-preimage terms before biconditional patterns can match.
  (rule app-id-eq
    :conclusion (holds (seq (app (id-fn ?A) ?x) ?x)))
  ;;; Written as upair(x,x) because singleton-def rewrite normalizes goals
  (rule app-singleton-map-eq
    :conclusion (holds (seq (app (singleton-map ?A) ?x) (upair ?x ?x))))
  (rule surj-preimage-id-eq
    :conclusion (holds (seq (surj-preimage (id-fn ?A) ?b) ?b)))

  ;; Ordinal predicates
  (constructor is-ordinal        : (-> Set Prop))
  (constructor is-limit-ord      : (-> Set Prop))
  (constructor is-transitive-set : (-> Set Prop))

  ;;; [DEFINITION] Transitive set: z ∈ y ∧ y ∈ x → z ∈ x
  (rule transitive-def
    :conclusion (holds (bic (is-transitive-set ?x)
                            (imp (conj (mem ?z ?y) (mem ?y ?x))
                                 (mem ?z ?x)))))

  ;;; [DEFINITION] Ordinal = transitive set whose elements are transitive
  (rule ordinal-def
    :conclusion (holds (bic (is-ordinal ?x)
                            (conj (is-transitive-set ?x)
                                  (imp (mem ?y ?x) (is-transitive-set ?y))))))

  ;;; [DEFINITION] Limit ordinal = non-zero ordinal closed under successor
  (rule limit-ord-def
    :conclusion (holds (bic (is-limit-ord ?x)
                            (conj (is-ordinal ?x)
                                  (conj (neg-p (seq ?x empty-set))
                                        (imp (mem ?y ?x) (mem (succ ?y) ?x)))))))


  ;; ══════════════════════════════════════════════════════════════════
  ;; ██  DERIVED: Rules whose proofs are exhibited below  ██
  ;; ══════════════════════════════════════════════════════════════════
  ;; These rules are NOT axioms. They are PROVED from axioms.
  ;; The proofs appear in the TIER 1 section at the bottom.
  ;; They are stated as rules here so later proofs can use them.
  ;; ══════════════════════════════════════════════════════════════════

  ;;; empty-ordinal is NOW A LEMMA — derived from ordinal-def + transitive-def + empty-ax.
  ;;; succ-ordinal is NOW A LEMMA — derived from ordinal-def + transitive-def + succ-cases.
  ;;; omega-ordinal is NOW A LEMMA — derived via ind-nat induction.
  ;;; omega-is-limit is NOW A LEMMA — derived from limit-ord-def + omega-ordinal + inf-succ.
  ;;; See "ORDINAL LEMMAS" section below.

  ;;; kpair-inj is NOW A LEMMA — derived from pair-ax + singleton-eq + kpair-fst/snd.
  ;;; See "KURATOWSKI PAIR LEMMAS" section below.


  ;; ══════════════════════════════════════════════════════════════════
  ;; ██  THE CANTOR DIAGONAL: DERIVED FROM AXIOMS  ██
  ;; ══════════════════════════════════════════════════════════════════
  ;; This is where we POUR CONCRETE.
  ;;
  ;; Cantor's theorem says: |A| < |P(A)|.
  ;; It has two parts:
  ;;   (a) There exists an injection A → P(A).  (via singletons)
  ;;   (b) There is no surjection A → P(A).     (the diagonal argument)
  ;;
  ;; Part (a) uses only the axioms.
  ;; Part (b) is THE hard part. The diagonal argument works like this:
  ;;
  ;;   Given f: A → P(A), define:
  ;;     D_f = {x ∈ A : x ∉ f(x)}        (by Separation)
  ;;
  ;;   D_f ⊆ A, so D_f ∈ P(A).           (by Power Set)
  ;;
  ;;   If f were surjective, then D_f = f(d) for some d ∈ A.
  ;;   Now ask: is d ∈ D_f?
  ;;
  ;;   d ∈ D_f  ↔  d ∉ f(d)              (by definition of D_f)
  ;;            ↔  d ∉ D_f                (since f(d) = D_f)
  ;;
  ;;   So d ∈ D_f ↔ d ∉ D_f.  CONTRADICTION.
  ;;
  ;; The AXIOMS live here (Separation instances, constructors).
  ;; The LEMMAS (diag-in-power, diag-contradiction, cantor-no-surj, cantor)
  ;; are proved AFTER the theory is registered — see "CANTOR LEMMA CHAIN".
  ;; ══════════════════════════════════════════════════════════════════

  ;; ── Functions and surjectivity ──
  (constructor maps      : (-> Set Set Set Prop))
  (constructor is-inj    : (-> Set Set Set Prop))
  (constructor is-surj   : (-> Set Set Set Prop))
  (constructor is-bij    : (-> Set Set Set Prop))
  (constructor has-inj   : (-> Set Set Prop))
  (constructor has-surj  : (-> Set Set Prop))
  (constructor has-bij   : (-> Set Set Prop))
  (constructor card-le   : (-> Set Set Prop))
  (constructor card-lt   : (-> Set Set Prop))
  (constructor card-eq-s : (-> Set Set Prop))
  (constructor id-fn     : (-> Set Set))

  ;;; [DEFINITION] maps(f,A,B) iff ∀x∈A. f(x)∈B
  (rule maps-def
    :conclusion (holds (bic (maps ?f ?A ?B)
                            (imp (mem ?x ?A) (mem (app ?f ?x) ?B)))))

  ;;; [DEFINITION] is-inj(f,A,B) iff maps(f,A,B) ∧ ∀x,y∈A. f(x)=f(y) → x=y
  (rule inj-def
    :conclusion (holds (bic (is-inj ?f ?A ?B)
                            (conj (maps ?f ?A ?B)
                                  (imp (conj (mem ?x ?A) (conj (mem ?y ?A) (seq (app ?f ?x) (app ?f ?y))))
                                       (seq ?x ?y))))))

  ;;; [DEFINITION] is-surj(f,A,B) iff maps(f,A,B) ∧ ∀b∈B. preimage(f,b)∈A ∧ f(preimage(f,b))=b
  (rule surj-def
    :conclusion (holds (bic (is-surj ?f ?A ?B)
                            (conj (maps ?f ?A ?B)
                                  (imp (mem ?b ?B)
                                       (conj (mem (surj-preimage ?f ?b) ?A)
                                             (seq (app ?f (surj-preimage ?f ?b)) ?b)))))))

  ;; ── The diagonal set ──
  ;; D_f = {x ∈ A : x ∉ f(x)}
  ;; This set EXISTS by Separation (ZFC axiom schema).
  (constructor diag : (-> Set Set Set))

  ;;; [AXIOM-ZFC: Separation instance]
  ;;; D_f = {x ∈ A : x ∉ f(x)} exists by the Separation schema.
  ;;; Every element of D_f is in A.
  (rule diag-sub
    :premises ((holds (maps ?f ?A (power ?A))))
    :conclusion (holds (sub (diag ?f ?A) ?A)))

  ;;; [AXIOM-ZFC: Separation instance]
  ;;; The defining property of D_f:
  ;;;   d ∈ D_f  ↔  d ∉ f(d)     (for d ∈ A)
  ;;; This is the Separation axiom for φ(x) ≡ x ∉ f(x).
  (rule diag-property
    :premises ((holds (maps ?f ?A (power ?A)))
               (holds (mem ?d ?A)))
    :conclusion (holds (bic (mem ?d (diag ?f ?A))
                            (neg-p (mem ?d (app ?f ?d))))))

  ;; ── Part (a): injection via singletons ──

  ;;; singleton-map constructor: x ↦ {x}
  (constructor singleton-map : (-> Set Set))

  ;;; singleton-maps is NOW A LEMMA — derived from maps-def + power-ax + sub-def + pair-ax.
  ;;; singleton-is-inj is NOW A LEMMA — derived from inj-def + singleton-maps + singleton-eq.
  ;;; inj-to-power is NOW A LEMMA — derived from witness-inj + singleton-maps + singleton-is-inj.
  ;;; See "FUNCTION INFRASTRUCTURE LEMMAS" section below.

  ;; ── Cantor's Theorem ──
  ;; The rules diag-in-power, diag-contradiction, cantor-no-surj, cantor
  ;; are NOW LEMMAS — proved after the theory is registered.
  ;; See the "CANTOR LEMMA CHAIN" section below.

  (rule card-lt-def
    :premises ((holds (has-inj ?A ?B)) (holds (neg-p (has-surj ?A ?B))))
    :conclusion (holds (card-lt ?A ?B)))

  ;; ── Surjection elimination (Skolem witnesses) ──
  ;; To prove ¬surj by contradiction, we need to "unwrap" what
  ;; has-surj means: extract a witnessing function and its preimages.

  (constructor surj-witness  : (-> Set Set Set))
  (constructor surj-preimage : (-> Set Set Set))

  ;;; [AXIOM-ZFC] Surjection witness: has-surj(A,B) provides a function
  (rule surj-witness-maps
    :premises ((holds (has-surj ?A ?B)))
    :conclusion (holds (maps (surj-witness ?A ?B) ?A ?B)))

  (rule surj-witness-surj
    :premises ((holds (has-surj ?A ?B)))
    :conclusion (holds (is-surj (surj-witness ?A ?B) ?A ?B)))

  ;;; surj-preimage-in-dom is NOW A LEMMA — derived from surj-def.
  ;;; surj-preimage-hits is NOW A LEMMA — derived from surj-def.
  ;;; See "FUNCTION INFRASTRUCTURE LEMMAS" section below.

  ;; ── Identity function (for reflexivity proofs) ──

  ;;; id-maps, id-is-inj, id-is-surj are NOW LEMMAS — derived from maps-def/inj-def/surj-def.
  ;;; id-is-bij is NOW A LEMMA — derived from bij-def + id-is-inj + id-is-surj.
  ;;; See "FUNCTION INFRASTRUCTURE LEMMAS" section below.

  (rule bij-def
    :premises ((holds (is-inj ?f ?A ?B)) (holds (is-surj ?f ?A ?B)))
    :conclusion (holds (is-bij ?f ?A ?B)))

  (rule witness-inj
    :premises ((holds (maps ?f ?A ?B)) (holds (is-inj ?f ?A ?B)))
    :conclusion (holds (has-inj ?A ?B)))

  (rule witness-bij
    :premises ((holds (maps ?f ?A ?B)) (holds (is-bij ?f ?A ?B)))
    :conclusion (holds (has-bij ?A ?B)))

  (rule card-le-def
    :premises ((holds (has-inj ?A ?B)))
    :conclusion (holds (card-le ?A ?B)))

  (rule card-eq-def
    :premises ((holds (has-bij ?A ?B)))
    :conclusion (holds (card-eq-s ?A ?B)))

  ;;; card-lt-trans is now DERIVED (Phase 19 Wave 6).
  (rule card-lt-trans-def
    :conclusion (holds (imp (card-lt ?A ?B) (imp (card-lt ?B ?C) (card-lt ?A ?C)))))


  ;; ══════════════════════════════════════════════════════════════════
  ;; ██  ADMITTED LEMMAS: THEOREMS WE OWE  ██
  ;; ══════════════════════════════════════════════════════════════════
  ;; Every rule below is a theorem of ZFC that we state without proof.
  ;; Each is tagged with the proof technique it requires.
  ;; These are the IOUs of the formalization.
  ;; ══════════════════════════════════════════════════════════════════

  ;; ── Aleph Hierarchy ──

  (constructor aleph : (-> Set Set))

  ;;; [ORDINAL-ARITH — α ∈ β ∧ Ord(β) → ℵ_α < ℵ_β]
  ;;; The aleph function is strictly monotone on ordinals.
  ;;; aleph-strict is now DERIVED (Phase 19 Wave 6).
  (rule aleph-strict-def
    :conclusion (holds (imp (mem ?a ?b) (imp (is-ordinal ?b) (card-lt (aleph ?a) (aleph ?b))))))

  ;; ── First-Order Logic & Models ──

  (constructor formula-obj  : Set)
  (constructor neg-form     : (-> Set Set))
  (constructor and-form     : (-> Set Set Set))
  (constructor mem-form     : (-> Set Set Set))   ;; atomic formula: x ∈ y
  (constructor exists-form  : (-> Set Set))        ;; existential: ∃x.φ

  ;; ── Formula Induction ──
  ;; Formulas are inductively defined with four constructors:
  ;;   mem-form(x,y)    — atomic:      x ∈ y
  ;;   neg-form(φ)      — negation:    ¬φ
  ;;   and-form(φ,ψ)    — conjunction: φ ∧ ψ
  ;;   exists-form(φ)   — existential: ∃x.φ
  ;; All others (∨, →, ∀) are definable from ¬, ∧, ∃.

  ;;; [INDUCTION] Structural induction on first-order formulas.
  ;;; To prove P(φ) for all formulas φ, prove the four constructor cases
  ;;; using induction hypotheses for sub-formulas (via context extensions).
  (rule ind-formula
    :premises ((holds (?P (mem-form ?x ?y)))
               (holds (?P (neg-form ?phi)))
               (holds (?P (and-form ?phi ?psi)))
               (holds (?P (exists-form ?phi))))
    :context ((1 (holds (?P ?phi)))
              (2 (holds (?P ?phi)))
              (2 (holds (?P ?psi)))
              (3 (holds (?P ?phi))))
    :conclusion (holds (?P ?formula)))

  ;;; [INDUCTION] Natural number (ordinal) induction.
  ;;; Base: P(∅), Step: P(α) → P(succ(α)).
  ;;; Context extension provides IH P(α) for the successor step.
  ;;; Uses empty-set/succ from ZFC (von Neumann ordinals).
  (rule ind-nat
    :premises ((holds (?P empty-set))
               (holds (?P (succ ?n))))
    :context ((1 (holds (?P ?n))))
    :conclusion (holds (?P ?m)))

  ;; ── Well-formedness (demonstrates formula induction) ──
  (constructor well-formed : (-> Set Prop))

  (rule wf-mem
    :conclusion (holds (well-formed (mem-form ?x ?y))))
  (rule wf-neg
    :premises ((holds (well-formed ?phi)))
    :conclusion (holds (well-formed (neg-form ?phi))))
  (rule wf-and
    :premises ((holds (well-formed ?phi)) (holds (well-formed ?psi)))
    :conclusion (holds (well-formed (and-form ?phi ?psi))))
  (rule wf-exists
    :premises ((holds (well-formed ?phi)))
    :conclusion (holds (well-formed (exists-form ?phi))))

  (constructor ch-formula   : Set)
  (constructor gch-formula  : Set)
  (constructor zfc-obj      : Set)
  (constructor model-univ   : (-> Set Set))
  (constructor sat          : (-> Set Set Prop))
  (constructor models-zfc   : (-> Set Prop))
  (constructor consistent   : (-> Set Prop))
  (constructor countable    : (-> Set Prop))
  (constructor transitive-m : (-> Set Prop))

  ;; ── Constructible Universe L ──
  ;; L-model is PARAMETERIZED by a ground model M: (L-model M) is the
  ;; constructible universe built inside M. All L-properties require
  ;; (holds (models-zfc ?M)) as a premise — essential by Gödel's 2nd.

  (constructor def-op  : (-> Set Set))
  (constructor L-stage : (-> Set Set))
  (constructor L-full  : Set)
  (constructor L-model : (-> Set Set))

  (rewrite L-zero (L-stage empty-set) empty-set)
  (rewrite L-suc  (L-stage (succ ?a)) (def-op (L-stage ?a)))

  ;;; [L-DEFINITION — L = ⋃_α L_α]
  ;;; x ∈ L_α implies x ∈ L (the constructible universe is the union of all stages).
  ;;; in-L-iff-stage is now DERIVED (Phase 19 Wave 5, imp-def + auto lemma below).
  (rule in-L-iff-stage-def
    :conclusion (holds (imp (mem ?x (L-stage ?a)) (mem ?x L-full))))

  ;;; [L-DEFINITION — ∅ is always definable: ∅ ∈ Def(X) for any X]
  ;;; The empty set is defined by "∀z. z ∉ Y" — a bounded formula.
  (rule def-op-contains-empty
    :conclusion (holds (mem empty-set (def-op ?X))))

  ;;; [L-DEFINITION — ω is definable over L_ω]
  ;;; Each n ∈ ω appears in L_{n+1}, so ω ⊆ L_ω. The formula
  ;;; "Y is inductive and minimal" defines ω over L_ω.
  (rule omega-in-def-of-L-omega
    :conclusion (holds (mem omega-set (def-op (L-stage omega-set)))))

  ;;; [L-DEFINITION — definable elements are in L(M)]
  ;;; If x ∈ Def(Y) for any set Y, then x ∈ L(M). This is because
  ;;; Def(Y) ⊆ L whenever Y ⊆ L, and L(M) is closed under Def.
  ;;; def-elem-in-L-model is now DERIVED (Phase 19 Wave 6).
  (rule def-elem-in-L-model-def
    :conclusion (holds (imp (models-zfc ?M) (imp (mem ?x (def-op ?Y)) (mem ?x (model-univ (L-model ?M)))))))

  ;;; L-transitive is NOW A LEMMA — derived from L-HIERARCHY sub-results.
  ;;; See "L-CONSTRUCTION LEMMAS" section below.

  ;; ── L(M) Satisfies ZFC ──
  ;; Each axiom requires its own proof. Some are easy (extensionality),
  ;; some are hard (power set, choice). All relative to M ⊨ ZFC.

  (constructor ax-ext    : Set)
  (constructor ax-empty  : Set)
  (constructor ax-pair   : Set)
  (constructor ax-union  : Set)
  (constructor ax-power  : Set)
  (constructor ax-inf    : Set)
  (constructor ax-sep    : (-> Set Set))
  (constructor ax-rep    : (-> Set Set))
  (constructor ax-reg    : Set)
  (constructor ax-choice : Set)

  ;;; All 10 L-sat-* rules are NOW LEMMAS — proved from absoluteness,
  ;;; definable closure, condensation, reflection, and well-ordering.
  ;;; See "L-SAT LEMMAS" section below.

  ;;; L-contains-empty and L-contains-omega are NOW LEMMAS — derived from
  ;;; def-op-contains-empty, omega-in-def-of-L-omega, L-stage-succ-intro,
  ;;; and L-model-from-stage. See "L-CONSTRUCTION LEMMAS" section below.

  ;;; L-def-closed is NOW A LEMMA — derived from L-HIERARCHY sub-results.
  ;;; See "L-CONSTRUCTION LEMMAS" section below.

  ;; ── L-Hierarchy: why L is transitive and definably closed ──
  ;; Decomposed into 5 fine-grained sub-results (3 for transitivity, 2 for def-closure).

  ;;; [L-HIERARCHY — Def(X) ⊆ P(X)]
  ;;; Every element of Def(X) is a subset of X. Def(X) consists of
  ;;; all first-order definable subsets of X — each is a subset by definition.
  ;;; def-op-sub is now DERIVED (Phase 19 Wave 5).
  (rule def-op-sub-def
    :conclusion (holds (imp (mem ?x (def-op ?Y)) (sub ?x ?Y))))

  ;;; [L-HIERARCHY — L-stages are transitive]
  ;;; Base: L₀ = ∅ transitive. Step: x ∈ L_{α+1} = Def(L_α) ⊆ P(L_α),
  ;;; so x ⊆ L_α; if L_α transitive, members of x are in L_α ⊆ L_{α+1}.
  ;;; This is the transfinite induction argument encapsulated as a single fact.
  ;;; L-has-transitive-stages is now DERIVED (Phase 19 Wave 5).
  (rule L-has-transitive-stages-def
    :conclusion (holds (imp (models-zfc ?M) (has-transitive-stages (L-model ?M)))))

  ;;; [L-HIERARCHY — transitive stages → transitive model]
  ;;; L(M) = ∪_α L_α. x ∈ L(M) means x ∈ L_α for some α.
  ;;; If y ∈ x and L_α is transitive, then y ∈ L_α ⊆ L(M).
  ;;; transitive-stages-give-transitive-model is now DERIVED (Phase 19 Wave 5).
  (rule transitive-stages-give-transitive-model-def
    :conclusion (holds (imp (has-transitive-stages ?M) (transitive-m ?M))))

  ;;; [L-HIERARCHY — each L_{α+1} = Def(L_α)]
  ;;; The constructible hierarchy is built by taking definable power sets.
  ;;; At each successor stage, all first-order definable subsets are added.
  ;;; L-has-def-stages is now DERIVED (Phase 19 Wave 5).
  (rule L-has-def-stages-def
    :conclusion (holds (imp (models-zfc ?M) (has-def-stages (L-model ?M)))))

  ;;; [L-HIERARCHY — Def-staged + transitive stages → definably closed]
  ;;; If each L_{α+1} = Def(L_α) and stages are transitive, any definable
  ;;; subset of L(M) appears at some stage, hence is in L(M).
  ;;; def-stages-give-def-closed is now DERIVED (Phase 19 Wave 6).
  (rule def-stages-give-def-closed-def
    :conclusion (holds (imp (has-def-stages ?M) (imp (has-transitive-stages ?M) (definably-closed ?M)))))

  ;; ── Condensation Lemma: decomposed into 3×2 sub-results ──

  ;;; [DEFINITION/LANGUAGE — L uses a single binary relation ∈]
  ;;; Definitional: the language of set theory has exactly one primitive (∈).
  ;;; set-theory-has-single-relation is now DERIVED (Phase 19, lemma below).
  (rule L-uses-single-relation
    :conclusion (holds (has-single-relation (L-model ?M))))

  ;;; [LOWENHEIM-SKOLEM/LANGUAGE-2 — single relation → countable language]
  ;;; A language with finitely many relation symbols generates countably
  ;;; many terms and formulas (finite strings over a finite alphabet).
  ;;; single-relation-gives-countable-language is now DERIVED (Phase 19 Wave 5).
  (rule single-relation-gives-countable-language-def
    :conclusion (holds (imp (has-single-relation ?M) (has-countable-language ?M))))

  ;;; [LOWENHEIM-SKOLEM/SKOLEM — countable language → Skolem functions]
  ;;; For each existential formula ∃y.φ(x,y), choose a witness function
  ;;; f_φ(x) = y. Countable language → countably many Skolem functions.
  ;;; countable-language-gives-skolem-functions is now DERIVED (Phase 19 Wave 5).
  (rule countable-language-gives-skolem-functions-def
    :conclusion (holds (imp (has-countable-language ?M) (has-skolem-functions ?M))))

  ;;; [LOWENHEIM-SKOLEM/CLOSURE — Skolem closure → elementary submodel]
  ;;; Start from any countable subset, close under all Skolem functions.
  ;;; Countable closure of countable set is countable; result is elementary.
  ;;; skolem-closure-gives-elem-submodel is now DERIVED (Phase 19 Wave 5).
  (rule skolem-closure-gives-elem-submodel-def
    :conclusion (holds (imp (has-skolem-functions ?M) (has-elem-submodels ?M))))

  ;;; [MOSTOWSKI/WF-EPSILON — ZFC models have well-founded ∈-relation]
  ;;; Regularity axiom guarantees no infinite descending ∈-chains.
  ;;; models-have-well-founded-epsilon is now DERIVED (Phase 19 Wave 5).
  (rule models-have-well-founded-epsilon-def
    :conclusion (holds (imp (models-zfc ?M) (has-well-founded-epsilon ?M))))

  ;;; [MOSTOWSKI/WF-INHERITED — transitive substructures inherit well-foundedness]
  ;;; L-submodels are transitive subsets of M, so ∈ is well-founded in them.
  ;;; well-founded-epsilon-inherited-by-L is now DERIVED (Phase 19 Wave 5).
  (rule well-founded-epsilon-inherited-by-L-def
    :conclusion (holds (imp (has-well-founded-epsilon ?M) (has-well-founded-submodels (L-model ?M)))))

  ;;; [MOSTOWSKI/MAP — well-founded extensional → Mostowski collapse map exists]
  ;;; Define π(x) = {π(y) : y ∈ x} recursively. Well-foundedness ensures
  ;;; termination; extensionality ensures the map is injective.
  ;;; well-founded-gives-mostowski-map is now DERIVED (Phase 19 Wave 5).
  (rule well-founded-gives-mostowski-map-def
    :conclusion (holds (imp (has-well-founded-submodels ?M) (has-mostowski-map ?M))))

  ;;; [MOSTOWSKI/COLLAPSE — Mostowski map → transitive collapse]
  ;;; The image of π is a transitive set isomorphic to the original structure.
  ;;; mostowski-map-gives-collapse is now DERIVED (Phase 19 Wave 5).
  (rule mostowski-map-gives-collapse-def
    :conclusion (holds (imp (has-mostowski-map ?M) (has-collapse ?M))))

  ;;; [L-CONDENSATION/ELEM-SUB — L has elementary submodels]
  ;;; Löwenheim-Skolem gives countable elementary submodels of L-stages.
  ;;; These are structures preserving all first-order truth.
  ;;; L-has-elementary-submodels is now DERIVED (Phase 19 Wave 5).
  (rule L-has-elementary-submodels-def
    :conclusion (holds (imp (models-zfc ?M) (has-elementary-submodels (L-model ?M)))))

  ;;; [L-CONDENSATION/ELEM-PRESERVES — elementary embeddings preserve definability]
  ;;; Elementary submodels preserve satisfaction of all formulas, hence
  ;;; they preserve Def-closure: definable subsets map to definable subsets.
  ;;; elementary-embeddings-preserve-definability is now DERIVED (Phase 19 Wave 5).
  (rule elementary-embeddings-preserve-definability-def
    :conclusion (holds (imp (has-elementary-submodels ?M) (has-def-preserving-collapse ?M))))

  ;;; [L-CONDENSATION/IMAGE — def-preserving collapse → transitive Def-closed image]
  ;;; The Mostowski collapse of a definability-preserving elementary submodel
  ;;; yields a transitive set closed under the Def operator.
  ;;; def-preserving-gives-transitive-image is now DERIVED (Phase 19 Wave 5).
  (rule def-preserving-gives-transitive-image-def
    :conclusion (holds (imp (has-def-preserving-collapse ?M) (has-transitive-def-closed-image ?M))))

  ;;; [L-CONDENSATION/L-STAGE — transitive Def-closed set is an L-stage]
  ;;; A transitive set closed under Def that looks like L_α must be some L_β.
  ;;; This is the key fact: the constructible hierarchy is characterized by
  ;;; transitive Def-closure.
  ;;; transitive-def-closed-image-is-L-stage is now DERIVED (Phase 19 Wave 5).
  (rule transitive-def-closed-image-is-L-stage-def
    :conclusion (holds (imp (has-transitive-def-closed-image ?M) (has-stage-collapse ?M))))

  ;;; [CONDENSATION/DEF — condensation is the conjunction of 3 sub-results]
  ;;; Purely definitional: condensation = elem-submodels + collapse + stage-collapse.
  (rule condensation-def
    :conclusion (holds (bic (has-condensation ?M)
      (conj (has-elem-submodels ?M) (conj (has-collapse ?M) (has-stage-collapse ?M))))))

  ;;; L-has-countable-language, countable-language-gives-elem-submodel,
  ;;; L-has-elem-submodels, L-has-well-founded-submodels,
  ;;; well-founded-extensional-collapses, L-has-collapse,
  ;;; L-has-def-preserving-collapse, def-preserving-collapse-lands-in-L,
  ;;; L-has-stage-collapse, condensation-assembly, and L-has-condensation
  ;;; are NOW LEMMAS — derived from Phase 14-17 decompositions.
  ;;; See "PHASE 17 RECOVERY LEMMAS", "PHASE 16 RECOVERY LEMMAS",
  ;;; "PRIMITIVE RECOVERY LEMMAS", and "DECOMPOSITION LEMMAS" below.

  ;; ── Reflection Principle: decomposed into 2×2 sub-results ──

  ;;; [L-COFINALITY/PROPER-CLASS — ZFC → ordinals form a proper class]
  ;;; By Replacement: if ordinals were a set, their union would be an ordinal
  ;;; greater than all ordinals — contradiction (Burali-Forti).
  ;;; zfc-ordinals-proper-class is now DERIVED (Phase 19 Wave 5).
  (rule zfc-ordinals-proper-class-def
    :conclusion (holds (imp (models-zfc ?M) (has-proper-class-ordinals ?M))))

  ;;; [DEFINITION/L-ORDINALS — proper class ordinals ↔ unbounded in L]
  ;;; Definitional: ordinals are definable, so all ordinals of M are in L(M).
  ;;; A proper class in M = unbounded in L(M). Zero inference power.
  ;;; proper-class-ordinals-unbounded-in-L is now DERIVED (Phase 19, lemma below).
  (rule unbounded-ords-in-L-def
    :conclusion (holds (bic (has-unbounded-ordinals (L-model ?M))
      (has-proper-class-ordinals ?M))))

  ;;; [L-COFINALITY/REFLECTING — unbounded ordinals → reflecting ordinals exist]
  ;;; For each formula φ, the set of ordinals α with L_α ⊨ φ ↔ L ⊨ φ is
  ;;; unbounded (by Tarski's undefinability + Replacement).
  ;;; unbounded-give-reflecting-ordinals is now DERIVED (Phase 19 Wave 5).
  (rule unbounded-give-reflecting-ordinals-def
    :conclusion (holds (imp (has-unbounded-ordinals ?M) (has-reflecting-ordinals ?M))))

  ;;; [L-COFINALITY/COFINAL — reflecting ordinals → cofinal reflecting stages]
  ;;; Reflecting ordinals at cofinally many heights give cofinal stages.
  ;;; reflecting-ordinals-give-cofinal-stages is now DERIVED (Phase 19 Wave 5).
  (rule reflecting-ordinals-give-cofinal-stages-def
    :conclusion (holds (imp (has-reflecting-ordinals ?M) (has-cofinal-stages ?M))))

  ;;; [TARSKI-VAUGHT/CRITERION — cofinal stages + definable closure → TV criterion]
  ;;; Cofinally many reflecting stages + definable closure ensures that
  ;;; for each φ and each element a ∈ M, if ∃y.φ(a,y) holds, a witness
  ;;; exists in some reflecting stage.
  ;;; cofinal-def-closed-meets-criterion is now DERIVED (Phase 19 Wave 6).
  (rule cofinal-def-closed-meets-criterion-def
    :conclusion (holds (imp (has-cofinal-stages ?M) (imp (definably-closed ?M) (satisfies-tarski-vaught-criterion ?M)))))

  ;;; [TARSKI-VAUGHT/REFLECTION — TV criterion → full reflection]
  ;;; PROVED by ind-formula (Phase 19 Wave 3). The Tarski-Vaught test:
  ;;; if every existential has a witness, all formulas are reflected.
  ;;; Infrastructure: formula-reflected predicate + 4 step rules + bridge.

  ;; Predicate: formula φ is reflected at cofinally many stages of M
  (constructor formula-reflected : (-> Prop Set Prop))

  ;; Base: membership (atomic) is reflected at all transitive stages
  ;; Definitional: a ∈ b is absolute for transitive models (Δ₀).
  (rule formula-reflected-mem
    :conclusion (holds (formula-reflected (mem-form ?x ?y) ?M)))

  ;; Neg step: if φ is reflected, then ¬φ is reflected
  ;; Definitional: sat(M, ¬φ) ↔ ¬sat(M, φ) at any stage.
  ;;; formula-reflected-neg-step is now DERIVED (Phase 19 Wave 5).
  (rule formula-reflected-neg-step-def
    :conclusion (holds (imp (formula-reflected ?phi ?M) (formula-reflected (neg-form ?phi) ?M))))

  ;; And step: if φ and ψ are reflected, then φ ∧ ψ is reflected
  ;; Definitional: sat(M, φ∧ψ) ↔ sat(M,φ) ∧ sat(M,ψ).
  ;;; formula-reflected-and-step is now DERIVED (Phase 19 Wave 6).
  (rule formula-reflected-and-step-def
    :conclusion (holds (imp (formula-reflected ?phi ?M) (imp (formula-reflected ?psi ?M) (formula-reflected (and-form ?phi ?psi) ?M)))))

  ;; Exists step: if φ is reflected AND the TV criterion gives witnesses,
  ;; then ∃x.φ is reflected. This is THE key step of the TV test.
  ;; Definitional: the TV criterion provides witnesses for existentials.
  ;;; formula-reflected-exists-step is now DERIVED (Phase 19 Wave 6).
  (rule formula-reflected-exists-step-def
    :conclusion (holds (imp (formula-reflected ?phi ?M) (imp (satisfies-tarski-vaught-criterion ?M) (formula-reflected (exists-form ?phi) ?M)))))

  ;; Bridge: if ALL formulas are reflected, then M has full reflection.
  ;; Definitional: has-reflection(M) = "all formulas are reflected in M".
  ;;; all-reflected-means-has-reflection is now DERIVED (Phase 19 Wave 5).
  (rule all-reflected-means-has-reflection-def
    :conclusion (holds (imp (formula-reflected ?formula ?M) (has-reflection ?M))))

  ;;; tarski-vaught-criterion-gives-reflection is now a LEMMA (Phase 19).
  ;;; See "DEFINITIONAL EQUIVALENCE LEMMAS" section below.

  ;;; L-has-unbounded-ordinals, unbounded-ordinals-give-cofinal-stages,
  ;;; L-has-cofinal-stages, tarski-vaught-gives-reflection, and L-has-reflection
  ;;; are NOW LEMMAS — derived from Phase 17 decompositions.
  ;;; See "PHASE 17 RECOVERY LEMMAS", "PRIMITIVE RECOVERY LEMMAS",
  ;;; and "DECOMPOSITION LEMMAS" below.

  ;; ── L Well-Ordering: decomposed into 2×2 sub-results ──

  ;;; [DEFINITION/PIPELINE — single relation → finite language]
  ;;; Reuses has-single-relation; ∈ is a finite (1-symbol) language.
  ;;; Logical connectives and quantifiers are from a fixed finite set.
  ;;; single-relation-gives-finite-language is now DERIVED (Phase 19 Wave 4).
  (rule single-relation-gives-finite-language-def
    :conclusion (holds (imp (has-single-relation ?M) (has-finite-language ?M))))

  ;;; [DEFINITION/PIPELINE — finite language → enumerable formula strings]
  ;;; Formulas over a finite alphabet are finite strings. The set of all
  ;;; finite strings over a finite alphabet is recursively enumerable.
  ;;; finite-language-gives-enumerable-strings is now DERIVED (Phase 19 Wave 4).
  (rule finite-language-gives-enumerable-strings-def
    :conclusion (holds (imp (has-finite-language ?M) (has-enumerable-strings ?M))))

  ;;; [DEFINITION/PIPELINE — enumerable strings → Gödel numbering]
  ;;; An enumeration of formula strings assigns each a unique natural number:
  ;;; its position in the enumeration. This is the Gödel numbering.
  ;;; enumerable-strings-give-godel-numbering is now DERIVED (Phase 19 Wave 4).
  (rule enumerable-strings-give-godel-numbering-def
    :conclusion (holds (imp (has-enumerable-strings ?M) (has-godel-numbering ?M))))

  ;;; [DEFINITION/L-HIERARCHY — L is built by transfinite stages]
  ;;; Definitional: L is constructed as L₀ ⊂ L₁ ⊂ ... by definition.
  ;;; L-has-staged-hierarchy is now DERIVED (Phase 19, lemma below).
  (rule L-always-staged
    :conclusion (holds (has-staged-hierarchy (L-model ?M))))

  ;;; [DEFINITION/PIPELINE — staged hierarchy → birthday function]
  ;;; Each x ∈ L first appears at some successor stage L_{α+1} = Def(L_α).
  ;;; The least such α is x's birthday — a well-defined ordinal.
  ;;; staged-hierarchy-gives-birthday is now DERIVED (Phase 19 Wave 4).
  (rule staged-hierarchy-gives-birthday-def
    :conclusion (holds (imp (has-staged-hierarchy ?M) (has-birthday-function ?M))))

  ;;; [DEFINITION/PIPELINE — birthday function → ordinal-valued birthdays]
  ;;; The birthday function assigns each x ∈ L an ordinal: the least α
  ;;; with x ∈ L_{α+1}. These ordinal values are well-defined.
  ;;; birthday-gives-ordinal-values is now DERIVED (Phase 19 Wave 4).
  (rule birthday-gives-ordinal-values-def
    :conclusion (holds (imp (has-birthday-function ?M) (has-ordinal-birthdays ?M))))

  ;;; [DEFINITION/PIPELINE — ordinal birthdays → stage ordering]
  ;;; Ordinal-valued birthdays induce a well-ordering on L-elements:
  ;;; x <_birth y iff birthday(x) < birthday(y).
  ;;; ordinal-birthdays-give-stage-ordering is now DERIVED (Phase 19 Wave 4).
  (rule ordinal-birthdays-give-stage-ordering-def
    :conclusion (holds (imp (has-ordinal-birthdays ?M) (has-stage-ordering ?M))))

  ;;; [L-WELLORDER/DEF — well-order is stage-ordering + Gödel numbering]
  ;;; Purely definitional: a definable well-ordering = stage ordering + Gödel numbering.
  (rule wellorder-def
    :conclusion (holds (bic (has-definable-wellorder ?M)
      (conj (has-stage-ordering ?M) (has-godel-numbering ?M)))))

  ;;; L-has-birthday-function, L-has-finite-language,
  ;;; finite-language-gives-godel-numbering, L-has-godel-numbering,
  ;;; birthday-function-gives-stage-ordering, L-has-stage-ordering,
  ;;; wellorder-from-parts, and L-has-definable-wellorder are NOW LEMMAS.
  ;;; See "PHASE 17 RECOVERY LEMMAS", "PHASE 16 RECOVERY LEMMAS",
  ;;; "PRIMITIVE RECOVERY LEMMAS", and "DECOMPOSITION LEMMAS".

  ;;; L-sat-power, L-sat-rep, L-sat-choice are NOW LEMMAS —
  ;;; proved from condensation/reflection/wellorder infrastructure.
  ;;; See "L-SAT LEMMAS" section below.

  ;;; L-models-zfc is NOW A LEMMA (relative to M ⊨ ZFC) — proved by
  ;;; chaining the 10 L-sat-* rules. See "INFRASTRUCTURE LEMMAS" below.

  ;; ── GCH in L ──

  ;;; L-satisfies-gch is NOW A LEMMA (relative to M ⊨ ZFC) — proved
  ;;; from condensation-gives-gch. See "GÖDEL THEOREM LEMMAS" below.

  ;;; [SOUNDNESS — universal instantiation: GCH at α=0 gives CH]
  ;;; gch-implies-ch is now DERIVED (Phase 19 Wave 5).
  (rule gch-implies-ch-def
    :conclusion (holds (imp (sat ?M gch-formula) (sat ?M ch-formula))))

  ;; ── Consistency ──

  ;;; [SOUNDNESS — a model witnesses consistency]
  ;;; model-implies-consistent is now DERIVED (Phase 19 Wave 5).
  (rule model-implies-consistent-def
    :conclusion (holds (imp (sat ?M ?T) (consistent ?T))))

  ;; ── Semantic Axioms (connecting sat to formula structure) ──

  ;;; [SAT-LOGIC] Satisfaction for conjunction of formulas/theories
  ;;; sat-and-intro is now DERIVED (Phase 19 Wave 6).
  (rule sat-and-intro-def
    :conclusion (holds (imp (sat ?M ?phi) (imp (sat ?M ?psi) (sat ?M (and-form ?phi ?psi))))))

  ;;; [SAT-LOGIC] models-zfc implies satisfaction of the ZFC theory object
  ;;; models-zfc-to-sat is now DERIVED (Phase 19 Wave 5).
  (rule models-zfc-to-sat-def
    :conclusion (holds (imp (models-zfc ?M) (sat ?M zfc-obj))))

  ;;; [SAT-LOGIC] models-zfc from individual axiom satisfaction
  ;;; models-zfc-def is now DERIVED (Phase 19 Wave 7).
  (rule models-zfc-conj-def
    :conclusion (holds (imp (sat ?M ax-ext) (imp (sat ?M ax-empty) (imp (sat ?M ax-pair) (imp (sat ?M ax-union) (imp (sat ?M ax-power) (imp (sat ?M ax-inf) (imp (sat ?M (ax-sep ?phi)) (imp (sat ?M (ax-rep ?psi)) (imp (sat ?M ax-reg) (imp (sat ?M ax-choice) (models-zfc ?M)))))))))))))

  ;;; godel-theorem is NOW A LEMMA (relative to M ⊨ ZFC) — proved from
  ;;; L-models-zfc + L-satisfies-gch + gch-implies-ch + sat-and-intro
  ;;; + model-implies-consistent. See "INFRASTRUCTURE LEMMAS" below.


  ;; ══════════════════════════════════════════════════════════════════
  ;; ██  MODEL-THEORETIC INFRASTRUCTURE  ██
  ;; ══════════════════════════════════════════════════════════════════
  ;; Model theory: absoluteness, definable closure, named mathematical
  ;; theorems (Condensation, Reflection, etc.). Each rule is honestly
  ;; tagged with the specific result it represents.
  ;; ══════════════════════════════════════════════════════════════════

  (constructor definably-closed      : (-> Set Prop))
  (constructor is-def-closure-axiom  : (-> Set Prop))

  ;; Condensation sub-results (Löwenheim-Skolem + Mostowski + L-condensation)
  (constructor has-countable-language     : (-> Set Prop))  ;; L uses countable FOL language
  (constructor has-elem-submodels  : (-> Set Prop))   ;; countable elementary submodels exist
  (constructor has-well-founded-submodels : (-> Set Prop))  ;; L-submodels are well-founded
  (constructor has-collapse        : (-> Set Prop))   ;; well-founded extensional → transitive
  (constructor has-def-preserving-collapse : (-> Set Prop)) ;; collapse preserves definability
  (constructor has-stage-collapse  : (-> Set Prop))   ;; collapsed L-submodels land in L
  (constructor has-condensation    : (-> Set Prop))   ;; composite: full Condensation Lemma
  (constructor has-bounded-subsets : (-> Set Prop))    ;; subsets bounded by condensation
  (constructor has-subset-counting : (-> Set Prop))    ;; |P(ℵ_α) ∩ L| ≤ |L_{ℵ_{α+1}}|

  ;; Reflection sub-results
  (constructor has-unbounded-ordinals : (-> Set Prop)) ;; ordinal heights are unbounded
  (constructor has-cofinal-stages  : (-> Set Prop))   ;; cofinally many stages (ordinal cofinality)
  (constructor has-reflection      : (-> Set Prop))   ;; composite: Reflection Principle
  (constructor has-bounded-ranges  : (-> Set Prop))   ;; class function ranges are bounded

  ;; L well-ordering sub-results
  (constructor has-finite-language : (-> Set Prop))    ;; L uses finite language (∈ only)
  (constructor has-godel-numbering : (-> Set Prop))   ;; formulas have Gödel numbers
  (constructor has-birthday-function : (-> Set Prop)) ;; each element has a birthday ordinal
  (constructor has-stage-ordering  : (-> Set Prop))   ;; elements ordered by stage of appearance
  (constructor has-definable-wellorder : (-> Set Prop)) ;; composite: definable well-ordering
  (constructor has-choice-function : (-> Set Prop))   ;; global choice function from <_L

  ;; L-hierarchy sub-results (transitivity + definable closure)
  (constructor has-transitive-stages : (-> Set Prop))    ;; each L_α is a transitive set
  (constructor has-def-stages        : (-> Set Prop))    ;; each L_{α+1} = Def(L_α)

  ;; Rasiowa-Sikorski sub-results
  (constructor has-dense-enumeration  : (-> Set Set Prop)) ;; dense sets enumerable
  (constructor has-countable-dense-sets : (-> Set Set Prop)) ;; countable model → countable dense sets
  (constructor has-descending-chain   : (-> Set Set Prop)) ;; descending chain through dense sets

  ;; Delta-system sub-results
  (constructor has-delta-system             : (-> Set Prop))   ;; uncountable family has Δ-system
  (constructor has-uniform-size-subfamily   : (-> Set Prop))   ;; pigeonhole: same-size sub-family
  (constructor root-pairs-compatible        : (-> Set Prop))   ;; root agreement → compatibility

  ;; CCC preservation sub-results
  (constructor has-bounded-antichains  : (-> Set Prop))  ;; all antichains countable
  (constructor has-countable-supports  : (-> Set Set Set Prop)) ;; every P-name has countable support
  (constructor has-no-collapsing-map   : (-> Set Prop))  ;; no cardinal-collapsing surjection

  ;; Forcing infrastructure
  (constructor has-nice-names         : (-> Set Set Set Prop))
  (constructor is-finite-function-poset : (-> Set Prop))
  (constructor has-kappa-reals        : (-> Set Set Prop))
  (constructor preserves-cardinals    : (-> Set Prop))

  ;; Forcing relation sub-results
  (constructor has-sound-forcing        : (-> Set Set Set Prop))  ;; (M,P,phi) verified forcing is sound
  (constructor has-name-interpretation  : (-> Set Set Set Prop))  ;; (M,P,G) every M[G]-element has a name
  (constructor has-thinnable-names      : (-> Set Prop))          ;; (P) CCC allows name thinning
  (constructor has-subset-enumeration   : (-> Set Set Set Prop))  ;; (M,P,G) nice names enumerate subsets
  (constructor has-extended-replacement : (-> Set Set Set Prop))  ;; (M,P,G) Replacement extends via names
  (constructor has-extended-choice      : (-> Set Set Set Prop))  ;; (M,P,G) Choice extends via names

  ;; Phase 16 decomposition sub-results
  (constructor has-single-relation             : (-> Set Prop))          ;; L uses ∈ only
  (constructor has-enumerable-strings          : (-> Set Prop))          ;; finite alphabet → enumerable formulas
  (constructor has-ordinal-birthdays           : (-> Set Prop))          ;; each element has ordinal birthday
  (constructor has-countable-listing           : (-> Set Set Prop))      ;; dense sets have countable listing
  (constructor has-filter-from-chain           : (-> Set Set Prop))      ;; chain generates upward-closed filter
  (constructor has-common-root                 : (-> Set Prop))          ;; Δ-system elements share common root
  (constructor has-no-uncountable-antichain    : (-> Set Prop))          ;; no uncountable antichain exists
  (constructor collapse-requires-large-antichain : (-> Set Prop))        ;; collapse needs uncountable antichain
  (constructor aleph-values-preserved          : (-> Set Prop))          ;; ℵ values unchanged in extension
  (constructor has-kappa-subsets-of-omega       : (-> Set Set Prop))     ;; κ-many subsets of ω
  (constructor continuum-exceeds-aleph1        : (-> Set Prop))          ;; |P(ω)| > ℵ₁

  ;; Phase 17 decomposition sub-results
  (constructor has-well-founded-epsilon          : (-> Set Prop))          ;; M has well-founded ∈
  (constructor has-mostowski-map                 : (-> Set Prop))          ;; Mostowski collapse map exists
  (constructor has-elementary-submodels          : (-> Set Prop))          ;; elementary submodels exist
  (constructor has-transitive-def-closed-image   : (-> Set Prop))          ;; collapse image is transitive + Def-closed
  (constructor has-proper-class-ordinals         : (-> Set Prop))          ;; ordinals form proper class
  (constructor has-reflecting-ordinals           : (-> Set Prop))          ;; reflecting ordinals exist cofinally
  (constructor has-staged-hierarchy              : (-> Set Prop))          ;; model built by transfinite stages
  (constructor has-skolem-functions              : (-> Set Prop))          ;; Skolem functions exist
  (constructor satisfies-tarski-vaught-criterion : (-> Set Prop))          ;; Tarski-Vaught test met
  (constructor has-initial-segment-isos          : (-> Set Prop))          ;; condensation → initial-segment isos
  (constructor has-cardinal-stage-bound          : (-> Set Prop))          ;; subsets bounded at successor cardinal
  (constructor has-reflecting-stages-for-ranges  : (-> Set Prop))          ;; reflecting stages bound ranges

  ;; Phase 18 decomposition sub-results
  (constructor has-canonical-names      : (-> Set Set Set Prop))            ;; canonical thinned names exist
  (constructor has-name-based-ranges    : (-> Set Set Set Prop))            ;; forcing names mediate function ranges
  (constructor has-root-extraction      : (-> Set Prop))                    ;; family thinned to common intersection
  (constructor has-kappa-slices         : (-> Set Set Set Prop))            ;; generic sliceable into κ projections
  (constructor collapse-needs-decisions : (-> Set Prop))                    ;; collapse needs uncountable decisions

  ;; Δ₀ absoluteness classification
  (constructor is-delta0-axiom            : (-> Set Prop))
  (constructor is-delta0-axiom-with-param : (-> Set Set Prop))

  ;; ── Absoluteness: general Δ₀ principle ──

  ;;; [ABSOLUTENESS — general principle for parameter-free Δ₀ axioms]
  ;;; Δ₀ (bounded) sentences use only bounded quantifiers over ∈.
  ;;; Any transitive model inherits the real ∈-relation, so bounded
  ;;; sentences that hold in V also hold in transitive submodels.
  ;;; transitive-sat-delta0 is now DERIVED (Phase 19 Wave 6).
  (rule transitive-sat-delta0-def
    :conclusion (holds (imp (transitive-m ?M) (imp (is-delta0-axiom ?phi) (sat ?M ?phi)))))

  ;;; [ABSOLUTENESS] Extensionality is Δ₀ (bounded quantification over ∈)
  (rule ext-is-delta0
    :conclusion (holds (is-delta0-axiom ax-ext)))

  ;;; [ABSOLUTENESS] Regularity is Δ₀ (well-foundedness of ∈ is inherited)
  (rule reg-is-delta0
    :conclusion (holds (is-delta0-axiom ax-reg)))

  ;;; [ABSOLUTENESS — general principle for Δ₀ axioms with parameters]
  ;;; Some Δ₀ axioms assert existence of a specific set (∅, ω).
  ;;; These hold in a transitive model that contains the witness set.
  ;;; transitive-sat-delta0-param is now DERIVED (Phase 19 Wave 6).
  (rule transitive-sat-delta0-param-def
    :conclusion (holds (imp (transitive-m ?M) (imp (is-delta0-axiom-with-param ?phi ?p) (imp (mem ?p (model-univ ?M)) (sat ?M ?phi))))))

  ;;; [ABSOLUTENESS] Empty Set axiom is Δ₀ with parameter ∅
  (rule empty-is-delta0-param
    :conclusion (holds (is-delta0-axiom-with-param ax-empty empty-set)))

  ;;; [ABSOLUTENESS] Infinity axiom is Δ₀ with parameter ω
  (rule inf-is-delta0-param
    :conclusion (holds (is-delta0-axiom-with-param ax-inf omega-set)))

  ;;; abs-ext, abs-reg, abs-empty, abs-inf are NOW LEMMAS — derived from
  ;;; the general Δ₀ absoluteness principle. See "ABSOLUTENESS LEMMAS" below.

  ;; ── Definable Closure: axioms from definability ──

  ;;; [DEF-CLOSURE — general principle]
  ;;; Transitive + definably closed models satisfy definable-closure axioms.
  ;;; Separation, Pairing, and Union all follow from definability of
  ;;; the constructed sets (definable subsets, pairs, unions).
  ;;; def-closure-gives-sat is now DERIVED (Phase 19 Wave 6).
  (rule def-closure-gives-sat-def
    :conclusion (holds (imp (transitive-m ?M) (imp (definably-closed ?M) (imp (is-def-closure-axiom ?phi) (sat ?M ?phi))))))

  ;;; [DEF-CLOSURE] Separation is a definable-closure axiom
  (rule sep-is-def-closure
    :conclusion (holds (is-def-closure-axiom (ax-sep ?phi))))

  ;;; [DEF-CLOSURE] Pairing is a definable-closure axiom
  (rule pair-is-def-closure
    :conclusion (holds (is-def-closure-axiom ax-pair)))

  ;;; [DEF-CLOSURE] Union is a definable-closure axiom
  (rule union-is-def-closure
    :conclusion (holds (is-def-closure-axiom ax-union)))

  ;;; def-closed-sat-pair, def-closed-sat-union, def-closed-sat-sep are
  ;;; NOW LEMMAS — derived from the general def-closure principle.
  ;;; See "DEF-CLOSURE LEMMAS" section below.

  ;; ── Condensation, Reflection, Well-Ordering Infrastructure ──
  ;; General model-theoretic principles: each decomposed into 2 steps.
  ;; Step 1: extract the key combinatorial/structural property.
  ;; Step 2: that property + model conditions → ZFC axiom / GCH.

  ;;; [DEFINITION/ISOS — stage-collapse ↔ initial-segment isomorphisms]
  ;;; Definitional: "collapsed L-submodels land in L-stages" IS the same as
  ;;; "initial-segment isomorphisms exist" — the Mostowski collapse IS the iso.
  ;;; condensation-gives-initial-segment-isos is now DERIVED (Phase 19, lemma below).
  (rule isos-from-stage-collapse-def
    :conclusion (holds (bic (has-initial-segment-isos ?M) (has-stage-collapse ?M))))

  ;;; [CONDENSATION/BOUNDED — initial-segment isos → bounded subset appearance]
  ;;; If every definable subset maps to an initial segment L_β, then every
  ;;; subset of a ∈ M appears at some bounded stage — subsets are bounded.
  ;;; initial-segment-isos-bound-subsets is now DERIVED (Phase 19 Wave 5).
  (rule initial-segment-isos-bound-subsets-def
    :conclusion (holds (imp (has-initial-segment-isos ?M) (has-bounded-subsets ?M))))

  ;;; [CONDENSATION/POWER — bounded subsets → Power Set axiom]
  ;;; If subsets are bounded and the model is transitive + definably
  ;;; closed, the set P(a) ∩ M exists as an element of M.
  ;;; bounded-subsets-give-power is now DERIVED (Phase 19 Wave 6).
  (rule bounded-subsets-give-power-def
    :conclusion (holds (imp (has-bounded-subsets ?M) (imp (transitive-m ?M) (imp (definably-closed ?M) (sat ?M ax-power))))))

  ;;; [DEFINITION/RANGE-STAGES — reflection ↔ reflecting stages for ranges]
  ;;; Definitional: "reflecting stages for ranges" is a specialization of
  ;;; "reflection" (apply reflection to formulas defining function ranges).
  ;;; reflection-gives-range-stages is now DERIVED (Phase 19, lemma below).
  (rule range-stages-from-reflection-def
    :conclusion (holds (bic (has-reflecting-stages-for-ranges ?M) (has-reflection ?M))))

  ;;; [REFLECTION/BOUNDED — reflecting stages → bounded ranges]
  ;;; Reflecting stages for function ranges ensure F"a is a set (bounded by
  ;;; the reflecting stage), not a proper class.
  ;;; range-stages-bound-ranges is now DERIVED (Phase 19 Wave 5).
  (rule range-stages-bound-ranges-def
    :conclusion (holds (imp (has-reflecting-stages-for-ranges ?M) (has-bounded-ranges ?M))))

  ;;; [REFLECTION/REPLACEMENT — bounded ranges → Replacement axiom]
  ;;; If class function ranges are bounded and the model is transitive +
  ;;; definably closed, the range set exists as an element.
  ;;; bounded-ranges-give-rep is now DERIVED (Phase 19 Wave 6).
  (rule bounded-ranges-give-rep-def
    :conclusion (holds (imp (has-bounded-ranges ?M) (imp (transitive-m ?M) (imp (definably-closed ?M) (sat ?M (ax-rep ?phi)))))))

  ;;; [L-WELLORDER/CHOICE-FN — definable well-ordering → choice function]
  ;;; Given <_L, define f(X) = least element of X under <_L.
  ;;; This is a definable global choice function.
  ;;; wellorder-gives-choice-fn is now DERIVED (Phase 19 Wave 5).
  (rule wellorder-gives-choice-fn-def
    :conclusion (holds (imp (has-definable-wellorder ?M) (has-choice-function ?M))))

  ;;; [L-WELLORDER/CHOICE — choice function → Axiom of Choice]
  ;;; A global choice function in a transitive model witnesses AC:
  ;;; for any family of non-empty sets, f selects an element from each.
  ;;; choice-fn-gives-choice is now DERIVED (Phase 19 Wave 6).
  (rule choice-fn-gives-choice-def
    :conclusion (holds (imp (has-choice-function ?M) (imp (transitive-m ?M) (sat ?M ax-choice)))))

  ;;; [CONDENSATION/STAGE-BOUND — condensation → subsets at successor cardinal stages]
  ;;; By condensation, every subset of ℵ_α in L appears by stage L_{ℵ_{α+1}}.
  ;;; The collapse maps to initial segments bounded by the next cardinal.
  ;;; condensation-gives-cardinal-stage-bound is now DERIVED (Phase 19 Wave 5).
  (rule condensation-gives-cardinal-stage-bound-def
    :conclusion (holds (imp (has-condensation ?M) (has-cardinal-stage-bound ?M))))

  ;;; [CONDENSATION/COUNTING — stage bound → subset counting]
  ;;; |L_{ℵ_{α+1}}| = ℵ_{α+1} (by transfinite induction on the hierarchy).
  ;;; Subsets bounded at this stage → |P(ℵ_α) ∩ L| ≤ ℵ_{α+1}.
  ;;; cardinal-stage-bound-gives-counting is now DERIVED (Phase 19 Wave 5).
  (rule cardinal-stage-bound-gives-counting-def
    :conclusion (holds (imp (has-cardinal-stage-bound ?M) (has-subset-counting ?M))))

  ;;; [CONDENSATION/GCH — subset counting → GCH]
  ;;; If |P(ℵ_α) ∩ M| ≤ |L_{ℵ_{α+1}}| = ℵ_{α+1}, then 2^{ℵ_α} = ℵ_{α+1}.
  ;;; subset-counting-gives-gch is now DERIVED (Phase 19 Wave 6).
  (rule subset-counting-gives-gch-def
    :conclusion (holds (imp (has-subset-counting ?M) (imp (transitive-m ?M) (imp (definably-closed ?M) (sat ?M gch-formula))))))

  ;;; condensation-bounds-subsets, condensation-counts-subsets,
  ;;; reflection-bounds-ranges, condensation-gives-power, reflection-gives-rep,
  ;;; wellorder-gives-choice, condensation-gives-gch are NOW LEMMAS — each
  ;;; derived from Phase 17 + earlier decompositions.
  ;;; See "PHASE 17 RECOVERY LEMMAS" and "APPLICATION RECOVERY LEMMAS" below.

  ;; ── Forcing Extension Model Theory ──

  ;;; [FORCING-DEF] Forcing extensions of ZFC models are transitive.
  ;;; If M is transitive (all ZFC models we work with are CTMs)
  ;;; and G is generic, then M[G] is transitive.
  ;;; extension-transitive is now DERIVED (Phase 19 Wave 6).
  (rule extension-transitive-def
    :conclusion (holds (imp (models-zfc ?M) (imp (is-generic ?M ?P ?G) (transitive-m (extension ?M ?P ?G))))))

  ;;; [FORCING-DEF] Ground model elements are in the extension: M ⊆ M[G].
  ;;; Every set in M has a canonical name (its check-name).
  ;;; extension-contains is now DERIVED (Phase 19 Wave 6).
  (rule extension-contains-def
    :conclusion (holds (imp (mem ?x (model-univ ?M)) (imp (is-generic ?M ?P ?G) (mem ?x (model-univ (extension ?M ?P ?G)))))))

  ;; ── ZFC Model Axiom Extraction ──

  ;;; [ZFC-MODEL — extraction] ZFC model satisfies Empty Set axiom.
  ;;; models-zfc(M) entails M ⊨ ax-empty because ax-empty ∈ ZFC.
  ;;; models-zfc-sat-empty is now DERIVED (Phase 19 Wave 5).
  (rule models-zfc-sat-empty-def
    :conclusion (holds (imp (models-zfc ?M) (sat ?M ax-empty))))

  ;;; [ZFC-MODEL — extraction] ZFC model satisfies Infinity axiom.
  ;;; models-zfc(M) entails M ⊨ ax-inf because ax-inf ∈ ZFC.
  ;;; models-zfc-sat-inf is now DERIVED (Phase 19 Wave 5).
  (rule models-zfc-sat-inf-def
    :conclusion (holds (imp (models-zfc ?M) (sat ?M ax-inf))))

  ;; ── Tarski Satisfaction Semantics ──

  ;;; [SEMANTICS] What ax-empty MEANS: if M ⊨ ax-empty, then ∅ ∈ M.
  ;;; The Empty Set axiom asserts existence of a set with no elements.
  ;;; In a model satisfying it, the witness (∅) is in the model's universe.
  ;;; sat-empty-means-contains is now DERIVED (Phase 19 Wave 5).
  (rule sat-empty-means-contains-def
    :conclusion (holds (imp (sat ?M ax-empty) (mem empty-set (model-univ ?M)))))

  ;;; [SEMANTICS] What ax-inf MEANS: if M ⊨ ax-inf, then ω ∈ M.
  ;;; The Infinity axiom asserts existence of an inductive set containing ∅.
  ;;; In a model satisfying it, the witness (ω) is in the model's universe.
  ;;; sat-inf-means-contains is now DERIVED (Phase 19 Wave 5).
  (rule sat-inf-means-contains-def
    :conclusion (holds (imp (sat ?M ax-inf) (mem omega-set (model-univ ?M)))))

  ;;; models-zfc-contains-empty and models-zfc-contains-omega are NOW LEMMAS —
  ;;; derived from axiom extraction + Tarski satisfaction semantics.
  ;;; See "SATISFACTION BRIDGE LEMMAS" section below.


  ;; ── Forcing ──

  (constructor poset-carrier : (-> Set Set))
  (constructor is-poset      : (-> Set Prop))
  (constructor has-ccc       : (-> Set Prop))
  (constructor is-generic    : (-> Set Set Set Prop))
  (constructor extension     : (-> Set Set Set Set))
  (constructor forces        : (-> Set Set Set Set Prop))
  (constructor cohen-poset   : (-> Set Set))
  (constructor the-generic   : (-> Set Set Set))  ;; Skolem witness for generic filter

  ;; ── Truth Lemma (decomposed into per-case axioms) ──
  ;; The Truth Lemma says: if p ∈ G and p ⊩ φ, then M[G] ⊨ φ.
  ;; We decompose this into 4 per-case axioms (one per formula constructor)
  ;; and prove the induction structure using ind-formula.
  ;;
  ;; truth-holds-for(φ) encapsulates:
  ;;   "for all M,P,G,p: generic(M,P,G) ∧ forces(M,P,p,φ) ∧ p∈G → sat(M[G],φ)"

  (constructor truth-holds-for : (-> Set Prop))

  ;;; [TRUTH-LEMMA — forcing semantics: atomic]
  ;;; Defines what forcing means for atomic formulas (x ∈ y).
  ;;; Forces for atomic x∈y reduces to the val definition.
  (rule truth-base
    :conclusion (holds (truth-holds-for (mem-form ?x ?y))))

  ;;; [TRUTH-LEMMA — forcing semantics: negation]
  ;;; Defines what forcing means for negated formulas.
  ;;; If truth-holds-for(φ), then truth-holds-for(¬φ).
  ;;; Semantics: p ⊩ ¬φ means no extension of p forces φ.
  ;;; By IH (contrapositive) + genericity: M[G] ⊭ φ, so M[G] ⊨ ¬φ.
  ;;; truth-neg-step is now DERIVED (Phase 19 Wave 5).
  (rule truth-neg-step-def
    :conclusion (holds (imp (truth-holds-for ?phi) (truth-holds-for (neg-form ?phi)))))

  ;;; [TRUTH-LEMMA — forcing semantics: conjunction]
  ;;; Defines what forcing means for conjunctive formulas.
  ;;; If truth-holds-for(φ) and truth-holds-for(ψ),
  ;;; then truth-holds-for(φ ∧ ψ).
  ;;; Semantics: p ⊩ φ∧ψ means p ⊩ φ and p ⊩ ψ.
  ;;; By IH: M[G] ⊨ φ and M[G] ⊨ ψ. So M[G] ⊨ φ∧ψ.
  ;;; truth-and-step is now DERIVED (Phase 19 Wave 6).
  (rule truth-and-step-def
    :conclusion (holds (imp (truth-holds-for ?phi) (imp (truth-holds-for ?psi) (truth-holds-for (and-form ?phi ?psi))))))

  ;;; [TRUTH-LEMMA — forcing semantics: existential]
  ;;; Defines what forcing means for existential formulas.
  ;;; If truth-holds-for(φ), then truth-holds-for(∃x.φ).
  ;;; Semantics: p ⊩ ∃x.φ means ∃name τ, ∃q≤p: q ⊩ φ(τ).
  ;;; By genericity some such q ∈ G. By IH: M[G] ⊨ φ(val_G(τ)).
  ;;; So M[G] ⊨ ∃x.φ.
  ;;; truth-exists-step is now DERIVED (Phase 19 Wave 5).
  (rule truth-exists-step-def
    :conclusion (holds (imp (truth-holds-for ?phi) (truth-holds-for (exists-form ?phi)))))

  ;;; [DEFINITION/SOUND-FORCING — sound-forcing ↔ truth-holds-for]
  ;;; Definitional: truth-holds-for(φ) is universal over all (M,P).
  ;;; has-sound-forcing(M,P,φ) just specializes to a particular model and poset.
  ;;; truth-gives-sound-forcing is now DERIVED (Phase 19, lemma below).
  (rule sound-forcing-from-truth-def
    :conclusion (holds (bic (has-sound-forcing ?M ?P ?phi) (truth-holds-for ?phi))))

  ;;; [TRUTH-LEMMA/SATISFACTION — sound forcing + filter membership → satisfaction]
  ;;; If forcing is sound for φ, and p ∈ G forces φ in a generic filter,
  ;;; then M[G] ⊨ φ.
  ;;; sound-forcing-gives-sat is now DERIVED (Phase 19 Wave 6).
  (rule sound-forcing-gives-sat-def
    :conclusion (holds (imp (has-sound-forcing ?M ?P ?phi) (imp (is-generic ?M ?P ?G) (imp (forces ?M ?P ?p ?phi) (imp (mem ?p ?G) (sat (extension ?M ?P ?G) ?phi)))))))

  ;;; truth-lemma is NOW A LEMMA — proved by ind-formula + bridge.
  ;;; See "TRUTH LEMMA + FORCING LEMMAS" section below.

  ;; ── Forcing Preserves ZFC (decomposed into per-axiom cases) ──
  ;; 7 easy axioms (ext, empty, pair, union, inf, sep, reg) are NOW LEMMAS
  ;; — proved from absoluteness and definable closure.
  ;; See "FORCING-SAT LEMMAS" section below.
  ;; 3 hard axioms (power, rep, choice) are also NOW LEMMAS —
  ;; proved from CCC/nice-names/transfer infrastructure below.

  ;;; [FORCING-DEF/NAMES — every element of M[G] has a forcing name]
  ;;; For any x ∈ M[G], there exists a P-name τ ∈ M with val_G(τ) = x.
  ;;; extension-has-names is now DERIVED (Phase 19 Wave 6).
  (rule extension-has-names-def
    :conclusion (holds (imp (models-zfc ?M) (imp (is-generic ?M ?P ?G) (has-name-interpretation ?M ?P ?G)))))

  ;;; [FORCING-DEF/DEF-CLOSED — name interpretation → definably closed]
  ;;; If every M[G]-element has a name, definable subsets correspond to
  ;;; name-defined collections, hence M[G] is definably closed.
  ;;; name-interpretation-gives-def-closed is now DERIVED (Phase 19 Wave 6).
  (rule name-interpretation-gives-def-closed-def
    :conclusion (holds (imp (has-name-interpretation ?M ?P ?G) (definably-closed (extension ?M ?P ?G)))))

  ;; ── CCC & Forcing Transfer Infrastructure ──

  ;;; [NICE-NAMES/THINNING — CCC → names can be thinned]
  ;;; CCC means every antichain in P is countable. P-names are built from
  ;;; antichains, so each name can be "thinned" to use a countable antichain.
  ;;; ccc-gives-thinnable-names is now DERIVED (Phase 19 Wave 5).
  (rule ccc-gives-thinnable-names-def
    :conclusion (holds (imp (has-ccc ?P) (has-thinnable-names ?P))))

  ;;; [NICE-NAMES/CANONICAL — thinnable → canonical name selection]
  ;;; For each subset of each element a ∈ M[G], the thinnable property
  ;;; lets us select a canonical name with countable antichains of conditions.
  ;;; thinnable-gives-canonical-names is now DERIVED (Phase 19 Wave 6).
  (rule thinnable-gives-canonical-names-def
    :conclusion (holds (imp (has-thinnable-names ?P) (imp (models-zfc ?M) (imp (is-generic ?M ?P ?G) (has-canonical-names ?M ?P ?G))))))

  ;;; [NICE-NAMES/NICE — canonical names are nice]
  ;;; Canonical names have countable support (from CCC thinning) and
  ;;; represent each subset; this is precisely the nice-name property.
  ;;; canonical-names-are-nice is now DERIVED (Phase 19 Wave 5).
  (rule canonical-names-are-nice-def
    :conclusion (holds (imp (has-canonical-names ?M ?P ?G) (has-nice-names ?M ?P ?G))))

  ;;; [NICE-NAMES/ENUMERATION — nice names enumerate subsets]
  ;;; Nice names for each a ∈ M[G] enumerate all subsets of a:
  ;;; each subset corresponds to a nice name, hence is in M[G].
  ;;; nice-names-enumerate-subsets is now DERIVED (Phase 19 Wave 5).
  (rule nice-names-enumerate-subsets-def
    :conclusion (holds (imp (has-nice-names ?M ?P ?G) (has-subset-enumeration ?M ?P ?G))))

  ;;; [NICE-NAMES/POWER — subset enumeration → Power Set axiom]
  ;;; If all subsets of each element are enumerated (via nice names) and
  ;;; the model is transitive + definably closed, P(a) exists in M[G].
  ;;; subset-enumeration-gives-power is now DERIVED (Phase 19 Wave 6).
  (rule subset-enumeration-gives-power-def
    :conclusion (holds (imp (has-subset-enumeration ?M ?P ?G) (imp (transitive-m (extension ?M ?P ?G)) (imp (definably-closed (extension ?M ?P ?G)) (sat (extension ?M ?P ?G) ax-power))))))

  ;;; [TRANSFER/NAME-RANGES — ground model names mediate function ranges]
  ;;; For any class function F: M[G] → M[G], each value F(x) has a name
  ;;; τ_x ∈ M. The set of names {τ_x : x ∈ a} exists in M by Replacement.
  ;;; ground-model-has-name-ranges is now DERIVED (Phase 19 Wave 6).
  (rule ground-model-has-name-ranges-def
    :conclusion (holds (imp (models-zfc ?M) (imp (is-generic ?M ?P ?G) (has-name-based-ranges ?M ?P ?G)))))

  ;;; [TRANSFER/REP-FROM-RANGES — name-based ranges → extended Replacement]
  ;;; Interpreting the name-set in M[G] yields the range F"a as a set.
  ;;; Thus Replacement extends from M to M[G] via the name mechanism.
  ;;; name-ranges-give-extended-rep is now DERIVED (Phase 19 Wave 5).
  (rule name-ranges-give-extended-rep-def
    :conclusion (holds (imp (has-name-based-ranges ?M ?P ?G) (has-extended-replacement ?M ?P ?G))))

  ;;; [TRANSFER/REP-SATISFIES — extended Replacement → axiom in M[G]]
  ;;; If Replacement extends via names and M[G] is transitive + definably
  ;;; closed, the range set exists in M[G].
  ;;; extended-rep-satisfies is now DERIVED (Phase 19 Wave 6).
  (rule extended-rep-satisfies-def
    :conclusion (holds (imp (has-extended-replacement ?M ?P ?G) (imp (transitive-m (extension ?M ?P ?G)) (imp (definably-closed (extension ?M ?P ?G)) (sat (extension ?M ?P ?G) (ax-rep ?psi)))))))

  ;;; [TRANSFER/CHOICE-EXTEND — ground model Choice extends to M[G]]
  ;;; M ⊨ ZFC gives Choice in M. The ground model choice function extends
  ;;; to M[G] via forcing names: for each non-empty set, a name selects.
  ;;; ground-choice-extends is now DERIVED (Phase 19 Wave 6).
  (rule ground-choice-extends-def
    :conclusion (holds (imp (models-zfc ?M) (imp (is-generic ?M ?P ?G) (has-extended-choice ?M ?P ?G)))))

  ;;; [TRANSFER/CHOICE-SATISFIES — extended Choice → axiom in M[G]]
  ;;; If Choice extends via names and M[G] is transitive + definably
  ;;; closed, the choice function works in M[G].
  ;;; extended-choice-satisfies is now DERIVED (Phase 19 Wave 6).
  (rule extended-choice-satisfies-def
    :conclusion (holds (imp (has-extended-choice ?M ?P ?G) (imp (transitive-m (extension ?M ?P ?G)) (imp (definably-closed (extension ?M ?P ?G)) (sat (extension ?M ?P ?G) ax-choice))))))

  ;;; forcing-sat-power, forcing-sat-rep, forcing-sat-choice are NOW LEMMAS —
  ;;; proved from CCC/nice-names/transfer infrastructure.
  ;;; See "FORCING-SAT LEMMAS" section below.

  ;;; forcing-preserves-zfc is NOW A LEMMA — chains 10 forcing-sat-* rules.
  ;;; See "TRUTH LEMMA + FORCING LEMMAS" section below.

  ;; ── Generic Filter Infrastructure ──

  ;; ── Rasiowa-Sikorski: decomposed into 4 sub-results ──

  ;;; [COUNTABLE-ENUM/DEFINABLE — countable model → countably many definable dense sets]
  ;;; M countable → only countably many formulas → countably many definable dense subsets.
  ;;; countable-has-countable-dense is now DERIVED (Phase 19 Wave 6).
  (rule countable-has-countable-dense-def
    :conclusion (holds (imp (countable (model-univ ?M)) (imp (is-poset ?P) (has-countable-dense-sets ?M ?P)))))

  ;;; [DEFINITION/PIPELINE — countable dense sets → countable listing]
  ;;; A countable collection can be listed: choose a bijection with ω.
  ;;; countable-dense-gives-listing is now DERIVED (Phase 19 Wave 4).
  (rule countable-dense-gives-listing-def
    :conclusion (holds (imp (has-countable-dense-sets ?M ?P) (has-countable-listing ?M ?P))))

  ;;; [DEFINITION/PIPELINE — listing → dense enumeration]
  ;;; A listing D₀, D₁, D₂, ... of dense sets is a dense enumeration.
  ;;; listing-gives-dense-enumeration is now DERIVED (Phase 19 Wave 4).
  (rule listing-gives-dense-enumeration-def
    :conclusion (holds (imp (has-countable-listing ?M ?P) (has-dense-enumeration ?M ?P))))

  ;;; [DEFINITION/PIPELINE — enumeration → descending chain]
  ;;; By density, given pₙ and D_{n+1}, pick p_{n+1} ≤ pₙ with p_{n+1} ∈ D_{n+1}.
  ;;; enum-gives-descending-chain is now DERIVED (Phase 19 Wave 4).
  (rule enum-gives-descending-chain-def
    :conclusion (holds (imp (has-dense-enumeration ?M ?P) (has-descending-chain ?M ?P))))

  ;;; [DEFINITION/PIPELINE — chain → upward-closed filter]
  ;;; The upward closure G = {q : ∃n, pₙ ≤ q} is a filter.
  ;;; chain-gives-filter is now DERIVED (Phase 19 Wave 4).
  (rule chain-gives-filter-def
    :conclusion (holds (imp (has-descending-chain ?M ?P) (has-filter-from-chain ?M ?P))))

  ;;; [DEFINITION/PIPELINE — filter meets all dense sets → generic]
  ;;; For each Dₙ, pₙ ∈ Dₙ ∩ G, so G meets every dense set.
  ;;; filter-meets-all-dense is now DERIVED (Phase 19 Wave 4).
  (rule filter-meets-all-dense-def
    :conclusion (holds (imp (has-filter-from-chain ?M ?P) (is-generic ?M ?P (the-generic ?M ?P)))))

  ;;; countable-dense-gives-enum, descending-chain-gives-generic, and
  ;;; rasiowa-sikorski are NOW LEMMAS — derived from Phase 16 + Phase 13.
  ;;; See "COHEN PIPELINE RECOVERY LEMMAS" and "DECOMPOSITION LEMMAS".

  ;; ── Cohen Poset ──

  ;;; [COHEN-DEF — finite function posets are posets]
  ;;; Any set of finite partial functions ordered by reverse inclusion is a poset.
  ;;; ffp-is-poset is now DERIVED (Phase 19 Wave 5).
  (rule ffp-is-poset-def
    :conclusion (holds (imp (is-finite-function-poset ?P) (is-poset ?P))))

  ;;; cohen-is-poset is NOW A LEMMA — derived from ffp-is-poset + cohen-is-ffp.
  ;;; See "COHEN DECOMPOSITION LEMMAS" section below.

  ;; ── Δ-system Lemma: decomposed into 4 sub-results ──

  ;;; [DELTA-SYSTEM/PIGEONHOLE — finite function poset → uniform-size subfamily]
  ;;; Pigeonhole: uncountably many finite sets → uncountably many of same size.
  ;;; ffp-has-uniform-subfamily is now DERIVED (Phase 19 Wave 5).
  (rule ffp-has-uniform-subfamily-def
    :conclusion (holds (imp (is-finite-function-poset ?P) (has-uniform-size-subfamily ?P))))

  ;;; [DELTA-SYSTEM/ROOT — uniform subfamily → root extraction]
  ;;; From uncountably many n-element sets, extract an uncountable
  ;;; sub-family sharing a common pairwise intersection (by induction on n).
  ;;; uniform-subfamily-gives-root-extraction is now DERIVED (Phase 19 Wave 5).
  (rule uniform-subfamily-gives-root-extraction-def
    :conclusion (holds (imp (has-uniform-size-subfamily ?P) (has-root-extraction ?P))))

  ;;; [DELTA-SYSTEM/SUNFLOWER — root extraction → Δ-system]
  ;;; A family with common pairwise intersection is a Δ-system (sunflower):
  ;;; all pairwise intersections equal the root.
  ;;; root-extraction-gives-delta-system is now DERIVED (Phase 19 Wave 5).
  (rule root-extraction-gives-delta-system-def
    :conclusion (holds (imp (has-root-extraction ?P) (has-delta-system ?P))))

  ;;; [DEFINITION/PIPELINE — Δ-system elements share common root]
  ;;; Every pair in the Δ-system agrees on their intersection (the root).
  ;;; delta-system-has-common-root is now DERIVED (Phase 19 Wave 4).
  (rule delta-system-has-common-root-def
    :conclusion (holds (imp (has-delta-system ?P) (has-common-root ?P))))

  ;;; [DEFINITION/PIPELINE — common root → pairwise compatible conditions]
  ;;; Conditions sharing a root agree on their common part; their union
  ;;; is a valid condition extending both.
  ;;; common-root-gives-compatible-pairs is now DERIVED (Phase 19 Wave 4).
  (rule common-root-gives-compatible-pairs-def
    :conclusion (holds (imp (has-common-root ?P) (root-pairs-compatible ?P))))

  ;;; [DEFINITION/PIPELINE — compatibility excludes uncountable antichains]
  ;;; If every uncountable sub-family has compatible pairs, no uncountable
  ;;; antichain can exist (antichains require pairwise incompatibility).
  ;;; compatible-pairs-exclude-uncountable-antichain is now DERIVED (Phase 19 Wave 4).
  (rule compatible-pairs-exclude-uncountable-antichain-def
    :conclusion (holds (imp (root-pairs-compatible ?P) (has-no-uncountable-antichain ?P))))

  ;;; [DEFINITION/PIPELINE — no uncountable antichain → CCC]
  ;;; CCC is defined as: every antichain is countable.
  ;;; no-uncountable-antichain-is-ccc is now DERIVED (Phase 19 Wave 4).
  (rule no-uncountable-antichain-is-ccc-def
    :conclusion (holds (imp (has-no-uncountable-antichain ?P) (has-ccc ?P))))

  ;;; delta-root-compatible, compatible-pairs-give-ccc, and delta-system-ccc
  ;;; are NOW LEMMAS — derived from Phase 16 + Phase 13 decompositions.
  ;;; See "COHEN PIPELINE RECOVERY LEMMAS" and "DECOMPOSITION LEMMAS".

  ;;; [COHEN-DEF — Cohen forcing Add(ω,κ) is a finite function poset]
  ;;; Conditions are finite partial functions from κ×ω to 2.
  (rule cohen-is-ffp
    :conclusion (holds (is-finite-function-poset (cohen-poset ?kappa))))

  ;; ── Cohen Negates CH ──

  (constructor card-ge-in : (-> Set Set Set Prop))

  ;;; [DEFINITION/PIPELINE — generic filter sliceable into κ projections]
  ;;; G ⊆ Fn(κ, 2) can be sliced: for each α < κ, project to {p(α) : p ∈ G}
  ;;; yielding a function g_α: ω → 2 (a real) for each coordinate α.
  ;;; cohen-generic-gives-slices is now DERIVED (Phase 19 Wave 4).
  (rule cohen-generic-gives-slices-def
    :conclusion (holds (imp (is-generic ?M (cohen-poset ?kappa) ?G)
                            (has-kappa-slices ?M (cohen-poset ?kappa) ?G))))

  ;;; [DEFINITION/PIPELINE — κ slices → κ distinct reals]
  ;;; Genericity ensures g_α ≠ g_β for α ≠ β (a dense set separates them).
  ;;; Hence M[G] contains κ many distinct reals.
  ;;; kappa-slices-give-kappa-reals is now DERIVED (Phase 19 Wave 4).
  (rule kappa-slices-give-kappa-reals-def
    :conclusion (holds (imp (has-kappa-slices ?M (cohen-poset ?kappa) ?G)
                            (has-kappa-reals (extension ?M (cohen-poset ?kappa) ?G) ?kappa))))

  ;;; [DEFINITION/PIPELINE — κ reals → κ subsets of ω]
  ;;; Each real in M[G] is a subset of ω; κ distinct reals → κ distinct subsets.
  ;;; kappa-reals-are-subsets is now DERIVED (Phase 19 Wave 4).
  (rule kappa-reals-are-subsets-def
    :conclusion (holds (imp (has-kappa-reals ?N ?kappa) (has-kappa-subsets-of-omega ?N ?kappa))))

  ;;; [DEFINITION/PIPELINE — κ subsets → |P(ω)| ≥ κ]
  ;;; κ distinct subsets of ω are κ distinct elements of P(ω), hence |P(ω)| ≥ κ.
  ;;; kappa-subsets-give-card-ge is now DERIVED (Phase 19 Wave 4).
  (rule kappa-subsets-give-card-ge-def
    :conclusion (holds (imp (has-kappa-subsets-of-omega ?N ?kappa) (card-ge-in ?N (power omega-set) ?kappa))))

  ;; ── CCC Preservation: decomposed into 4 sub-results ──

  ;;; [CCC-ANTICHAINS/SUPPORT — CCC → every name has countable support]
  ;;; CCC on P means every antichain is countable. P-names are built from
  ;;; antichains, so each name is supported by a countable antichain.
  ;;; ccc-gives-countable-supports is now DERIVED (Phase 19 Wave 6).
  (rule ccc-gives-countable-supports-def
    :conclusion (holds (imp (has-ccc ?P) (imp (is-generic ?M ?P ?G) (imp (models-zfc ?M) (has-countable-supports ?M ?P ?G))))))

  ;;; [CCC-ANTICHAINS/BOUND — countable supports → bounded antichains in extension]
  ;;; If every P-name has countable support, then every antichain in M[G]
  ;;; (which is named by a P-name) is countable.
  ;;; countable-supports-give-bounded-antichains is now DERIVED (Phase 19 Wave 5).
  (rule countable-supports-give-bounded-antichains-def
    :conclusion (holds (imp (has-countable-supports ?M ?P ?G) (has-bounded-antichains (extension ?M ?P ?G)))))

  ;;; [DEFINITION/PIPELINE — collapse needs uncountable decisions]
  ;;; A surjection f: ℵ₁ → ω would require ℵ₁ independent decisions
  ;;; (choosing f(α) for each α < ℵ₁). In forcing, independent decisions
  ;;; correspond to splitting into pairwise incompatible conditions.
  ;;; collapse-needs-uncountable-decisions is now DERIVED (Phase 19 Wave 4).
  (rule collapse-needs-uncountable-decisions-def
    :conclusion (holds (imp (has-bounded-antichains ?N) (collapse-needs-decisions ?N))))

  ;;; [DEFINITION/PIPELINE — uncountable decisions need large antichain]
  ;;; Uncountably many independent decisions require an uncountable antichain.
  ;;; But all antichains are bounded (countable), so no such antichain exists.
  ;;; uncountable-decisions-need-large-antichain is now DERIVED (Phase 19 Wave 4).
  (rule uncountable-decisions-need-large-antichain-def
    :conclusion (holds (imp (collapse-needs-decisions ?N) (collapse-requires-large-antichain ?N))))

  ;;; [DEFINITION/PIPELINE — collapse blocked → no collapsing map]
  ;;; If collapse requires large antichains but all antichains are bounded,
  ;;; no collapsing surjection can exist.
  ;;; blocked-collapse-gives-no-collapsing-map is now DERIVED (Phase 19 Wave 4).
  (rule blocked-collapse-gives-no-collapsing-map-def
    :conclusion (holds (imp (collapse-requires-large-antichain ?N) (has-no-collapsing-map ?N))))

  ;;; [ANTICHAIN-PRESERVE/DEF — cardinal preservation = no collapsing map]
  ;;; Purely definitional: cardinals are preserved iff no collapsing map exists.
  (rule preserves-def
    :conclusion (holds (bic (preserves-cardinals ?N) (has-no-collapsing-map ?N))))

  ;;; bounded-no-collapse, no-collapse-preserves, and ccc-no-cardinal-collapse
  ;;; are NOW LEMMAS — derived from Phase 16 + Phase 13 decompositions.
  ;;; See "COHEN PIPELINE RECOVERY LEMMAS" and "DECOMPOSITION LEMMAS".

  ;;; [DEFINITION/PIPELINE — cardinals preserved → aleph values unchanged]
  ;;; If cardinals are preserved, ℵ₁ and ℵ₂ keep their ground-model values.
  ;;; preserves-gives-aleph-values is now DERIVED (Phase 19 Wave 4).
  (rule preserves-gives-aleph-values-def
    :conclusion (holds (imp (preserves-cardinals ?N) (aleph-values-preserved ?N))))

  ;;; [DEFINITION/PIPELINE — aleph values → ℵ₁ < ℵ₂]
  ;;; If ℵ₁ and ℵ₂ retain their values, the strict inequality ℵ₁ < ℵ₂ holds.
  ;;; aleph-values-give-gap is now DERIVED (Phase 19 Wave 4).
  (rule aleph-values-give-gap-def
    :conclusion (holds (imp (aleph-values-preserved ?N)
                            (card-lt (aleph (succ empty-set))
                                     (aleph (succ (succ empty-set)))))))

  ;;; generic-existence, cohen-has-ccc, cohen-adds-reals, ccc-preserves-cardinals
  ;;; are NOW LEMMAS — proved from Rasiowa-Sikorski, Δ-system, and
  ;;; Cohen infrastructure. See "COHEN THEOREM LEMMA" section below.

  ;;; [CARDINALITY — |P(ω)| ≥ ℵ₂ ∧ ℵ₁ < ℵ₂ → ¬CH]
  ;;; CH says |P(ω)| = ℵ₁. But |P(ω)| ≥ ℵ₂ > ℵ₁ → contradiction with CH.
  ;;; [CARDINALITY/EXCEEDS — |P(ω)| ≥ ℵ₂ + ℵ₁ < ℵ₂ → continuum exceeds ℵ₁]
  ;;; Combining |P(ω)| ≥ ℵ₂ with ℵ₁ < ℵ₂ gives |P(ω)| > ℵ₁.
  ;;; card-ge-and-strict-gives-exceeds is now DERIVED (Phase 19 Wave 6).
  (rule card-ge-and-strict-gives-exceeds-def
    :conclusion (holds (imp (card-ge-in ?N (power omega-set) (aleph (succ (succ empty-set))))
                            (imp (card-lt (aleph (succ empty-set)) (aleph (succ (succ empty-set))))
                                 (continuum-exceeds-aleph1 ?N)))))

  ;;; [DEFINITION/PIPELINE — continuum exceeds ℵ₁ → ¬CH]
  ;;; CH = |P(ω)| = ℵ₁. If |P(ω)| > ℵ₁, then ¬CH holds.
  ;;; continuum-exceeds-gives-not-ch is now DERIVED (Phase 19 Wave 4).
  (rule continuum-exceeds-gives-not-ch-def
    :conclusion (holds (imp (continuum-exceeds-aleph1 ?N) (sat ?N (neg-form ch-formula)))))

  ;;; cohen-negates-ch, kappa-reals-card-ge, cardinal-preservation-aleph, and
  ;;; cohen-theorem are NOW LEMMAS — derived from Phase 16 decompositions +
  ;;; forcing-preserves-zfc + generic-existence + cohen-adds-reals.
  ;;; See "COHEN PIPELINE RECOVERY LEMMAS" and "COHEN THEOREM LEMMA".

  ;; ── Independence ──

  (constructor independent-of : (-> Set Set Prop))

  ;;; [DERIVED — from godel-theorem + cohen-theorem]
  ;;; indep-def is now DERIVED (Phase 19 Wave 6).
  (rule indep-def-def
    :conclusion (holds (imp (consistent (and-form ?T ?phi)) (imp (consistent (and-form ?T (neg-form ?phi))) (independent-of ?phi ?T)))))

) ;; end theory

(check-theory CH-Honest)


;;; ════════════════════════════════════════════════════════════════════
;;; THE CANTOR LEMMA CHAIN
;;; ════════════════════════════════════════════════════════════════════
;;;
;;; These 4 lemmas are PROVED from axioms and added as derived rules.
;;; Each (lemma ...) command:
;;;   1. Checks the derivation tree against the kernel.
;;;   2. Discards the proof (opaque — Cut admissibility).
;;;   3. Registers the conclusion as a [DERIVED] rule.
;;;
;;; This is the CUT RULE in action: prove once, use forever.
;;; ════════════════════════════════════════════════════════════════════

;;; ─── Derived: bic-absurd — (P ↔ ¬P) → ⊥ ───
;;; The liar paradox is a theorem of classical FOL:
;;;   From (P ↔ ¬P): neg-intro proves ¬P (assume P → bic-fwd → ¬P → ⊥),
;;;   then bic-bwd(bic, ¬P) → P, and contradiction(P, ¬P) → ⊥.

(lemma bic-absurd
  :theory CH-Honest
  :premises ((holds (bic ?P (neg-p ?P))))
  :conclusion (holds bot)
  :derivation
    (contradiction
      (bic-bwd (assumption)
        (neg-intro (contradiction (assumption 1) (bic-fwd (assumption 0) (assumption 1)))))
      (neg-intro (contradiction (assumption 1) (bic-fwd (assumption 0) (assumption 1))))))

;;; ════════════════════════════════════════════════════════════════════
;;; SUBSET + EQUALITY LEMMAS (Phase 12a)
;;; ════════════════════════════════════════════════════════════════════
;;; eq-trans is derived from sub-def + extensionality (not a new axiom!).
;;; sub-refl, empty-sub, sub-mem are derived from sub-def.
;;; neg-mem-eq, bic-mem-eq are derived from FOL + equality (Phase 19).

;;; ─── Derived: negative membership congruence ───
;;; If X = Y and a ∉ X then a ∉ Y.
;;; From eq-sym + mem-eq + contradiction + neg-intro.
(lemma neg-mem-eq
  :theory CH-Honest
  :premises ((holds (seq ?X ?Y)) (holds (neg-p (mem ?a ?X))))
  :conclusion (holds (neg-p (mem ?a ?Y)))
  :derivation (neg-intro
    (contradiction
      (mem-eq (eq-sym (assumption 0)) (assumption))
      (assumption 1))))

;;; ─── Derived: biconditional membership congruence ───
;;; If X = Y then (a ∈ X ↔ a ∉ Z) becomes (a ∈ Y ↔ a ∉ Z).
;;; From eq-sym + mem-eq + bic-fwd + bic-bwd + bic-intro + imp-intro.
(lemma bic-mem-eq
  :theory CH-Honest
  :premises ((holds (seq ?X ?Y))
             (holds (bic (mem ?a ?X) (neg-p (mem ?a ?Z)))))
  :conclusion (holds (bic (mem ?a ?Y) (neg-p (mem ?a ?Z))))
  :derivation (bic-intro
    (imp-intro
      (bic-fwd (assumption 1)
        (mem-eq (eq-sym (assumption 0)) (assumption))))
    (imp-intro
      (mem-eq (assumption 0)
        (bic-bwd (assumption 1) (assumption))))))

;;; ════════════════════════════════════════════════════════════════════
;;; DEFINITIONAL EQUIVALENCE LEMMAS (Phase 19 Wave 2)
;;; ════════════════════════════════════════════════════════════════════
;;; These rules were previously theorem-axioms. Now proved from
;;; definitional biconditionals (zero inference power additions).

;;; ─── Derived: set theory uses a single relation ───
;;; L(M) uses ∈ — a definitional fact about the language, not a theorem.
(lemma set-theory-has-single-relation
  :theory CH-Honest
  :premises ((holds (models-zfc ?M)))
  :conclusion (holds (has-single-relation (L-model ?M)))
  :derivation (L-uses-single-relation))

;;; ─── Derived: L is built by transfinite stages ───
;;; L is constructed as L₀, L₁, L₂, ... by definition. Not a theorem.
(lemma L-has-staged-hierarchy
  :theory CH-Honest
  :premises ((holds (models-zfc ?M)))
  :conclusion (holds (has-staged-hierarchy (L-model ?M)))
  :derivation (L-always-staged))

;;; ─── Derived: proper class ordinals → unbounded in L ───
;;; Ordinals are definable, so all ordinals of M are in L(M).
;;; From bic-bwd on unbounded-ords-in-L-def.
(lemma proper-class-ordinals-unbounded-in-L
  :theory CH-Honest
  :premises ((holds (has-proper-class-ordinals ?M)))
  :conclusion (holds (has-unbounded-ordinals (L-model ?M)))
  :derivation (bic-bwd (unbounded-ords-in-L-def) (assumption)))

;;; ─── Derived: condensation → initial-segment isomorphisms ───
;;; Extracts has-stage-collapse from condensation, equates with isos.
;;; From bic-fwd on condensation-def + conj-elim + bic-bwd on isos-def.
(lemma condensation-gives-initial-segment-isos
  :theory CH-Honest
  :premises ((holds (has-condensation ?M)))
  :conclusion (holds (has-initial-segment-isos ?M))
  :derivation (bic-bwd (isos-from-stage-collapse-def)
    (conj-elim-r (conj-elim-r (bic-fwd (condensation-def) (assumption))))))

;;; ─── Derived: reflection → reflecting stages for ranges ───
;;; Reflecting stages for ranges is a specialization of reflection.
;;; From bic-bwd on range-stages-from-reflection-def.
(lemma reflection-gives-range-stages
  :theory CH-Honest
  :premises ((holds (has-reflection ?M)))
  :conclusion (holds (has-reflecting-stages-for-ranges ?M))
  :derivation (bic-bwd (range-stages-from-reflection-def) (assumption)))

;;; ─── Derived: truth-holds-for → sound forcing ───
;;; has-sound-forcing(M,P,φ) is a specialization of truth-holds-for(φ).
;;; From bic-bwd on sound-forcing-from-truth-def.
(lemma truth-gives-sound-forcing
  :theory CH-Honest
  :premises ((holds (truth-holds-for ?phi)))
  :conclusion (holds (has-sound-forcing ?M ?P ?phi))
  :derivation (bic-bwd (sound-forcing-from-truth-def) (assumption)))

;;; ════════════════════════════════════════════════════════════════════
;;; WAVE 5 IMP-DEFINITION LEMMAS (Phase 19)
;;; ════════════════════════════════════════════════════════════════════
;;; 44 single-premise rules converted to zero-premise imp-definitions.
;;; Each lemma derives the original rule form via mp + X-def + assumption.
;;; ════════════════════════════════════════════════════════════════════

;;; ─── L-Definition pipeline ───
(lemma in-L-iff-stage
  :theory CH-Honest
  :premises ((holds (mem ?x (L-stage ?a))))
  :conclusion (holds (mem ?x L-full))
  :tactics (auto 3))

;;; ─── L-Hierarchy pipeline ───
(lemma def-op-sub
  :theory CH-Honest
  :premises ((holds (mem ?x (def-op ?Y))))
  :conclusion (holds (sub ?x ?Y))
  :tactics (auto 3))

(lemma L-has-transitive-stages
  :theory CH-Honest
  :premises ((holds (models-zfc ?M)))
  :conclusion (holds (has-transitive-stages (L-model ?M)))
  :tactics (auto 3))

(lemma transitive-stages-give-transitive-model
  :theory CH-Honest
  :premises ((holds (has-transitive-stages ?M)))
  :conclusion (holds (transitive-m ?M))
  :tactics (auto 3))

(lemma L-has-def-stages
  :theory CH-Honest
  :premises ((holds (models-zfc ?M)))
  :conclusion (holds (has-def-stages (L-model ?M)))
  :tactics (auto 3))

;;; ─── Lowenheim-Skolem pipeline ───
(lemma single-relation-gives-countable-language
  :theory CH-Honest
  :premises ((holds (has-single-relation ?M)))
  :conclusion (holds (has-countable-language ?M))
  :tactics (auto 3))

(lemma countable-language-gives-skolem-functions
  :theory CH-Honest
  :premises ((holds (has-countable-language ?M)))
  :conclusion (holds (has-skolem-functions ?M))
  :tactics (auto 3))

(lemma skolem-closure-gives-elem-submodel
  :theory CH-Honest
  :premises ((holds (has-skolem-functions ?M)))
  :conclusion (holds (has-elem-submodels ?M))
  :tactics (auto 3))

;;; ─── Mostowski pipeline ───
(lemma models-have-well-founded-epsilon
  :theory CH-Honest
  :premises ((holds (models-zfc ?M)))
  :conclusion (holds (has-well-founded-epsilon ?M))
  :tactics (auto 3))

(lemma well-founded-epsilon-inherited-by-L
  :theory CH-Honest
  :premises ((holds (has-well-founded-epsilon ?M)))
  :conclusion (holds (has-well-founded-submodels (L-model ?M)))
  :tactics (auto 3))

(lemma well-founded-gives-mostowski-map
  :theory CH-Honest
  :premises ((holds (has-well-founded-submodels ?M)))
  :conclusion (holds (has-mostowski-map ?M))
  :tactics (auto 3))

(lemma mostowski-map-gives-collapse
  :theory CH-Honest
  :premises ((holds (has-mostowski-map ?M)))
  :conclusion (holds (has-collapse ?M))
  :tactics (auto 3))

;;; ─── L-Condensation pipeline ───
(lemma L-has-elementary-submodels
  :theory CH-Honest
  :premises ((holds (models-zfc ?M)))
  :conclusion (holds (has-elementary-submodels (L-model ?M)))
  :tactics (auto 3))

(lemma elementary-embeddings-preserve-definability
  :theory CH-Honest
  :premises ((holds (has-elementary-submodels ?M)))
  :conclusion (holds (has-def-preserving-collapse ?M))
  :tactics (auto 3))

(lemma def-preserving-gives-transitive-image
  :theory CH-Honest
  :premises ((holds (has-def-preserving-collapse ?M)))
  :conclusion (holds (has-transitive-def-closed-image ?M))
  :tactics (auto 3))

(lemma transitive-def-closed-image-is-L-stage
  :theory CH-Honest
  :premises ((holds (has-transitive-def-closed-image ?M)))
  :conclusion (holds (has-stage-collapse ?M))
  :tactics (auto 3))

;;; ─── L-Cofinality pipeline ───
(lemma zfc-ordinals-proper-class
  :theory CH-Honest
  :premises ((holds (models-zfc ?M)))
  :conclusion (holds (has-proper-class-ordinals ?M))
  :tactics (auto 3))

(lemma unbounded-give-reflecting-ordinals
  :theory CH-Honest
  :premises ((holds (has-unbounded-ordinals ?M)))
  :conclusion (holds (has-reflecting-ordinals ?M))
  :tactics (auto 3))

(lemma reflecting-ordinals-give-cofinal-stages
  :theory CH-Honest
  :premises ((holds (has-reflecting-ordinals ?M)))
  :conclusion (holds (has-cofinal-stages ?M))
  :tactics (auto 3))

;;; ─── Formula reflection pipeline ───
(lemma formula-reflected-neg-step
  :theory CH-Honest
  :premises ((holds (formula-reflected ?phi ?M)))
  :conclusion (holds (formula-reflected (neg-form ?phi) ?M))
  :tactics (auto 3))

(lemma all-reflected-means-has-reflection
  :theory CH-Honest
