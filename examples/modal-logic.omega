;;; Modal Logic S5 — Necessity and Possibility
;;;
;;; The modal operators box (necessarily) and dia (possibly)
;;; with the S5 axioms: K, T, and 5.
;;;
;;; Proved here:
;;;   1. box(A->B) -> (box A -> box B)   (K as a theorem)
;;;   2. box A /\ box B -> box(A /\ B)   (box distributes in)
;;;   3. box(A /\ B) -> box A /\ box B   (box distributes out)
;;;   4. box A -> box(box A)              (positive introspection)
;;;   5. box A -> dia A                   (necessary implies possible)
;;;   6. dia A -> box(dia A)              (S5: possible is necessarily so)

(theory ModalS5
  (sort Prop)

  ;; ── Propositional connectives ──
  (constructor true  : Prop)
  (constructor false : Prop)
  (constructor and   : (-> Prop Prop Prop))
  (constructor or    : (-> Prop Prop Prop))
  (constructor imp   : (-> Prop Prop Prop))
  (constructor not   : (-> Prop Prop))

  ;; ── Modal operators ──
  (constructor box   : (-> Prop Prop))    ;; necessarily
  (constructor dia   : (-> Prop Prop))    ;; possibly

  ;; ── Judgment ──
  (judgment (proves ?P) :where P : Prop)

  ;; ── Propositional logic ──
  (rule and-intro
    :premises ((proves ?A) (proves ?B))
    :conclusion (proves (and ?A ?B)))

  (rule and-elim-l
    :premises ((proves (and ?A ?B)))
    :conclusion (proves ?A))

  (rule and-elim-r
    :premises ((proves (and ?A ?B)))
    :conclusion (proves ?B))

  (rule imp-intro
    :premises ((proves ?B))
    :context ((0 (proves ?A)))
    :conclusion (proves (imp ?A ?B)))

  (rule imp-elim
    :premises ((proves (imp ?A ?B)) (proves ?A))
    :conclusion (proves ?B))

  ;; ── Modal axioms ──

  ;; Axiom K: box(A -> B) -> (box A -> box B)
  (rule axiom-K
    :premises ((proves (box (imp ?A ?B))) (proves (box ?A)))
    :conclusion (proves (box ?B)))

  ;; Axiom T: box A -> A   (what is necessary is actual)
  (rule axiom-T
    :premises ((proves (box ?A)))
    :conclusion (proves ?A))

  ;; Axiom 5: dia A -> box(dia A)   (what is possible is necessarily possible)
  (rule axiom-5
    :premises ((proves (dia ?A)))
    :conclusion (proves (box (dia ?A))))

  ;; Necessitation: if A is provable, then box A
  (rule necessitation
    :premises ((proves ?A))
    :conclusion (proves (box ?A)))

  ;; Diamond introduction: A -> dia A
  (rule dia-intro
    :premises ((proves ?A))
    :conclusion (proves (dia ?A))))

(check-theory ModalS5)


;; ════════════════════════════════════════════════════════════
;; Theorem 1:  box(A -> B) -> (box A -> box B)   (K as theorem)
;; ════════════════════════════════════════════════════════════
;;
;; Assume box(A->B).  Assume box A.  Apply axiom-K.

(proof K-theorem
  :theory ModalS5
  :goal (proves (imp (box (imp ?A ?B)) (imp (box ?A) (box ?B))))
  :derivation
    (imp-intro (imp-intro (axiom-K (assumption) (assumption)))))


;; ════════════════════════════════════════════════════════════
;; Theorem 2:  box A /\ box B -> box(A /\ B)   (box distributes in)
;; ════════════════════════════════════════════════════════════
;;
;; From box A and box B, extract A and B by axiom-T,
;; form A /\ B, then necessitate.

(proof box-and
  :theory ModalS5
  :goal (proves (imp (and (box ?A) (box ?B)) (box (and ?A ?B))))
  :derivation
    (imp-intro
      (necessitation
        (and-intro
          (axiom-T (and-elim-l (assumption)))
          (axiom-T (and-elim-r (assumption)))))))


;; ════════════════════════════════════════════════════════════
;; Theorem 3:  box(A /\ B) -> box A /\ box B   (box distributes out)
;; ════════════════════════════════════════════════════════════
;;
;; For box A:  prove box(A/\B -> A) by necessitating a tautology,
;;             then apply axiom-K with box(A/\B).
;; Similarly for box B.

(proof box-dist
  :theory ModalS5
  :goal (proves (imp (box (and ?A ?B)) (and (box ?A) (box ?B))))
  :derivation
    (imp-intro
      (and-intro
        (axiom-K (necessitation (imp-intro (and-elim-l (assumption)))) (assumption))
        (axiom-K (necessitation (imp-intro (and-elim-r (assumption)))) (assumption)))))


;; ════════════════════════════════════════════════════════════
;; Theorem 4:  box A -> box(box A)   (positive introspection)
;; ════════════════════════════════════════════════════════════

(proof box-box
  :theory ModalS5
  :goal (proves (imp (box ?A) (box (box ?A))))
  :derivation (imp-intro (necessitation (assumption))))


;; ════════════════════════════════════════════════════════════
;; Theorem 5:  box A -> dia A   (necessary implies possible)
;; ════════════════════════════════════════════════════════════

(proof necessary-possible
  :theory ModalS5
  :goal (proves (imp (box ?A) (dia ?A)))
  :derivation (imp-intro (dia-intro (axiom-T (assumption)))))


;; ════════════════════════════════════════════════════════════
;; Theorem 6:  dia A -> box(dia A)   (S5 characteristic axiom)
;; ════════════════════════════════════════════════════════════
;;
;; What is possible is necessarily possible — a hallmark of S5.

(proof possible-necessarily-possible
  :theory ModalS5
  :goal (proves (imp (dia ?A) (box (dia ?A))))
  :derivation (imp-intro (axiom-5 (assumption))))
