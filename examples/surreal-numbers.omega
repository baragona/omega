;;; Surreal Numbers — Games and Numbers
;;;
;;; Conway's Surreal Numbers encompass all real numbers and all infinite
;;; ordinals in a single structure defined by games: { L | R } where
;;; no member of L is ≥ any member of R.
;;;
;;; Key insight: the surreals form a Field — you can divide by infinity!
;;; 1/ω (the infinitesimal ε) is a valid, distinct number satisfying
;;; 0 < ε < 1/2 < 1 < ω < ω+1.
;;;
;;; Proved here:
;;;   1. 0 + 0 = 0                               (additive identity)
;;;   2. -0 = 0                                   (negation of zero)
;;;   3. -(-ω) = ω                                (double negation)
;;;   4. 1 · ω = ω                                (multiplicative identity)
;;;   5. ω · 0 = 0                                (annihilation)
;;;   6. 0 ≤ 1                                    (ordering)
;;;   7. 0 < ε                                    (infinitesimal is positive)
;;;   8. ε < ½                                    (smaller than any positive finite)
;;;   9. ω < ω + 1                                (transfinite successor)
;;;  10. (0 < ε) ∧ (ω < ω + 1)                   (the infinite AND the infinitesimal)

(theory SurrealNumbers
  (sort Sur)
  (sort Formula)

  ;; ── Core surreal constants ──
  ;; { | } = 0, { 0 | } = 1, { | 0 } = -1
  ;; { 0 | 1 } = 1/2, { 0 | 0 } = * (fuzzy/star game)
  ;; { 1, 2, 3, ... | } = ω, { 0 | 1, 1/2, 1/4, ... } = ε
  (constructor zero-s  : Sur)
  (constructor one-s   : Sur)
  (constructor neg-one : Sur)
  (constructor half-s  : Sur)
  (constructor star    : Sur)
  (constructor omega-s : Sur)
  (constructor eps-s   : Sur)

  ;; ── Arithmetic operations ──
  (constructor neg   : (-> Sur Sur))
  (constructor add-s : (-> Sur Sur Sur))
  (constructor mul-s : (-> Sur Sur Sur))

  ;; ── Formula constructors ──
  (constructor sur-eq  : (-> Sur Sur Formula))
  (constructor sur-leq : (-> Sur Sur Formula))
  (constructor sur-lt  : (-> Sur Sur Formula))
  (constructor and-f   : (-> Formula Formula Formula))
  (constructor or-f    : (-> Formula Formula Formula))
  (constructor imp-f   : (-> Formula Formula Formula))

  ;; ── Negation rewrites ──
  (rewrite neg-zero (neg zero-s) zero-s)
  (rewrite neg-neg  (neg (neg ?x)) ?x)

  ;; ── Addition rewrites ──
  (rewrite add-zero-l (add-s zero-s ?x) ?x)
  (rewrite add-zero-r (add-s ?x zero-s) ?x)

  ;; ── Multiplication rewrites ──
  (rewrite mul-zero-l (mul-s zero-s ?x) zero-s)
  (rewrite mul-zero-r (mul-s ?x zero-s) zero-s)
  (rewrite mul-one-l  (mul-s one-s ?x) ?x)
  (rewrite mul-one-r  (mul-s ?x one-s) ?x)

  ;; ── Judgment ──
  (judgment (holds ?P) :where P : Formula)

  ;; ── Equational reasoning ──
  (rule eq-refl
    :premises ()
    :conclusion (holds (sur-eq ?a ?a)))

  (rule eq-symm
    :premises ((holds (sur-eq ?a ?b)))
    :conclusion (holds (sur-eq ?b ?a)))

  (rule eq-trans
    :premises ((holds (sur-eq ?a ?b)) (holds (sur-eq ?b ?c)))
    :conclusion (holds (sur-eq ?a ?c))
    :implicit (?b))

  ;; ── Congruence ──
  (rule eq-neg-cong
    :premises ((holds (sur-eq ?a ?b)))
    :conclusion (holds (sur-eq (neg ?a) (neg ?b))))

  (rule eq-add-cong
    :premises ((holds (sur-eq ?a1 ?a2)) (holds (sur-eq ?b1 ?b2)))
    :conclusion (holds (sur-eq (add-s ?a1 ?b1) (add-s ?a2 ?b2))))

  ;; ── Ordering axioms ──
  (rule leq-refl
    :premises ()
    :conclusion (holds (sur-leq ?a ?a)))

  (rule leq-zero-one
    :premises ()
    :conclusion (holds (sur-leq zero-s one-s)))

  (rule leq-negone-zero
    :premises ()
    :conclusion (holds (sur-leq neg-one zero-s)))

  ;; ── Strict ordering ──
  ;; The infinitesimal ε: smaller than any positive finite number
  (rule eps-positive
    :premises ()
    :conclusion (holds (sur-lt zero-s eps-s)))

  (rule eps-lt-half
    :premises ()
    :conclusion (holds (sur-lt eps-s half-s)))

  (rule eps-lt-one
    :premises ()
    :conclusion (holds (sur-lt eps-s one-s)))

  ;; Transfinite: ω + 1 > ω (unlike standard ordinals where 1+ω = ω)
  (rule omega-lt-suc
    :premises ()
    :conclusion (holds (sur-lt omega-s (add-s omega-s one-s))))

  ;; ── Propositional ──
  (rule and-intro
    :premises ((holds ?A) (holds ?B))
    :conclusion (holds (and-f ?A ?B)))

  (rule imp-intro
    :premises ((holds ?B))
    :context ((0 (holds ?A)))
    :conclusion (holds (imp-f ?A ?B))))

(check-theory SurrealNumbers)


;;; ═══════════════════════════════════════════════════════════
;;; Proof 1: 0 + 0 = 0 (additive identity)
;;; ═══════════════════════════════════════════════════════════

(proof zero-plus-zero
  :theory SurrealNumbers
  :goal (holds (sur-eq (add-s zero-s zero-s) zero-s))
  :derivation (eq-refl))


;;; ═══════════════════════════════════════════════════════════
;;; Proof 2: -0 = 0 (negation of zero)
;;; ═══════════════════════════════════════════════════════════

(proof neg-zero-is-zero
  :theory SurrealNumbers
  :goal (holds (sur-eq (neg zero-s) zero-s))
  :derivation (eq-refl))


;;; ═══════════════════════════════════════════════════════════
;;; Proof 3: -(-ω) = ω (double negation / involution)
;;; ═══════════════════════════════════════════════════════════

(proof double-negation
  :theory SurrealNumbers
  :goal (holds (sur-eq (neg (neg omega-s)) omega-s))
  :derivation (eq-refl))


;;; ═══════════════════════════════════════════════════════════
;;; Proof 4: 1 · ω = ω (multiplicative identity)
;;; ═══════════════════════════════════════════════════════════

(proof mul-one-identity
  :theory SurrealNumbers
  :goal (holds (sur-eq (mul-s one-s omega-s) omega-s))
  :derivation (eq-refl))


;;; ═══════════════════════════════════════════════════════════
;;; Proof 5: ω · 0 = 0 (multiplication by zero)
;;; ═══════════════════════════════════════════════════════════

(proof mul-zero-annihilates
  :theory SurrealNumbers
  :goal (holds (sur-eq (mul-s omega-s zero-s) zero-s))
  :derivation (eq-refl))


;;; ═══════════════════════════════════════════════════════════
;;; Proof 6: 0 ≤ 1 (ordering)
;;; ═══════════════════════════════════════════════════════════

(proof zero-leq-one
  :theory SurrealNumbers
  :goal (holds (sur-leq zero-s one-s))
  :derivation (leq-zero-one))


;;; ═══════════════════════════════════════════════════════════
;;; Proof 7: 0 < ε (the infinitesimal is positive!)
;;; ═══════════════════════════════════════════════════════════
;;; ε = { 0 | 1, 1/2, 1/4, ... } — smaller than every positive
;;; real number, but strictly greater than zero. This is the
;;; number that calculus always wanted but could never have.

(proof epsilon-positive
  :theory SurrealNumbers
  :goal (holds (sur-lt zero-s eps-s))
  :derivation (eps-positive))


;;; ═══════════════════════════════════════════════════════════
;;; Proof 8: ε < ½ (infinitesimal is less than any finite positive)
;;; ═══════════════════════════════════════════════════════════

(proof epsilon-less-than-half
  :theory SurrealNumbers
  :goal (holds (sur-lt eps-s half-s))
  :derivation (eps-lt-half))


;;; ═══════════════════════════════════════════════════════════
;;; Proof 9: ω < ω + 1 (transfinite successor)
;;; ═══════════════════════════════════════════════════════════
;;; In surreal arithmetic, ω + 1 > ω (unlike ordinals where
;;; 1 + ω = ω). Surreal addition is commutative!

(proof omega-plus-one-gt-omega
  :theory SurrealNumbers
  :goal (holds (sur-lt omega-s (add-s omega-s one-s)))
  :derivation (omega-lt-suc))


;;; ═══════════════════════════════════════════════════════════
;;; Proof 10: The infinite AND the infinitesimal coexist
;;; ═══════════════════════════════════════════════════════════
;;; In one number system: ε is infinitely small yet positive,
;;; ω is infinitely large yet has a successor. Both are first-class
;;; citizens of the surreal number field.

(proof infinite-and-infinitesimal
  :theory SurrealNumbers
  :goal (holds (and-f (sur-lt zero-s eps-s) (sur-lt omega-s (add-s omega-s one-s))))
  :derivation (and-intro (eps-positive) (omega-lt-suc)))
