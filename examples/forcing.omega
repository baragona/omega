;;; Forcing — The Independence of the Continuum Hypothesis
;;;
;;; The most famous unprovable statement in mathematics.
;;;
;;;   The Continuum Hypothesis (CH):  2^ℵ₀ = ℵ₁
;;;   "There is no set whose size is strictly between
;;;    the integers and the real numbers."
;;;
;;; Cantor conjectured it in 1878.  Hilbert made it Problem #1.
;;; It took 85 years and two revolutions to resolve:
;;;
;;;   Gödel (1938): CH is CONSISTENT with ZFC.
;;;     Proof: construct L, the universe of constructible sets.
;;;     In L every subset of ℵ_α appears before stage ℵ_{α+1},
;;;     so GCH holds, and CH follows as the special case α = 0.
;;;
;;;   Cohen (1963): ¬CH is CONSISTENT with ZFC.
;;;     Proof: invent forcing.  Starting from any model M of ZFC,
;;;     build a generic extension M[G] using Add(ω, ℵ₂).
;;;     This adds ℵ₂ new reals.  The countable chain condition
;;;     ensures cardinals are preserved, so 2^ℵ₀ ≥ ℵ₂ > ℵ₁.
;;;
;;; Together: CH can be neither proved nor refuted from ZFC.
;;; It is INDEPENDENT — the first natural example of Gödel
;;; incompleteness in mainstream mathematics.
;;;
;;; Proved here (10 proofs):
;;;
;;;   Cardinal Arithmetic:
;;;    1.  beth₀ = ℵ₀                         (beth hierarchy base)
;;;    2.  ℵ₀ < 2^ℵ₀                          (Cantor's theorem)
;;;
;;;   Gödel's Constructible Universe (1938):
;;;    3.  L ⊨ ZFC                             (L is a model of set theory)
;;;    4.  L ⊨ CH                              (CH holds in L, via GCH)
;;;    5.  Con(ZFC) → Con(ZFC + CH)            (Gödel's theorem)
;;;
;;;   Cohen's Forcing (1963):
;;;    6.  Add(ω,ℵ₂) satisfies CCC            (cardinal preservation)
;;;    7.  M[G] ⊨ ZFC                          (forcing preserves ZFC)
;;;    8.  M[G] ⊨ ¬CH                          (2^ℵ₀ = ℵ₂ in M[G])
;;;    9.  Con(ZFC) → Con(ZFC + ¬CH)           (Cohen's theorem)
;;;
;;;   The Crown Jewel:
;;;   10.  CH is independent of ZFC            (the main theorem)

(theory Forcing

  ;; ══════════════════════════════════════════════════════
  ;; ORDINALS & CARDINALS
  ;; ══════════════════════════════════════════════════════

  (sort Ord)
  (sort Card)

  ;; ── Ordinals ──
  (constructor zero : Ord)
  (constructor suc  : (-> Ord Ord))

  ;; ── Cardinals ──
  (constructor aleph   : (-> Ord Card))       ;; ℵ_α
  (constructor beth    : (-> Ord Card))        ;; beth_α
  (constructor power   : (-> Card Card))       ;; 2^κ
  (constructor omega-c : Card)                 ;; ℵ₀ = ω

  ;; ── Cardinal arithmetic ──
  (rewrite aleph-zero-def (aleph zero) omega-c)
  (rewrite beth-zero-def  (beth zero)  omega-c)

  ;; ══════════════════════════════════════════════════════
  ;; SET-THEORETIC FORMULAS
  ;; ══════════════════════════════════════════════════════

  (sort Formula)

  ;; ── Atomic sentences ──
  (constructor ch      : Formula)              ;; 2^ℵ₀ = ℵ₁
  (constructor gch     : Formula)              ;; ∀α. 2^ℵ_α = ℵ_{α+1}
  (constructor zfc     : Formula)              ;; the ZFC axioms
  (constructor v-eq-l  : Formula)              ;; V = L

  ;; ── Connectives ──
  (constructor neg     : (-> Formula Formula))
  (constructor and-f   : (-> Formula Formula Formula))

  ;; ── Cardinal comparisons as formulas ──
  (constructor eq-card : (-> Card Card Formula))
  (constructor lt-card : (-> Card Card Formula))

  ;; ══════════════════════════════════════════════════════
  ;; MODELS & JUDGMENTS
  ;; ══════════════════════════════════════════════════════

  (sort Model)
  (sort Poset)

  ;; ── Model constructors ──
  (constructor L     : (-> Model Model))       ;; L^M (constructible universe)
  (constructor ext   : (-> Model Poset Model)) ;; M[G] (generic extension)
  (constructor cohen : (-> Card Poset))        ;; Add(ω, κ)

  ;; ── Absolute truths (provable cardinal facts) ──
  (judgment (holds ?P) :where P : Formula)

  ;; ── Satisfaction: M ⊨ φ ──
  (judgment (sat ?M ?phi) :where M : Model phi : Formula)

  ;; ── Consistency ──
  (judgment (consistent ?phi) :where phi : Formula)

  ;; ── Independence ──
  (judgment (independent ?phi ?T) :where phi : Formula T : Formula)

  ;; ── Countable chain condition ──
  (judgment (has-ccc ?P) :where P : Poset)

  ;; ══════════════════════════════════════════════════════
  ;; RULES — Cardinal Arithmetic
  ;; ══════════════════════════════════════════════════════

  (rule eq-card-refl
    :conclusion (holds (eq-card ?a ?a)))

  ;; Cantor's theorem: κ < 2^κ (diagonal argument)
  (rule cantor
    :conclusion (holds (lt-card ?k (power ?k))))

  ;; ══════════════════════════════════════════════════════
  ;; RULES — Propositional Structure
  ;; ══════════════════════════════════════════════════════

  (rule sat-and
    :premises ((sat ?M ?A) (sat ?M ?B))
    :conclusion (sat ?M (and-f ?A ?B)))

  ;; Soundness: a model witnesses consistency
  (rule model-to-consistent
    :premises ((sat ?M ?T))
    :conclusion (consistent ?T))

  ;; Independence = consistent both ways
  (rule independent-def
    :premises ((consistent (and-f ?T ?A))
               (consistent (and-f ?T (neg ?A))))
    :conclusion (independent ?A ?T))

  ;; ══════════════════════════════════════════════════════
  ;; RULES — Gödel's Constructible Universe (1938)
  ;; ══════════════════════════════════════════════════════
  ;;
  ;; L is defined by transfinite recursion:
  ;;   L₀ = ∅
  ;;   L_{α+1} = first-order definable subsets of L_α
  ;;   L_λ = ⋃_{α<λ} L_α
  ;;   L = ⋃_α L_α
  ;;
  ;; L is an "inner model": same ordinals, all ZFC axioms,
  ;; plus V = L and GCH (via the Condensation Lemma).

  (rule L-models-zfc
    :premises ((sat ?M zfc))
    :conclusion (sat (L ?M) zfc))

  (rule L-models-gch
    :premises ((sat ?M zfc))
    :conclusion (sat (L ?M) gch))

  ;; GCH at α=0 gives 2^ℵ₀ = ℵ₁, which is CH
  (rule gch-to-ch
    :premises ((sat ?M gch))
    :conclusion (sat ?M ch))

  ;; ══════════════════════════════════════════════════════
  ;; RULES — Cohen Forcing (1963)
  ;; ══════════════════════════════════════════════════════
  ;;
  ;; Add(ω, κ) = finite partial functions κ × ω → 2.
  ;; For κ = ℵ₂, this adds ℵ₂ new subsets of ω.
  ;;
  ;; CCC (proved by Δ-system lemma) ensures no cardinals
  ;; collapse: ℵ₁^M = ℵ₁^{M[G]}, ℵ₂^M = ℵ₂^{M[G]}.

  (rule cohen-has-ccc
    :premises ()
    :conclusion (has-ccc (cohen ?K)))

  (rule forcing-preserves-zfc
    :premises ((sat ?M zfc) (has-ccc ?P))
    :conclusion (sat (ext ?M ?P) zfc))

  ;; ℵ₂ new reals + CCC ⇒ 2^ℵ₀ ≥ ℵ₂ > ℵ₁ ⇒ ¬CH
  (rule cohen-adds-reals
    :premises ((sat ?M zfc))
    :conclusion (sat (ext ?M (cohen (aleph (suc (suc zero))))) (neg ch))))

(check-theory Forcing)


;;; ═══════════════════════════════════════════════════════════
;;; Proof 1: beth₀ = ℵ₀  (beth hierarchy base case)
;;; ═══════════════════════════════════════════════════════════
;;; The beth numbers measure iterated cardinal exponentiation:
;;;   beth₀ = ℵ₀,  beth₁ = 2^ℵ₀,  beth₂ = 2^(2^ℵ₀), ...
;;; At the base, both hierarchies agree.
;;; Both (beth zero) and (aleph zero) normalize to omega-c.

(proof beth-zero-is-aleph-zero
  :theory Forcing
  :goal (holds (eq-card (beth zero) (aleph zero)))
  :derivation (eq-card-refl))


;;; ═══════════════════════════════════════════════════════════
;;; Proof 2: ℵ₀ < 2^ℵ₀  (Cantor's theorem)
;;; ═══════════════════════════════════════════════════════════
;;; Cantor's diagonal argument: no surjection ℕ → P(ℕ).
;;; This raises THE question: how much larger is 2^ℵ₀?
;;;   2^ℵ₀ = ℵ₁?  That's CH.
;;;   2^ℵ₀ = ℵ₂?  That's what Cohen's model gives.
;;; ZFC leaves the size of the continuum almost entirely open.

(proof cantor-theorem
  :theory Forcing
  :goal (holds (lt-card (aleph zero) (power (aleph zero))))
  :derivation (cantor))


;;; ═══════════════════════════════════════════════════════════
;;; GÖDEL'S CONSTRUCTIBLE UNIVERSE (1938)
;;; ═══════════════════════════════════════════════════════════


;;; ═══════════════════════════════════════════════════════════
;;; Proof 3: L ⊨ ZFC  (the constructible universe models ZFC)
;;; ═══════════════════════════════════════════════════════════
;;; L is an inner model: it contains all ordinals and satisfies
;;; every axiom of ZFC.  Restricting the universe to definable
;;; sets doesn't break any axioms.

(proof L-models-set-theory
  :theory Forcing
  :assumptions ((sat M0 zfc))
  :goal (sat (L M0) zfc)
  :derivation (L-models-zfc (assumption)))


;;; ═══════════════════════════════════════════════════════════
;;; Proof 4: L ⊨ CH  (the Continuum Hypothesis holds in L)
;;; ═══════════════════════════════════════════════════════════
;;; Two-step argument:
;;;   Step 1: L ⊨ GCH  (by the Condensation Lemma — every subset
;;;           of ℵ_α in L appears before stage ℵ_{α+1})
;;;   Step 2: GCH ⇒ CH  (specialize the generalized form to α = 0)

(proof L-satisfies-CH
  :theory Forcing
  :assumptions ((sat M0 zfc))
  :goal (sat (L M0) ch)
  :derivation (gch-to-ch (L-models-gch (assumption))))


;;; ═══════════════════════════════════════════════════════════
;;; Proof 5: Con(ZFC) → Con(ZFC + CH)  — Gödel's theorem
;;; ═══════════════════════════════════════════════════════════
;;; L^M witnesses the consistency of ZFC + CH.
;;; Given any model M of ZFC, build L^M which models both.

(proof godel-1938
  :theory Forcing
  :assumptions ((sat M0 zfc))
  :goal (consistent (and-f zfc ch))
  :derivation (model-to-consistent
    (sat-and
      (L-models-zfc (assumption))
      (gch-to-ch (L-models-gch (assumption))))))


;;; ═══════════════════════════════════════════════════════════
;;; COHEN'S FORCING (1963)
;;; ═══════════════════════════════════════════════════════════


;;; ═══════════════════════════════════════════════════════════
;;; Proof 6: Add(ω, ℵ₂) satisfies CCC
;;; ═══════════════════════════════════════════════════════════
;;; The countable chain condition: every antichain is countable.
;;; Proved by Δ-system (sunflower) lemma.
;;;
;;; Why it matters: CCC implies cardinals are preserved.
;;; Without it, adding new reals might collapse ℵ₂ to ℵ₀.

(proof cohen-poset-ccc
  :theory Forcing
  :goal (has-ccc (cohen (aleph (suc (suc zero)))))
  :derivation (cohen-has-ccc))


;;; ═══════════════════════════════════════════════════════════
;;; Proof 7: M[G] ⊨ ZFC  (forcing preserves set theory)
;;; ═══════════════════════════════════════════════════════════
;;; Each ZFC axiom is verified in M[G] using names and the
;;; forcing relation.  CCC is essential for Power Set.

(proof forcing-preserves
  :theory Forcing
  :assumptions ((sat M0 zfc))
  :goal (sat (ext M0 (cohen (aleph (suc (suc zero))))) zfc)
  :derivation (forcing-preserves-zfc (assumption) (cohen-has-ccc)))


;;; ═══════════════════════════════════════════════════════════
;;; Proof 8: M[G] ⊨ ¬CH  (the continuum is ℵ₂ in M[G])
;;; ═══════════════════════════════════════════════════════════
;;; Add(ω, ℵ₂) adds ℵ₂ distinct subsets of ω.
;;; CCC ensures ℵ₁ and ℵ₂ are not collapsed.
;;; So 2^ℵ₀ ≥ ℵ₂ > ℵ₁, hence ¬CH.

(proof cohen-negates-CH
  :theory Forcing
  :assumptions ((sat M0 zfc))
  :goal (sat (ext M0 (cohen (aleph (suc (suc zero))))) (neg ch))
  :derivation (cohen-adds-reals (assumption)))


;;; ═══════════════════════════════════════════════════════════
;;; Proof 9: Con(ZFC) → Con(ZFC + ¬CH)  — Cohen's theorem
;;; ═══════════════════════════════════════════════════════════
;;; M[G] witnesses the consistency of ZFC + ¬CH.

(proof cohen-1963
  :theory Forcing
  :assumptions ((sat M0 zfc))
  :goal (consistent (and-f zfc (neg ch)))
  :derivation (model-to-consistent
    (sat-and
      (forcing-preserves-zfc (assumption) (cohen-has-ccc))
      (cohen-adds-reals (assumption)))))


;;; ═══════════════════════════════════════════════════════════
;;; Proof 10: CH is independent of ZFC  — THE CROWN JEWEL
;;; ═══════════════════════════════════════════════════════════
;;;
;;; The derivation tree encodes 85 years of set theory:
;;;
;;;                    (independent ch zfc)
;;;                    /                    \
;;;          Con(ZFC + CH)            Con(ZFC + ¬CH)
;;;              |                          |
;;;       L^M ⊨ ZFC ∧ CH         M[G] ⊨ ZFC ∧ ¬CH
;;;          /        \              /           \
;;;    L^M ⊨ ZFC   L^M ⊨ CH   M[G] ⊨ ZFC   M[G] ⊨ ¬CH
;;;        |         |    \        |              |
;;;    (L-zfc)    (gch→ch)(gch) (forcing+ccc)  (cohen)
;;;        \        /              |
;;;         M ⊨ ZFC             M ⊨ ZFC
;;;
;;; Left branch:  Gödel (1938) — the constructible universe
;;; Right branch: Cohen (1963) — forcing with Add(ω, ℵ₂)

(proof ch-independent
  :theory Forcing
  :assumptions ((sat M0 zfc))
  :goal (independent ch zfc)
  :derivation (independent-def
    (model-to-consistent
      (sat-and
        (L-models-zfc (assumption))
        (gch-to-ch (L-models-gch (assumption)))))
    (model-to-consistent
      (sat-and
        (forcing-preserves-zfc (assumption) (cohen-has-ccc))
        (cohen-adds-reals (assumption))))))


;; ════════════════════════════════════════════════════════════
;; WHAT FORCING REVEALS
;; ════════════════════════════════════════════════════════════
;;
;;   Gödel's L:
;;     "Restrict the universe to constructible sets."
;;     Every subset of ℵ₀ appears by stage ℵ₁.
;;     So 2^ℵ₀ = ℵ₁.  CH holds.
;;
;;   Cohen's M[G]:
;;     "Expand the universe with ℵ₂ new reals."
;;     The reals outnumber ℵ₁.  2^ℵ₀ ≥ ℵ₂ > ℵ₁.
;;     CH fails.
;;
;;   Independence:
;;     ZFC cannot decide whether the universe is thin or wide.
;;     The size of the continuum is not fixed by the axioms.
;;
;;   Both ZFC + CH and ZFC + ¬CH are legitimate.
;;   The choice is not a matter of proof but of axioms.
;;
;;   Hilbert's First Problem is not unsolved — it is UNSOLVABLE.
;; ════════════════════════════════════════════════════════════
