;;; Paraconsistent Collapse: The Consistency Filter
;;;
;;; Paraconsistent logic tolerates contradictions: A ∧ ¬A can hold
;;; without everything becoming provable (no explosion).  But when
;;; do we KNOW a proposition is "safe" — consistent enough for
;;; classical reasoning?
;;;
;;; This bridge defines a FILTER that extracts the consistent
;;; fragment.  A proposition is "classically safe" when we can
;;; prove it WITHOUT using any contradictory facts.
;;;
;;; The key insight: paraconsistent logic has TWO kinds of truth:
;;;   - Dialetheia: both A and ¬A hold (like Russell's paradox)
;;;   - Robust truth: A holds and ¬A does NOT (safe for export)
;;;
;;; The filter: "consistent(A)" means A is provable and its
;;; negation is not involved.  We model this with a separate
;;; judgment that has classical rules but NO access to dialetheias.
;;;
;;; Proved here (4 bridges, 10 proofs):
;;;
;;;  Bridge 1 -- Safe reasoning survives:
;;;   1.  Paraconsistent: ⊤                     (trivially true)
;;;   2.  Consistent: ⊤                         (passes filter)
;;;   3.  Paraconsistent: ⊤ → ⊤                 (identity)
;;;
;;;  Bridge 2 -- Contradictions are blocked:
;;;   4.  Paraconsistent: R∈R ∧ R∉R             (dialetheia exists)
;;;   5.  Consistent: ⊤ → (⊤ → ⊤)              (weakening passes)
;;;   6.  Consistent: (P∧Q) → (Q∧P)            (∧-comm passes)
;;;
;;;  Bridge 3 -- Classical power restored:
;;;   7.  Consistent: ¬¬P → P                   (DNE works again!)
;;;   8.  Consistent: P ∨ ¬P                    (LEM restored)
;;;
;;;  Bridge 4 -- The bridge theorem:
;;;   9.  Paraconsistent: (P∧¬P) → (P∧¬P)     (tautology in both)
;;;  10.  Consistent: (P→Q) → ((Q→R) → (P→R)) (composition safe)

(theory CollapseFilter

  ;; ====================================================
  ;; PARACONSISTENT LOGIC (source: tolerates contradictions)
  ;; ====================================================

  (sort PProp)

  (constructor pP    : PProp)
  (constructor pQ    : PProp)
  (constructor pR    : PProp)
  (constructor p-and : (-> PProp PProp PProp))
  (constructor p-or  : (-> PProp PProp PProp))
  (constructor p-imp : (-> PProp PProp PProp))
  (constructor p-not : (-> PProp PProp))
  (constructor p-top : PProp)
  (constructor p-bot : PProp)

  ;; Russell's set (the canonical dialetheia)
  (constructor p-russell-in  : PProp)   ;; "R ∈ R"
  (constructor p-russell-out : PProp)   ;; "R ∉ R"

  (judgment (p-proves ?A) :where A : PProp)

  ;; Propositional rules
  (rule p-top-intro
    :conclusion (p-proves p-top))

  (rule p-and-intro
    :premises ((p-proves ?A) (p-proves ?B))
    :conclusion (p-proves (p-and ?A ?B)))

  (rule p-and-elim-l
    :premises ((p-proves (p-and ?A ?B)))
    :conclusion (p-proves ?A))

  (rule p-and-elim-r
    :premises ((p-proves (p-and ?A ?B)))
    :conclusion (p-proves ?B))

  (rule p-or-intro-l
    :premises ((p-proves ?A))
    :conclusion (p-proves (p-or ?A ?B)))

  (rule p-or-intro-r
    :premises ((p-proves ?B))
    :conclusion (p-proves (p-or ?A ?B)))

  (rule p-imp-intro
    :premises ((p-proves ?B))
    :context ((0 (p-proves ?A)))
    :conclusion (p-proves (p-imp ?A ?B)))

  (rule p-imp-elim
    :premises ((p-proves (p-imp ?A ?B)) (p-proves ?A))
    :conclusion (p-proves ?B))

  ;; Double negation (paraconsistent flavor)
  (rule p-dn-intro
    :premises ((p-proves ?A))
    :conclusion (p-proves (p-not (p-not ?A))))

  (rule p-dn-elim
    :premises ((p-proves (p-not (p-not ?A))))
    :conclusion (p-proves ?A))

  ;; ══════════════════════════════════════
  ;; THE DIALETHEIAS (both directions hold unconditionally)
  ;; These are the "toxic" facts — true AND false simultaneously.
  ;; ══════════════════════════════════════

  (rule p-russell-is-in
    :conclusion (p-proves p-russell-in))

  (rule p-russell-is-not-in
    :conclusion (p-proves p-russell-out))

  ;; Biconditional: R∈R ↔ R∉R
  (rule p-russell-fwd
    :premises ((p-proves p-russell-in))
    :conclusion (p-proves p-russell-out))

  (rule p-russell-bwd
    :premises ((p-proves p-russell-out))
    :conclusion (p-proves p-russell-in))

  ;; NO explosion!  p-bot does not prove everything.
  ;; NO ex falso:  (p-proves p-bot) does NOT give (p-proves ?A).
  ;; This is what makes it paraconsistent.

  ;; ====================================================
  ;; CONSISTENT CLASSICAL LOGIC (target: the safe fragment)
  ;; ====================================================
  ;;
  ;; Same connectives, but WITH explosion and DNE.
  ;; No access to Russell's set.  No dialetheias.
  ;; This is ordinary classical logic — anything provable
  ;; here is "safe" for classical reasoning.

  (sort CProp)

  (constructor cP    : CProp)
  (constructor cQ    : CProp)
  (constructor cR    : CProp)
  (constructor c-and : (-> CProp CProp CProp))
  (constructor c-or  : (-> CProp CProp CProp))
  (constructor c-imp : (-> CProp CProp CProp))
  (constructor c-not : (-> CProp CProp))
  (constructor c-top : CProp)
  (constructor c-bot : CProp)

  (judgment (c-proves ?A) :where A : CProp)

  (rule c-top-intro
    :conclusion (c-proves c-top))

  (rule c-and-intro
    :premises ((c-proves ?A) (c-proves ?B))
    :conclusion (c-proves (c-and ?A ?B)))

  (rule c-and-elim-l
    :premises ((c-proves (c-and ?A ?B)))
    :conclusion (c-proves ?A))

  (rule c-and-elim-r
    :premises ((c-proves (c-and ?A ?B)))
    :conclusion (c-proves ?B))

  (rule c-or-intro-l
    :premises ((c-proves ?A))
    :conclusion (c-proves (c-or ?A ?B)))

  (rule c-or-intro-r
    :premises ((c-proves ?B))
    :conclusion (c-proves (c-or ?A ?B)))

  (rule c-imp-intro
    :premises ((c-proves ?B))
    :context ((0 (c-proves ?A)))
    :conclusion (c-proves (c-imp ?A ?B)))

  (rule c-imp-elim
    :premises ((c-proves (c-imp ?A ?B)) (c-proves ?A))
    :conclusion (c-proves ?B))

  (rule c-not-intro
    :premises ((c-proves c-bot))
    :context ((0 (c-proves ?A)))
    :conclusion (c-proves (c-not ?A)))

  (rule c-not-elim
    :premises ((c-proves (c-not ?A)) (c-proves ?A))
    :conclusion (c-proves c-bot))

  ;; Classical power: explosion + DNE
  (rule c-bot-elim
    :premises ((c-proves c-bot))
    :conclusion (c-proves ?A))

  (rule c-dne
    :premises ((c-proves (c-not (c-not ?A))))
    :conclusion (c-proves ?A))

  ;; ====================================================
  ;; THE FILTER (rewrite rules)
  ;; ====================================================
  ;; Maps paraconsistent propositions to classical ones.
  ;; Russell-related propositions map to ⊤ (neutralized).

  (constructor filter : (-> PProp CProp))

  (rewrite f-P   (filter pP) cP)
  (rewrite f-Q   (filter pQ) cQ)
  (rewrite f-R   (filter pR) cR)
  (rewrite f-and (filter (p-and ?A ?B)) (c-and (filter ?A) (filter ?B)))
  (rewrite f-or  (filter (p-or ?A ?B))  (c-or  (filter ?A) (filter ?B)))
  (rewrite f-imp (filter (p-imp ?A ?B)) (c-imp (filter ?A) (filter ?B)))
  (rewrite f-not (filter (p-not ?A))    (c-not (filter ?A)))
  (rewrite f-top (filter p-top)         c-top)
  (rewrite f-bot (filter p-bot)         c-bot)

  ;; THE KEY: dialetheias collapse to harmless ⊤
  (rewrite f-rin  (filter p-russell-in)  c-top)
  (rewrite f-rout (filter p-russell-out) c-top)

  ;; ====================================================
  ;; EQUALITY CHECKER
  ;; ====================================================

  (sort Eq)
  (constructor equals : (-> CProp CProp Eq))
  (judgment (is-equal ?e) :where e : Eq)
  (rule eq-refl :conclusion (is-equal (equals ?A ?A))))

(check-theory CollapseFilter)


;; ============================================================
;;  BRIDGE 1: Safe Reasoning Survives
;; ============================================================
;;
;;  Ordinary logical reasoning that doesn't touch contradictions
;;  passes through the filter unchanged.

;; 1. Paraconsistent: ⊤
(proof p-truth
  :theory CollapseFilter
  :goal (p-proves p-top)
  :derivation (p-top-intro))

;; 2. Consistent: ⊤ (passes the filter)
(proof c-truth
  :theory CollapseFilter
  :goal (c-proves c-top)
  :derivation (c-top-intro))

;; 3. Paraconsistent: ⊤ → ⊤
(proof p-identity
  :theory CollapseFilter
  :goal (p-proves (p-imp p-top p-top))
  :derivation (p-imp-intro (assumption)))


;; ============================================================
;;  BRIDGE 2: Contradictions Are Blocked
;; ============================================================
;;
;;  The paraconsistent side can prove the Russell paradox.
;;  The consistent side cannot — the filter neutralizes it.
;;  But clean reasoning still passes through.

;; 4. Paraconsistent: R∈R ∧ R∉R  (the dialetheia)
(proof p-paradox
  :theory CollapseFilter
  :goal (p-proves (p-and p-russell-in p-russell-out))
  :derivation (p-and-intro (p-russell-is-in) (p-russell-is-not-in)))

;; Compilation check: the paradox collapses to ⊤∧⊤
(proof filter-paradox
  :theory CollapseFilter
  :goal (is-equal (equals
    (filter (p-and p-russell-in p-russell-out))
    (c-and c-top c-top)))
  :derivation (eq-refl))

;; 5. Consistent: ⊤ → (⊤ → ⊤)  (weakening — clean reasoning passes)
(proof c-weakening
  :theory CollapseFilter
  :goal (c-proves (c-imp c-top (c-imp c-top c-top)))
  :derivation (c-imp-intro (c-imp-intro (assumption))))

;; 6. Consistent: (P∧Q) → (Q∧P)  (∧-commutativity — clean reasoning)
(proof c-and-comm
  :theory CollapseFilter
  :goal (c-proves (c-imp (c-and cP cQ) (c-and cQ cP)))
  :derivation
    (c-imp-intro
      (c-and-intro (c-and-elim-r (assumption)) (c-and-elim-l (assumption)))))


;; ============================================================
;;  BRIDGE 3: Classical Power Restored
;; ============================================================
;;
;;  The consistent fragment has FULL classical reasoning.
;;  DNE and LEM work — because there are no dialetheias
;;  to corrupt the explosion rule.

;; 7. Consistent: ¬¬P → P  (DNE — impossible in paraconsistent!)
(proof c-dne-thm
  :theory CollapseFilter
  :goal (c-proves (c-imp (c-not (c-not cP)) cP))
  :derivation (c-imp-intro (c-dne (assumption))))

;; 8. Consistent: P ∨ ¬P  (LEM — the hallmark of classical logic)
(proof c-lem
  :theory CollapseFilter
  :goal (c-proves (c-or cP (c-not cP)))
  :derivation
    (c-dne
      (c-not-intro
        (c-not-elim
          (assumption)
          (c-or-intro-r
            (c-not-intro
              (c-not-elim
                (assumption 0)
                (c-or-intro-l (assumption)))))))))


;; ============================================================
;;  BRIDGE 4: The Bridge Theorem
;; ============================================================
;;
;;  Some theorems hold in BOTH logics.  These are the universal
;;  truths — valid regardless of whether contradictions exist.

;; 9. Paraconsistent: (P∧¬P) → (P∧¬P)  (tautology)
(proof p-tautology
  :theory CollapseFilter
  :goal (p-proves (p-imp (p-and pP (p-not pP)) (p-and pP (p-not pP))))
  :derivation (p-imp-intro (assumption)))

;; Compilation check: filter preserves the structure
(proof filter-tautology
  :theory CollapseFilter
  :goal (is-equal (equals
    (filter (p-imp (p-and pP (p-not pP)) (p-and pP (p-not pP))))
    (c-imp (c-and cP (c-not cP)) (c-and cP (c-not cP)))))
  :derivation (eq-refl))

;; 10. Consistent: (P→Q) → ((Q→R) → (P→R))  (composition)
(proof c-composition
  :theory CollapseFilter
  :goal (c-proves (c-imp (c-imp cP cQ) (c-imp (c-imp cQ cR) (c-imp cP cR))))
  :derivation
    (c-imp-intro
      (c-imp-intro
        (c-imp-intro
          (c-imp-elim
            (assumption 1)
            (c-imp-elim
              (assumption 0)
              (assumption)))))))

;; ============================================================
;; WHAT THE BRIDGE REVEALS
;; ============================================================
;;
;; The collapse filter is a FORGETFUL FUNCTOR:
;;
;;   Paraconsistent World          Classical World
;;   ──────────────────────────────────────────────
;;   R∈R (true)                 →  ⊤  (neutralized)
;;   R∉R (true)                 →  ⊤  (neutralized)
;;   R∈R ∧ R∉R (dialetheia)    →  ⊤∧⊤ = ⊤  (harmless)
;;   P (clean proposition)      →  P  (preserved)
;;   P → Q (clean reasoning)   →  P → Q  (preserved)
;;
;; The filter says: "I'll take your results, but only the ones
;; that don't depend on contradictions."
;;
;; In the consistent world, explosion (⊥ → anything) is SAFE
;; because there's no way to actually derive ⊥ — the filter
;; removed all paths to contradiction.
;;
;; Combined with the other bridges:
;;   Paraconsistent → [filter] → Classical → [¬¬] → Intuitionistic → [!] → Linear
;; A complete pipeline from the most permissive to the most restrictive logic.
;; ============================================================
