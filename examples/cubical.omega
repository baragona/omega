;;; Cubical Type Theory: Where Univalence Computes
;;;
;;; In HoTT, transport is an axiom — it exists but doesn't reduce.
;;; In Cubical Type Theory, transport COMPUTES via rewrite rules.
;;; The interval I (with endpoints i0, i1) makes paths into
;;; functions, and univalence into a computational principle.
;;;
;;; The key insight: a path p : Path_A(a,b) is a "function" from
;;; the interval I to A, with p(i0) = a and p(i1) = b.
;;; Transport along a path literally evaluates it.
;;;
;;; Proved here (8 proofs):
;;;
;;;   Path computation:
;;;    1.  refl(0) @ i0 = 0                          (left endpoint)
;;;    2.  refl(1) @ i1 = 1                          (right endpoint)
;;;    3.  sym(refl(tt)) @ i0 = tt                   (symmetry computes)
;;;    4.  transport(refl, 2) = 2                     (transport reduces!)
;;;
;;;   Function extensionality (derived, not axiom):
;;;    5.  funext(id, neg∘neg, h) @ i0 = id          (left endpoint)
;;;    6.  neg∘neg agrees with id pointwise           (why funext works)
;;;
;;;   Univalence computes:
;;;    7.  transport(ua(neg), true) = false            (THE FLEX)
;;;    8.  transport(ua(neg), transport(ua(neg), t)) = t  (round-trip)

(theory CubicalTT

  ;; ══════════════════════════════════════
  ;; THE INTERVAL
  ;; ══════════════════════════════════════
  ;; I has two endpoints.  Paths are "functions from I."

  (sort Dim)
  (constructor i0 : Dim)     ;; left endpoint
  (constructor i1 : Dim)     ;; right endpoint

  ;; ══════════════════════════════════════
  ;; TYPES & TERMS
  ;; ══════════════════════════════════════

  (sort Ty)
  (sort Tm)

  ;; Base types
  (constructor Nat : Ty)
  (constructor Bool : Ty)

  ;; Naturals
  (constructor z : Tm)
  (constructor s : (-> Tm Tm))

  ;; Booleans
  (constructor tt : Tm)
  (constructor ff : Tm)
  (constructor neg : (-> Tm Tm))

  ;; First-class functions
  (constructor id-fn : Tm)
  (constructor neg-fn : Tm)
  (constructor comp : (-> Tm Tm Tm))
  (constructor app : (-> Tm Tm Tm))

  ;; ══════════════════════════════════════
  ;; PATHS
  ;; ══════════════════════════════════════
  ;; Path_A(a,b): the type of paths from a to b in A.
  ;; A path p satisfies p @ i0 = a and p @ i1 = b.

  (constructor PathTy : (-> Ty Tm Tm Ty))
  (constructor refl : (-> Tm Tm))
  (constructor sym : (-> Tm Tm))
  (constructor papp : (-> Tm Dim Tm))

  ;; funext(f, g, h): path from f to g,
  ;; where h witnesses pointwise equality.
  ;; DERIVED from the interval, not an axiom!
  (constructor funext : (-> Tm Tm Tm Tm))

  ;; ══════════════════════════════════════
  ;; TRANSPORT & UNIVALENCE
  ;; ══════════════════════════════════════
  ;; transport(p, x): coerce x along type-path p.
  ;; ua(f): equivalence f gives a path in the universe.

  (constructor transport : (-> Tm Tm Tm))
  (constructor ua : (-> Tm Tm))

  ;; ══════════════════════════════════════
  ;; COMPUTATION RULES
  ;; ══════════════════════════════════════

  ;; ── Booleans ──
  (rewrite neg-tt (neg tt) ff)
  (rewrite neg-ff (neg ff) tt)

  ;; ── Function application ──
  (rewrite app-id (app id-fn ?x) ?x)
  (rewrite app-neg (app neg-fn ?x) (neg ?x))
  (rewrite app-comp (app (comp ?f ?g) ?x) (app ?f (app ?g ?x)))

  ;; ── Path evaluation ──
  ;; refl(a) is the constant path: both endpoints are a.
  (rewrite papp-refl-0 (papp (refl ?a) i0) ?a)
  (rewrite papp-refl-1 (papp (refl ?a) i1) ?a)

  ;; sym swaps endpoints.
  (rewrite papp-sym-0 (papp (sym ?p) i0) (papp ?p i1))
  (rewrite papp-sym-1 (papp (sym ?p) i1) (papp ?p i0))

  ;; funext endpoints: funext(f,g,h) @ i0 = f, @ i1 = g.
  (rewrite funext-0 (papp (funext ?f ?g ?h) i0) ?f)
  (rewrite funext-1 (papp (funext ?f ?g ?h) i1) ?g)

  ;; ── Transport (THE key difference from HoTT) ──
  ;; Transport along refl = identity.  NOT stuck — COMPUTES!
  (rewrite transport-refl (transport (refl ?a) ?x) ?x)

  ;; Transport along ua(f) = apply f.  UNIVALENCE COMPUTES!
  (rewrite transport-ua (transport (ua ?f) ?x) (app ?f ?x))

  ;; ══════════════════════════════════════
  ;; EQUALITY
  ;; ══════════════════════════════════════

  (sort Eq)
  (constructor eq : (-> Tm Tm Eq))
  (judgment (is-eq ?e) :where e : Eq)
  (rule eq-refl :conclusion (is-eq (eq ?a ?a))))

(check-theory CubicalTT)


;; ════════════════════════════════════════════════════════════
;;  PATH COMPUTATION
;; ════════════════════════════════════════════════════════════

;; ─── Proof 1: refl(0) @ i0 = 0 ───
;; The constant path at zero, evaluated at the left endpoint.
;; papp(refl(z), i0) → z

(proof refl-left
  :theory CubicalTT
  :goal (is-eq (eq (papp (refl z) i0) z))
  :derivation (eq-refl))


;; ─── Proof 2: refl(1) @ i1 = 1 ───
;; Same path, right endpoint.
;; papp(refl(s(z)), i1) → s(z)

(proof refl-right
  :theory CubicalTT
  :goal (is-eq (eq (papp (refl (s z)) i1) (s z)))
  :derivation (eq-refl))


;; ─── Proof 3: sym(refl(tt)) @ i0 = tt ───
;; Symmetry of a constant path computes:
;;   papp(sym(refl(tt)), i0) → papp(refl(tt), i1) → tt

(proof sym-computes
  :theory CubicalTT
  :goal (is-eq (eq (papp (sym (refl tt)) i0) tt))
  :derivation (eq-refl))


;; ─── Proof 4: transport(refl, 2) = 2 ───
;; THE key difference from HoTT.
;; In HoTT:    transport(refl, x) is an AXIOM (stuck term).
;; In Cubical: transport(refl, x) REDUCES to x.
;;
;; transport(refl(Nat), s(s(z))) → s(s(z))

(proof transport-refl-computes
  :theory CubicalTT
  :goal (is-eq (eq (transport (refl Nat) (s (s z))) (s (s z))))
  :derivation (eq-refl))


;; ════════════════════════════════════════════════════════════
;;  FUNCTION EXTENSIONALITY (derived from interval)
;; ════════════════════════════════════════════════════════════
;;
;; In HoTT, funext is an axiom.
;; In Cubical TT, it's DERIVED from the interval:
;;   Given h : ∀x. Path(f(x), g(x)),
;;   funext(f,g,h) := λi. λx. h(x)(i)
;;   This is a path from f to g because:
;;     (λi. λx. h(x)(i)) @ i0 = λx. h(x)(i0) = λx. f(x) = f
;;     (λi. λx. h(x)(i)) @ i1 = λx. h(x)(i1) = λx. g(x) = g

;; ─── Proof 5: funext left endpoint ───
;; funext(id, neg∘neg, h) @ i0 = id
;; The path from id to neg∘neg starts at id.

(proof funext-left
  :theory CubicalTT
  :goal (is-eq (eq
    (papp (funext id-fn (comp neg-fn neg-fn) tt) i0)
    id-fn))
  :derivation (eq-refl))


;; ─── Proof 6: neg∘neg = id pointwise ───
;; WHY funext works: neg(neg(x)) = x for all x.
;; app(comp(neg, neg), tt) → app(neg, app(neg, tt))
;;   → app(neg, neg(tt)) → app(neg, ff) → neg(ff) → tt
;; app(id, tt) → tt
;; Both reduce to tt, confirming pointwise equality.

(proof neg-involution
  :theory CubicalTT
  :goal (is-eq (eq
    (app (comp neg-fn neg-fn) tt)
    (app id-fn tt)))
  :derivation (eq-refl))


;; ════════════════════════════════════════════════════════════
;;  UNIVALENCE COMPUTES
;; ════════════════════════════════════════════════════════════
;;
;; In HoTT:    ua(neg) is a path Bool = Bool, but
;;             transport(ua(neg), true) is STUCK.
;;
;; In Cubical: transport(ua(neg), true) REDUCES:
;;   transport(ua(neg-fn), tt)
;;   → app(neg-fn, tt)       [transport-ua]
;;   → neg(tt)               [app-neg]
;;   → ff                    [neg-tt]
;;
;; The equivalence neg : Bool ≃ Bool gives a path in the
;; universe.  Transporting along it IS applying the function.

;; ─── Proof 7: transport(ua(neg), true) = false ───
;; The path Bool = Bool (via negation) maps true to false.
;; Three computation steps — not stuck, not an axiom, COMPUTED.

(proof ua-computes
  :theory CubicalTT
  :goal (is-eq (eq (transport (ua neg-fn) tt) ff))
  :derivation (eq-refl))


;; ─── Proof 8: Round-trip through isomorphism ───
;; transport(ua(neg), transport(ua(neg), true)) = true
;;
;; Evaluation:
;;   transport(ua(neg-fn), transport(ua(neg-fn), tt))
;;   → transport(ua(neg-fn), app(neg-fn, tt))
;;   → transport(ua(neg-fn), neg(tt))
;;   → transport(ua(neg-fn), ff)
;;   → app(neg-fn, ff)
;;   → neg(ff)
;;   → tt
;;
;; Six reduction steps.  The isomorphism round-trips to identity.
;; In HoTT this would be a stuck term.  Here it reduces to tt.

(proof ua-roundtrip
  :theory CubicalTT
  :goal (is-eq (eq
    (transport (ua neg-fn) (transport (ua neg-fn) tt))
    tt))
  :derivation (eq-refl))


;; ════════════════════════════════════════════════════════════
;; WHAT CUBICAL TYPE THEORY REVEALS
;; ════════════════════════════════════════════════════════════
;;
;;   HoTT                      Cubical TT
;;   ─────────────────────────────────────────────────
;;   transport(refl, x) axiom  transport(refl, x) → x
;;   funext is an axiom        funext is derived from I
;;   ua(f) is an axiom         transport(ua(f), x) → f(x)
;;   Paths are abstract        Paths are I-indexed functions
;;   Univalence is stuck       Univalence computes
;;
;; The interval I is the secret ingredient:
;;   - It has two endpoints (i0, i1)
;;   - Paths evaluate at endpoints
;;   - Transport evaluates along paths
;;   - Everything REDUCES — no stuck terms
;;
;; Proofs 7-8 are the crown jewel:
;;   A path Bool = Bool (via negation) lets you TRANSPORT
;;   values between "two copies" of Bool.  Transporting true
;;   gives false, and transporting twice gives true back.
;;   The type checker computes this in six steps.
;; ════════════════════════════════════════════════════════════
