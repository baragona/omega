;;; Extensional Type Theory (ETT)
;;;
;;; In Intensional Type Theory (Coq, Lean), propositional equality
;;; (Id A a b) and definitional equality (a ≡ b) are distinct.
;;; You can prove a = b but the type checker won't "know" it.
;;;
;;; ETT adds the REFLECTION rule: if you have a proof p : Id(A,a,b),
;;; then a ≡ b definitionally.  This makes programming much easier
;;; (the checker knows more) but makes type checking undecidable.
;;;
;;; Omega sidesteps undecidability: it checks explicit derivation
;;; trees, so the user provides the proof.  ETT works perfectly.
;;;
;;; Also demonstrated: function extensionality (f = g when they
;;; agree pointwise) and UIP (all identity proofs are equal) —
;;; both are consequences of reflection.
;;;
;;; Proved here:
;;;   1.  refl : Id(Nat, ze, ze)                    (reflexivity)
;;;   2.  refl : Id(Nat, add(ze,ze), ze)             (computation: 0+0=0)
;;;   3.  refl : Id(Nat, add(su ze, ze), su ze)      (computation: 1+0=1)
;;;   4.  add(ze,ze) ≡ ze                            (REFLECTION: prop → def)
;;;   5.  su(a) ≡ su(b) from a ≡ b                  (congruence + reflection)
;;;   6.  refl ≡ sym(refl)                           (UIP: all proofs equal)
;;;   7.  f ≡ g from ∀x. f(x) ≡ g(x)               (function extensionality)
;;;   8.  ty-eq from reflection                       (type-level congruence)
;;;   9.  type conversion via ty-eq                   (change type annotation)
;;;  10.  b ≡ a from Id(A, a, b)                     (reflect + symmetry)

(theory ETT
  (sort Ty)
  (sort Tm)

  ;; ── Types ──
  (constructor Nat : Ty)
  (constructor Id : (-> Ty Tm Tm Ty))
  (constructor Arr : (-> Ty Ty Ty))

  ;; ── Terms ──
  (constructor ze : Tm)
  (constructor su : (-> Tm Tm))
  (constructor refl : Tm)
  (constructor sym-pf : (-> Tm Tm))
  (constructor app : (-> Tm Tm Tm))
  (constructor add : (-> Tm Tm Tm))

  ;; ── Computation rules for addition ──
  (rewrite add-ze (add ze ?n) ?n)
  (rewrite add-su (add (su ?m) ?n) (su (add ?m ?n)))

  ;; ── Judgments ──
  (judgment (typed ?e ?T) :where e : Tm T : Ty)
  (judgment (tm-eq ?a ?b) :where a : Tm b : Tm)
  (judgment (ty-eq ?A ?B) :where A : Ty B : Ty)

  ;; ── Basic typing ──
  (rule t-ze :premises () :conclusion (typed ze Nat))
  (rule t-su :premises ((typed ?n Nat)) :conclusion (typed (su ?n) Nat))
  (rule t-refl
    :premises ((typed ?a ?A))
    :conclusion (typed refl (Id ?A ?a ?a)))
  (rule t-sym
    :premises ((typed ?p (Id ?A ?a ?b)))
    :conclusion (typed (sym-pf ?p) (Id ?A ?b ?a)))

  ;; ── Definitional equality (reflexive) ──
  (rule eq-refl :premises () :conclusion (tm-eq ?a ?a))
  (rule tyeq-refl :premises () :conclusion (ty-eq ?A ?A))

  ;; ══════════════════════════════════════════════════
  ;; THE extensional rules
  ;; ══════════════════════════════════════════════════

  ;; REFLECTION: propositional equality → definitional equality
  ;; If there is a proof p : Id(A, a, b), then a ≡ b.
  ;; This is undecidable in general, but omega checks derivations.
  (rule reflection
    :premises ((typed ?p (Id ?A ?a ?b)))
    :conclusion (tm-eq ?a ?b))

  ;; TYPE CONVERSION: change the type of a term
  (rule conversion
    :premises ((typed ?e ?A) (ty-eq ?A ?B))
    :conclusion (typed ?e ?B))

  ;; CONGRUENCE: definitional equality lifts through constructors
  (rule eq-su
    :premises ((tm-eq ?a ?b))
    :conclusion (tm-eq (su ?a) (su ?b)))

  (rule eq-app
    :premises ((tm-eq ?f ?g) (tm-eq ?a ?b))
    :conclusion (tm-eq (app ?f ?a) (app ?g ?b)))

  ;; TYPE CONGRUENCE
  (rule tyeq-id
    :premises ((tm-eq ?a ?c) (tm-eq ?b ?d))
    :conclusion (ty-eq (Id ?A ?a ?b) (Id ?A ?c ?d)))

  (rule tyeq-sym
    :premises ((ty-eq ?A ?B))
    :conclusion (ty-eq ?B ?A))

  ;; FUNCTION EXTENSIONALITY: if f(x)=g(x) for all x, then f=g
  ;; The meta-variable ?x is universally quantified.
  (rule fun-ext
    :premises ((tm-eq (app ?f ?x) (app ?g ?x)))
    :conclusion (tm-eq ?f ?g))

  ;; UIP: all identity proofs between the same endpoints are equal
  (rule uip
    :premises ((typed ?p (Id ?A ?a ?b))
               (typed ?q (Id ?A ?a ?b)))
    :conclusion (tm-eq ?p ?q)))

(check-theory ETT)


;; ════════════════════════════════════════════════════════════
;; PART 1: Computation via normalization
;; ════════════════════════════════════════════════════════════


;; ─── Proof 1: Reflexivity at ze ───

(proof refl-ze
  :theory ETT
  :goal (typed refl (Id Nat ze ze))
  :derivation (t-refl (t-ze)))


;; ─── Proof 2: 0 + 0 = 0 ───
;; add(ze, ze) normalizes to ze via add-ze rewrite.

(proof add-zero-zero
  :theory ETT
  :goal (typed refl (Id Nat (add ze ze) ze))
  :derivation (t-refl (t-ze)))


;; ─── Proof 3: 1 + 0 = 1 ───
;; add(su(ze), ze) → su(add(ze, ze)) → su(ze)

(proof add-one-zero
  :theory ETT
  :goal (typed refl (Id Nat (add (su ze) ze) (su ze)))
  :derivation (t-refl (t-su (t-ze))))


;; ════════════════════════════════════════════════════════════
;; PART 2: Equality reflection
;; ════════════════════════════════════════════════════════════


;; ─── Proof 4: REFLECTION — propositional → definitional ───
;; From refl : Id(Nat, ze, ze), derive ze ≡ ze definitionally.
;; The point: reflection makes computation results usable as
;; definitional equalities, not just propositional ones.

(proof reflect-refl
  :theory ETT
  :goal (tm-eq ze ze)
  :derivation (reflection (t-refl (t-ze))))


;; ─── Proof 5: Congruence via reflection ───
;; Given a proof a = b, derive su(a) ≡ su(b).
;; In intensional TT, you'd need explicit transport.
;; In ETT, just reflect and lift through su.

(proof congruence-reflect
  :theory ETT
  :assumptions ((typed eq-pf (Id Nat a b)))
  :goal (tm-eq (su a) (su b))
  :derivation (eq-su (reflection (assumption))))


;; ════════════════════════════════════════════════════════════
;; PART 3: Uniqueness of Identity Proofs (UIP)
;; ════════════════════════════════════════════════════════════


;; ─── Proof 6: UIP — refl ≡ sym(refl) ───
;; Two DIFFERENT proofs of ze = ze are definitionally equal.
;; This is incompatible with HoTT (where paths have structure)
;; but is a feature of ETT (where proofs are irrelevant).

(proof uip-refl-sym
  :theory ETT
  :goal (tm-eq refl (sym-pf refl))
  :derivation (uip (t-refl (t-ze)) (t-sym (t-refl (t-ze)))))


;; ════════════════════════════════════════════════════════════
;; PART 4: Function extensionality
;; ════════════════════════════════════════════════════════════


;; ─── Proof 7: Function extensionality ───
;; If f(x) ≡ g(x) for all x (meta-variable ?x), then f ≡ g.
;; In intensional TT, this requires a separate axiom.
;; In ETT, it follows from reflection.

(proof fun-ext-demo
  :theory ETT
  :assumptions ((tm-eq (app f ?x) (app g ?x)))
  :goal (tm-eq f g)
  :derivation (fun-ext (assumption)))


;; ════════════════════════════════════════════════════════════
;; PART 5: Type-level consequences
;; ════════════════════════════════════════════════════════════


;; ─── Proof 8: Type congruence ───
;; From a ≡ b, derive Id(Nat, a, ze) = Id(Nat, b, ze) as types.

(proof type-congruence
  :theory ETT
  :assumptions ((tm-eq a b))
  :goal (ty-eq (Id Nat a ze) (Id Nat b ze))
  :derivation (tyeq-id (assumption) (eq-refl)))


;; ─── Proof 9: Type conversion ───
;; If x : Id(Nat, a, ze) and a ≡ b, then x : Id(Nat, b, ze).
;; The term doesn't change — only its type annotation does.

(proof type-conversion
  :theory ETT
  :assumptions ((typed x (Id Nat a ze)) (tm-eq a b))
  :goal (typed x (Id Nat b ze))
  :derivation (conversion (assumption 0) (tyeq-id (assumption 1) (eq-refl))))


;; ─── Proof 10: Reflect + symmetry ───
;; Given p : Id(Nat, a, b), derive b ≡ a.
;; Reflect p to get a ≡ b, then reflect sym(p) to get b ≡ a.

(proof reflect-sym
  :theory ETT
  :assumptions ((typed p (Id Nat a b)))
  :goal (tm-eq b a)
  :derivation (reflection (t-sym (assumption))))
