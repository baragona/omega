;;; ═══════════════════════════════════════════════════════════════════


;;; ═══════════════════════════════════════════════════════════════════
;;;  34. NO TAGGED SCATTER:  tagged e⁻ + tagged e⁺ ⊬ γ+γ
;;; ═══════════════════════════════════════════════════════════════════
;;;
;;;  Information-carrying (tagged) particles cannot undergo physics
;;;  reactions. Conservation rules require is-free=true on both sides;
;;;  tagged particles have is-free=false. This tests that the
;;;  information layer and physics layer are properly isolated.
;;;
;;;    Q: (-3)+3=0 → 0  ✓   B: 0  ✓   L: 0  ✓   S: 0  ✓   C: 0  ✓
;;;    But is-free(tagged b0 electron) = false. BLOCKED.

(refute no-tagged-scatter
  :theory GUTPhys
  :assumptions (
    (has (tagged b0 electron))
    (has (tagged b0 positron))
    (cms-energy (s (s z))))
  :goal (has (tensor (particle photon) (particle photon)))
  :depth 5)


;;; ═══════════════════════════════════════════════════════════════════
;;;  35. NO GHOST NEUTRINO PAIR:  γ+γ ⊬ ν+ν̄  (vertex specificity)
;;; ═══════════════════════════════════════════════════════════════════
;;;
;;;  All conservation passes (Q=B=L=S=C=0, triality=t0, mass OK).
;;;  Blocked by vertex library: no `allowed` rewrite exists for ANY
;;;  channel with this reaction. In real physics this would require
;;;  a Z boson or box diagram not in our vertex library.

(refute no-ghost-neutrino-pair
  :theory GUTPhys
  :assumptions (
    (has (particle photon))
    (has (particle photon))
    (cms-energy (s z)))
  :goal (has (tensor (particle neutrino) (particle antineutrino)))
  :depth 5)


;;; ═══════════════════════════════════════════════════════════════════
;;;  36. NO PHANTOM PION DECAY:  π⁰ ⊬ e⁻+e⁺  (vertex specificity)
;;; ═══════════════════════════════════════════════════════════════════
;;;
;;;  Conservation passes: Q: 0→0, B: 0→0, L: 0→0, S: 0→0, C: 0→0.
;;;  Mass: 2 ≥ 1+1 = 2. ✓
;;;  Blocked by vertex library: no `allowed` rewrite for pion decay
;;;  in any channel. In real physics, the Dalitz pair π⁰→e⁻+e⁺+γ
;;;  exists but is not in our toy Lagrangian.

(refute no-phantom-pion-decay
  :theory GUTPhys
  :assumptions ((has (particle pion-zero)))
  :goal (has (tensor (particle electron) (particle positron)))
  :depth 5)


;;; ═══════════════════════════════════════════════════════════════════
;;;  37. NO DOUBLE FLAVOR CHANGE:  s+ū ⊬ c̄+d  (single-W constraint)
;;; ═══════════════════════════════════════════════════════════════════
;;;
;;;  This reaction conserves Q, B, L, and triality:
;;;    Q: (-1)+(-2)=-3 → (-2)+(-1)=-3  ✓
;;;    B: (+1)+(-1)=0 → (-1)+(+1)=0    ✓
;;;    L: 0 → 0                          ✓
;;;    Tri: t1+t2=t0 → t2+t1=t0         ✓
;;;    Mass: cms(2) ≥ 2+0 = 2           ✓
;;;  But ΔS=+1 AND ΔC=-1 simultaneously — both flavors change.
;;;  Single-W constraint: |ΔS|+|ΔC| = 2 > 1. Blocked.
;;;  Defense-in-depth: vertex library also has no such vertex.

(refute no-double-flavor-change
  :theory GUTPhys
  :assumptions (
    (has (particle strange-quark))
    (has (particle anti-up))
    (cms-energy (s (s z))))
  :goal (has (tensor (particle anti-charm) (particle down-quark)))
  :depth 5)


;;; ═══════════════════════════════════════════════════════════════════
;;;  ╔════════════════════════════════════════════════════════════╗
;;;  ║  PART IX: RELATIVISTIC KINEMATICS                         ║
;;;  ╚════════════════════════════════════════════════════════════╝
;;; ═══════════════════════════════════════════════════════════════════


;;; ═══════════════════════════════════════════════════════════════════
;;;  38. BETHE-HEITLER:  γ + target → e⁻ + e⁺ + target  (EM)
;;; ═══════════════════════════════════════════════════════════════════
;;;
;;;  Nuclear pair production: a photon converts to an e⁻e⁺ pair in
;;;  the field of a heavy nucleus (the "target"). The target absorbs
;;;  recoil momentum and is unchanged.
;;;
;;;    Q: 0+0=0 → (-3)+3+0=0       ✓
;;;    B: 0+0=0 → 0+0+0=0          ✓
;;;    L: 0+0=0 → 3+(-3)+0=0       ✓
;;;    S: 0 → 0                      ✓
;;;    C: 0 → 0                      ✓
;;;    Tri: t0+t0=t0 → t0+t0+t0=t0  ✓
;;;    Mass: cms(5) ≥ 1+1+3 = 5     ✓
;;;    4-mom: kind-add(lightlike,timelike) = timelike → OK (no noncollinear needed!)

(proof bethe-heitler :theory GUTPhys
  :assumptions (
    (has (particle photon))
    (has (particle target))
    (cms-energy (s (s (s (s (s z)))))))
  :goal (has (tensor (tensor (particle electron) (particle positron))
                     (particle target)))
  :derivation
    (interact-scatter
      (tensor-intro (assumption 0) (assumption 1))
      (conserve-em (eq-refl) (eq-refl) (eq-refl) (eq-refl) (eq-refl)
                   (eq-tri-refl) (eq-tri-refl)
                   (eq-bool-refl) (eq-bool-refl))
      (eq-bool-refl)
      (assumption 2)
      (eq-mc-refl)
      (sr-ok-timelike (eq-vk-refl))))


;;; ═══════════════════════════════════════════════════════════════════
;;;  38R. NO COLLINEAR PAIR PRODUCTION:  γ+γ ⊬ e⁻+e⁺  (SR-only block)
;;; ═══════════════════════════════════════════════════════════════════
;;;
;;;  The definitive SR-only refutation.  Every other check PASSES:
;;;    Conservation: Q=B=L=S=C=0 → 0                                ✓
;;;    Vertex: allow-em-pair exists for γ+γ→e⁻+e⁺                   ✓
;;;    Mass: cms(2) ≥ 1+1 = 2                                       ✓
;;;    Free: is-free(particle photon) = true                         ✓
;;;    Triality: t0+t0=t0 → t0+t0=t0                                ✓
;;;  The ONLY obstruction is the SR gate:
;;;    mom-kind(tensor(γ,γ)) = kind-add(lightlike,lightlike) = vk-unknown
;;;    collinear-beams provided → sr-blocked-collinear fires (→ false)
;;;    No rule produces scatter-4mom-ok(input, true).
;;;
;;;  Compare with proof 1 (pair-production) which succeeds with
;;;  noncollinear-beams for the identical reaction.

(refute no-collinear-pair-production
  :theory GUTPhys
  :assumptions (
    (has (particle photon))
    (has (particle photon))
    (collinear-beams (tensor (particle photon) (particle photon)))
    (cms-energy (s (s z))))
  :goal (has (tensor (particle electron) (particle positron)))
  :depth 5)


;;; ═══════════════════════════════════════════════════════════════════
;;;  39R. NO BETHE-HEITLER WITHOUT TARGET:  γ+γ ⊬ (e⁻+e⁺)+target
;;; ═══════════════════════════════════════════════════════════════════
;;;
;;;  Two photons with a noncollinear witness still cannot produce
;;;  (e⁻+e⁺)+target. Even though 4-momentum would be OK, the
;;;  target particle cannot be created from photon assumptions —
;;;  there is no vertex γ+γ→(e⁻+e⁺)+target in the library.
;;;  The Bethe-Heitler vertex requires γ+target as INPUT.
;;;  This demonstrates that the vertex library correctly gates
;;;  reactions even when conservation and kinematics pass.

(refute no-bethe-heitler-without-target
  :theory GUTPhys
  :assumptions (
    (has (particle photon))
    (has (particle photon))
    (noncollinear-beams (tensor (particle photon) (particle photon)))
    (cms-energy (s (s (s (s (s z)))))))
  :goal (has (tensor (tensor (particle electron) (particle positron))
                     (particle target)))
  :depth 5)


;;; ═══════════════════════════════════════════════════════════════════
;;;  39. KIND-CONSISTENCY AUDIT (all 18 particles)
;;; ═══════════════════════════════════════════════════════════════════
;;;
;;;  Batch verification that particle-kind is consistent with rest-mass:
;;;    mass > 0  ⇒  kind = timelike
;;;    mass = 0  ⇒  any kind acceptable (modeling choice)
;;;  Each (kind-consistent P) rewrites to true; the nested and-bool
;;;  chain reduces to true, so eq-bool-refl closes it.
;;;
;;;  If a future edit makes a massive particle lightlike (or vice versa),
;;;  this proof breaks immediately.

(proof kind-audit :theory GUTPhys
  :assumptions ()
  :goal (eq-bool
    (and-bool (kind-consistent proton)
    (and-bool (kind-consistent neutron)
    (and-bool (kind-consistent electron)
    (and-bool (kind-consistent positron)
    (and-bool (kind-consistent neutrino)
    (and-bool (kind-consistent antineutrino)
    (and-bool (kind-consistent photon)
    (and-bool (kind-consistent pion-zero)
    (and-bool (kind-consistent kaon-plus)
    (and-bool (kind-consistent up-quark)
    (and-bool (kind-consistent down-quark)
    (and-bool (kind-consistent strange-quark)
    (and-bool (kind-consistent charm-quark)
    (and-bool (kind-consistent anti-up)
    (and-bool (kind-consistent anti-down)
    (and-bool (kind-consistent anti-strange)
    (and-bool (kind-consistent anti-charm)
              (kind-consistent target))))))))))))))))))
    true)
  :derivation (eq-bool-refl))


;;; NOTE: Collinear light-by-light (γ+γ→γ+γ) is NOT a valid SR refutation
;;; because tensor-intro can construct has(tensor(photon,photon)) directly
;;; from the two photon assumptions without any scatter reaction.  The
;;; definitive SR-only refutation is 38R (collinear pair production),
;;; where the output (e⁻+e⁺) DIFFERS from the input (γ+γ) and thus
;;; requires an actual scatter reaction that SR can gate.


;;; ═══════════════════════════════════════════════════════════════════
;;;  ╔════════════════════════════════════════════════════════════╗
;;;  ║  PART X: FUNDAMENTAL IMPOSSIBILITIES                      ║
;;;  ╚════════════════════════════════════════════════════════════╝
;;; ═══════════════════════════════════════════════════════════════════


;;; ═══════════════════════════════════════════════════════════════════
;;;  40R. VACUUM STABILITY:  ∅ ⊬ γ  (nothing from nothing)
;;; ═══════════════════════════════════════════════════════════════════
;;;
;;;  The most fundamental impossibility: with zero assumptions, no
;;;  particle can be derived — not even a massless photon. Every rule
;;;  that produces `has` requires at least one `has` premise (interact-
;;;  scatter, interact-decay, tensor-intro, tensor-elim, gates).
;;;  The vacuum is stable.

(refute vacuum-stability
  :theory GUTPhys
  :assumptions ()
  :goal (has (particle photon))
  :depth 3)


;;; ═══════════════════════════════════════════════════════════════════
;;;  41R. PHOTON CANNOT SPLIT:  γ ⊬ γ+γ  (affine + no vertex)
;;; ═══════════════════════════════════════════════════════════════════
;;;
;;;  A single photon cannot become two photons. Two obstructions:
;;;    1. Affine context: the one `has(γ)` assumption is consumed once.
;;;       tensor-intro needs two `has` premises — blocked.
;;;    2. No decay vertex: `allowed ch (particle photon) ...` has no
;;;       rewrite for any channel. interact-decay can't fire.
;;;  In real physics: energy-momentum conservation forbids 1→2 for
;;;  massless on-shell particles (the vertex vanishes kinematically).

(refute no-photon-splitting
  :theory GUTPhys
  :assumptions ((has (particle photon)))
  :goal (has (tensor (particle photon) (particle photon)))
  :depth 5)


;;; ═══════════════════════════════════════════════════════════════════
;;;  42R. INSUFFICIENT ENERGY:  γ+γ ⊬ e⁻+e⁺ at cms=1  (mass-only block)
;;; ═══════════════════════════════════════════════════════════════════
;;;
;;;  A pure energy-threshold refutation. Every other check PASSES:
;;;    Conservation: Q=B=L=S=C=0 → 0                                ✓
;;;    Vertex: allow-em-pair exists                                  ✓
;;;    SR: noncollinear witness provided                             ✓
;;;    Free: true                                                    ✓
;;;    Triality: t0 → t0                                             ✓
;;;  The ONLY obstruction is energy:
;;;    check-mass(1, 1+1=2) = check-mass(s(z), s(s(z)))
;;;                         = check-mass(z, s(z)) = mass-fail  ✗
;;;
;;;  Compare with proof 1 (pair-production) which succeeds at cms=2.

(refute insufficient-energy-pair
  :theory GUTPhys
  :assumptions (
    (has (particle photon))
    (has (particle photon))
    (noncollinear-beams (tensor (particle photon) (particle photon)))
    (cms-energy (s z)))
  :goal (has (tensor (particle electron) (particle positron)))
  :depth 5)
