;;; ═══════════════════════════════════════════════════════════════════
;;;  32. LIGHT-BY-LIGHT SCATTERING:  γ+γ → γ+γ  (loop, unbounded)
;;; ═══════════════════════════════════════════════════════════════════
;;;
;;;  Delbrück scattering: photon-photon scattering via virtual e±
;;;  box diagram. All quantum numbers trivially conserved (0→0).
;;;
;;;    Q: 0 → 0  ✓    B: 0 → 0  ✓    L: 0 → 0  ✓
;;;    S: 0 → 0  ✓    C: 0 → 0  ✓    Tri: t0 → t0  ✓
;;;    Mass: cms(1) ≥ 0+0 = 0  ✓

(proof light-by-light :theory GUTPhys
  :assumptions (
    (has (particle photon))
    (has (particle photon))
    (cms-energy (s z))
    (noncollinear-beams (tensor (particle photon) (particle photon))))
  :goal (has (tensor (particle photon) (particle photon)))
  :derivation
    (interact-scatter
      (tensor-intro (assumption 0) (assumption 1))
      (conserve-loop (eq-refl) (eq-refl) (eq-refl) (eq-refl) (eq-refl)
                     (eq-tri-refl) (eq-tri-refl)
                     (eq-bool-refl) (eq-bool-refl))
      (eq-bool-refl)
      (assumption 2)
      (eq-mc-refl)
      (sr-ok-nc (eq-vk-refl) (assumption 3))))


;;; ═══════════════════════════════════════════════════════════════════
;;;  33. LIGHT-BY-LIGHT (BUDGET):  γ+γ → γ+γ  under budget 5
;;; ═══════════════════════════════════════════════════════════════════
;;;
;;;  Loop channel has penalty 5. Budget 5 ≥ 5. ✓

(proof light-by-light-budget :theory GUTPhys
  :assumptions (
    (has-under (particle photon) (s (s (s (s (s z))))))
    (has-under (particle photon) (s (s (s (s (s z))))))
    (cms-energy (s z))
    (noncollinear-beams (tensor (particle photon) (particle photon))))
  :goal (has-under (tensor (particle photon) (particle photon))
                   (s (s (s (s (s z))))))
  :derivation
    (interact-scatter-under
      (tensor-intro-under (assumption 0) (assumption 1))
      (conserve-loop (eq-refl) (eq-refl) (eq-refl) (eq-refl) (eq-refl)
                     (eq-tri-refl) (eq-tri-refl)
                     (eq-bool-refl) (eq-bool-refl))
      (eq-bool-refl)
      (assumption 2)
      (eq-mc-refl)
      (eq-bool-refl)
      (sr-ok-nc (eq-vk-refl) (assumption 3))))


;;; ═══════════════════════════════════════════════════════════════════
;;;  ╔════════════════════════════════════════════════════════════╗
;;;  ║  PART VIII: ADVERSARIAL REFUTATIONS                        ║
