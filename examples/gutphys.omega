;;; ═══════════════════════════════════════════════════════════════════
;;;  GUTPhys v7: Typed Reaction Calculus — Standard Model in Omega
;;; ═══════════════════════════════════════════════════════════════════
;;;
;;;  A resource theory encoding Standard Model conservation laws
;;;  as a typed reaction calculus with channel admissibility.
;;;
;;;  MODEL CONSTRAINTS (not fundamental laws):
;;;    - Q: electric charge (exact U(1)_EM gauge symmetry)
;;;    - B: baryon number (modelled global charge; sphalerons violate)
;;;    - L: lepton number (modelled global charge; sphalerons violate)
;;;    - S: strangeness (conserved by strong/EM; |ΔS|≤1 for weak)
;;;    - C: charm (conserved by strong/EM; |ΔC|≤1 for weak)
;;;    - Center-neutral: triality(Z₃) = t0 (NECESSARY but NOT
;;;      SUFFICIENT for color singlet — see §3)
;;;    - Mass/energy thresholds (proxy for 4-momentum conservation)
;;;
;;;  FOUR INTERACTION CHANNELS:
;;;    strong: conserves Q,B,L,S,C + triality + vertex library  (penalty 0)
;;;    em:     conserves Q,B,L,S,C + triality + vertex library  (penalty 1)
;;;    weak:   conserves Q,B,L + single-W flavor + triality     (penalty 3)
;;;    loop:   conserves Q,B,L,S,C + triality + vertex library  (penalty 5)
;;;
;;;  VERTEX LIBRARY: Each reaction must appear in the `allowed`
;;;  table (11 vertices: 3 strong, 4 EM, 3 weak, 1 loop).
;;;  Reactions not in the library are blocked even if conservation
;;;  holds.
;;;
;;;  SUPPRESSION PENALTIES: strong=0, em=1, weak=3, loop=5.
;;;  Budget-bounded `has-under` judgment gates reactions by cost.
;;;
;;;  SINGLE-W FLAVOR: |ΔS|+|ΔC|≤1 (Manhattan distance) enforced
;;;  via `abs-delta-leq1` + `int-eq`. A single W boson changes at
;;;  most one flavor quantum number. Blocks simultaneous ΔS=±1,
;;;  ΔC=∓1 (e.g., s+ū→c̄+d).
;;;
;;;  SCATTER OUTPUT: 2+ particles (tensor). Prevents unphysical
;;;  2→1 processes like e⁻+e⁺→γ (forbidden by 4-momentum
;;;  conservation). Hadron formation requires a spectator photon
;;;  to absorb recoil: u+ū→π⁰+γ, not u+ū→π⁰.
;;;
;;;  COMPOSITES AS ATOMS: Proton, neutron, pion, kaon are modelled
;;;  as primitive constructors (stand-ins for quark bound states).
;;;  We do not model hadronization or spectroscopy.
;;;
;;;  INFORMATION LAYER: Classical reversible bits, NOT quantum.
;;;  CNOT/RCNOT implement truth tables on {0,1}.
;;;
;;;  RELATIVISTIC KINEMATICS (SR module):
;;;    VKind lattice classifies 4-momentum as lightlike/timelike/unknown.
;;;    Spacelike is INFECTIOUS (propagates through kind-add, blocks all).
;;;    scatter-4mom-ok gates scatter rules: timelike input OK, or
;;;    unknown input + noncollinear-beams(resource) witness OK.
;;;    Noncollinear witness is SCOPED to a specific beam resource
;;;    (prevents ambient authority).  collinear-beams(resource)
;;;    explicitly models collinear geometry (blocks scatter).
;;;    Quarks classified as timelike (physical causal class, not Nat mass).
;;;    Bethe-Heitler: γ+target → e⁻+e⁺+target (recoil pair production).
;;;
;;;  RESULTS: 21 proofs (VALID) + 23 refutations (VERIFIED) = 44
;;;
;;;  Remaining simplifications: no bottom/top quarks, single L
;;;  (no Lₑ/Lμ/Lτ), no spin, no CKM matrix, discrete mass scale.
;;;
;;; ═══════════════════════════════════════════════════════════════════

(theory GUTPhys
  (context-mode affine)

  ;; ═════════════════════════════════════════════════════════════
  ;; §1  ARITHMETIC
  ;; ═════════════════════════════════════════════════════════════

  (sort Nat)
  (constructor z : Nat)
  (constructor s : (-> Nat Nat))
  (constructor add : (-> Nat Nat Nat))

  (rewrite add-z (add z ?n) ?n)
  (rewrite add-s (add (s ?n) ?m) (s (add ?n ?m)))

  (sort Int)
  (constructor int : (-> Nat Nat Int))
  (constructor i-add : (-> Int Int Int))

  (rewrite cancel (int (s ?p) (s ?n)) (int ?p ?n))
  (rewrite i-add-def (i-add (int ?p1 ?n1) (int ?p2 ?n2))
                      (int (add ?p1 ?p2) (add ?n1 ?n2)))

  (sort Bool)
  (constructor true : Bool)
  (constructor false : Bool)
  (constructor and-bool : (-> Bool Bool Bool))

  (rewrite and-tt (and-bool true true) true)
  (rewrite and-tf (and-bool true false) false)
  (rewrite and-ft (and-bool false true) false)
  (rewrite and-ff (and-bool false false) false)

  ;; ═════════════════════════════════════════════════════════════
  ;; §2  MASS / ENERGY THRESHOLD
  ;; ═════════════════════════════════════════════════════════════

  (sort MassCheck)
  (constructor mass-ok : MassCheck)
  (constructor mass-fail : MassCheck)
  (constructor check-mass : (-> Nat Nat MassCheck))

  (rewrite cm-z  (check-mass ?n z) mass-ok)
  (rewrite cm-sz (check-mass z (s ?n)) mass-fail)
  (rewrite cm-ss (check-mass (s ?n) (s ?m)) (check-mass ?n ?m))

  ;; ═════════════════════════════════════════════════════════════
  ;; §3  COLOR TRIALITY (Z₃ center of SU(3))
  ;; ═════════════════════════════════════════════════════════════
  ;;
  ;; Triality = Z₃ center charge of SU(3) color:
  ;;   t0 = 0 mod 3  (hadrons, leptons, photon)
  ;;   t1 = 1 mod 3  (quarks)
  ;;   t2 = 2 mod 3  (antiquarks)
  ;;
  ;; Total triality = t0 is NECESSARY but NOT SUFFICIENT for
  ;; being a color singlet.
  ;;
  ;; Counterexample: 3 ⊗ 3̄ = 1 ⊕ 8. Both the singlet (1) and
  ;; the octet (8) have triality 0, but the octet is NOT a
  ;; singlet. Similarly, multi-parton states can have triality 0
  ;; while living in non-singlet representations.
  ;;
  ;; Our model uses triality as a FILTER for "not obviously
  ;; colored." It correctly blocks isolated quarks (t1≠t0),
  ;; diquarks (t1+t1=t2≠t0), and allows mesons (t1+t2=t0),
  ;; baryons (t1+t1+t1=t0). But it cannot distinguish a true
  ;; singlet from an octet or other center-neutral rep.

  (sort Triality)
  (constructor t0 : Triality)
  (constructor t1 : Triality)
  (constructor t2 : Triality)
  (constructor tri-add : (-> Triality Triality Triality))

  (rewrite ta-00 (tri-add t0 t0) t0)
  (rewrite ta-01 (tri-add t0 t1) t1)
  (rewrite ta-02 (tri-add t0 t2) t2)
  (rewrite ta-10 (tri-add t1 t0) t1)
  (rewrite ta-11 (tri-add t1 t1) t2)
  (rewrite ta-12 (tri-add t1 t2) t0)
  (rewrite ta-20 (tri-add t2 t0) t2)
  (rewrite ta-21 (tri-add t2 t1) t0)
  (rewrite ta-22 (tri-add t2 t2) t1)

  ;; ═════════════════════════════════════════════════════════════
  ;; §4  PARTICLES
  ;; ═════════════════════════════════════════════════════════════
  ;;
  ;; All quantum numbers in units of 1/3 (avoids rationals).
  ;; Seven properties per particle: Q, B, L, S, C, triality, mass.
  ;;
  ;;   Particle        Q    B    L    S    C   Tri   Mass
  ;;   ─────────      ───  ───  ───  ───  ───  ───   ────
  ;;   proton (uud)   +3   +3    0    0    0   t0     5
  ;;   neutron (udd)   0   +3    0    0    0   t0     6
  ;;   electron       −3    0   +3    0    0   t0     1
  ;;   positron       +3    0   −3    0    0   t0     1
  ;;   neutrino        0    0   +3    0    0   t0     0
  ;;   antineutrino    0    0   −3    0    0   t0     0
  ;;   photon          0    0    0    0    0   t0     0
  ;;   pion-zero       0    0    0    0    0   t0     2
  ;;   kaon-plus (us̄) +3    0    0   +1    0   t0     3
  ;;   up-quark       +2   +1    0    0    0   t1     0
  ;;   down-quark     −1   +1    0    0    0   t1     0
  ;;   strange-quark  −1   +1    0   −1    0   t1     1
  ;;   charm-quark    +2   +1    0    0   +1   t1     2
  ;;   anti-up        −2   −1    0    0    0   t2     0
  ;;   anti-down      +1   −1    0    0    0   t2     0
  ;;   anti-strange   +1   −1    0   +1    0   t2     1
  ;;   anti-charm     −2   −1    0    0   −1   t2     2
  ;;
  ;; Mass scale: ν=0, e=1, π=2, K=3, p=5, n=6.

  (sort Particle)
  (constructor proton : Particle)
  (constructor neutron : Particle)
  (constructor electron : Particle)
  (constructor positron : Particle)
  (constructor neutrino : Particle)
  (constructor antineutrino : Particle)
  (constructor photon : Particle)
  (constructor pion-zero : Particle)
  (constructor kaon-plus : Particle)
  (constructor up-quark : Particle)
  (constructor down-quark : Particle)
  (constructor strange-quark : Particle)
  (constructor charm-quark : Particle)
  (constructor anti-up : Particle)
  (constructor anti-down : Particle)
  (constructor anti-strange : Particle)
  (constructor anti-charm : Particle)

  ;; ═════════════════════════════════════════════════════════════
  ;; §5  RESOURCES
  ;; ═════════════════════════════════════════════════════════════

  (sort Resource)
  (constructor particle : (-> Particle Resource))
  (constructor tensor : (-> Resource Resource Resource))

  ;; ═════════════════════════════════════════════════════════════
  ;; §6  PER-PARTICLE PROPERTIES (7 × 17 = 119 rewrites)
  ;; ═════════════════════════════════════════════════════════════

  (constructor charge : (-> Particle Int))
  (constructor baryon : (-> Particle Int))
  (constructor lepton : (-> Particle Int))
  (constructor strangeness : (-> Particle Int))
  (constructor charm-num : (-> Particle Int))
  (constructor triality-of : (-> Particle Triality))
  (constructor rest-mass : (-> Particle Nat))

  ;; --- Proton: Q=+3, B=+3, L=0, S=0, C=0, t0, mass=5 ---
  (rewrite q-proton      (charge proton)       (int (s (s (s z))) z))
  (rewrite b-proton      (baryon proton)       (int (s (s (s z))) z))
  (rewrite l-proton      (lepton proton)       (int z z))
  (rewrite s-proton      (strangeness proton)  (int z z))
  (rewrite c-proton      (charm-num proton)    (int z z))
  (rewrite tri-proton    (triality-of proton)  t0)
  (rewrite m-proton      (rest-mass proton)    (s (s (s (s (s z))))))

  ;; --- Neutron: Q=0, B=+3, L=0, S=0, C=0, t0, mass=6 ---
  (rewrite q-neutron      (charge neutron)       (int z z))
  (rewrite b-neutron      (baryon neutron)       (int (s (s (s z))) z))
  (rewrite l-neutron      (lepton neutron)       (int z z))
  (rewrite s-neutron      (strangeness neutron)  (int z z))
  (rewrite c-neutron      (charm-num neutron)    (int z z))
  (rewrite tri-neutron    (triality-of neutron)  t0)
  (rewrite m-neutron      (rest-mass neutron)    (s (s (s (s (s (s z)))))))

  ;; --- Electron: Q=-3, B=0, L=+3, S=0, C=0, t0, mass=1 ---
  (rewrite q-electron      (charge electron)       (int z (s (s (s z)))))
  (rewrite b-electron      (baryon electron)       (int z z))
  (rewrite l-electron      (lepton electron)       (int (s (s (s z))) z))
  (rewrite s-electron      (strangeness electron)  (int z z))
  (rewrite c-electron      (charm-num electron)    (int z z))
  (rewrite tri-electron    (triality-of electron)  t0)
  (rewrite m-electron      (rest-mass electron)    (s z))

  ;; --- Positron: Q=+3, B=0, L=-3, S=0, C=0, t0, mass=1 ---
  (rewrite q-positron      (charge positron)       (int (s (s (s z))) z))
  (rewrite b-positron      (baryon positron)       (int z z))
  (rewrite l-positron      (lepton positron)       (int z (s (s (s z)))))
  (rewrite s-positron      (strangeness positron)  (int z z))
  (rewrite c-positron      (charm-num positron)    (int z z))
  (rewrite tri-positron    (triality-of positron)  t0)
  (rewrite m-positron      (rest-mass positron)    (s z))

  ;; --- Neutrino: Q=0, B=0, L=+3, S=0, C=0, t0, mass=0 ---
  (rewrite q-neutrino      (charge neutrino)       (int z z))
  (rewrite b-neutrino      (baryon neutrino)       (int z z))
  (rewrite l-neutrino      (lepton neutrino)       (int (s (s (s z))) z))
  (rewrite s-neutrino      (strangeness neutrino)  (int z z))
  (rewrite c-neutrino      (charm-num neutrino)    (int z z))
  (rewrite tri-neutrino    (triality-of neutrino)  t0)
  (rewrite m-neutrino      (rest-mass neutrino)    z)

  ;; --- Antineutrino: Q=0, B=0, L=-3, S=0, C=0, t0, mass=0 ---
  (rewrite q-antineutrino      (charge antineutrino)       (int z z))
  (rewrite b-antineutrino      (baryon antineutrino)       (int z z))
  (rewrite l-antineutrino      (lepton antineutrino)       (int z (s (s (s z)))))
  (rewrite s-antineutrino      (strangeness antineutrino)  (int z z))
  (rewrite c-antineutrino      (charm-num antineutrino)    (int z z))
  (rewrite tri-antineutrino    (triality-of antineutrino)  t0)
  (rewrite m-antineutrino      (rest-mass antineutrino)    z)

  ;; --- Photon: all zero, t0, mass=0 ---
  (rewrite q-photon      (charge photon)       (int z z))
  (rewrite b-photon      (baryon photon)       (int z z))
  (rewrite l-photon      (lepton photon)       (int z z))
  (rewrite s-photon      (strangeness photon)  (int z z))
  (rewrite c-photon      (charm-num photon)    (int z z))
  (rewrite tri-photon    (triality-of photon)  t0)
  (rewrite m-photon      (rest-mass photon)    z)

  ;; --- Pion-zero: all zero, t0, mass=2 ---
  (rewrite q-pion      (charge pion-zero)       (int z z))
  (rewrite b-pion      (baryon pion-zero)       (int z z))
  (rewrite l-pion      (lepton pion-zero)       (int z z))
  (rewrite s-pion      (strangeness pion-zero)  (int z z))
  (rewrite c-pion      (charm-num pion-zero)    (int z z))
  (rewrite tri-pion    (triality-of pion-zero)  t0)
  (rewrite m-pion      (rest-mass pion-zero)    (s (s z)))

  ;; --- Kaon-plus (us̄): Q=+3, B=0, L=0, S=+1, C=0, t0, mass=3 ---
  (rewrite q-kaon      (charge kaon-plus)       (int (s (s (s z))) z))
  (rewrite b-kaon      (baryon kaon-plus)       (int z z))
  (rewrite l-kaon      (lepton kaon-plus)       (int z z))
  (rewrite s-kaon      (strangeness kaon-plus)  (int (s z) z))
  (rewrite c-kaon      (charm-num kaon-plus)    (int z z))
  (rewrite tri-kaon    (triality-of kaon-plus)  t0)
  (rewrite m-kaon      (rest-mass kaon-plus)    (s (s (s z))))

  ;; --- Up quark: Q=+2, B=+1, L=0, S=0, C=0, t1, mass=0 ---
  (rewrite q-up      (charge up-quark)       (int (s (s z)) z))
  (rewrite b-up      (baryon up-quark)       (int (s z) z))
  (rewrite l-up      (lepton up-quark)       (int z z))
  (rewrite s-up      (strangeness up-quark)  (int z z))
  (rewrite c-up      (charm-num up-quark)    (int z z))
  (rewrite tri-up    (triality-of up-quark)  t1)
  (rewrite m-up      (rest-mass up-quark)    z)

  ;; --- Down quark: Q=-1, B=+1, L=0, S=0, C=0, t1, mass=0 ---
  (rewrite q-down      (charge down-quark)       (int z (s z)))
  (rewrite b-down      (baryon down-quark)       (int (s z) z))
  (rewrite l-down      (lepton down-quark)       (int z z))
  (rewrite s-down      (strangeness down-quark)  (int z z))
  (rewrite c-down      (charm-num down-quark)    (int z z))
  (rewrite tri-down    (triality-of down-quark)  t1)
  (rewrite m-down      (rest-mass down-quark)    z)

  ;; --- Strange quark: Q=-1, B=+1, L=0, S=-1, C=0, t1, mass=1 ---
  (rewrite q-strange      (charge strange-quark)       (int z (s z)))
  (rewrite b-strange      (baryon strange-quark)       (int (s z) z))
  (rewrite l-strange      (lepton strange-quark)       (int z z))
  (rewrite s-strange      (strangeness strange-quark)  (int z (s z)))
  (rewrite c-strange      (charm-num strange-quark)    (int z z))
  (rewrite tri-strange    (triality-of strange-quark)  t1)
  (rewrite m-strange      (rest-mass strange-quark)    (s z))

  ;; --- Charm quark: Q=+2, B=+1, L=0, S=0, C=+1, t1, mass=2 ---
  (rewrite q-charm      (charge charm-quark)       (int (s (s z)) z))
  (rewrite b-charm      (baryon charm-quark)       (int (s z) z))
  (rewrite l-charm      (lepton charm-quark)       (int z z))
  (rewrite s-charm      (strangeness charm-quark)  (int z z))
  (rewrite c-charm      (charm-num charm-quark)    (int (s z) z))
  (rewrite tri-charm    (triality-of charm-quark)  t1)
  (rewrite m-charm      (rest-mass charm-quark)    (s (s z)))

  ;; --- Anti-up: Q=-2, B=-1, L=0, S=0, C=0, t2, mass=0 ---
  (rewrite q-antiup      (charge anti-up)       (int z (s (s z))))
  (rewrite b-antiup      (baryon anti-up)       (int z (s z)))
  (rewrite l-antiup      (lepton anti-up)       (int z z))
  (rewrite s-antiup      (strangeness anti-up)  (int z z))
  (rewrite c-antiup      (charm-num anti-up)    (int z z))
  (rewrite tri-antiup    (triality-of anti-up)  t2)
  (rewrite m-antiup      (rest-mass anti-up)    z)

  ;; --- Anti-down: Q=+1, B=-1, L=0, S=0, C=0, t2, mass=0 ---
  (rewrite q-antidown      (charge anti-down)       (int (s z) z))
  (rewrite b-antidown      (baryon anti-down)       (int z (s z)))
  (rewrite l-antidown      (lepton anti-down)       (int z z))
  (rewrite s-antidown      (strangeness anti-down)  (int z z))
  (rewrite c-antidown      (charm-num anti-down)    (int z z))
  (rewrite tri-antidown    (triality-of anti-down)  t2)
  (rewrite m-antidown      (rest-mass anti-down)    z)

  ;; --- Anti-strange: Q=+1, B=-1, L=0, S=+1, C=0, t2, mass=1 ---
  (rewrite q-antistrange      (charge anti-strange)       (int (s z) z))
  (rewrite b-antistrange      (baryon anti-strange)       (int z (s z)))
  (rewrite l-antistrange      (lepton anti-strange)       (int z z))
  (rewrite s-antistrange      (strangeness anti-strange)  (int (s z) z))
  (rewrite c-antistrange      (charm-num anti-strange)    (int z z))
  (rewrite tri-antistrange    (triality-of anti-strange)  t2)
  (rewrite m-antistrange      (rest-mass anti-strange)    (s z))

  ;; --- Anti-charm: Q=-2, B=-1, L=0, S=0, C=-1, t2, mass=2 ---
  (rewrite q-anticharm      (charge anti-charm)       (int z (s (s z))))
  (rewrite b-anticharm      (baryon anti-charm)       (int z (s z)))
  (rewrite l-anticharm      (lepton anti-charm)       (int z z))
  (rewrite s-anticharm      (strangeness anti-charm)  (int z z))
  (rewrite c-anticharm      (charm-num anti-charm)    (int z (s z)))
  (rewrite tri-anticharm    (triality-of anti-charm)  t2)
  (rewrite m-anticharm      (rest-mass anti-charm)    (s (s z)))

  ;; ═════════════════════════════════════════════════════════════
  ;; §7  RECURSIVE EXTRACTORS
  ;; ═════════════════════════════════════════════════════════════

  (constructor total-charge : (-> Resource Int))
  (constructor total-baryon : (-> Resource Int))
  (constructor total-lepton : (-> Resource Int))
  (constructor total-strange : (-> Resource Int))
  (constructor total-charm : (-> Resource Int))
  (constructor total-triality : (-> Resource Triality))
  (constructor total-rest-mass : (-> Resource Nat))

  (rewrite tc-p (total-charge (particle ?p)) (charge ?p))
  (rewrite tc-t (total-charge (tensor ?a ?b))
                 (i-add (total-charge ?a) (total-charge ?b)))
  (rewrite tb-p (total-baryon (particle ?p)) (baryon ?p))
  (rewrite tb-t (total-baryon (tensor ?a ?b))
                 (i-add (total-baryon ?a) (total-baryon ?b)))
  (rewrite tl-p (total-lepton (particle ?p)) (lepton ?p))
  (rewrite tl-t (total-lepton (tensor ?a ?b))
                 (i-add (total-lepton ?a) (total-lepton ?b)))
  (rewrite ts-p (total-strange (particle ?p)) (strangeness ?p))
  (rewrite ts-t (total-strange (tensor ?a ?b))
                 (i-add (total-strange ?a) (total-strange ?b)))
  (rewrite tch-p (total-charm (particle ?p)) (charm-num ?p))
  (rewrite tch-t (total-charm (tensor ?a ?b))
                  (i-add (total-charm ?a) (total-charm ?b)))
  (rewrite ttri-p (total-triality (particle ?p)) (triality-of ?p))
  (rewrite ttri-t (total-triality (tensor ?a ?b))
                   (tri-add (total-triality ?a) (total-triality ?b)))
  (rewrite tm-p (total-rest-mass (particle ?p)) (rest-mass ?p))
  (rewrite tm-t (total-rest-mass (tensor ?a ?b))
                 (add (total-rest-mass ?a) (total-rest-mass ?b)))

  ;; ═════════════════════════════════════════════════════════════
  ;; §8  INTERACTION GUARD + TAGGED EXTRACTORS
  ;; ═════════════════════════════════════════════════════════════

  (constructor is-free : (-> Resource Bool))
  (rewrite free-particle (is-free (particle ?p)) true)
  (rewrite free-tensor   (is-free (tensor ?a ?b))
                          (and-bool (is-free ?a) (is-free ?b)))

  (sort Bit)
  (constructor b0 : Bit)
  (constructor b1 : Bit)
  (constructor tagged : (-> Bit Particle Resource))

  (rewrite tc-tagged    (total-charge (tagged ?b ?p))      (charge ?p))
  (rewrite tb-tagged    (total-baryon (tagged ?b ?p))      (baryon ?p))
  (rewrite tl-tagged    (total-lepton (tagged ?b ?p))      (lepton ?p))
  (rewrite ts-tagged    (total-strange (tagged ?b ?p))     (strangeness ?p))
  (rewrite tch-tagged   (total-charm (tagged ?b ?p))       (charm-num ?p))
  (rewrite ttri-tagged  (total-triality (tagged ?b ?p))    (triality-of ?p))
  (rewrite tm-tagged    (total-rest-mass (tagged ?b ?p))   (rest-mass ?p))
  (rewrite free-tagged  (is-free (tagged ?b ?p)) false)

  ;; ═════════════════════════════════════════════════════════════
  ;; §9  CHANNELS, VERTEX LIBRARY, PENALTIES, WEAK FLAVOR
  ;; ═════════════════════════════════════════════════════════════
  ;;
  ;; Four interaction channels: strong, em, weak, loop.
  ;; Each reaction must be in the vertex library (allowed ch IN OUT → true).
  ;; Channels carry suppression penalties: strong=0, em=1, weak=3, loop=5.
  ;; Weak channel additionally requires |ΔS|+|ΔC|≤1 (single-W constraint).

  (sort Channel)
  (constructor strong : Channel)
  (constructor em : Channel)
  (constructor weak : Channel)
  (constructor loop : Channel)

  ;; --- Vertex library: allowed reactions per channel ---
  (constructor allowed : (-> Channel Resource Resource Bool))

  ;; Strong vertices
  (rewrite allow-strong-meson
    (allowed strong (tensor (particle up-quark) (particle anti-up))
                    (tensor (particle pion-zero) (particle photon)))
    true)
  (rewrite allow-strong-baryon
    (allowed strong (tensor (particle up-quark) (tensor (particle up-quark) (particle down-quark)))
                    (tensor (particle proton) (particle photon)))
    true)
  (rewrite allow-strong-strange
    (allowed strong (tensor (particle up-quark) (particle anti-strange))
                    (tensor (particle kaon-plus) (particle photon)))
    true)

  ;; EM vertices
  (rewrite allow-em-pair
    (allowed em (tensor (particle photon) (particle photon))
               (tensor (particle electron) (particle positron)))
    true)
  (rewrite allow-em-annihilate
    (allowed em (tensor (particle electron) (particle positron))
               (tensor (particle photon) (particle photon)))
    true)
  (rewrite allow-em-compton
    (allowed em (tensor (particle electron) (particle photon))
               (tensor (particle electron) (particle photon)))
    true)

  ;; Weak vertices (scatter)
  (rewrite allow-weak-inverse-beta
    (allowed weak (tensor (particle antineutrino) (particle proton))
                  (tensor (particle neutron) (particle positron)))
    true)

  ;; Weak vertices (decay)
  (rewrite allow-weak-beta
    (allowed weak (particle neutron)
                  (tensor (particle proton) (tensor (particle electron) (particle antineutrino))))
    true)
  (rewrite allow-weak-kaon
    (allowed weak (particle kaon-plus)
                  (tensor (particle pion-zero) (tensor (particle positron) (particle neutrino))))
    true)

  ;; Loop vertex (light-by-light scattering via virtual e± box)
  (rewrite allow-loop-photon-scatter
    (allowed loop (tensor (particle photon) (particle photon))
                  (tensor (particle photon) (particle photon)))
    true)

  ;; --- Suppression penalties ---
  (constructor penalty : (-> Channel Nat))
  (rewrite pen-strong (penalty strong) z)
  (rewrite pen-em     (penalty em)     (s z))
  (rewrite pen-weak   (penalty weak)   (s (s (s z))))
  (rewrite pen-loop   (penalty loop)   (s (s (s (s (s z))))))

  ;; --- Nat proximity: |a-b| ≤ 1 ---
  (constructor nat-close : (-> Nat Nat Bool))
  (rewrite nc-zz  (nat-close z z)             true)
  (rewrite nc-zs  (nat-close z (s z))         true)
  (rewrite nc-sz  (nat-close (s z) z)         true)
  (rewrite nc-zss (nat-close z (s (s ?n)))    false)
  (rewrite nc-ssz (nat-close (s (s ?n)) z)    false)
  (rewrite nc-ss  (nat-close (s ?a) (s ?b))   (nat-close ?a ?b))

  ;; --- Absolute delta ≤ 1 on integers ---
  (constructor abs-delta-leq1 : (-> Int Int Bool))
  (rewrite adl-def (abs-delta-leq1 (int ?p1 ?n1) (int ?p2 ?n2))
                    (nat-close (add ?p1 ?n2) (add ?n1 ?p2)))

  ;; --- Boolean OR ---
  (constructor or-bool : (-> Bool Bool Bool))
  (rewrite or-tt (or-bool true true) true)
  (rewrite or-tf (or-bool true false) true)
  (rewrite or-ft (or-bool false true) true)
  (rewrite or-ff (or-bool false false) false)

  ;; --- Nat equality ---
  (constructor nat-eq : (-> Nat Nat Bool))
  (rewrite ne-zz (nat-eq z z) true)
  (rewrite ne-zs (nat-eq z (s ?n)) false)
  (rewrite ne-sz (nat-eq (s ?n) z) false)
  (rewrite ne-ss (nat-eq (s ?n) (s ?m)) (nat-eq ?n ?m))

  ;; --- Int equality ---
  (constructor int-eq : (-> Int Int Bool))
  (rewrite ie-def (int-eq (int ?p1 ?n1) (int ?p2 ?n2))
    (nat-eq (add ?p1 ?n2) (add ?n1 ?p2)))

  ;; --- Weak flavor check: single-W constraint ---
  ;; Physics: a single W boson changes exactly one flavor quantum number.
  ;; Manhattan distance: |ΔS| + |ΔC| ≤ 1.
  ;; Encoded as: (|ΔS|≤1 AND |ΔC|≤1) AND (ΔS=0 OR ΔC=0).
  ;; The first conjunct bounds each individually; the second ensures
  ;; at most one changes (blocking simultaneous ΔS=±1,ΔC=∓1).
  (constructor weak-flavor-ok : (-> Resource Resource Bool))
  (rewrite wfo-def (weak-flavor-ok ?IN ?OUT)
    (and-bool (and-bool (abs-delta-leq1 (total-strange ?IN) (total-strange ?OUT))
                        (abs-delta-leq1 (total-charm ?IN) (total-charm ?OUT)))
              (or-bool (int-eq (total-strange ?IN) (total-strange ?OUT))
                       (int-eq (total-charm ?IN) (total-charm ?OUT)))))

  ;; --- Budget comparison: Nat ≥ Nat ---
  (constructor nat-geq : (-> Nat Nat Bool))
  (rewrite geq-zz (nat-geq z z)           true)
  (rewrite geq-sz (nat-geq (s ?n) z)      true)
  (rewrite geq-zs (nat-geq z (s ?n))      false)
  (rewrite geq-ss (nat-geq (s ?n) (s ?m)) (nat-geq ?n ?m))

  ;; ═════════════════════════════════════════════════════════════
  ;; §10  JUDGMENTS AND RULES
  ;; ═════════════════════════════════════════════════════════════

  (judgment (has ?R) :where R : Resource)
  (judgment (eq ?a ?b) :where a : Int b : Int)
  (judgment (eq-tri ?a ?b) :where a : Triality b : Triality)
  (judgment (eq-bool ?a ?b) :where a : Bool b : Bool)
  (judgment (eq-mc ?a ?b) :where a : MassCheck b : MassCheck)
  (judgment (conserved ?Ch ?A ?B) :where Ch : Channel A : Resource B : Resource)
  (judgment (cms-energy ?S) :where S : Nat)
  (judgment (has-under ?R ?Budget) :where R : Resource Budget : Nat)

  (rule eq-refl       :premises () :conclusion (eq ?a ?a))
  (rule eq-tri-refl   :premises () :conclusion (eq-tri ?a ?a))
  (rule eq-bool-refl  :premises () :conclusion (eq-bool ?a ?a))
  (rule eq-mc-refl    :premises () :conclusion (eq-mc ?a ?a))

  (rule tensor-intro
    :premises ((has ?A) (has ?B))
    :conclusion (has (tensor ?A ?B)))

  ;; STRONG CONSERVATION: Q, B, L, S, C + center-neutral + free.
  (rule conserve-strong
    :premises (
      (eq (total-charge ?A) (total-charge ?B))
      (eq (total-baryon ?A) (total-baryon ?B))
      (eq (total-lepton ?A) (total-lepton ?B))
      (eq (total-strange ?A) (total-strange ?B))
      (eq (total-charm ?A) (total-charm ?B))
      (eq-tri (total-triality ?A) t0)
      (eq-tri (total-triality ?B) t0)
      (eq-bool (is-free ?A) true)
      (eq-bool (is-free ?B) true))
    :conclusion (conserved strong ?A ?B))

  ;; EM CONSERVATION: same as strong (Q, B, L, S, C + triality + free).
  (rule conserve-em
    :premises (
      (eq (total-charge ?A) (total-charge ?B))
      (eq (total-baryon ?A) (total-baryon ?B))
      (eq (total-lepton ?A) (total-lepton ?B))
      (eq (total-strange ?A) (total-strange ?B))
      (eq (total-charm ?A) (total-charm ?B))
      (eq-tri (total-triality ?A) t0)
      (eq-tri (total-triality ?B) t0)
      (eq-bool (is-free ?A) true)
      (eq-bool (is-free ?B) true))
    :conclusion (conserved em ?A ?B))

  ;; WEAK CONSERVATION: Q, B, L + center-neutral + free + weak flavor ok.
  ;; Does NOT check S or C individually, but enforces |ΔS|+|ΔC|≤1 (single-W).
  (rule conserve-weak
    :premises (
      (eq (total-charge ?A) (total-charge ?B))
      (eq (total-baryon ?A) (total-baryon ?B))
      (eq (total-lepton ?A) (total-lepton ?B))
      (eq-tri (total-triality ?A) t0)
      (eq-tri (total-triality ?B) t0)
      (eq-bool (is-free ?A) true)
      (eq-bool (is-free ?B) true)
      (eq-bool (weak-flavor-ok ?A ?B) true))
    :conclusion (conserved weak ?A ?B))

  ;; LOOP CONSERVATION: same as strong/EM (all quantum numbers conserved).
  ;; Loop processes are higher-order (virtual particle mediation) but
  ;; still obey all conservation laws.
  (rule conserve-loop
    :premises (
      (eq (total-charge ?A) (total-charge ?B))
      (eq (total-baryon ?A) (total-baryon ?B))
      (eq (total-lepton ?A) (total-lepton ?B))
      (eq (total-strange ?A) (total-strange ?B))
      (eq (total-charm ?A) (total-charm ?B))
      (eq-tri (total-triality ?A) t0)
      (eq-tri (total-triality ?B) t0)
      (eq-bool (is-free ?A) true)
      (eq-bool (is-free ?B) true))
    :conclusion (conserved loop ?A ?B))

  ;; SCATTER: 2+ in → 2+ out, channel-parameterized.
  ;; Output (tensor ?C ?D) is a binary tensor; for 3+ output particles,
  ;; nest: (tensor (tensor A B) C).  Conservation extractors recurse
  ;; on tensor, so nested shapes are handled correctly.
  ;; Premise 5 (scatter-4mom-ok) ensures the input 4-momentum is
  ;; kinematically valid: timelike (massive beam), or noncollinear
  ;; (massless beams at an angle).
  (rule interact-scatter
    :premises (
      (has (tensor ?A ?B))
      (conserved ?Ch (tensor ?A ?B) (tensor ?C ?D))
      (eq-bool (allowed ?Ch (tensor ?A ?B) (tensor ?C ?D)) true)
      (cms-energy ?S)
      (eq-mc (check-mass ?S (total-rest-mass (tensor ?C ?D))) mass-ok)
      (scatter-4mom-ok (tensor ?A ?B) true))
    :conclusion (has (tensor ?C ?D)))

  ;; DECAY: 1 particle → products, channel-parameterized.
  (rule interact-decay
    :premises (
      (has (particle ?P))
      (conserved ?Ch (particle ?P) ?OUT)
      (eq-bool (allowed ?Ch (particle ?P) ?OUT) true)
      (eq-mc (check-mass (rest-mass ?P) (total-rest-mass ?OUT)) mass-ok))
    :conclusion (has ?OUT))

  (rule tensor-elim
    :premises ((has (tensor ?A ?B)) (has ?C))
    :conclusion (has ?C)
    :context ((1 (has ?A)) (1 (has ?B))))

  ;; --- Budget-bounded rules ---
  (rule tensor-intro-under
    :premises ((has-under ?A ?B) (has-under ?C ?B))
    :conclusion (has-under (tensor ?A ?C) ?B))

  (rule interact-scatter-under
    :premises (
      (has-under (tensor ?A ?B) ?Budget)
      (conserved ?Ch (tensor ?A ?B) (tensor ?C ?D))
      (eq-bool (allowed ?Ch (tensor ?A ?B) (tensor ?C ?D)) true)
      (cms-energy ?S)
      (eq-mc (check-mass ?S (total-rest-mass (tensor ?C ?D))) mass-ok)
      (eq-bool (nat-geq ?Budget (penalty ?Ch)) true)
      (scatter-4mom-ok (tensor ?A ?B) true))
    :conclusion (has-under (tensor ?C ?D) ?Budget))

  (rule interact-decay-under
    :premises (
      (has-under (particle ?P) ?Budget)
      (conserved ?Ch (particle ?P) ?OUT)
      (eq-bool (allowed ?Ch (particle ?P) ?OUT) true)
      (eq-mc (check-mass (rest-mass ?P) (total-rest-mass ?OUT)) mass-ok)
      (eq-bool (nat-geq ?Budget (penalty ?Ch)) true))
    :conclusion (has-under ?OUT ?Budget))

  ;; ═════════════════════════════════════════════════════════════
  ;; §11  CLASSICAL REVERSIBLE BIT GATES
  ;; ═════════════════════════════════════════════════════════════

  (rule gate-cnot-zz
    :premises ((has (tensor (tagged b0 ?P1) (tagged b0 ?P2))))
    :conclusion (has (tensor (tagged b0 ?P1) (tagged b0 ?P2))))
  (rule gate-cnot-zu
    :premises ((has (tensor (tagged b0 ?P1) (tagged b1 ?P2))))
    :conclusion (has (tensor (tagged b0 ?P1) (tagged b1 ?P2))))
  (rule gate-cnot-uz
    :premises ((has (tensor (tagged b1 ?P1) (tagged b0 ?P2))))
    :conclusion (has (tensor (tagged b1 ?P1) (tagged b1 ?P2))))
  (rule gate-cnot-uu
    :premises ((has (tensor (tagged b1 ?P1) (tagged b1 ?P2))))
    :conclusion (has (tensor (tagged b1 ?P1) (tagged b0 ?P2))))

  (rule gate-rcnot-zz
    :premises ((has (tensor (tagged b0 ?P1) (tagged b0 ?P2))))
    :conclusion (has (tensor (tagged b0 ?P1) (tagged b0 ?P2))))
  (rule gate-rcnot-uz
    :premises ((has (tensor (tagged b1 ?P1) (tagged b0 ?P2))))
    :conclusion (has (tensor (tagged b1 ?P1) (tagged b0 ?P2))))
  (rule gate-rcnot-zu
    :premises ((has (tensor (tagged b0 ?P1) (tagged b1 ?P2))))
    :conclusion (has (tensor (tagged b1 ?P1) (tagged b1 ?P2))))
  (rule gate-rcnot-uu
    :premises ((has (tensor (tagged b1 ?P1) (tagged b1 ?P2))))
    :conclusion (has (tensor (tagged b0 ?P1) (tagged b1 ?P2))))

  ;; ═════════════════════════════════════════════════════════════
  ;; §12a  VKIND LATTICE — Causal Classification of 4-Momentum
  ;; ═════════════════════════════════════════════════════════════
  ;;
  ;; VKind classifies a resource's total 4-momentum by causal type:
  ;;   lightlike  — on the light cone (massless particles)
  ;;   timelike   — inside the future light cone (massive particles)
  ;;   spacelike  — outside the light cone (tachyonic, unphysical)
  ;;   vk-unknown — cannot determine without beam geometry info
  ;;
  ;; kind-add is CONSERVATIVE: only timelike+timelike, timelike+lightlike,
  ;; and lightlike+timelike are guaranteed timelike.  lightlike+lightlike
  ;; returns vk-unknown (collinear vs non-collinear ambiguity).
  ;; Spacelike is INFECTIOUS: any spacelike operand propagates spacelike,
  ;; blocking the reaction entirely (no rule derives scatter-4mom-ok
  ;; from spacelike).  vk-unknown + anything non-spacelike stays unknown.

  (sort VKind)
  (constructor lightlike : VKind)
  (constructor timelike : VKind)
  (constructor spacelike : VKind)
  (constructor vk-unknown : VKind)

  (constructor kind-add : (-> VKind VKind VKind))

  ;; Timelike + anything known → timelike (massive + anything is massive)
  (rewrite ka-tt (kind-add timelike timelike) timelike)
  (rewrite ka-tl (kind-add timelike lightlike) timelike)
  (rewrite ka-lt (kind-add lightlike timelike) timelike)

  ;; Lightlike + lightlike → unknown (could be collinear → still lightlike)
  (rewrite ka-ll (kind-add lightlike lightlike) vk-unknown)

  ;; Spacelike is INFECTIOUS — propagates through all combinations.
  ;; No scatter-4mom-ok rule accepts spacelike, so this blocks reactions.
  (rewrite ka-ts (kind-add timelike spacelike) spacelike)
  (rewrite ka-st (kind-add spacelike timelike) spacelike)
  (rewrite ka-ls (kind-add lightlike spacelike) spacelike)
  (rewrite ka-sl (kind-add spacelike lightlike) spacelike)
  (rewrite ka-ss (kind-add spacelike spacelike) spacelike)
  (rewrite ka-su (kind-add spacelike vk-unknown) spacelike)
  (rewrite ka-us (kind-add vk-unknown spacelike) spacelike)

  ;; Unknown + non-spacelike → unknown
  (rewrite ka-tu (kind-add timelike vk-unknown) vk-unknown)
  (rewrite ka-ut (kind-add vk-unknown timelike) vk-unknown)
  (rewrite ka-lu (kind-add lightlike vk-unknown) vk-unknown)
  (rewrite ka-ul (kind-add vk-unknown lightlike) vk-unknown)
  (rewrite ka-uu (kind-add vk-unknown vk-unknown) vk-unknown)

  ;; ═════════════════════════════════════════════════════════════
  ;; §12b  4-MOMENTUM CLASSIFICATION — Per-Particle and Recursive
  ;; ═════════════════════════════════════════════════════════════

  (constructor particle-kind : (-> Particle VKind))

  ;; Lightlike: photon, neutrino, antineutrino (truly massless or ~massless)
  (rewrite pk-photon       (particle-kind photon)         lightlike)
  (rewrite pk-neutrino     (particle-kind neutrino)       lightlike)
  (rewrite pk-antineutrino (particle-kind antineutrino)   lightlike)

  ;; Timelike: all massive particles.  Quarks are physically massive
  ;; (current mass ~ few MeV); rest-mass=0 in our Nat scale is a
  ;; modelling convenience, but particle-kind reflects their true
  ;; causal class, not the discretized mass proxy.
  (rewrite pk-up           (particle-kind up-quark)        timelike)
  (rewrite pk-down         (particle-kind down-quark)      timelike)
  (rewrite pk-antiup       (particle-kind anti-up)         timelike)
  (rewrite pk-antidown     (particle-kind anti-down)       timelike)
  (rewrite pk-proton       (particle-kind proton)          timelike)
  (rewrite pk-neutron      (particle-kind neutron)         timelike)
  (rewrite pk-electron     (particle-kind electron)        timelike)
  (rewrite pk-positron     (particle-kind positron)        timelike)
  (rewrite pk-pion         (particle-kind pion-zero)       timelike)
  (rewrite pk-kaon         (particle-kind kaon-plus)       timelike)
  (rewrite pk-strange      (particle-kind strange-quark)   timelike)
  (rewrite pk-charm        (particle-kind charm-quark)     timelike)
  (rewrite pk-antistrange  (particle-kind anti-strange)    timelike)
  (rewrite pk-anticharm    (particle-kind anti-charm)      timelike)
  (rewrite pk-target       (particle-kind target)          timelike)

  ;; Recursive momentum kind over resources
  (constructor mom-kind : (-> Resource VKind))
  (rewrite mk-particle (mom-kind (particle ?p))    (particle-kind ?p))
  (rewrite mk-tensor   (mom-kind (tensor ?a ?b))   (kind-add (mom-kind ?a) (mom-kind ?b)))
  (rewrite mk-tagged   (mom-kind (tagged ?b ?p))   (particle-kind ?p))

  ;; ═════════════════════════════════════════════════════════════
  ;; §12c  NONCOLLINEAR WITNESS
  ;; ═════════════════════════════════════════════════════════════
  ;;
  ;; Two massless beams (lightlike+lightlike) have timelike total
  ;; 4-momentum ONLY if they are not collinear. This is a geometric
  ;; fact about the experiment, not derivable from particle properties.
  ;; Parameterized by the specific input resource to scope the witness
  ;; and prevent ambient authority (an unscoped witness would justify
  ;; any vk-unknown input, not just the intended beam pair).

  (sort Witness)
  (constructor noncollinear : Witness)

  (judgment (noncollinear-beams ?IN) :where IN : Resource)
  (judgment (collinear-beams ?IN) :where IN : Resource)

  ;; ═════════════════════════════════════════════════════════════
  ;; §12d  SR JUDGMENTS — 4-Momentum Admissibility
  ;; ═════════════════════════════════════════════════════════════

  ;; eq-vk is DEFINITIONAL EQUALITY only (reflexivity, no subtyping).
  ;; (eq-vk (mom-kind ?IN) timelike) holds iff mom-kind rewrites to
  ;; timelike.  Do NOT add non-trivial eq-vk axioms (e.g., subtyping
  ;; vk-unknown ≤ timelike) — that would blow the SR gate open.
  (judgment (eq-vk ?a ?b) :where a : VKind b : VKind)
  (rule eq-vk-refl :premises () :conclusion (eq-vk ?a ?a))

  ;; scatter-4mom-ok: DECIDABLE boolean gate for 4-momentum admissibility.
  ;; Second argument is the decision: true (scatter allowed) or false
  ;; (scatter blocked).  This is a causal-type sanity filter, not full
  ;; 4-vector conservation.  The mass threshold (check-mass) is the real
  ;; energy gate; scatter-4mom-ok is a necessary precondition.
  ;;
  ;; Scatter rules require (scatter-4mom-ok ?IN true).  Refutations
  ;; succeed when no rule can derive the true case; the explicit false
  ;; rules document WHY the gate blocks (collinear geometry, spacelike
  ;; input) rather than relying on proof absence.
  (judgment (scatter-4mom-ok ?R ?B) :where R : Resource B : Bool)

  ;; OK: input kind computes to timelike (massive beam → COM frame exists).
  (rule sr-ok-timelike
    :premises ((eq-vk (mom-kind ?IN) timelike))
    :conclusion (scatter-4mom-ok ?IN true))

  ;; OK: input kind is unknown + noncollinear geometry witness.
  (rule sr-ok-nc
    :premises ((eq-vk (mom-kind ?IN) vk-unknown)
               (noncollinear-beams ?IN))
    :conclusion (scatter-4mom-ok ?IN true))

  ;; BLOCKED: input kind is unknown + collinear geometry → no COM frame.
  (rule sr-blocked-collinear
    :premises ((eq-vk (mom-kind ?IN) vk-unknown)
               (collinear-beams ?IN))
    :conclusion (scatter-4mom-ok ?IN false))

  ;; BLOCKED: spacelike input → tachyonic, unphysical.
  (rule sr-blocked-spacelike
    :premises ((eq-vk (mom-kind ?IN) spacelike))
    :conclusion (scatter-4mom-ok ?IN false))

  ;; ═════════════════════════════════════════════════════════════
  ;; §12e  RECOIL TARGET + BETHE-HEITLER VERTEX
  ;; ═════════════════════════════════════════════════════════════
  ;;
  ;; An effective recoil partner for pair production from a single
  ;; photon. In real physics, this role is played by a heavy nucleus
  ;; (Bethe-Heitler process: γ + Z → e⁻ + e⁺ + Z).
  ;;
  ;; The target is modelled as a neutral, colorless, massive particle
  ;; with no quantum numbers — a momentum sink, not a faithful
  ;; nuclear representation.  Mass=3 on our Nat scale (comparable
  ;; to kaon) is an effective value, not a claim about nuclear mass.
  ;;
  ;; Target: Q=0, B=0, L=0, S=0, C=0, t0, mass=3 (effective).

  (constructor target : Particle)
  (rewrite q-target      (charge target)       (int z z))
  (rewrite b-target      (baryon target)       (int z z))
  (rewrite l-target      (lepton target)       (int z z))
  (rewrite s-target      (strangeness target)  (int z z))
  (rewrite c-target      (charm-num target)    (int z z))
  (rewrite tri-target    (triality-of target)  t0)
  (rewrite m-target      (rest-mass target)    (s (s (s z))))

  ;; Bethe-Heitler vertex: γ + target → (e⁻ + e⁺) + target
  (rewrite allow-em-bethe-heitler
    (allowed em (tensor (particle photon) (particle target))
               (tensor (tensor (particle electron) (particle positron))
                       (particle target)))
    true)

  ;; ═════════════════════════════════════════════════════════════
  ;; §12f  KIND-CONSISTENCY AUDIT
  ;; ═════════════════════════════════════════════════════════════
  ;;
  ;; Since particle-kind reflects physical causal class (not derived
  ;; from Nat rest-mass), we add a lightweight consistency check:
  ;;   mass > 0  ⇒  kind must be timelike
  ;;   mass = 0  ⇒  any kind is acceptable (modeling choice)
  ;; This catches future edits that accidentally make a massive
  ;; particle lightlike or vice versa.

  (constructor is-zero-nat : (-> Nat Bool))
  (rewrite izn-z (is-zero-nat z)      true)
  (rewrite izn-s (is-zero-nat (s ?n)) false)

  (constructor is-timelike : (-> VKind Bool))
  (rewrite it-t (is-timelike timelike)   true)
  (rewrite it-l (is-timelike lightlike)  false)
  (rewrite it-s (is-timelike spacelike)  false)
  (rewrite it-u (is-timelike vk-unknown) false)

  ;; kind-consistent p = (mass=0) OR (kind=timelike)
  ;; Computes to true for every well-configured particle.
  (constructor kind-consistent : (-> Particle Bool))
  (rewrite kc-def (kind-consistent ?p)
    (or-bool (is-zero-nat (rest-mass ?p))
             (is-timelike (particle-kind ?p))))
)

(check-theory GUTPhys)


;;; ═══════════════════════════════════════════════════════════════════
;;;  ╔════════════════════════════════════════════════════════════╗
;;;  ║  PART I: STRONG / EM REACTIONS                            ║
;;;  ╚════════════════════════════════════════════════════════════╝
;;; ═══════════════════════════════════════════════════════════════════


;;; ═══════════════════════════════════════════════════════════════════
;;;  1. PAIR PRODUCTION:  γ + γ → e⁻ + e⁺  (EM scatter)
;;; ═══════════════════════════════════════════════════════════════════
;;;
;;;  Two photons annihilate into an electron-positron pair.
;;;  REQUIRES two photons — a single photon cannot produce massive
;;;  particles (blocked by interact-decay mass threshold).
;;;  cms ≥ mass(e)+mass(e⁺) = 1+1 = 2.
;;;
;;;    Q: 0+0 = 0 → (-3)+3 = 0       ✓
;;;    B: 0 → 0                        ✓
;;;    L: 0 → 3+(-3) = 0              ✓
;;;    S: 0 → 0                        ✓
;;;    C: 0 → 0                        ✓
;;;    Tri: t0+t0=t0 → t0+t0=t0       ✓
;;;    Mass: cms(2) ≥ 1+1 = 2         ✓

(proof pair-production :theory GUTPhys
  :assumptions (
    (has (particle photon))
    (has (particle photon))
    (cms-energy (s (s z)))
    (noncollinear-beams (tensor (particle photon) (particle photon))))
  :goal (has (tensor (particle electron) (particle positron)))
  :derivation
    (interact-scatter
      (tensor-intro (assumption 0) (assumption 1))
      (conserve-em (eq-refl) (eq-refl) (eq-refl) (eq-refl) (eq-refl)
                   (eq-tri-refl) (eq-tri-refl)
                   (eq-bool-refl) (eq-bool-refl))
      (eq-bool-refl)
      (assumption 2)
      (eq-mc-refl)
      (sr-ok-nc (eq-vk-refl) (assumption 3))))


;;; ═══════════════════════════════════════════════════════════════════
;;;  2. ANNIHILATION:  e⁻ + e⁺ → γ + γ  (EM scatter)
;;; ═══════════════════════════════════════════════════════════════════
;;;
;;;  Matter meets antimatter → two photons.
;;;
;;;    Q: (-3)+3 = 0 → 0+0 = 0       ✓
;;;    B: 0 → 0                        ✓
;;;    L: 3+(-3) = 0 → 0              ✓
;;;    S: 0 → 0                        ✓
;;;    C: 0 → 0                        ✓
;;;    Tri: t0+t0=t0 → t0+t0=t0       ✓

(proof annihilation :theory GUTPhys
  :assumptions (
    (has (particle electron))
    (has (particle positron))
    (cms-energy (s (s z))))
  :goal (has (tensor (particle photon) (particle photon)))
  :derivation
    (interact-scatter
      (tensor-intro (assumption 0) (assumption 1))
      (conserve-em (eq-refl) (eq-refl) (eq-refl) (eq-refl) (eq-refl)
                   (eq-tri-refl) (eq-tri-refl)
                   (eq-bool-refl) (eq-bool-refl))
      (eq-bool-refl)
      (assumption 2)
      (eq-mc-refl)
      (sr-ok-timelike (eq-vk-refl))))


;;; ═══════════════════════════════════════════════════════════════════
;;;  3. COMPTON SCATTERING:  e⁻ + γ → e⁻ + γ  (EM scatter)
;;; ═══════════════════════════════════════════════════════════════════

(proof compton-scattering :theory GUTPhys
  :assumptions (
    (has (tensor (particle electron) (particle photon)))
    (cms-energy (s z)))
  :goal (has (tensor (particle electron) (particle photon)))
  :derivation
    (interact-scatter
      (assumption 0)
      (conserve-em (eq-refl) (eq-refl) (eq-refl) (eq-refl) (eq-refl)
                   (eq-tri-refl) (eq-tri-refl)
                   (eq-bool-refl) (eq-bool-refl))
      (eq-bool-refl)
      (assumption 1)
      (eq-mc-refl)
      (sr-ok-timelike (eq-vk-refl))))


;;; ═══════════════════════════════════════════════════════════════════
;;;  4. MESON FORMATION:  u + ū → π⁰ + γ  (strong, spectator photon)
;;; ═══════════════════════════════════════════════════════════════════
;;;
;;;  A quark and antiquark combine into a pion. Spectator photon
;;;  absorbs recoil momentum (scatter requires 2+ output).
;;;
;;;    Q: 2+(-2) = 0 → 0+0 = 0       ✓
;;;    B: 1+(-1) = 0 → 0+0 = 0       ✓
;;;    S: 0 → 0                        ✓
;;;    C: 0 → 0                        ✓
;;;    Tri: t1+t2=t0 → t0+t0=t0       ✓
;;;    Mass: cms(2) ≥ 2+0 = 2         ✓

(proof meson-formation :theory GUTPhys
  :assumptions (
    (has (particle up-quark))
    (has (particle anti-up))
    (cms-energy (s (s z))))
  :goal (has (tensor (particle pion-zero) (particle photon)))
  :derivation
    (interact-scatter
      (tensor-intro (assumption 0) (assumption 1))
      (conserve-strong (eq-refl) (eq-refl) (eq-refl) (eq-refl) (eq-refl)
                       (eq-tri-refl) (eq-tri-refl)
                       (eq-bool-refl) (eq-bool-refl))
      (eq-bool-refl)
      (assumption 2)
      (eq-mc-refl)
      (sr-ok-timelike (eq-vk-refl))))


;;; ═══════════════════════════════════════════════════════════════════
;;;  5. BARYON FORMATION:  u + u + d → p + γ  (strong, spectator)
;;; ═══════════════════════════════════════════════════════════════════
;;;
;;;  Three quarks combine into a proton.
;;;
;;;    Q: 2+2+(-1) = 3 → 3+0 = 3     ✓
;;;    B: 1+1+1 = 3 → 3+0 = 3        ✓
;;;    S: 0 → 0                        ✓
;;;    C: 0 → 0                        ✓
;;;    Tri: t1+t1+t1 = t2+t1 = t0
;;;         → t0+t0 = t0              ✓
;;;    Mass: cms(5) ≥ 5+0 = 5         ✓

(proof baryon-formation :theory GUTPhys
  :assumptions (
    (has (particle up-quark))
    (has (particle up-quark))
    (has (particle down-quark))
    (cms-energy (s (s (s (s (s z)))))))
  :goal (has (tensor (particle proton) (particle photon)))
  :derivation
    (interact-scatter
      (tensor-intro (assumption 0)
        (tensor-intro (assumption 1) (assumption 2)))
      (conserve-strong (eq-refl) (eq-refl) (eq-refl) (eq-refl) (eq-refl)
                       (eq-tri-refl) (eq-tri-refl)
                       (eq-bool-refl) (eq-bool-refl))
      (eq-bool-refl)
      (assumption 3)
      (eq-mc-refl)
      (sr-ok-timelike (eq-vk-refl))))


;;; ═══════════════════════════════════════════════════════════════════
;;;  6. STRANGE MESON:  u + s̄ → K⁺ + γ  (strong)
;;; ═══════════════════════════════════════════════════════════════════
;;;
;;;  Demonstrates strangeness conservation in strong interaction:
;;;
;;;    Q: 2+1 = 3 → 3+0 = 3          ✓
;;;    B: 1+(-1) = 0 → 0+0 = 0       ✓
;;;    S: 0+1 = 1 → 1+0 = 1          ✓  (conserved!)
;;;    C: 0 → 0                        ✓
;;;    Tri: t1+t2=t0 → t0+t0=t0       ✓
;;;    Mass: cms(3) ≥ 3+0 = 3         ✓

(proof strange-meson-formation :theory GUTPhys
  :assumptions (
    (has (particle up-quark))
    (has (particle anti-strange))
    (cms-energy (s (s (s z)))))
  :goal (has (tensor (particle kaon-plus) (particle photon)))
  :derivation
    (interact-scatter
      (tensor-intro (assumption 0) (assumption 1))
      (conserve-strong (eq-refl) (eq-refl) (eq-refl) (eq-refl) (eq-refl)
                       (eq-tri-refl) (eq-tri-refl)
                       (eq-bool-refl) (eq-bool-refl))
      (eq-bool-refl)
      (assumption 2)
      (eq-mc-refl)
      (sr-ok-timelike (eq-vk-refl))))


;;; ═══════════════════════════════════════════════════════════════════
;;;  ╔════════════════════════════════════════════════════════════╗
;;;  ║  PART II: WEAK REACTIONS                                  ║
;;;  ╚════════════════════════════════════════════════════════════╝
;;; ═══════════════════════════════════════════════════════════════════


;;; ═══════════════════════════════════════════════════════════════════
;;;  7. BETA DECAY:  n → p + e⁻ + ν̄ₑ  (weak decay)
;;; ═══════════════════════════════════════════════════════════════════
;;;
;;;  The classic weak process. Uses interact-decay-weak because beta
;;;  decay IS a weak process (W boson mediates d→u+e⁻+ν̄ₑ).
;;;  S and C happen to be conserved here, but the rule doesn't check.
;;;
;;;    Q: 0 → 3+(-3)+0 = 0            ✓
;;;    B: 3 → 3+0+0 = 3               ✓
;;;    L: 0 → 0+3+(-3) = 0            ✓
;;;    Tri: t0 → t0+t0+t0 = t0        ✓
;;;    Mass: 6 ≥ 5+1+0 = 6            ✓  (exactly at threshold)

(proof beta-decay :theory GUTPhys
  :assumptions ((has (particle neutron)))
  :goal (has (tensor (particle proton)
               (tensor (particle electron)
                       (particle antineutrino))))
  :derivation
    (interact-decay
      (assumption)
      (conserve-weak (eq-refl) (eq-refl) (eq-refl)
                     (eq-tri-refl) (eq-tri-refl)
                     (eq-bool-refl) (eq-bool-refl)
                     (eq-bool-refl))
      (eq-bool-refl)
      (eq-mc-refl)))


;;; ═══════════════════════════════════════════════════════════════════
;;;  8. INVERSE BETA:  ν̄ₑ + p → n + e⁺  (weak scatter)
;;; ═══════════════════════════════════════════════════════════════════
;;;
;;;  The reverse weak process. Used in neutrino detectors.
;;;
;;;    Q: 0+3 = 3 → 0+3 = 3           ✓
;;;    B: 0+3 = 3 → 3+0 = 3           ✓
;;;    L: (-3)+0 = -3 → 0+(-3) = -3   ✓
;;;    Tri: t0+t0=t0 → t0+t0=t0       ✓
;;;    Mass: cms(7) ≥ 6+1 = 7         ✓

(proof inverse-beta :theory GUTPhys
  :assumptions (
    (has (tensor (particle antineutrino) (particle proton)))
    (cms-energy (s (s (s (s (s (s (s z)))))))))
  :goal (has (tensor (particle neutron) (particle positron)))
  :derivation
    (interact-scatter
      (assumption 0)
      (conserve-weak (eq-refl) (eq-refl) (eq-refl)
                     (eq-tri-refl) (eq-tri-refl)
                     (eq-bool-refl) (eq-bool-refl)
                     (eq-bool-refl))
      (eq-bool-refl)
      (assumption 1)
      (eq-mc-refl)
      (sr-ok-timelike (eq-vk-refl))))


;;; 9. KAON WEAK DECAY:  K⁺ → π⁰ + e⁺ + ν  (weak decay, ΔS=1)
;;;
;;;    This was IMPOSSIBLE in v3 (strangeness conservation blocked it).
;;;    Now derivable because the weak interaction does not conserve S:
;;;      Q: +3 → 0+3+0 = 3    ✓
;;;      B: 0 → 0              ✓
;;;      L: 0 → 0+(-3)+3 = 0  ✓
;;;      S: +1 → 0+0+0 = 0    (ΔS = -1, allowed by weak!)
;;;      Mass: 3 ≥ 2+1+0 = 3  ✓

(proof kaon-weak-decay :theory GUTPhys
  :assumptions ((has (particle kaon-plus)))
  :goal (has (tensor (particle pion-zero)
               (tensor (particle positron)
                       (particle neutrino))))
  :derivation
    (interact-decay
      (assumption)
      (conserve-weak (eq-refl) (eq-refl) (eq-refl)
                     (eq-tri-refl) (eq-tri-refl)
                     (eq-bool-refl) (eq-bool-refl)
                     (eq-bool-refl))
      (eq-bool-refl)
      (eq-mc-refl)))


;;; ═══════════════════════════════════════════════════════════════════
;;;  ╔════════════════════════════════════════════════════════════╗
;;;  ║  PART III: IMPOSSIBILITY — Conservation Checks            ║
;;;  ╚════════════════════════════════════════════════════════════╝
;;; ═══════════════════════════════════════════════════════════════════


;;; ═══════════════════════════════════════════════════════════════════
;;;  10. NO PROTON DECAY:  p ⊬ e⁺ + π⁰
;;; ═══════════════════════════════════════════════════════════════════
;;;
;;;  Baryon number violation: B goes from 3 → 0.
;;;  Blocked by both strong and weak conservation (both check B).
;;;  Predicted by some GUTs, never observed experimentally.

(refute no-proton-decay
  :theory GUTPhys
  :assumptions ((has (particle proton)))
  :goal (has (tensor (particle positron) (particle pion-zero)))
  :depth 5)


;;; ═══════════════════════════════════════════════════════════════════
;;;  11. NO QUARK ESCAPE:  p ⊬ u
;;; ═══════════════════════════════════════════════════════════════════
;;;
;;;  An isolated quark can never appear. The output has triality=t1,
;;;  which fails the center-neutral check (t0) in both conservation
;;;  rules. This is the Z₃ obstruction: colored states cannot
;;;  escape to be observed.

(refute no-quark-escape
  :theory GUTPhys
  :assumptions ((has (particle proton)))
  :goal (has (particle up-quark))
  :depth 5)


;;; ═══════════════════════════════════════════════════════════════════
;;;  12. NO CHARGE CREATION:  γ ⊬ e⁻
;;; ═══════════════════════════════════════════════════════════════════
;;;
;;;  Q: 0 → -3, L: 0 → +3. Both violated.

(refute no-charge-creation
  :theory GUTPhys
  :assumptions ((has (particle photon)))
  :goal (has (particle electron))
  :depth 5)


;;; ═══════════════════════════════════════════════════════════════════
;;;  13. NO BARYON GENESIS:  γ ⊬ p
;;; ═══════════════════════════════════════════════════════════════════
;;;
;;;  Q: 0 → +3, B: 0 → +3. Both violated.

(refute no-baryon-genesis
  :theory GUTPhys
  :assumptions ((has (particle photon)))
  :goal (has (particle proton))
  :depth 5)


;;; ═══════════════════════════════════════════════════════════════════
;;;  14. NO LEPTON ALCHEMY:  e⁻ ⊬ ν̄ₑ
;;; ═══════════════════════════════════════════════════════════════════
;;;
;;;  Q: -3 → 0, L: +3 → -3. Both violated.

(refute no-lepton-alchemy
  :theory GUTPhys
  :assumptions ((has (particle electron)))
  :goal (has (particle antineutrino))
  :depth 5)


;;; ═══════════════════════════════════════════════════════════════════
;;;  15. NO VACUUM PAIR PRODUCTION:  γ ⊬ e⁻ + e⁺
;;; ═══════════════════════════════════════════════════════════════════
;;;
;;;  A single photon cannot produce a massive pair. Conservation of
;;;  Q/B/L all pass, but the mass threshold blocks it:
;;;  mass(γ)=0 < mass(e)+mass(e⁺)=2.
;;;
;;;  In reality, this is blocked by 4-momentum conservation (a
;;;  massless on-shell photon cannot produce massive pairs in any
;;;  frame). Our mass threshold is an acceptable proxy.

(refute no-vacuum-pair-production
  :theory GUTPhys
  :assumptions ((has (particle photon)))
  :goal (has (tensor (particle electron) (particle positron)))
  :depth 5)


;;; ═══════════════════════════════════════════════════════════════════
;;;  16. NO DIQUARK:  u + u ⊬ p
;;; ═══════════════════════════════════════════════════════════════════
;;;
;;;  Two quarks cannot form a center-neutral state.
;;;  Triality: t1+t1 = t2 ≠ t0. Need three quarks (t1+t1+t1=t0).

(refute no-diquark
  :theory GUTPhys
  :assumptions ((has (particle up-quark)) (has (particle up-quark)))
  :goal (has (particle proton))
  :depth 5)


;;; ═══════════════════════════════════════════════════════════════════
;;;  17. NO CHARM FROM LIGHT QUARKS:  u + d ⊬ c + d
;;; ═══════════════════════════════════════════════════════════════════
;;;
;;;  Cannot create charm quarks from non-charm quarks.
;;;  Center-neutral blocks: both sides have triality t1+t1=t2≠t0.
;;;  Additionally, charm conservation (in strong mode) would block
;;;  even in a center-neutral configuration: C goes from 0 → 1.

(refute no-charm-from-light
  :theory GUTPhys
  :assumptions (
    (has (particle up-quark))
    (has (particle down-quark)))
  :goal (has (tensor (particle charm-quark) (particle down-quark)))
  :depth 5)


;;; ═══════════════════════════════════════════════════════════════════
;;;  ╔════════════════════════════════════════════════════════════╗
;;;  ║  PART IV: CLASSICAL INFORMATION — Reversible Bit Gates    ║
;;;  ╚════════════════════════════════════════════════════════════╝
;;; ═══════════════════════════════════════════════════════════════════


;;; ═══════════════════════════════════════════════════════════════════
;;;  18. PHYSICAL MEASUREMENT (Von Neumann Pre-Measurement)
;;; ═══════════════════════════════════════════════════════════════════
;;;
;;;  An electron (system) scatters off a photon (observer).
;;;  The photon's bit becomes correlated with the electron's.
;;;    System:   e⁻(b1)  →  e⁻(b1)  (unchanged)
;;;    Observer: γ(b0)   →  γ(b1)   (now carries record)

(proof physical-measurement :theory GUTPhys
  :assumptions (
    (has (tagged b1 electron))
    (has (tagged b0 photon)))
  :goal (has (tensor (tagged b1 electron) (tagged b1 photon)))
  :derivation
    (gate-cnot-uz (tensor-intro (assumption 0) (assumption 1))))


;;; ═══════════════════════════════════════════════════════════════════
;;;  19. LANDAUER ERASURE (Entropy Transfer via Scattering)
;;; ═══════════════════════════════════════════════════════════════════
;;;
;;;  To "erase" an electron's data, SWAP its bit with a cold photon.
;;;  SWAP = CNOT + RCNOT:
;;;    CNOT(b1, b0) → (b1, b1)
;;;    RCNOT(b1, b1) → (b0, b1)
;;;  The electron is reset (b0). The photon carries the entropy.

(proof particle-erasure :theory GUTPhys
  :assumptions (
    (has (tagged b1 electron))
    (has (tagged b0 photon)))
  :goal (has (tensor (tagged b0 electron) (tagged b1 photon)))
  :derivation
    (gate-rcnot-uu (gate-cnot-uz
      (tensor-intro (assumption 0) (assumption 1)))))


;;; ═══════════════════════════════════════════════════════════════════
;;;  20. CNOT INVOLUTION (Gate Self-Inverse)
;;; ═══════════════════════════════════════════════════════════════════
;;;
;;;  CNOT(CNOT(b1,b0)) = CNOT(b1,b1) = (b1,b0).

(proof cnot-involution :theory GUTPhys
  :assumptions ((has (tensor (tagged b1 electron) (tagged b0 photon))))
  :goal (has (tensor (tagged b1 electron) (tagged b0 photon)))
  :derivation
    (gate-cnot-uu (gate-cnot-uz (assumption))))


;;; ═══════════════════════════════════════════════════════════════════
;;;  21. MAXWELL'S DEMON (Measurement + Erasure Cycle)
;;; ═══════════════════════════════════════════════════════════════════
;;;
;;;  The demon measures an electron, then erases its own memory.
;;;    Step 1: CNOT(electron, demon-photon) → (b1, b1)  [measure]
;;;    Step 2: SWAP(demon-photon, env-photon) → (b0, b1) [erase]

(proof maxwell-demon :theory GUTPhys
  :assumptions (
    (has (tagged b1 electron))
    (has (tagged b0 photon))
    (has (tagged b0 photon)))
  :goal (has (tensor (tagged b1 electron)
               (tensor (tagged b0 photon)
                       (tagged b1 photon))))
  :derivation
    (tensor-elim
      (gate-cnot-uz (tensor-intro (assumption 0) (assumption 1)))
      (tensor-intro
        (assumption)
        (gate-rcnot-uu (gate-cnot-uz
          (tensor-intro (assumption) (assumption 2)))))))


;;; ═══════════════════════════════════════════════════════════════════
;;;  22. BENNETT'S TRICK (Compute + Copy + Uncompute = Zero Garbage)
;;; ═══════════════════════════════════════════════════════════════════
;;;
;;;  The reversible computation protocol:
;;;    1. Compute:   CNOT(input, ancilla)  → (b1, b1)
;;;    2. Copy out:  CNOT(ancilla, output) → (b1, b1)
;;;    3. Uncompute: CNOT(input, ancilla)  → (b1, b0)
;;;  The ancilla is borrowed and returned clean — a catalyst.

(proof particle-bennett :theory GUTPhys
  :assumptions (
    (has (tagged b1 electron))
    (has (tagged b0 photon))
    (has (tagged b0 photon)))
  :goal (has (tensor (tagged b1 electron)
               (tensor (tagged b0 photon)
                       (tagged b1 photon))))
  :derivation
    (tensor-elim
      (gate-cnot-uz (tensor-intro (assumption 0) (assumption 1)))
      (tensor-elim
        (gate-cnot-uz (tensor-intro (assumption) (assumption 2)))
        (tensor-elim
          (gate-cnot-uu (tensor-intro (assumption) (assumption)))
          (tensor-intro (assumption)
            (tensor-intro (assumption) (assumption)))))))


;;; ═══════════════════════════════════════════════════════════════════
;;;  ╔════════════════════════════════════════════════════════════╗
;;;  ║  PART V: INFORMATION IMPOSSIBILITY                        ║
;;;  ╚════════════════════════════════════════════════════════════╝
;;; ═══════════════════════════════════════════════════════════════════


;;; ═══════════════════════════════════════════════════════════════════
;;;  23. NO MAGICAL COOLING (Landauer is Mandatory)
;;; ═══════════════════════════════════════════════════════════════════
;;;
;;;  An electron cannot be cooled (b1→b0) without emitting a particle
;;;  to carry away the entropy. Gate rules require two particles.

(refute no-magical-cooling
  :theory GUTPhys
  :assumptions ((has (tagged b1 electron)))
  :goal (has (tagged b0 electron))
  :depth 5)


;;; ═══════════════════════════════════════════════════════════════════
;;;  24. SECOND LAW (No Total Information Destruction)
;;; ═══════════════════════════════════════════════════════════════════
;;;
;;;  A (b1, b0) pair cannot both become b0. Gates rearrange bits
;;;  but cannot destroy information: one hot bit always survives.

(refute no-info-destruction
  :theory GUTPhys
  :assumptions ((has (tensor (tagged b1 electron) (tagged b0 photon))))
  :goal (has (tensor (tagged b0 electron) (tagged b0 photon)))
  :depth 5)


;;; ═══════════════════════════════════════════════════════════════════
;;;  25. NO BIT COPYING (Classical No-Cloning Without Ancilla)
;;; ═══════════════════════════════════════════════════════════════════
;;;
;;;  A single hot electron cannot become two hot electrons.
;;;  Copying requires an ancilla (a cold photon to CNOT onto).
;;;  This is the classical reversible analogue of no-cloning.

(refute no-bit-copying
  :theory GUTPhys
  :assumptions ((has (tagged b1 electron)))
  :goal (has (tensor (tagged b1 electron) (tagged b1 electron)))
  :depth 5)


;;; ═══════════════════════════════════════════════════════════════════
;;;  ╔════════════════════════════════════════════════════════════╗
;;;  ║  PART VI: BUDGET-BOUNDED DYNAMICS                         ║
;;;  ╚════════════════════════════════════════════════════════════╝
;;; ═══════════════════════════════════════════════════════════════════


;;; ═══════════════════════════════════════════════════════════════════
;;;  26. PAIR PRODUCTION (BUDGET):  γ+γ → e⁻+e⁺  under budget 1
;;; ═══════════════════════════════════════════════════════════════════
;;;
;;;  EM channel has penalty 1. Budget 1 ≥ 1, so reaction proceeds.

(proof pair-production-budget :theory GUTPhys
  :assumptions (
    (has-under (particle photon) (s z))
    (has-under (particle photon) (s z))
    (cms-energy (s (s z)))
    (noncollinear-beams (tensor (particle photon) (particle photon))))
  :goal (has-under (tensor (particle electron) (particle positron)) (s z))
  :derivation
    (interact-scatter-under
      (tensor-intro-under (assumption 0) (assumption 1))
      (conserve-em (eq-refl) (eq-refl) (eq-refl) (eq-refl) (eq-refl)
                   (eq-tri-refl) (eq-tri-refl)
                   (eq-bool-refl) (eq-bool-refl))
      (eq-bool-refl)
      (assumption 2)
      (eq-mc-refl)
      (eq-bool-refl)
      (sr-ok-nc (eq-vk-refl) (assumption 3))))


;;; ═══════════════════════════════════════════════════════════════════
;;;  27. BETA DECAY (BUDGET):  n → p+e⁻+ν̄  under budget 3
;;; ═══════════════════════════════════════════════════════════════════
;;;
;;;  Weak channel has penalty 3. Budget 3 ≥ 3, so reaction proceeds.

(proof beta-decay-budget :theory GUTPhys
  :assumptions ((has-under (particle neutron) (s (s (s z)))))
  :goal (has-under (tensor (particle proton)
                     (tensor (particle electron)
                             (particle antineutrino)))
                   (s (s (s z))))
  :derivation
    (interact-decay-under
      (assumption)
      (conserve-weak (eq-refl) (eq-refl) (eq-refl)
                     (eq-tri-refl) (eq-tri-refl)
                     (eq-bool-refl) (eq-bool-refl)
                     (eq-bool-refl))
      (eq-bool-refl)
      (eq-mc-refl)
      (eq-bool-refl)))


;;; ═══════════════════════════════════════════════════════════════════
;;;  28. KAON DECAY (BUDGET):  K⁺ → π⁰+e⁺+ν  under budget 3
;;; ═══════════════════════════════════════════════════════════════════
;;;
;;;  Weak channel, penalty 3. Budget 3 ≥ 3. ✓

(proof kaon-decay-budget :theory GUTPhys
  :assumptions ((has-under (particle kaon-plus) (s (s (s z)))))
  :goal (has-under (tensor (particle pion-zero)
                     (tensor (particle positron)
                             (particle neutrino)))
                   (s (s (s z))))
  :derivation
    (interact-decay-under
      (assumption)
      (conserve-weak (eq-refl) (eq-refl) (eq-refl)
                     (eq-tri-refl) (eq-tri-refl)
                     (eq-bool-refl) (eq-bool-refl)
                     (eq-bool-refl))
      (eq-bool-refl)
      (eq-mc-refl)
      (eq-bool-refl)))


;;; ═══════════════════════════════════════════════════════════════════
;;;  29. NO FREE PAIR PRODUCTION:  budget 0 blocks EM
;;; ═══════════════════════════════════════════════════════════════════
;;;
;;;  EM penalty = 1 > budget = 0. nat-geq(0,1) = false.

(refute no-free-pair-production
  :theory GUTPhys
  :assumptions (
    (has-under (particle photon) z)
    (has-under (particle photon) z)
    (cms-energy (s (s z))))
  :goal (has-under (tensor (particle electron) (particle positron)) z)
  :depth 5)


;;; ═══════════════════════════════════════════════════════════════════
;;;  30. NO CHEAP BETA DECAY:  budget 1 blocks weak
;;; ═══════════════════════════════════════════════════════════════════
;;;
;;;  Weak penalty = 3 > budget = 1. nat-geq(1,3) = false.

(refute no-cheap-beta-decay
  :theory GUTPhys
  :assumptions ((has-under (particle neutron) (s z)))
  :goal (has-under (tensor (particle proton)
                     (tensor (particle electron)
                             (particle antineutrino)))
                   (s z))
  :depth 5)


;;; ═══════════════════════════════════════════════════════════════════
;;;  31. NO FREE KAON DECAY:  budget 0 blocks all channels
;;; ═══════════════════════════════════════════════════════════════════
;;;
;;;  Budget 0 < penalty for any channel (strong=0 has no kaon vertex,
;;;  em=1>0, weak=3>0).

(refute no-free-kaon-decay
  :theory GUTPhys
  :assumptions ((has-under (particle kaon-plus) z))
  :goal (has-under (tensor (particle pion-zero)
                     (tensor (particle positron)
                             (particle neutrino)))
                   z)
  :depth 5)


;;; ═══════════════════════════════════════════════════════════════════
;;;  ╔════════════════════════════════════════════════════════════╗
;;;  ║  PART VII: LOOP CHANNEL                                    ║
