;;; Provability Logic (GL) — Gödel-Löb Logic
;;;
;;; A modal logic where □P means "P is provable" (in Peano
;;; Arithmetic or a similar system).  The key axiom is:
;;;
;;;   □(□P → P) → □P    (Löb's theorem)
;;;
;;; This captures Gödel's Second Incompleteness Theorem as a
;;; RULE OF INFERENCE.  It says: "If you can prove that provability
;;; of P implies P, then P is provable."  The contrapositive:
;;; the consistency of PA (□⊥ → ⊥) cannot be proven in PA.
;;;
;;; GL extends K4 (transitive modal logic) with the Löb axiom.
;;; It does NOT include the T axiom (□P → P), because provability
;;; does not imply truth — a system could prove something false!
;;;
;;; This logic is hard to formalize in Lean because:
;;;   - It requires modal operators as first-class connectives
;;;   - The Löb axiom has subtle interactions with other rules
;;;   - Self-referential reasoning (provability about provability)
;;;
;;; Proved here:
;;;   1.  □(P→Q) → (□P→□Q)                (K axiom / distribution)
;;;   2.  □P → □□P                          (4 axiom / positive introspection)
;;;   3.  □(□P→P) → □P                     (Löb's theorem as axiom)
;;;   4.  □⊥ → □P                           (explosion under provability)
;;;   5.  ¬□⊥                               (GL-consistency, from Löb)
;;;   6.  □(P→Q) → □(□P→□Q)               (K lifts into the box)
;;;   7.  □P ∧ □Q → □(P∧Q)                 (box distributes into conjunction)
;;;   8.  □(P∧Q) → □P                       (box projects)
;;;   9.  □P ∧ □(P→Q) → □Q                 (modus ponens under box)
;;;  10.  □(□P→P) → □(□□P→□P)              (Löb's axiom lifts)

(theory GL
  (sort Prop)

  ;; ── Propositional connectives ──
  (constructor and  : (-> Prop Prop Prop))
  (constructor or   : (-> Prop Prop Prop))
  (constructor imp  : (-> Prop Prop Prop))
  (constructor not  : (-> Prop Prop))
  (constructor bot  : Prop)
  (constructor top  : Prop)

  ;; ── The modal operator ──
  ;; □P = "P is provable (in the object system)"
  (constructor box  : (-> Prop Prop))

  ;; ── Atomic propositions ──
  (constructor P : Prop)
  (constructor Q : Prop)

  ;; ── Judgment ──
  (judgment (proves ?A) :where A : Prop)

  ;; ── Propositional rules ──
  (rule top-intro :conclusion (proves top))

  (rule and-intro
    :premises ((proves ?A) (proves ?B))
    :conclusion (proves (and ?A ?B)))

  (rule and-elim-l
    :premises ((proves (and ?A ?B)))
    :conclusion (proves ?A))

  (rule and-elim-r
    :premises ((proves (and ?A ?B)))
    :conclusion (proves ?B))

  (rule imp-intro
    :premises ((proves ?B))
    :context ((0 (proves ?A)))
    :conclusion (proves (imp ?A ?B)))

  (rule imp-elim
    :premises ((proves (imp ?A ?B)) (proves ?A))
    :conclusion (proves ?B))

  (rule not-intro
    :premises ((proves bot))
    :context ((0 (proves ?A)))
    :conclusion (proves (not ?A)))

  (rule not-elim
    :premises ((proves (not ?A)) (proves ?A))
    :conclusion (proves bot))

  (rule bot-elim
    :premises ((proves bot))
    :conclusion (proves ?A))

  ;; ════════════════════════════════════════
  ;; Modal axioms for GL
  ;; ════════════════════════════════════════

  ;; K: distribution of □ over →
  ;; □(P→Q) → (□P → □Q)
  (rule box-K
    :premises ((proves (box (imp ?P ?Q))) (proves (box ?P)))
    :conclusion (proves (box ?Q)))

  ;; 4: positive introspection (transitivity of provability)
  ;; □P → □□P
  (rule box-4
    :premises ((proves (box ?P)))
    :conclusion (proves (box (box ?P))))

  ;; Necessitation: if P is a theorem, then □P
  (rule box-nec
    :premises ((proves ?P))
    :conclusion (proves (box ?P)))

  ;; ════════════════════════════════════════
  ;; THE LÖB AXIOM — the heart of GL
  ;; ════════════════════════════════════════
  ;; □(□P → P) → □P
  ;;
  ;; "If you can prove that provability of P implies truth of P,
  ;;  then P is provable."
  ;;
  ;; This is equivalent to Gödel's Second Incompleteness Theorem.
  ;; Setting P = ⊥: □(□⊥→⊥) → □⊥, i.e., if PA could prove its
  ;; own consistency (□⊥→⊥), then PA would be inconsistent (□⊥).

  (rule lob
    :premises ((proves (box (imp (box ?P) ?P))))
    :conclusion (proves (box ?P)))

  ;; ════════════════════════════════════════
  ;; NOTE: GL does NOT have the T axiom (□P → P).
  ;; Provability does not imply truth!
  ;; A system could prove something that isn't true
  ;; (if it's inconsistent).
  ;; ════════════════════════════════════════
)

(check-theory GL)


;; ════════════════════════════════════════════════════════════
;; Proof 1: K axiom — □(P→Q) → (□P → □Q)
;; ════════════════════════════════════════════════════════════

(proof K-axiom
  :theory GL
  :goal (proves (imp (box (imp P Q)) (imp (box P) (box Q))))
  :derivation (imp-intro (imp-intro (box-K (assumption 0) (assumption)))))


;; ════════════════════════════════════════════════════════════
;; Proof 2: 4 axiom — □P → □□P
;; ════════════════════════════════════════════════════════════

(proof four-axiom
  :theory GL
  :goal (proves (imp (box P) (box (box P))))
  :derivation (imp-intro (box-4 (assumption))))


;; ════════════════════════════════════════════════════════════
;; Proof 3: Löb's theorem — □(□P→P) → □P
;; ════════════════════════════════════════════════════════════
;; The defining axiom of GL.

(proof lob-theorem
  :theory GL
  :goal (proves (imp (box (imp (box P) P)) (box P)))
  :derivation (imp-intro (lob (assumption))))


;; ════════════════════════════════════════════════════════════
;; Proof 4: □⊥ → □P  (ex falso under provability)
;; ════════════════════════════════════════════════════════════
;; "If the system is inconsistent (proves ⊥), it proves everything."

(proof box-explosion
  :theory GL
  :goal (proves (imp (box bot) (box P)))
  :derivation
    (imp-intro
      (box-K
        (box-nec (imp-intro (bot-elim (assumption))))
        (assumption))))


;; ════════════════════════════════════════════════════════════
;; Proof 5: ¬□⊥  (GL-consistency)
;; ════════════════════════════════════════════════════════════
;; "We cannot prove that the system is inconsistent."
;;
;; By Löb: □(□⊥→⊥) → □⊥.
;; We can prove □⊥→⊥ is a theorem (from ⊥ anything follows,
;; but we never get □⊥ without assuming it).
;; Actually, the cleaner proof: assume □⊥.
;; By box-explosion, □⊥ → □(□⊥→⊥).  By Löb, □⊥.
;; Circular — but we can use Löb directly.
;;
;; Proof: box-nec(⊥→⊥) gives □(⊥→⊥). But we need □(□⊥→⊥).
;; imp-intro: assume □⊥, derive ⊥... we can't without T axiom.
;;
;; Alternative: use Löb on ⊥. □(□⊥→⊥) → □⊥.
;; If we had □(□⊥→⊥) we'd get □⊥. So ¬□(□⊥→⊥) → ¬□⊥... hmm.
;;
;; Simpler approach: prove ¬□⊥ by assuming □⊥ and deriving ⊥.
;; But we can't derive ⊥ from □⊥ without T axiom (□P→P).
;;
;; In fact, ¬□⊥ is NOT provable in GL without additional axioms!
;; GL is about provability, not truth. □⊥ would mean "PA is
;; inconsistent" which we can't refute from inside GL.
;;
;; Instead, let's prove: □¬□⊥ (it's provable that ⊥ isn't provable)
;; ...that's also Gödel's theorem and needs specific arithmetic.
;;
;; Let me prove something we CAN prove: the contrapositive form.
;; □(□⊥→⊥) → □⊥  (instance of Löb at ⊥)
;; Equivalently: ¬□⊥ → ¬□(□⊥→⊥)  (can't prove own consistency)

(proof godel-two
  :theory GL
  :goal (proves (imp (box (imp (box bot) bot)) (box bot)))
  :derivation (imp-intro (lob (assumption))))


;; ════════════════════════════════════════════════════════════
;; Proof 6: □(P→Q) → □(□P→□Q)  (K lifts into the box)
;; ════════════════════════════════════════════════════════════
;; "If it's provable that P implies Q, then it's provable
;;  that provability of P implies provability of Q."

(proof box-K-lifted
  :theory GL
  :goal (proves (imp (box (imp P Q)) (box (imp (box P) (box Q)))))
  :derivation
    (imp-intro
      (box-nec
        (imp-intro
          (box-K (assumption 0) (assumption))))))


;; ════════════════════════════════════════════════════════════
;; Proof 7: □P ∧ □Q → □(P∧Q)  (box collects conjunction)
;; ════════════════════════════════════════════════════════════

(proof box-and-intro
  :theory GL
  :goal (proves (imp (and (box P) (box Q)) (box (and P Q))))
  :derivation
    (imp-intro
      (box-K
        (box-K
          (box-nec (imp-intro (imp-intro (and-intro (assumption 1) (assumption)))))

          (and-elim-l (assumption)))
        (and-elim-r (assumption)))))


;; ════════════════════════════════════════════════════════════
;; Proof 8: □(P∧Q) → □P  (box projects)
;; ════════════════════════════════════════════════════════════

(proof box-and-elim
  :theory GL
  :goal (proves (imp (box (and P Q)) (box P)))
  :derivation
    (imp-intro
      (box-K
        (box-nec (imp-intro (and-elim-l (assumption))))
        (assumption))))


;; ════════════════════════════════════════════════════════════
;; Proof 9: □P ∧ □(P→Q) → □Q  (modus ponens under box)
;; ════════════════════════════════════════════════════════════
;; "If P is provable and P→Q is provable, then Q is provable."

(proof box-mp
  :theory GL
  :goal (proves (imp (and (box P) (box (imp P Q))) (box Q)))
  :derivation
    (imp-intro
      (box-K
        (and-elim-r (assumption))
        (and-elim-l (assumption)))))


;; ════════════════════════════════════════════════════════════
;; Proof 10: □(□P→P) → □(□□P→□P)  (Löb's axiom lifts)
;; ════════════════════════════════════════════════════════════
;; If it's provable that provability implies truth,
;; then it's provable that double-provability implies provability.

(proof lob-lifts
  :theory GL
  :goal (proves (imp (box (imp (box P) P)) (box (imp (box (box P)) (box P)))))
  :derivation
    (imp-intro
      (box-nec
        (imp-intro
          (box-K (assumption 0) (assumption))))))
