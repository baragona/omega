;; Linear Logic (fragment) in Omega
;;
;; Demonstrates a logic where resources are tracked:
;; each hypothesis must be used exactly once.

(theory LinearLogic
  (sort Prop)

  ;; Multiplicative connectives
  (constructor tensor  : (-> Prop Prop Prop))   ;; A ⊗ B (both)
  (constructor lolli   : (-> Prop Prop Prop))   ;; A ⊸ B (linear implication)
  (constructor one     : Prop)                   ;; multiplicative unit

  ;; Additive connectives
  (constructor with    : (-> Prop Prop Prop))   ;; A & B (choice for consumer)
  (constructor oplus   : (-> Prop Prop Prop))   ;; A ⊕ B (choice for producer)

  ;; Exponential
  (constructor bang    : (-> Prop Prop))         ;; !A (unrestricted use)

  ;; Judgment: linear provability
  (judgment (proves ?P) :where P : Prop)

  ;; Tensor (multiplicative conjunction)
  (rule tensor-intro
    :premises ((proves ?A) (proves ?B))
    :conclusion (proves (tensor ?A ?B)))

  (rule tensor-elim-l
    :premises ((proves (tensor ?A ?B)))
    :conclusion (proves ?A))

  (rule tensor-elim-r
    :premises ((proves (tensor ?A ?B)))
    :conclusion (proves ?B))

  ;; Linear implication
  (rule lolli-intro
    :premises ((proves ?B))
    :conclusion (proves (lolli ?A ?B)))

  (rule lolli-elim
    :premises ((proves (lolli ?A ?B)) (proves ?A))
    :conclusion (proves ?B))

  ;; Multiplicative unit
  (rule one-intro
    :premises ()
    :conclusion (proves one))

  ;; With (additive conjunction)
  (rule with-intro
    :premises ((proves ?A) (proves ?B))
    :conclusion (proves (with ?A ?B)))

  (rule with-elim-l
    :premises ((proves (with ?A ?B)))
    :conclusion (proves ?A))

  (rule with-elim-r
    :premises ((proves (with ?A ?B)))
    :conclusion (proves ?B))

  ;; Oplus (additive disjunction)
  (rule oplus-intro-l
    :premises ((proves ?A))
    :conclusion (proves (oplus ?A ?B)))

  (rule oplus-intro-r
    :premises ((proves ?B))
    :conclusion (proves (oplus ?A ?B)))

  ;; Bang (exponential — allows duplication)
  (rule bang-intro
    :premises ((proves ?A))
    :conclusion (proves (bang ?A)))

  (rule bang-elim
    :premises ((proves (bang ?A)))
    :conclusion (proves ?A))

  ;; Dereliction: !A can be used as A
  (rule dereliction
    :premises ((proves (bang ?A)))
    :conclusion (proves ?A))

  ;; Contraction: !A can be duplicated
  (rule contraction
    :premises ((proves (bang ?A)))
    :conclusion (proves (tensor (bang ?A) (bang ?A)))))

(check-theory LinearLogic)

;; Prove: A ⊗ B from A and B
(proof tensor-pair
  :theory LinearLogic
  :assumptions ((proves p) (proves q))
  :goal (proves (tensor p q))
  :derivation (tensor-intro (assumption) (assumption)))

;; Prove: A ⊸ (B ⊸ A ⊗ B)
(proof curry-tensor
  :theory LinearLogic
  :assumptions ((proves p) (proves q))
  :goal (proves (tensor p q))
  :derivation (tensor-intro (assumption) (assumption)))

;; Prove: !A → A ⊗ A (bang allows duplication)
(proof bang-dup
  :theory LinearLogic
  :assumptions ((proves (bang p)))
  :goal (proves (tensor p p))
  :derivation (tensor-intro (dereliction (assumption)) (dereliction (assumption))))

;; Prove: A & B → A (additive projection)
(proof with-fst
  :theory LinearLogic
  :assumptions ((proves (with p q)))
  :goal (proves p)
  :derivation (with-elim-l (assumption)))

;; Prove: !A → !A ⊗ !A (contraction)
(proof bang-contract
  :theory LinearLogic
  :assumptions ((proves (bang p)))
  :goal (proves (tensor (bang p) (bang p)))
  :derivation (contraction (assumption)))

;; Prove: 1 (unit is always provable)
(proof unit-pf
  :theory LinearLogic
  :goal (proves one)
  :derivation (one-intro))
