;; Implicit Arguments Demo
;;
;; Demonstrates how Omega handles rules with implicit arguments
;; that are inferred from context rather than stated explicitly.
;;
;; The key feature: eq-trans has ?b as implicit — the middle term
;; of a transitivity chain is inferred from the sub-derivations.
;;
;; Proved here:
;;   1. zero = zero                              (reflexivity)
;;   2. succ(zero) = succ(zero)                  (congruence)
;;   3. succ(zero) = succ(succ(zero)) assumed    (symmetry from assumption)
;;   4. zero = zero via trans                    (trivial transitivity)
;;   5. succ(succ(zero)) = succ(succ(zero))      (double congruence)
;;   6. a=b ⊢ succ(succ(a)) = succ(succ(b))     (deep congruence from assumption)
;;   7. a=b, b=c ⊢ succ(a) = succ(c)            (congruence + trans chain)
;;   8. a=b ⊢ b=a                               (symmetry from assumption)
;;   9. a=b, b=c, c=d ⊢ a=d                     (triple transitivity, 2 implicit)
;;  10. a=b ⊢ succ(succ(a)) = succ(succ(b))     (deep cong + symm roundtrip)

(theory ImplicitDemo
  (sort Tm)
  (sort Ty)

  ;; Types
  (constructor Nat : Ty)
  (constructor Bool : Ty)
  (constructor Arrow : (-> Ty Ty Ty))

  ;; Terms
  (constructor zero : Tm)
  (constructor succ : (-> Tm Tm))
  (constructor tru  : Tm)
  (constructor fls  : Tm)

  ;; Typing judgment: (has-type t T) means t has type T
  (judgment (has-type ?t ?T) :where t : Tm T : Ty)

  ;; Typing rules
  (rule t-zero
    :premises ()
    :conclusion (has-type zero Nat))

  (rule t-succ
    :premises ((has-type ?n Nat))
    :conclusion (has-type (succ ?n) Nat))

  (rule t-true
    :premises ()
    :conclusion (has-type tru Bool))

  (rule t-false
    :premises ()
    :conclusion (has-type fls Bool))

  ;; Equality judgment with implicit type
  ;; When we write (eq ?a ?b), the type is implicit
  (judgment (eq ?a ?b) :where a : Tm b : Tm)

  ;; Reflexivity: anything equals itself
  (rule eq-refl
    :premises ()
    :conclusion (eq ?a ?a))

  ;; Symmetry: if a = b then b = a
  (rule eq-symm
    :premises ((eq ?a ?b))
    :conclusion (eq ?b ?a))

  ;; Transitivity: if a = b and b = c then a = c
  ;; Here ?b is implicit — it appears in premises but determined from context
  (rule eq-trans
    :premises ((eq ?a ?b) (eq ?b ?c))
    :conclusion (eq ?a ?c)
    :implicit (?b))

  ;; Congruence for succ
  (rule cong-succ
    :premises ((eq ?a ?b))
    :conclusion (eq (succ ?a) (succ ?b))))

(check-theory ImplicitDemo)

;; Prove: zero = zero
(proof zero-eq-zero
  :theory ImplicitDemo
  :goal (eq zero zero)
  :derivation (eq-refl))

;; Prove: succ(zero) = succ(zero)
(proof succ-zero-eq
  :theory ImplicitDemo
  :goal (eq (succ zero) (succ zero))
  :derivation (cong-succ (eq-refl)))

;; Prove: symmetry of succ equality
;; Given succ(zero) = succ(succ(zero)), prove succ(succ(zero)) = succ(zero)
(proof symm-succ
  :theory ImplicitDemo
  :assumptions ((eq (succ zero) (succ (succ zero))))
  :goal (eq (succ (succ zero)) (succ zero))
  :derivation (eq-symm (assumption)))

;; Prove: transitivity — zero = zero = zero via eq-trans
;; The middle term ?b = zero is inferred from the sub-derivations
(proof trans-trivial
  :theory ImplicitDemo
  :goal (eq zero zero)
  :derivation (eq-trans (eq-refl) (eq-refl)))

;; Prove: congruence chain
;; succ(succ(zero)) = succ(succ(zero)) by double congruence
(proof double-cong
  :theory ImplicitDemo
  :goal (eq (succ (succ zero)) (succ (succ zero)))
  :derivation (cong-succ (cong-succ (eq-refl))))


;;; ═══════════════════════════════════════════════════════════
;;; Part 2: Multi-step proofs with implicit inference
;;; ═══════════════════════════════════════════════════════════

;; Prove: from a = b, derive succ(succ(a)) = succ(succ(b))
;; Deep congruence chain from an assumption.
(proof deep-cong-assumption
  :theory ImplicitDemo
  :assumptions ((eq a0 b0))
  :goal (eq (succ (succ a0)) (succ (succ b0)))
  :derivation (cong-succ (cong-succ (assumption))))

;; Prove: from a = b and b = c, derive succ(a) = succ(c)
;; Requires: eq-trans infers ?b from sub-derivations,
;; then cong-succ wraps the result.
;; Actually: cong-succ(eq-trans(assumption 0, assumption 1))
;; eq-trans gets (eq a0 b0) and (eq b0 c0), infers ?b = b0.
(proof cong-trans-chain
  :theory ImplicitDemo
  :assumptions ((eq a0 b0) (eq b0 c0))
  :goal (eq (succ a0) (succ c0))
  :derivation (cong-succ (eq-trans (assumption 0) (assumption 1))))

;; Prove: from a = b, derive b = a
;; Simple symmetry from assumption.
(proof symm-assumption
  :theory ImplicitDemo
  :assumptions ((eq a0 b0))
  :goal (eq b0 a0)
  :derivation (eq-symm (assumption)))

;; Prove: from a=b, b=c, c=d, derive a=d
;; Triple transitivity — two implicit middle terms must be inferred.
;; eq-trans(eq-trans(a=b, b=c), c=d) — inner trans infers ?b=b0, outer infers ?b=c0.
(proof triple-trans
  :theory ImplicitDemo
  :assumptions ((eq a0 b0) (eq b0 c0) (eq c0 d0))
  :goal (eq a0 d0)
  :derivation (eq-trans (eq-trans (assumption 0) (assumption 1)) (assumption 2)))

;; Prove: from a=b, derive succ(succ(b)) = succ(succ(a))
;; Compose symmetry with deep congruence.
;; eq-symm(cong-succ(cong-succ(assumption)))
(proof deep-cong-symm
  :theory ImplicitDemo
  :assumptions ((eq a0 b0))
  :goal (eq (succ (succ b0)) (succ (succ a0)))
  :derivation (eq-symm (cong-succ (cong-succ (assumption)))))
