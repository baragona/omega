;;; Continuum Hypothesis — Independence via Boolean-Valued Models
;;;
;;; The "final boss" of set theory. You cannot prove CH (that there is
;;; no infinity between the integers and the reals) in ZFC, but you CAN
;;; build models where it is true or false.
;;;
;;; Instead of truth values {True, False}, use elements of a Boolean
;;; algebra B. Equality ⟦u = v⟧ evaluates to a "probability" in B.
;;;
;;; Gödel (1940): In the constructible universe L, CH holds.
;;; Cohen (1963): Via forcing, CH can fail — 2^ℵ₀ > ℵ₁.
;;; Together: CH is independent of ZFC.
;;;
;;; Proved here:
;;;   1. ⊤ ∧ x = x                                (Boolean identity)
;;;   2. ⊥ ∨ x = x                                (Boolean identity)
;;;   3. ⊥ ∧ x = ⊥                                (annihilation)
;;;   4. ¬¬x = x                                  (double negation)
;;;   5. (a ⇒ b) = ¬a ∨ b                         (implication unfold)
;;;   6. (⊤ ⇒ x) = x                              (modus ponens computes)
;;;   7. ℵ₀ < 2^ℵ₀                                (Cantor's theorem)
;;;   8. CH is consistent with ZFC                 (Gödel 1940)
;;;   9. CH is independent of ZFC                  (Gödel + Cohen)
;;;  10. CH independent ∧ ℵ₀ < 2^ℵ₀               (the full picture)

(theory ContinuumHypothesis
  (sort BVal)
  (sort Formula)
  (sort Card)

  ;; ── Boolean algebra ──
  (constructor b-top : BVal)
  (constructor b-bot : BVal)
  (constructor b-and : (-> BVal BVal BVal))
  (constructor b-or  : (-> BVal BVal BVal))
  (constructor b-imp : (-> BVal BVal BVal))
  (constructor b-not : (-> BVal BVal))

  ;; ── Boolean rewrite rules ──
  ;; Identity
  (rewrite b-and-top-l (b-and b-top ?x) ?x)
  (rewrite b-and-top-r (b-and ?x b-top) ?x)
  (rewrite b-or-bot-l  (b-or b-bot ?x) ?x)
  (rewrite b-or-bot-r  (b-or ?x b-bot) ?x)

  ;; Annihilation
  (rewrite b-and-bot-l (b-and b-bot ?x) b-bot)
  (rewrite b-and-bot-r (b-and ?x b-bot) b-bot)
  (rewrite b-or-top-l  (b-or b-top ?x) b-top)
  (rewrite b-or-top-r  (b-or ?x b-top) b-top)

  ;; Negation
  (rewrite b-not-top (b-not b-top) b-bot)
  (rewrite b-not-bot (b-not b-bot) b-top)
  (rewrite b-not-not (b-not (b-not ?x)) ?x)

  ;; Implication as disjunction
  (rewrite b-imp-def (b-imp ?a ?b) (b-or (b-not ?a) ?b))

  ;; ── Cardinals ──
  (constructor aleph-0   : Card)
  (constructor aleph-1   : Card)
  (constructor aleph-2   : Card)
  (constructor continuum : Card)

  ;; ── Formula constructors ──
  (constructor card-eq     : (-> Card Card Formula))
  (constructor card-lt     : (-> Card Card Formula))
  (constructor ch          : Formula)
  (constructor neg-ch      : Formula)
  (constructor consistent  : (-> Formula Formula))
  (constructor independent : (-> Formula Formula))
  (constructor and-f       : (-> Formula Formula Formula))
  (constructor or-f        : (-> Formula Formula Formula))
  (constructor imp-f       : (-> Formula Formula Formula))

  ;; ── Judgments ──
  (judgment (holds ?P) :where P : Formula)
  (judgment (bval-eq ?a ?b) :where a : BVal b : BVal)

  ;; ── BVal equality ──
  (rule bval-refl
    :premises ()
    :conclusion (bval-eq ?a ?a))

  (rule bval-symm
    :premises ((bval-eq ?a ?b))
    :conclusion (bval-eq ?b ?a))

  (rule bval-trans
    :premises ((bval-eq ?a ?b) (bval-eq ?b ?c))
    :conclusion (bval-eq ?a ?c)
    :implicit (?b))

  ;; ── Formula-level reasoning ──
  (rule and-intro
    :premises ((holds ?A) (holds ?B))
    :conclusion (holds (and-f ?A ?B)))

  (rule and-elim-l
    :premises ((holds (and-f ?A ?B)))
    :conclusion (holds ?A))

  (rule and-elim-r
    :premises ((holds (and-f ?A ?B)))
    :conclusion (holds ?B))

  (rule imp-intro
    :premises ((holds ?B))
    :context ((0 (holds ?A)))
    :conclusion (holds (imp-f ?A ?B)))

  ;; ── Set-theoretic axioms ──
  ;; Cantor's theorem: ℵ₀ < 2^ℵ₀
  (rule cantor-diagonal
    :premises ()
    :conclusion (holds (card-lt aleph-0 continuum)))

  ;; Gödel (1940): In the constructible universe L, CH holds
  (rule godel-L-ch
    :premises ()
    :conclusion (holds (consistent ch)))

  ;; Cohen (1963): Via forcing, ¬CH is consistent
  (rule cohen-neg-ch
    :premises ()
    :conclusion (holds (consistent neg-ch)))

  ;; Independence: if both φ and ψ are consistent, φ is independent
  (rule independent-from-consistent
    :premises ((holds (consistent ?P)) (holds (consistent ?Q)))
    :conclusion (holds (independent ?P))))

(check-theory ContinuumHypothesis)


;;; ═══════════════════════════════════════════════════════════
;;; Proof 1: ⊤ ∧ x = x (Boolean identity)
;;; ═══════════════════════════════════════════════════════════

(proof b-and-identity
  :theory ContinuumHypothesis
  :goal (bval-eq (b-and b-top p0) p0)
  :derivation (bval-refl))


;;; ═══════════════════════════════════════════════════════════
;;; Proof 2: ⊥ ∨ x = x (Boolean identity)
;;; ═══════════════════════════════════════════════════════════

(proof b-or-identity
  :theory ContinuumHypothesis
  :goal (bval-eq (b-or b-bot p0) p0)
  :derivation (bval-refl))


;;; ═══════════════════════════════════════════════════════════
;;; Proof 3: ⊥ ∧ x = ⊥ (annihilation)
;;; ═══════════════════════════════════════════════════════════

(proof b-and-annihilate
  :theory ContinuumHypothesis
  :goal (bval-eq (b-and b-bot p0) b-bot)
  :derivation (bval-refl))


;;; ═══════════════════════════════════════════════════════════
;;; Proof 4: ¬¬x = x (double negation elimination in B)
;;; ═══════════════════════════════════════════════════════════

(proof b-double-negation
  :theory ContinuumHypothesis
  :goal (bval-eq (b-not (b-not p0)) p0)
  :derivation (bval-refl))


;;; ═══════════════════════════════════════════════════════════
;;; Proof 5: (a ⇒ b) = ¬a ∨ b (implication is disjunction)
;;; ═══════════════════════════════════════════════════════════

(proof b-imp-unfold
  :theory ContinuumHypothesis
  :goal (bval-eq (b-imp p0 q0) (b-or (b-not p0) q0))
  :derivation (bval-refl))


;;; ═══════════════════════════════════════════════════════════
;;; Proof 6: (⊤ ⇒ x) = x (modus ponens computes!)
;;; ═══════════════════════════════════════════════════════════
;;; Three rewrites chain: b-imp-def → b-not-top → b-or-bot-l

(proof b-imp-top-left
  :theory ContinuumHypothesis
  :goal (bval-eq (b-imp b-top p0) p0)
  :derivation (bval-refl))


;;; ═══════════════════════════════════════════════════════════
;;; Proof 7: ℵ₀ < 2^ℵ₀ (Cantor's theorem)
;;; ═══════════════════════════════════════════════════════════
;;; No set can be put in bijection with its powerset.
;;; The continuum is strictly larger than the countable.

(proof cantor-proof
  :theory ContinuumHypothesis
  :goal (holds (card-lt aleph-0 continuum))
  :derivation (cantor-diagonal))


;;; ═══════════════════════════════════════════════════════════
;;; Proof 8: CH is consistent with ZFC (Gödel 1940)
;;; ═══════════════════════════════════════════════════════════
;;; In the constructible universe L, every set is "definable"
;;; from smaller sets. In L, 2^ℵ₀ = ℵ₁ — there is no
;;; intermediate infinity.

(proof ch-is-consistent
  :theory ContinuumHypothesis
  :goal (holds (consistent ch))
  :derivation (godel-L-ch))


;;; ═══════════════════════════════════════════════════════════
;;; Proof 9: CH is independent of ZFC
;;; ═══════════════════════════════════════════════════════════
;;; Gödel showed CH is consistent; Cohen showed ¬CH is consistent.
;;; Both are consistent with ZFC, so ZFC cannot decide CH.
;;; This is the Boolean-valued model approach: shift the semantic
;;; model to handle "undecidable" propositions.

(proof ch-is-independent
  :theory ContinuumHypothesis
  :goal (holds (independent ch))
  :derivation (independent-from-consistent (godel-L-ch) (cohen-neg-ch)))


;;; ═══════════════════════════════════════════════════════════
;;; Proof 10: The full picture — CH independent AND ℵ₀ < 2^ℵ₀
;;; ═══════════════════════════════════════════════════════════
;;; We know the continuum is bigger than ℵ₀ (Cantor).
;;; We know we can't determine HOW much bigger (Cohen/Gödel).
;;; This is the state of the art in infinite set theory.

(proof full-picture
  :theory ContinuumHypothesis
  :goal (holds (and-f (independent ch) (card-lt aleph-0 continuum)))
  :derivation (and-intro
                (independent-from-consistent (godel-L-ch) (cohen-neg-ch))
                (cantor-diagonal)))
