;;; Number Theory via Induction (with Miller Pattern Unification)
;;;
;;; Real formal verification: theorems about ALL natural numbers.
;;; Each proof uses structural induction over the naturals, with the
;;; kernel verifying every step.
;;;
;;; This version leverages Miller's pattern unification to state
;;; properties inline — no more boilerplate constructor + intro/elim
;;; rules for each predicate.
;;;
;;; Proved here:
;;;   Lemma 1:  n + 0 = n           (right identity of addition)
;;;   Lemma 2:  n + S(m) = S(n + m) (right successor)
;;;   Theorem:  n + m = m + n       (commutativity of addition)

;; ── Base Theory ──
;; Shared definitions used by all proofs

(theory PeanoBase
  (sort Nat)
  (sort Prop)

  ;; Data constructors
  (constructor z : Nat)
  (constructor s : (-> Nat Nat))
  (constructor add : (-> Nat Nat Nat))

  ;; Propositions
  (constructor eq : (-> Nat Nat Prop))

  ;; Computation rules
  (rewrite add-z (add z ?n) ?n)
  (rewrite add-s (add (s ?n) ?m) (s (add ?n ?m)))

  ;; Judgment
  (judgment (proves ?P) :where P : Prop)

  ;; Equational reasoning
  (rule eq-refl
    :premises ()
    :conclusion (proves (eq ?a ?a)))

  (rule eq-symm
    :premises ((proves (eq ?a ?b)))
    :conclusion (proves (eq ?b ?a)))

  (rule eq-trans
    :premises ((proves (eq ?a ?b)) (proves (eq ?b ?c)))
    :conclusion (proves (eq ?a ?c)))

  (rule eq-succ
    :premises ((proves (eq ?a ?b)))
    :conclusion (proves (eq (s ?a) (s ?b))))

  ;; Induction principle (higher-order via Miller unification)
  ;; ?P is solved to a lambda by the kernel when matching against the goal.
  (rule nat-ind
    :premises ((proves (?P z)) (proves (?P (s ?n))))
    :context ((1 (proves (?P ?n))))
    :conclusion (proves (?P ?n))))

(check-theory PeanoBase)


;; ── Induction Theory ──
;; Imports PeanoBase and adds proved lemmas as axioms for use
;; in subsequent proofs.

(theory PeanoInduction
  (import PeanoBase)

  ;; Proved lemmas (used as axioms in later proofs)
  (rule right-z-lemma
    :premises ()
    :conclusion (proves (eq (add ?n z) ?n)))

  (rule right-s-lemma
    :premises ()
    :conclusion (proves (eq (add ?n (s ?m)) (s (add ?n ?m))))))

(check-theory PeanoInduction)


;; ════════════════════════════════════════════════════════════
;; Lemma 1:  ∀n. n + 0 = n    (right identity of addition)
;; ════════════════════════════════════════════════════════════
;;
;; Proof by induction on n, with property P(n) ≡ n + 0 = n.
;; The kernel solves ?P → λx.(eq (add x z) x) via Miller unification.
;;
;; Base case:  (eq (add z z) z) → rewrites to (eq z z) → eq-refl ✓
;; Step case:  (eq (add (s n) z) (s n)) → rewrites to (eq (s (add n z)) (s n))
;;             eq-succ on IH: (eq (s (add n z)) (s n)) ✓

(proof add-right-zero
  :theory PeanoBase
  :goal (proves (eq (add ?n z) ?n))
  :derivation
    (nat-ind
      (eq-refl)
      (eq-succ (assumption))))


;; ════════════════════════════════════════════════════════════
;; Lemma 2:  ∀n,m. n + S(m) = S(n + m)  (right successor)
;; ════════════════════════════════════════════════════════════
;;
;; Proof by induction on n, with P(n) ≡ n + S(m) = S(n + m).
;; The kernel solves ?P → λx.(eq (add x (s ?m)) (s (add x ?m))).
;;
;; Note: ?m is free in the property — this is fine because it stays
;; as a meta-variable throughout.
;;
;; Base case:  (eq (add z (s m)) (s (add z m))) → both sides rewrite to (s m) → eq-refl ✓
;; Step case:  (eq (add (s n) (s m)) (s (add (s n) m)))
;;           → (eq (s (add n (s m))) (s (s (add n m))))  [after rewrites]
;;           → eq-succ on IH ✓

(proof add-right-succ
  :theory PeanoBase
  :goal (proves (eq (add ?n (s ?m)) (s (add ?n ?m))))
  :derivation
    (nat-ind
      (eq-refl)
      (eq-succ (assumption))))


;; ════════════════════════════════════════════════════════════
;; Theorem:  ∀n,m. n + m = m + n  (commutativity of addition)
;; ════════════════════════════════════════════════════════════
;;
;; Proof by induction on n, with P(n) ≡ n + m = m + n.
;; The kernel solves ?P → λx.(eq (add x ?m) (add ?m x)).
;;
;; Base case:  (eq (add z m) (add m z)) → LHS rewrites to m
;;             RHS: (add m z) = m by right-z-lemma
;;             So: eq-symm(right-z-lemma) ✓
;;
;; Step case:  (eq (add (s n) m) (add m (s n)))
;;           → (eq (s (add n m)) (add m (s n)))  [LHS rewrites]
;;           Chain: S(n + m) = S(m + n)     [eq-succ on IH]
;;                  S(m + n) = m + S(n)     [eq-symm of right-s-lemma]
;;           eq-trans(eq-succ(IH), eq-symm(right-s-lemma)) ✓

(proof add-comm
  :theory PeanoInduction
  :goal (proves (eq (add ?n ?m) (add ?m ?n)))
  :derivation
    (nat-ind
      (eq-symm (right-z-lemma))
      (eq-trans
        (eq-succ (assumption))
        (eq-symm (right-s-lemma)))))
