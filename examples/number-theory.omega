;;; Number Theory via Induction
;;;
;;; Real formal verification: theorems about ALL natural numbers,
;;; not just specific values. Each proof uses structural induction
;;; over the naturals, with the kernel verifying every step.
;;;
;;; Proved here:
;;;   Lemma 1:  n + 0 = n           (right identity of addition)
;;;   Lemma 2:  n + S(m) = S(n + m) (right successor)
;;;   Theorem:  n + m = m + n       (commutativity of addition)

(theory PeanoInduction
  (sort Nat)
  (sort Prop)

  ;; ── Data ──
  (constructor z : Nat)
  (constructor s : (-> Nat Nat))
  (constructor add : (-> Nat Nat Nat))

  ;; ── Propositions ──
  (constructor eq : (-> Nat Nat Prop))

  ;; ── Computation rules ──
  ;; Addition is defined by recursion on the first argument:
  ;;   0 + n = n,   S(n) + m = S(n + m)
  (rewrite add-z (add z ?n) ?n)
  (rewrite add-s (add (s ?n) ?m) (s (add ?n ?m)))

  ;; ── Judgment ──
  (judgment (proves ?P) :where P : Prop)

  ;; ── Equational reasoning ──
  (rule eq-refl
    :premises ()
    :conclusion (proves (eq ?a ?a)))

  (rule eq-symm
    :premises ((proves (eq ?a ?b)))
    :conclusion (proves (eq ?b ?a)))

  (rule eq-trans
    :premises ((proves (eq ?a ?b)) (proves (eq ?b ?c)))
    :conclusion (proves (eq ?a ?c)))

  (rule eq-succ
    :premises ((proves (eq ?a ?b)))
    :conclusion (proves (eq (s ?a) (s ?b))))

  ;; ── Induction principle ──
  ;; To prove P(n) for all n:
  ;;   Premise 0: prove P(0)              [base case]
  ;;   Premise 1: prove P(S(n)) given P(n) [inductive step with IH in context]
  (rule nat-ind
    :premises ((proves (?P z)) (proves (?P (s ?n))))
    :context ((1 (proves (?P ?n))))
    :conclusion (proves (?P ?n)))

  ;; ── Predicate encodings ──
  ;; Since Omega uses first-order matching, we encode each property
  ;; as a constructor (Nat → Prop) with intro/elim rules.

  ;; P₁(n) ≡ n + 0 = n
  (constructor add-right-z : (-> Nat Prop))
  (rule arz-i
    :premises ((proves (eq (add ?n z) ?n)))
    :conclusion (proves (add-right-z ?n)))
  (rule arz-e
    :premises ((proves (add-right-z ?n)))
    :conclusion (proves (eq (add ?n z) ?n)))

  ;; P₂(n) ≡ ∀m. n + S(m) = S(n + m)
  (constructor add-right-s : (-> Nat Prop))
  (rule ars-i
    :premises ((proves (eq (add ?n (s ?m)) (s (add ?n ?m)))))
    :conclusion (proves (add-right-s ?n)))
  (rule ars-e
    :premises ((proves (add-right-s ?n)))
    :conclusion (proves (eq (add ?n (s ?m)) (s (add ?n ?m)))))

  ;; P₃(n) ≡ ∀m. n + m = m + n
  (constructor add-comm-p : (-> Nat Prop))
  (rule ac-i
    :premises ((proves (eq (add ?n ?m) (add ?m ?n))))
    :conclusion (proves (add-comm-p ?n)))
  (rule ac-e
    :premises ((proves (add-comm-p ?n)))
    :conclusion (proves (eq (add ?n ?m) (add ?m ?n))))

  ;; ── Proved lemmas as rules ──
  ;; These are verified by induction below.  Including them as rules
  ;; lets subsequent proofs (commutativity) reference them.
  (rule right-z-lemma
    :premises ()
    :conclusion (proves (eq (add ?n z) ?n)))

  (rule right-s-lemma
    :premises ()
    :conclusion (proves (eq (add ?n (s ?m)) (s (add ?n ?m))))))

(check-theory PeanoInduction)


;; ════════════════════════════════════════════════════════════
;; Lemma 1:  ∀n. n + 0 = n    (right identity of addition)
;; ════════════════════════════════════════════════════════════
;;
;; Proof by induction on n.
;;
;; Base case:  0 + 0 = 0
;;   By rewrite:  (add z z) → z.  Then eq-refl.
;;
;; Step case:  Assume n + 0 = n.  Prove S(n) + 0 = S(n).
;;   By rewrite:  (add (s n) z) → (s (add n z)).
;;   By eq-succ on IH:  S(n + 0) = S(n).

(proof add-right-zero
  :theory PeanoInduction
  :goal (proves (add-right-z ?n))
  :derivation
    (nat-ind
      (arz-i (eq-refl))
      (arz-i (eq-succ (arz-e (assumption))))))


;; ════════════════════════════════════════════════════════════
;; Lemma 2:  ∀n,m. n + S(m) = S(n + m)  (right successor)
;; ════════════════════════════════════════════════════════════
;;
;; Proof by induction on n  (m is universally quantified).
;;
;; Base case:  0 + S(m) = S(0 + m)
;;   Both sides rewrite to S(m).  Then eq-refl.
;;
;; Step case:  Assume n + S(m) = S(n + m).  Prove S(n) + S(m) = S(S(n) + m).
;;   LHS rewrites:  (add (s n) (s m)) → (s (add n (s m)))
;;   RHS rewrites:  (s (add (s n) m)) → (s (s (add n m)))
;;   By eq-succ on IH:  S(n + S(m)) = S(S(n + m)).

(proof add-right-succ
  :theory PeanoInduction
  :goal (proves (add-right-s ?n))
  :derivation
    (nat-ind
      (ars-i (eq-refl))
      (ars-i (eq-succ (ars-e (assumption))))))


;; ════════════════════════════════════════════════════════════
;; Theorem:  ∀n,m. n + m = m + n  (commutativity of addition)
;; ════════════════════════════════════════════════════════════
;;
;; Proof by induction on n  (m is universally quantified).
;;
;; Base case:  0 + m = m + 0
;;   LHS rewrites to m.  RHS = m + 0 = m by right-z-lemma.
;;   So:  eq-symm(right-z-lemma).
;;
;; Step case:  Assume n + m = m + n.  Prove S(n) + m = m + S(n).
;;   LHS rewrites:  (add (s n) m) → (s (add n m))
;;   Chain:  S(n + m) = S(m + n)         [eq-succ on IH]
;;           S(m + n) = m + S(n)          [eq-symm of right-s-lemma]
;;   So:  eq-trans(eq-succ(IH), eq-symm(right-s-lemma))

(proof add-comm
  :theory PeanoInduction
  :goal (proves (add-comm-p ?n))
  :derivation
    (nat-ind
      (ac-i (eq-symm (right-z-lemma)))
      (ac-i (eq-trans
              (eq-succ (ac-e (assumption)))
              (eq-symm (right-s-lemma))))))
