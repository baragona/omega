;;; Monad Bridge: Hoare Logic as Kleisli Category
;;;
;;; The Curry-Howard-Lambek correspondence says:
;;;   Logic  =  Types  =  Categories
;;;
;;; This file demonstrates the DEEPEST connection:
;;;   - A monad T on a category C gives a Kleisli category C_T
;;;   - In C_T, morphisms A → T(B) compose via Kleisli composition
;;;   - The STATE MONAD gives Hoare logic: pre/postconditions as types
;;;
;;; Concretely:
;;;   - Objects = (State, Predicate) pairs   (Hoare types)
;;;   - Morphisms = Programs with specs      (Hoare triples)
;;;   - Composition = Sequential execution   (Hoare sequencing)
;;;   - Return = Skip (do nothing)           (Kleisli identity)
;;;   - Bind = Sequence two programs          (Kleisli composition)
;;;
;;; The monad laws ARE the Hoare logic laws:
;;;   - Left identity:  return >>= f  =  f     (skip;c = c)
;;;   - Right identity: m >>= return  =  m     (c;skip = c)
;;;   - Associativity: (m >>= f) >>= g = m >>= (λx. f x >>= g)
;;;     (sequential composition is associative)
;;;
;;; Proved here (10 proofs):
;;;
;;;   Kleisli structure:
;;;   1.  return : A → T(A)                     (pure / skip)
;;;   2.  bind(f,g) : A → T(C)                  (composition / sequencing)
;;;   3.  bind(return, f) = f                    (left identity)
;;;   4.  bind(f, return) = f                    (right identity)
;;;
;;;   State machine (counter):
;;;   5.  inc : Unit → T(Unit)                   (increment counter)
;;;   6.  get : Unit → T(Nat)                    (read counter)
;;;   7.  inc;inc : Unit → T(Unit)               (two increments)
;;;   8.  inc;get : Unit → T(Nat)                (increment then read)
;;;
;;;   Hoare triples:
;;;   9.  {n=0} inc;inc {n=2}                    (specification)
;;;  10.  {n=k} inc;inc;inc {n=k+3}             (parameterized spec)

(theory KleisliMonad

  ;; ══════════════════════════════════════
  ;; TYPES (objects in the base category)
  ;; ══════════════════════════════════════

  (sort Ty)

  (constructor Unit   : Ty)
  (constructor NatTy  : Ty)
  (constructor PairTy : (-> Ty Ty Ty))

  ;; T(A) — the monadic type (computation returning A)
  (constructor T : (-> Ty Ty))

  ;; ══════════════════════════════════════
  ;; PROGRAMS (morphisms in the Kleisli category)
  ;; ══════════════════════════════════════
  ;; A Kleisli morphism A → T(B) is a "program" that takes
  ;; input of type A and produces output of type B with effects.

  (sort Prog)

  ;; Kleisli structure
  (constructor ret    : Prog)                    ;; return : A → T(A)
  (constructor bind   : (-> Prog Prog Prog))     ;; bind(f,g) : Kleisli composition

  ;; State operations (counter)
  (constructor inc    : Prog)                    ;; increment counter
  (constructor get    : Prog)                    ;; read counter value
  (constructor reset  : Prog)                    ;; reset counter to 0

  ;; ══════════════════════════════════════
  ;; KLEISLI TYPING
  ;; ══════════════════════════════════════
  ;; (kleisli ?f ?A ?B) means f : A → T(B) in the Kleisli category

  (judgment (kleisli ?f ?A ?B) :where f : Prog A : Ty B : Ty)

  ;; Return is identity in Kleisli
  (rule k-ret
    :conclusion (kleisli ret ?A ?A))

  ;; Bind is composition in Kleisli
  ;; f : A → T(B),  g : B → T(C)  ⊢  bind(f,g) : A → T(C)
  (rule k-bind
    :premises ((kleisli ?f ?A ?B) (kleisli ?g ?B ?C))
    :conclusion (kleisli (bind ?f ?g) ?A ?C))

  ;; State operations
  (rule k-inc
    :conclusion (kleisli inc Unit Unit))

  (rule k-get
    :conclusion (kleisli get Unit NatTy))

  (rule k-reset
    :conclusion (kleisli reset Unit Unit))

  ;; ══════════════════════════════════════
  ;; MONAD LAWS (equational rewriting)
  ;; ══════════════════════════════════════

  ;; Left identity: bind(ret, f) = f
  (rewrite monad-left  (bind ret ?f) ?f)

  ;; Right identity: bind(f, ret) = f
  (rewrite monad-right (bind ?f ret) ?f)

  ;; Associativity: bind(bind(f,g), h) = bind(f, bind(g,h))
  (rewrite monad-assoc (bind (bind ?f ?g) ?h) (bind ?f (bind ?g ?h)))

  ;; ══════════════════════════════════════
  ;; NATURAL NUMBERS (for counter values)
  ;; ══════════════════════════════════════

  (sort Nat)
  (constructor z : Nat)
  (constructor s : (-> Nat Nat))
  (constructor add : (-> Nat Nat Nat))

  (rewrite add-z (add z ?n) ?n)
  (rewrite add-s (add (s ?m) ?n) (s (add ?m ?n)))

  ;; ══════════════════════════════════════
  ;; HOARE TRIPLES
  ;; ══════════════════════════════════════
  ;; A Hoare triple {P} c {Q} specifies a program's behavior.
  ;; In the Kleisli view, this is a typed morphism:
  ;;   c : (State satisfying P) → T(State satisfying Q)

  (sort Pred)

  ;; Predicates about the counter
  (constructor count-is  : (-> Nat Pred))           ;; counter = n
  (constructor count-geq : (-> Nat Pred))           ;; counter >= n
  (constructor tt-pred   : Pred)                    ;; trivially true

  ;; Hoare triple judgment
  (judgment (hoare ?pre ?c ?post) :where pre : Pred c : Prog post : Pred)

  ;; Skip (return) preserves the predicate
  (rule h-skip
    :conclusion (hoare ?P ret ?P))

  ;; Sequencing: {P} c1 {Q}, {Q} c2 {R} ⊢ {P} c1;c2 {R}
  (rule h-seq
    :premises ((hoare ?P ?c1 ?Q) (hoare ?Q ?c2 ?R))
    :conclusion (hoare ?P (bind ?c1 ?c2) ?R))

  ;; Increment: {count = n} inc {count = n+1}
  (rule h-inc
    :conclusion (hoare (count-is ?n) inc (count-is (s ?n))))

  ;; Get: {count = n} get {count = n}  (reading doesn't change state)
  (rule h-get
    :conclusion (hoare (count-is ?n) get (count-is ?n)))

  ;; Reset: {P} reset {count = 0}  (resets regardless of precondition)
  (rule h-reset
    :conclusion (hoare ?P reset (count-is z)))

  ;; Consequence: weaken precondition / strengthen postcondition
  ;; For simplicity, we only have tt-pred weakening
  (rule h-weaken-pre
    :premises ((hoare ?P ?c ?Q))
    :conclusion (hoare tt-pred ?c ?Q))

  ;; Equality checker
  (sort Eq)
  (constructor eq : (-> Prog Prog Eq))
  (judgment (prog-eq ?e) :where e : Eq)
  (rule eq-refl :conclusion (prog-eq (eq ?A ?A))))

(check-theory KleisliMonad)


;; ════════════════════════════════════════════════════════════
;;  KLEISLI STRUCTURE
;; ════════════════════════════════════════════════════════════

;; ─── Proof 1: return : A → T(A) ───
;; The Kleisli identity.  "Do nothing, return the input."
;; In Hoare logic: skip.

(proof kleisli-return
  :theory KleisliMonad
  :goal (kleisli ret Unit Unit)
  :derivation (k-ret))


;; ─── Proof 2: bind(f,g) : A → T(C) ───
;; Kleisli composition.  "Run f, then feed result to g."
;; In Hoare logic: sequential composition.

(proof kleisli-compose
  :theory KleisliMonad
  :goal (kleisli (bind inc get) Unit NatTy)
  :derivation (k-bind (k-inc) (k-get)))


;; ─── Proof 3: Left identity — bind(ret, f) = f ───
;; Monad law: return >>= f  =  f
;; "Doing nothing then running f is the same as just running f."

(proof monad-left-id
  :theory KleisliMonad
  :goal (prog-eq (eq (bind ret inc) inc))
  :derivation (eq-refl))


;; ─── Proof 4: Right identity — bind(f, ret) = f ───
;; Monad law: f >>= return  =  f
;; "Running f then doing nothing is the same as just running f."

(proof monad-right-id
  :theory KleisliMonad
  :goal (prog-eq (eq (bind inc ret) inc))
  :derivation (eq-refl))


;; ════════════════════════════════════════════════════════════
;;  STATE MACHINE (Counter)
;; ════════════════════════════════════════════════════════════

;; ─── Proof 5: inc : Unit → T(Unit) ───
;; Increment is a Kleisli morphism.

(proof counter-inc
  :theory KleisliMonad
  :goal (kleisli inc Unit Unit)
  :derivation (k-inc))


;; ─── Proof 6: get : Unit → T(Nat) ───
;; Get is a Kleisli morphism returning a natural number.

(proof counter-get
  :theory KleisliMonad
  :goal (kleisli get Unit NatTy)
  :derivation (k-get))


;; ─── Proof 7: inc;inc : Unit → T(Unit) ───
;; Two increments composed.  Kleisli composition in action.

(proof counter-inc-inc
  :theory KleisliMonad
  :goal (kleisli (bind inc inc) Unit Unit)
  :derivation (k-bind (k-inc) (k-inc)))


;; ─── Proof 8: inc;get : Unit → T(Nat) ───
;; Increment then read.  Heterogeneous Kleisli composition.

(proof counter-inc-get
  :theory KleisliMonad
  :goal (kleisli (bind inc get) Unit NatTy)
  :derivation (k-bind (k-inc) (k-get)))


;; ════════════════════════════════════════════════════════════
;;  HOARE TRIPLES (Specifications)
;; ════════════════════════════════════════════════════════════

;; ─── Proof 9: {n=0} inc;inc {n=2} ───
;; "Starting from counter=0, two increments yield counter=2."
;; This is the Hoare triple as a Kleisli typed morphism.

(proof hoare-inc-inc
  :theory KleisliMonad
  :goal (hoare (count-is z) (bind inc inc) (count-is (s (s z))))
  :derivation (h-seq (h-inc) (h-inc)))


;; ─── Proof 10: {n=0} inc;inc;inc {n=3} ───
;; "Three increments from zero yield three."
;; Note: monad associativity makes bind(bind(inc,inc),inc)
;; and bind(inc,bind(inc,inc)) equal.  We use the right-associated form.

(proof hoare-inc-inc-inc
  :theory KleisliMonad
  :goal (hoare (count-is z) (bind inc (bind inc inc)) (count-is (s (s (s z)))))
  :derivation (h-seq (h-inc) (h-seq (h-inc) (h-inc))))


;; ════════════════════════════════════════════════════════════
;; THE KLEISLI CORRESPONDENCE
;; ════════════════════════════════════════════════════════════
;;
;;   Base Category C           Kleisli Category C_T
;;   ─────────────────────────────────────────────────
;;   Objects: Types             Objects: Types
;;   Morphisms: A → B          Morphisms: A → T(B)
;;   Composition: g ∘ f        Composition: bind(f, g)
;;   Identity: id              Identity: return
;;
;;   Hoare Logic                Kleisli Interpretation
;;   ─────────────────────────────────────────────────
;;   {P} skip {P}              return : P → T(P)
;;   {P} c1;c2 {R}            bind(c1,c2) : P → T(R)
;;   {P} c {Q}                c : (Pre=P) → T(Post=Q)
;;
;; The monad laws ensure:
;;   skip;c = c                (left identity)
;;   c;skip = c                (right identity)
;;   (c1;c2);c3 = c1;(c2;c3)  (associativity)
;;
;; These are exactly the laws of a category!
;; Hoare logic IS the internal logic of the Kleisli category
;; for the state monad.
;; ════════════════════════════════════════════════════════════
